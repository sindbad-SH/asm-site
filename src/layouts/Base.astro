---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import MobileMenu from "../components/MobileMenu.astro";
import PageVeil from "../components/PageVeil.astro";
import { SITE } from "../consts";
import { ogSources, pageKey, breadcrumbTrail, shortTitle } from "../lib/seo";
// Hashed URLs for the two paint-critical font files (display + body), so we
// can preload them — text is the LCP on most pages, and early font arrival
// also shrinks the swap-shift window (§4 CLS).
import frauncesWoff2 from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import dmSansWoff2 from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  /** keep this page out of search indexes (e.g. the 404) */
  noindex?: boolean;
  /** place name for story pages — becomes the Article's contentLocation */
  location?: string;
}

// PUB-D (2026-07-27) — default description no longer uses "The StorySmith" as
// a name/title byline (retired site-wide per the consistency sweep; only
// used as JSON-LD alternateName below now). Currently the fallback for pages
// that pass no description prop (e.g. 404.astro).
const DEFAULT_DESCRIPTION = "Adventure Storytelling Media — Adventure & Venture Stories from Boulder, Colorado.";
const { title, description = DEFAULT_DESCRIPTION, noindex = false, location } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Absolute URLs for social scrapers (they don't resolve relative paths).
// Astro.site is parameterized in astro.config.mjs (staging github.io vs the
// apex domain at cutover), so these flip automatically with DEPLOY_TARGET.
const abs = (path: string) => new URL(`${base}${path}`, Astro.site).href;
// strip the base prefix (if present) then re-join — avoids the double-slash
// a naive string replace produces on the root path
const pagePath = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length) || "/"
  : Astro.url.pathname;
const canonical = new URL(`${base}${pagePath}`, Astro.site).href;
// Staging (github.io) must never compete with the live domain in search.
const isStaging = (Astro.site?.href ?? "").includes("github.io");

// SEO PASS (2026-10-17) — story pages share their OWN lead photo (a 1200×630
// JPEG baked by src/pages/og/[...slug].jpg.ts, alt reused verbatim) and are
// typed as articles; everything else keeps the brand endcard. See src/lib/seo.ts.
const og = (await ogSources())[pageKey(pagePath)];
const ogImage = og ? abs(`/og/${pageKey(pagePath)}.jpg`) : abs("/media/og.jpg");
const ogImageAlt = og?.alt ?? `The ${SITE.name} mountain-S mark over snowy peaks and an aurora night sky`;
const isArticle = !!og;
const trail = breadcrumbTrail(pagePath, title);

// JSON-LD (BUILD-ORDERS Task 9; REPOSITION 2026-08-27, operator-directed) —
// a PUBLICATION, not a vendor: Person + Organization (the publisher, carrying
// contact@ and the socials) + WebSite (published by the Organization). The
// former ProfessionalService node was a machine-readable services-for-hire
// claim to search engines and AI assistants and is deliberately GONE. Values
// come ONLY from the SITE consts (no composed facts). Socials wire in as
// `sameAs` only for the entries that actually exist on SITE.socials.
const siteBase = new URL(base || "/", Astro.site).href.replace(/\/$/, "");
const sameAs = Object.values(SITE.socials);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteBase}/#person`,
      name: SITE.person,
      alternateName: SITE.persona,
      // REPOSITION (2026-08-27): NO email on the Person node — SITE.
      // founderEmail renders ONLY beside the /about portrait (placement
      // policy 2026-08-20), and JSON-LD ships on every page: scarcity is
      // the mechanism, so the direct address stays out of structured data.
      url: `${siteBase}/`,
    },
    {
      // SEO PASS (2026-10-17): NewsMediaOrganization is schema.org's
      // Organization subtype for publishers — the publication framing above,
      // in the vocabulary search engines read. Same properties as before, plus
      // the site-wide default meta description (existing copy).
      "@type": "NewsMediaOrganization",
      "@id": `${siteBase}/#publisher`,
      name: SITE.name,
      description: DEFAULT_DESCRIPTION,
      url: `${siteBase}/`,
      email: `mailto:${SITE.email}`,
      logo: `${siteBase}/logo-mark.png`,
      founder: { "@id": `${siteBase}/#person` },
      ...(sameAs.length ? { sameAs } : {}),
    },
    {
      "@type": "WebSite",
      "@id": `${siteBase}/#site`,
      name: SITE.name,
      publisher: { "@id": `${siteBase}/#publisher` },
      url: `${siteBase}/`,
      inLanguage: "en",
    },
    // SEO PASS (2026-10-17) — story pages: an Article built only from what
    // the page already says (its title, description, lead photo, place).
    // No dates: the site records when stories HAPPENED, not when they were
    // published, and datePublished must not guess.
    ...(isArticle
      ? [
          {
            "@type": "Article",
            "@id": `${canonical}#article`,
            headline: shortTitle(title),
            description,
            image: { "@type": "ImageObject", url: ogImage, width: 1200, height: 630, caption: ogImageAlt },
            author: { "@id": `${siteBase}/#person` },
            publisher: { "@id": `${siteBase}/#publisher` },
            isPartOf: { "@id": `${siteBase}/#site` },
            mainEntityOfPage: canonical,
            inLanguage: "en",
            ...(location ? { contentLocation: { "@type": "Place", name: location } } : {}),
          },
        ]
      : []),
    ...(trail
      ? [
          {
            "@type": "BreadcrumbList",
            itemListElement: trail.map((t, i) => ({
              "@type": "ListItem",
              position: i + 1,
              name: t.name,
              item: new URL(`${base}${t.path === "/" ? "/" : `${t.path}/`}`, Astro.site).href,
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}/favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="preload" as="font" type="font/woff2" href={frauncesWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={dmSansWoff2} crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(isStaging || noindex) && <meta name="robots" content="noindex" />}

    <!-- Open Graph / Twitter (og.jpg = the brand endcard: mark over the sting
         scene; story pages use their own lead photo — src/lib/seo.ts) -->
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- JSON-LD: the publication (Person + publisher + WebSite — no services
         entity), plus Article + BreadcrumbList on story pages.
         Values only from SITE consts — no composed facts (BUILD-ORDERS
         Task 9; REPOSITION 2026-08-27). -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      document.documentElement.classList.replace("no-js", "js");
    </script>

    <!-- Privacy-respecting analytics (GoatCounter: no cookies, no personal
         data, aggregate counts only). DISABLED until SITE.analytics is set to
         a real GoatCounter code — requires Sindbad to create the (free)
         account; see /privacy. Nothing loads while it's empty. -->
    {
      SITE.analytics && (
        <script
          is:inline
          data-goatcounter={`https://${SITE.analytics}.goatcounter.com/count`}
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>
    <!-- P2 — entry/navigation ritual. The home page's entry belongs to the
         Portal Hero, so the veil only holds first paint on subpages. -->
    <PageVeil entry={pagePath !== "/"} />
    <Nav />
    <MobileMenu />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Reveal engine + watchdog (v1 KEEP architecture, research-brief §7):
      // [data-reveal] elements are hidden only under html.js (CSS), revealed
      // on approach, force-revealed by a 4s watchdog so nothing can stay
      // hidden, and skipped entirely under reduced motion.
      (() => {
        const els = document.querySelectorAll("[data-reveal]");
        if (!els.length) return;
        const revealAll = () => els.forEach((el) => el.classList.add("is-revealed"));
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
          revealAll();
          return;
        }
        // DIRECTION §1.1 P3: 70ms stagger between siblings (proof-band legend
        // items opt into 40ms via data-reveal-stagger). Siblings entering in the
        // same IO batch get an incremental --reveal-delay so a heading/body/CTA
        // group arrives as a staged sequence, then settles (once: true — the
        // element is unobserved after it reveals, so it never re-animates).
        const io = new IntersectionObserver(
          (entries) => {
            const arriving = entries.filter((e) => e.isIntersecting);
            // group by parent so only true siblings stagger together
            const seq = new Map();
            for (const entry of arriving) {
              const el = entry.target;
              const parent = el.parentElement;
              const step = Number(el.getAttribute("data-reveal-stagger")) || 70;
              const n = seq.get(parent) ?? 0;
              seq.set(parent, n + 1);
              el.style.setProperty("--reveal-delay", `${n * step}ms`);
              el.classList.add("is-revealed");
              io.unobserve(el);
            }
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
        setTimeout(revealAll, 4000); // watchdog — nothing stays hidden
      })();
    </script>
    <script>
      // Site-wide Lenis smooth scroll (v1 KEEP). Singleton; no-ops under
      // reduced motion. Scroll-animation islands share this same instance.
      import { ensureSmoothScroll } from "../lib/smooth-scroll";
      void ensureSmoothScroll();
    </script>
  </body>
</html>
