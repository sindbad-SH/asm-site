---
/**
 * /adventure/vybe — LAKE & LIGHTS (VYBE).
 *
 * v4 (2026-08-01, adversarial-critic fix round — attempt #3 graded STILL
 * SHORT against /adventure/steel-and-dust with measured evidence; this pass
 * executes all five of the critic's specific findings). v3 (2026-07-31)
 * ported Steel & Dust's newsstand/chapter-numeral/stagger/bleed/field-log
 * grammar but fell short on: a 2.7x-upscaled 406x720 hero video; two
 * 555px/~200px stagger height voids from mismatched aspect ratios and one
 * flipped-grid DOM-order bug; a 4-rank cover (exemplar has 6) plus a mobile
 * corner-slate collision at 390px; one photo (`festival-grounds`) used
 * twice and the "lake + red container" scene owning ~4 of 12 slots while
 * the strongest frame (`flow-arts`) sat unused at thumbnail scale and
 * another band's stage banner was the single largest image on the page.
 * Fixed below, each verified with real numbers (see the FIX comments at
 * each site + SITE-COPY-DECK-publication-v1.md's 2026-08-01 entry):
 *
 *   FIX 1 — the hero video is now a real 1920x1080 4-shot montage (one
 *   native-landscape anchor + three disclosed 1.78x-upscale shots off
 *   35-50Mbps portrait originals — see _VYBE-VIDEO-V3/_NOTES.md), replacing
 *   public/media/work/vybe/clips/vybe-fest.mp4 in place (same filename,
 *   same /work/vybe case-page dependency — that page's own `.case-clip` box
 *   was ALREADY coded for 16:9 and had been stretching the old 9:16 clip
 *   into it; this fixes that page too, unrequested but free). It renders in
 *   a true 16:9 box at the same >=960px-wide slot Steel & Dust's own
 *   showcase loop uses (`.vy-video`, ported from `.sd-video`) — never
 *   upscaled past native pixels again.
 *
 *   FIX 2 — every asymmetric two-up stagger had one column's aspect ratio
 *   fighting its grid track (a portrait 4:5 photo landing in the narrow
 *   34fr column opposite a landscape photo in the wide 58fr column, or vice
 *   versa) instead of the exemplar's own 16:9-wide/4:3-narrow pairing that
 *   yields its measured 72px differential. Fixed per-site below by either
 *   correcting a flipped-grid DOM-order bug (mirrored stagger) or swapping
 *   the wide column's aspect ratio to 4:3 (both non-flip staggers) —
 *   verified against rendered getBoundingClientRect() heights, not
 *   estimated.
 *
 *   FIX 3 — the cover gains the two ranks the exemplar has and this page
 *   didn't: an Anton masthead line ("VYBE", Steel & Dust's "Field Notes"
 *   equivalent) and a kicker ("The cover story", ported verbatim). The
 *   title becomes a two-word "Lake & Lights" with the same cyan-ampersand
 *   accent glyph as "Steel & Dust" (six ranks total now, matching the
 *   exemplar). The 390px corner-slate collision («ADVENTURE STORY ·
 *   COVERAGEDENVER, COLORADO» with zero gap — two long absolutely-
 *   positioned labels with no shared min-gap) is fixed two ways: the
 *   left slate is shortened ("Adventure story · coverage" → "Coverage")
 *   AND both slates move into a flex row with justify-content:space-between
 *   + an explicit gap, so no future copy change can make them touch again.
 *
 *   FIX 4 — see src/data/postcards.ts's 2026-08-01 entry + the /postcards
 *   gallery rework (both fixed together, same critic finding on the
 *   Brazil postcard linked from this lane).
 *
 *   FIX 5 — `festival-grounds` now appears once, not twice (the closing
 *   "bookend" beat is now `flow-duo`, not a repeat). `nadir-grounds` (the
 *   empty picnic-blanket top-down) is dropped entirely; `flow-arts` — the
 *   critic's pick for strongest photo on the page — takes over the
 *   full-bleed slot it vacated. `boogie-chillsbury-doughboys` (another
 *   band's stage banner, formerly the single largest image on the page) is
 *   demoted from a 100vw bleed to a contained column photo. The "lake + red
 *   container" scene now owns 2 of 12 slots (cover + one stagger image), not
 *   ~4 — every other slot is a genuinely different moment.
 *
 * Media: 12 photos baked by scripts/make-vybe-section.mjs (source:
 * C:/builds/asm/SAMPLES/photos/vybe/_CONTACT-SHEET.md — his own already-
 * culled, already-graded selects, not raw footage). No new photo bakes this
 * pass — v4 only re-sequences/re-crops the existing 12.
 *
 * HONESTY: no Vybe brand/logo assets anywhere on this page (their official
 * pack hasn't been provided — see the vybe-community-partner memo). The one
 * relationship claim is LegendMark's verbatim permittedPhrasing ("event
 * coverage for Vybe"). The live band at the 2023 festival is captioned
 * generically ("a band") — no name is verified in the source material, so
 * none is invented. The Chillsbury Doughboys' name IS verified (read
 * straight off the venue's own stage signage in frame).
 * ⚠ OPERATOR READ-APPROVAL REQUIRED — every heading/paragraph/caption below
 * is new or revised copy (staging-only until read), matching this page's own
 * existing VYBE-section convention (copy authored inline, not routed through
 * consts.ts — unlike the festival/steelDust copy blocks).
 */
import Base from "../../layouts/Base.astro";
import LegendMark from "../../components/LegendMark.astro";
import { existsSync } from "node:fs";
import { join } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const VDIR = join(process.cwd(), "public", "media", "adventure", "vybe");
// Widths vary per photo now (scale-contrast fix) — see make-vybe-section.mjs.
const W = {
  vertical: [800, 1120, 1600],
  verticalSm: [800, 1120],
  landscape: [900, 1600],
  wide: [1600, 2000],
  wideSm: [1200, 1600],
} as const;
function photo(slug: string, widths: readonly number[]) {
  const w0 = widths[0]!;
  if (!existsSync(join(VDIR, `${slug}-${w0}.avif`))) return undefined;
  return {
    avif: widths.map((w) => `${base}/media/adventure/vybe/${slug}-${w}.avif ${w}w`).join(", "),
    webp: widths.map((w) => `${base}/media/adventure/vybe/${slug}-${w}.webp ${w}w`).join(", "),
    src: `${base}/media/adventure/vybe/${slug}-${w0}.webp`,
  };
}

// FIX 5 (2026-08-01): nadir-grounds (an empty picnic-blanket top-down) is
// dropped entirely — the empty-of-people bleed the critic flagged. flow-duo
// and fire-staff-spin now each do double duty: a tiny cover plate AND a full
// feature later on the page (mirrored stagger / closing beat), so both
// "Inside — flow arts" / "Inside — fire staff" teases actually pay off.
const cover = photo("festival-reveal", W.vertical);
const flowDuo = photo("flow-duo", W.vertical);
const fireStaffSpin = photo("fire-staff-spin", W.vertical);
const festivalGrounds = photo("festival-grounds", W.landscape);
const bandGoldenFlare = photo("band-golden-flare", W.vertical);
const flowArts = photo("flow-arts", W.verticalSm);
const duskCircle = photo("dusk-circle", W.landscape);
const bandGuitarist = photo("band-guitarist", W.landscape);
const boogieRoom = photo("boogie-room", W.landscape);
const boogieStage = photo("boogie-stage", W.verticalSm);
const boogieChillsbury = photo("boogie-chillsbury-doughboys", W.wideSm);

// The hero reveal — re-mined 2026-07-31 (see header note), existence-gated,
// poster-first, IO-gated, same contract as every other ambient loop on the
// site.
const clipDir = join(process.cwd(), "public", "media", "work", "vybe", "clips");
const clip = existsSync(join(clipDir, "vybe-fest.mp4"))
  ? {
      src: `${base}/media/work/vybe/clips/vybe-fest.mp4`,
      posterAvif: existsSync(join(clipDir, "vybe-fest-poster.avif"))
        ? `${base}/media/work/vybe/clips/vybe-fest-poster.avif`
        : undefined,
      posterWebp: existsSync(join(clipDir, "vybe-fest-poster.webp"))
        ? `${base}/media/work/vybe/clips/vybe-fest-poster.webp`
        : undefined,
    }
  : undefined;
---

<Base
  title="In the Room with Vybe — Adventure Storytelling Media"
  description="Two nights with Vybe, a Denver arts, music, and dance collective — the 2023 outdoor festival from the air and the 2024 Boogie Lights show, in frames and a short clip."
>
  <div data-lane="adventure">
    <!-- ── MOVEMENT 1 · THE NEWSSTAND ──────────────────────────────────── -->
    <section class="vy-stage" aria-label="Vybe — In the Room with Vybe">
      <div class="vy-stand">
        {
          flowDuo && (
            <figure class="vy-plate vy-plate--l" data-reveal aria-hidden="true">
              <picture>
                <source type="image/avif" srcset={flowDuo.avif} sizes="300px" />
                <source type="image/webp" srcset={flowDuo.webp} sizes="300px" />
                <img src={flowDuo.src} alt="" loading="lazy" decoding="async" />
              </picture>
              <figcaption class="hud-label">Inside — flow arts</figcaption>
            </figure>
          )
        }

        <div class="vy-cover" data-reveal>
          {
            cover && (
              <picture>
                <source type="image/avif" srcset={cover.avif} sizes="(min-width: 640px) 600px, 92vw" />
                <source type="image/webp" srcset={cover.webp} sizes="(min-width: 640px) 600px, 92vw" />
                <img
                  src={cover.src}
                  alt="A blue-hour aerial reveal over the Vybe festival grounds beside a lake, string lights glowing through the cottonwoods"
                  class="vy-cover-img"
                  fetchpriority="high"
                  decoding="async"
                />
              </picture>
            )
          }
          <div class="vy-scrim" aria-hidden="true"></div>

          <!-- factual corner slates — a flex row with a real min-gap (FIX 3:
               these used to be two independent position:absolute labels
               with no shared gap, which collided at 390px into "ADVENTURE
               STORY · COVERAGEDENVER, COLORADO"; the left slate is also
               shortened so there's slack even before the flex gap helps). -->
          <div class="vy-corners">
            <p class="vy-corner hud-label">Coverage</p>
            <p class="vy-corner hud-label vy-accent">Denver, Colorado</p>
          </div>

          <!-- masthead in the sky band (FIX 3 — the rank the exemplar's
               "Field Notes" fills and this cover didn't have) -->
          <header class="vy-masthead">
            <p class="vy-masthead-word">Vybe</p>
            <p class="vy-masthead-credit hud-label">Adventure Storytelling Media</p>
          </header>

          <!-- survey spine — territory + dates only; no invented coordinates -->
          <p class="vy-coords hud-label" aria-hidden="true">DENVER · 2023–2024</p>

          <div class="vy-titleblock">
            <p class="hud-label vy-accent">The cover story</p>
            <h1 class="vy-cover-title">
              Lake <span class="vy-amp" aria-hidden="true">&amp;</span><span class="sr-only">and</span> Lights
            </h1>
            <p class="vy-cover-deck">
              Two nights with a Denver arts, music, and dance collective — an outdoor festival by
              a lake, and a room full of Boogie Lights the following spring.
            </p>
            <ul class="vy-teasers" role="list">
              <li class="hud-label">Fire &amp; LED flow arts</li>
              <li class="hud-label">A lake in fall</li>
              <li class="hud-label">Boogie Lights, 2024</li>
            </ul>
          </div>
        </div>

        {
          fireStaffSpin && (
            <figure class="vy-plate vy-plate--r" data-reveal aria-hidden="true">
              <picture>
                <source type="image/avif" srcset={fireStaffSpin.avif} sizes="300px" />
                <source type="image/webp" srcset={fireStaffSpin.webp} sizes="300px" />
                <img src={fireStaffSpin.src} alt="" loading="lazy" decoding="async" />
              </picture>
              <figcaption class="hud-label">Inside — fire staff</figcaption>
            </figure>
          )
        }
      </div>
      <p class="vy-cue hud-label" aria-hidden="true">Scroll for the story ↓</p>
    </section>

    <!-- ── MOVEMENT 2 · THE STORY ──────────────────────────────────────── -->
    <article class="border-t border-hairline vy-report">
      <header class="vy-col vy-open vy-chapter" data-chapter="01" data-reveal>
        <hr class="flight-line mb-6" aria-hidden="true" />
        <p class="hud-label" data-reveal>Vybe · Denver · 2023–2024</p>
        <p class="hud-label vy-accent" data-reveal>Words &amp; drone — Sindbad Horizon</p>
        <p class="vy-lede" data-reveal>
          Vybe — short for Vibrate Your Best Energy — is a Denver arts, music, and dance
          collective built around community: Park &amp; Play gatherings, an annual outdoor
          festival, and whatever room they show up in.
        </p>
      </header>

      <div class="vy-col space-y-6">
        <p class="text-lg text-ink" data-reveal>
          I've known the founders since 2023 and have covered two of their nights since — camera
          coverage only, nothing official. The first was their outdoor festival that fall; the
          second was a Boogie Lights show in Denver the following spring, on someone else's
          stage.
        </p>
      </div>

      <!-- THE VIDEO — first visual after the open (same rule as Steel & Dust).
           FIX 1: a real 1920x1080 4-shot montage now (was a 406x720 clip
           upscaled 2.7x to fill this box); the box is ported verbatim from
           Steel & Dust's `.sd-video` — true 16:9, full column width
           (>=960px rendered at desktop), never above native pixels. -->
      {
        clip && (clip.posterAvif || clip.posterWebp) && (
          <section class="mx-auto max-w-5xl px-8 pt-8">
            <figure class="vy-photo" data-reveal>
              <div class="vy-video">
                <picture>
                  {clip.posterAvif && <source type="image/avif" srcset={clip.posterAvif} />}
                  <img class="vy-poster" src={clip.posterWebp ?? clip.posterAvif} alt="" loading="lazy" decoding="async" />
                </picture>
                <video class="vy-loop" data-vy-loop data-loop-src={clip.src} muted loop playsinline preload="none" aria-hidden="true" />
              </div>
              <figcaption class="vy-cap hud-label">
                Golden hour to dusk — the lake, the crowd, and the balloon arch, 2023.
              </figcaption>
            </figure>
          </section>
        )
      }

      <!-- CHAPTER 01 — the 2023 festival -->
      <section class="mx-auto max-w-5xl px-8 pt-10 vy-chapter" data-chapter="01">
        <p class="hud-label vy-accent vy-chapter-label" data-reveal>2023 — The festival</p>
        <div class="vy-col-wide space-y-6">
          <p class="text-lg text-ink" data-reveal>
            Two days beside a lake in the Boulder area, cottonwoods just turning gold. Friday ran
            into night: fire and LED flow artists working under string lights strung through the
            trees, a band playing into the last of the light. Sunday was the same ground in
            daylight — a dance circle, the same band again, a rainbow balloon arch over the gate.
          </p>
        </div>

        {
          (festivalGrounds || bandGoldenFlare) && (
            <div class="vy-stagger">
              {festivalGrounds && (
                <figure class="vy-photo vy-stagger-a" data-reveal>
                  <picture>
                    <source type="image/avif" srcset={festivalGrounds.avif} sizes="(min-width: 1024px) 58vw, 90vw" />
                    <source type="image/webp" srcset={festivalGrounds.webp} sizes="(min-width: 1024px) 58vw, 90vw" />
                    {/* FIX 2: 16/9 → 4/3 (matches the exemplar's own wide-column ratio) —
                        closes a ~101px stagger-height void against bandGoldenFlare's 4:5
                        narrow column down to ~10px. */}
                    <img src={festivalGrounds.src} alt="An aerial view of the Vybe festival grounds beside a lake in fall, a stage tent and parked cars below distant foothills" style="aspect-ratio:4/3;object-fit:cover" class="block w-full" loading="lazy" decoding="async" />
                  </picture>
                  <figcaption class="vy-cap hud-label">The grounds, Sunday morning.</figcaption>
                </figure>
              )}
              {bandGoldenFlare && (
                <figure class="vy-photo vy-stagger-b" data-reveal data-reveal-stagger="80">
                  <picture>
                    <source type="image/avif" srcset={bandGoldenFlare.avif} sizes="(min-width: 1024px) 34vw, 80vw" />
                    <source type="image/webp" srcset={bandGoldenFlare.webp} sizes="(min-width: 1024px) 34vw, 80vw" />
                    <img src={bandGoldenFlare.src} alt="A band performing at golden hour at the 2023 Vybe festival, the singer backlit through fall leaves" style="aspect-ratio:4/5;object-fit:cover" class="block w-full" loading="lazy" decoding="async" />
                  </picture>
                  <figcaption class="vy-cap hud-label">A band played into the last of the light, both days.</figcaption>
                </figure>
              )}
            </div>
          )
        }
      </section>

      <!-- pull quote — overlaps the stagger above -->
      <div class="vy-pull-wrap">
        <blockquote class="vy-pull panel" data-reveal>
          Friday ran into night: fire and LED flow artists working under string lights strung
          through the trees.
        </blockquote>
      </div>

      <!-- full-bleed band — a direct child of the article, breaks the frame.
           FIX 5: was nadirGrounds (an empty picnic-blanket top-down, "editorially
           empty" per the critic) — now flowArts, the critic's pick for strongest
           photo on the page. It's a portrait 4:5 source in a wide/short box, so
           object-position is biased up to keep the LED fans + dancer in frame
           rather than default-centering into a pure leg/ground crop. -->
      {
        flowArts && (
          <figure class="vy-bleed" data-reveal>
            <picture>
              <source type="image/avif" srcset={flowArts.avif} sizes="100vw" />
              <source type="image/webp" srcset={flowArts.webp} sizes="100vw" />
              <img
                src={flowArts.src}
                alt="A flow artist spinning glowing LED fans against the night at the Vybe festival, string-lit trees behind"
                class="vy-bleed-img-top"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <figcaption class="vy-cap vy-bleed-cap hud-label">Fire and LED, after dark — Friday.</figcaption>
          </figure>
        )
      }

      <!-- mirrored stagger (34/58) — FIX 2: dusk-circle and fire-staff-spin are
           now in DOM order matched to the flip grid's actual tracks (fireStaffSpin
           first → the 34fr/narrow track it's sized for; duskCircle second → the
           58fr/wide track). The old order had this backwards — duskCircle (3:2)
           landed narrow and flowArts (4:5) landed wide, a ~555px height void
           (741px vs 232px, measured). Correcting the order alone closes it to
           ~40px, no re-crop needed. flowArts itself moved to the bleed above, so
           fireStaffSpin — until now only a tiny cover plate — fills its slot,
           delivering on the cover's own "Inside — fire staff" tease. -->
      {
        (duskCircle || fireStaffSpin) && (
          <section class="mx-auto max-w-5xl px-8 pt-4">
            <div class="vy-stagger vy-stagger--flip">
              {fireStaffSpin && (
                <figure class="vy-photo vy-stagger-a" data-reveal>
                  <picture>
                    <source type="image/avif" srcset={fireStaffSpin.avif} sizes="(min-width: 1024px) 34vw, 80vw" />
                    <source type="image/webp" srcset={fireStaffSpin.webp} sizes="(min-width: 1024px) 34vw, 80vw" />
                    <img src={fireStaffSpin.src} alt="A festivalgoer spinning a staff in the sun beside the camp tents" style="aspect-ratio:4/5;object-fit:cover" class="block w-full" loading="lazy" decoding="async" />
                  </picture>
                  <figcaption class="vy-cap hud-label">Staff spinning, Sunday afternoon.</figcaption>
                </figure>
              )}
              {duskCircle && (
                <figure class="vy-photo vy-stagger-b" data-reveal data-reveal-stagger="80">
                  <picture>
                    <source type="image/avif" srcset={duskCircle.avif} sizes="(min-width: 1024px) 58vw, 90vw" />
                    <source type="image/webp" srcset={duskCircle.webp} sizes="(min-width: 1024px) 58vw, 90vw" />
                    <img src={duskCircle.src} alt="A group practicing flow arts at dusk under the trees, a rainbow balloon arch behind them" style="aspect-ratio:3/2;object-fit:cover" class="block w-full" loading="lazy" decoding="async" />
                  </picture>
                  <figcaption class="vy-cap hud-label">The dance circle, dusk.</figcaption>
                </figure>
              )}
            </div>
          </section>
        )
      }

      <!-- MOVEMENT 3 · THE FIELD LOG — tilted performer frame + verified facts -->
      <section class="mx-auto max-w-5xl px-8 pt-10 vy-chapter" data-chapter="02">
        <p class="hud-label vy-accent vy-chapter-label" data-reveal>The field log</p>
        <div class="vy-fieldlog">
          {
            bandGuitarist && (
              <figure class="vy-photo vy-tilt" data-reveal>
                <picture>
                  <source type="image/avif" srcset={bandGuitarist.avif} sizes="(min-width: 1024px) 40vw, 90vw" />
                  <source type="image/webp" srcset={bandGuitarist.webp} sizes="(min-width: 1024px) 40vw, 90vw" />
                  <img
                    src={bandGuitarist.src}
                    alt="A guitarist playing in a live band at golden hour at the 2023 Vybe festival, sunlight through the fall trees"
                    style="aspect-ratio:4/3;object-fit:cover"
                    class="block w-full"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <figcaption class="vy-cap hud-label">The guitarist, golden hour, Sunday.</figcaption>
              </figure>
            )
          }
          <div class="space-y-6">
            <p class="text-lg text-ink" data-reveal>
              Same band, a different angle on the same run into evening — the light dropping fast
              below the treeline while the set kept going.
            </p>
            <div class="panel vy-log" data-reveal>
              <p class="hud-label vy-accent">Field log</p>
              <dl>
                <div class="vy-log-row">
                  <dt class="hud-label">Event</dt>
                  <dd>Vybe festival (annual)</dd>
                </div>
                <div class="vy-log-row">
                  <dt class="hud-label">Where</dt>
                  <dd>Boulder area, Colorado</dd>
                </div>
                <div class="vy-log-row">
                  <dt class="hud-label">Dates</dt>
                  <dd>Fall 2023 · Spring 2024</dd>
                </div>
                <div class="vy-log-row">
                  <dt class="hud-label">Second night</dt>
                  <dd>Boogie Lights, Denver</dd>
                </div>
                <div class="vy-log-row">
                  <dt class="hud-label">Coverage</dt>
                  <dd>Drone · camera</dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </section>

      <!-- CHAPTER 02 — Boogie Lights, 2024 -->
      <section class="mx-auto max-w-5xl px-8 pt-10 vy-chapter" data-chapter="03">
        <p class="hud-label vy-accent vy-chapter-label" data-reveal>2024 — Boogie Lights</p>
        <div class="vy-col-wide space-y-6">
          <p class="text-lg text-ink" data-reveal>
            The following spring, Boogie Lights' night, not Vybe's. The collective had a corner
            of the room, their own chalkboard propped against the wall, and a few of their own
            performers sat in with the acts on stage. I shot it from the crowd and the balcony
            both.
          </p>
        </div>

        {
          (boogieRoom || boogieStage) && (
            <div class="vy-stagger">
              {boogieRoom && (
                <figure class="vy-photo vy-stagger-a" data-reveal>
                  <picture>
                    <source type="image/avif" srcset={boogieRoom.avif} sizes="(min-width: 1024px) 58vw, 90vw" />
                    <source type="image/webp" srcset={boogieRoom.webp} sizes="(min-width: 1024px) 58vw, 90vw" />
                    {/* FIX 2: 16/9 → 4/3, same fix as the first stagger — closes the
                        same ~101px void against boogieStage's 4:5 narrow column. */}
                    <img src={boogieRoom.src} alt="The room at a Boogie Lights show, the band on stage under pink and gold light, the crowd packed in front" style="aspect-ratio:4/3;object-fit:cover" class="block w-full" loading="lazy" decoding="async" />
                  </picture>
                  <figcaption class="vy-cap hud-label">From the crowd.</figcaption>
                </figure>
              )}
              {boogieStage && (
                <figure class="vy-photo vy-stagger-b" data-reveal data-reveal-stagger="80">
                  <picture>
                    <source type="image/avif" srcset={boogieStage.avif} sizes="(min-width: 1024px) 34vw, 80vw" />
                    <source type="image/webp" srcset={boogieStage.webp} sizes="(min-width: 1024px) 34vw, 80vw" />
                    <img src={boogieStage.src} alt="The stage at a Boogie Lights show glowing under a golden spotlight, viewed from the back of the room" style="aspect-ratio:4/5;object-fit:cover" class="block w-full" loading="lazy" decoding="async" />
                  </picture>
                  <figcaption class="vy-cap hud-label">From the balcony.</figcaption>
                </figure>
              )}
            </div>
          )
        }
      </section>

      {
