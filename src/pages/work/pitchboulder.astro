---
/**
 * PitchBoulder — the first case study and the template's proof-of-concept
 * (BUILD-PLAN.md §2c/§1.5). All structure lives in CaseStudy.astro; a future
 * case is this same three lines with different data + a real video id.
 */
import Base from "../../layouts/Base.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import { PAGES } from "../../consts";
import { existsSync } from "node:fs";
import { join } from "node:path";

const study = PAGES.work.caseStudies.pitchboulder;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// R3.2c — PitchBoulder reserved logo slot. Per the PARTNER-LOGO RULE (consts.ts),
// PitchBoulder's logo may render (client relationship + public testimonial) IF a
// real asset is supplied. None exists on disk as of 2026-07-06 → this build-time
// check renders nothing today; dropping pb-logo.png in is the only future action.
const pbLogo = existsSync(join(process.cwd(), "public", "media", "work", "pitchboulder", "pb-logo.png"))
  ? `${base}/media/work/pitchboulder/pb-logo.png`
  : undefined;
// The embed his live site already uses (COPY.md §3 / DIRECTION §2.5).
const commercialVideoId = "n7k-Bwu3KIU";
/**
 * LAYOUT-OVERHAUL P3 (2026-08-01, see LAYOUT-RESEQUENCE-PLAN.md +
 * scripts/make-pitchboulder-variety.mjs): the operator flagged the repeated
 * "top-down box-opening" fixed-camera frame — it was BOTH this page's hook
 * and /venture's chapter-card poster. Retired everywhere:
 *  - this hook is now `hook-podium` (his own Tier-1 web pick, 2026-05-06:
 *    a presenter at the Boulder Chamber podium beside the "Every Parent's
 *    Worst Fear" slide);
 *  - the context still is now `context-room` (the professionally edited
 *    Jan-28-2026 eye-level room-wide, per the archive's own _ABOUT.md);
 *  - /venture's hook-poster.avif was re-extracted in place from loop.mp4
 *    (frame n=120) so that card fronts a real frame of the loop it plays.
 * Old files existence-gated as fallbacks so a missing bake never breaks the
 * page. ⚠ OPERATOR READ-APPROVAL REQUIRED — the context caption, Ask-thumb
 * caption, and Work pull quote below are new visible copy (the pull quote is
 * a verbatim reprise of this page's own Context sentence); staging-only
 * until read.
 *
 * LINKEDIN-VERIFIED (rider #2, READ-ONLY mining 2026-08-01): the hook
 * photo's presenter is Alana Arnold, MD, MBA pitching PEMPal — named in
 * Sindbad's OWN LinkedIn recap of that session ("PEMPal at PitchBoulder —
 * Boulder Startup Week... set up shop at the Boulder Chamber"), the same
 * session as the Leyden Space alumni update (photo set 2026-05-06, a
 * Wednesday, matches). The 2026-04-29 ask-thumb founder is NOT named in any
 * recap found, so that caption stays date-only — no name is invented.
 */
const pbMedia = (file: string) =>
  existsSync(join(process.cwd(), "public", "media", "work", "pitchboulder", file))
    ? `${base}/media/work/pitchboulder/${file}`
    : undefined;
// Hook = Alana Arnold, MD, MBA pitching PEMPal at the Boulder Chamber
// (Boulder Startup Week session, 2026-05-06 — see the LinkedIn-verified note).
const hookPoster = pbMedia("hook-podium-1600.avif") ?? `${base}/media/work/pitchboulder/hook-poster.avif`;
const contextImage = pbMedia("context-room-1600.webp") ?? `${base}/media/work/pitchboulder/context.avif`;
const contextAlt =
  "The PitchBoulder room mid-session — presenters at the front, the audience around the tables.";
const contextCaption = "The room at work — January 28, 2026 session.";
const askThumbSrc = pbMedia("ask-thumb-900.webp");
const askThumb = askThumbSrc
  ? {
      src: askThumbSrc,
      alt: "A founder in a blazer taking the floor beside a projected slide at a PitchBoulder session.",
      caption: "A founder takes the floor — April 29, 2026.",
    }
  : undefined;
const workPull = "Watching the gap between what a founder says and what the room actually hears.";
// BTS: no PitchBoulder BTS footage exists → section hidden (DIRECTION §2.5/§2.7).

// Build #4 (2026-08-01 archive-mining integration) — "The Wednesday Room"
// chapter, appended below the case-study template (not inside it — keeps
// CaseStudy.astro's shared shape untouched for the Shelby page too).
// COLLISION-MAP BLOCK: 2 of the plan's original 5 kept images collide with
// stills already live on THIS page (founder-duo-fullroom / full-room-bleed —
// same fixed-camera session as coworking-presenter-1600 / coworking-crowd-
// 1600 above). Ships with the 4 clean images instead — see
// scripts/make-pitchboulder-wednesday-room.mjs header for the full swap
// rationale. No pull-quote here: TESTIMONIALS["pitchboulder"] already
// renders once in CaseStudy's own "05 · Words" chapter above — repeating it
// would render the same quote twice on one page.
const wrDir = join(process.cwd(), "public", "media", "work", "pitchboulder", "wednesday-room");
function wrShot(slug: string) {
  if (!existsSync(join(wrDir, `${slug}-900.avif`))) return undefined;
  const url = (w: number, ext: string) => `${base}/media/work/pitchboulder/wednesday-room/${slug}-${w}.${ext}`;
  return {
    avif: `${url(900, "avif")} 900w, ${url(1600, "avif")} 1600w`,
    webp: `${url(900, "webp")} 900w, ${url(1600, "webp")} 1600w`,
    src: url(900, "webp"),
  };
}
const wrHero = wrShot("leyden-space-hero");
const wrLeydenTitle = wrShot("leyden-space-title");
const wrPerlionTitle = wrShot("perlion-title");
const wrFollowUs = wrShot("followus-handoff");

const WEDNESDAY_ROOM = {
  kicker: "The Wednesday Room",
  heading: "What two years of showing up looks like.",
  paragraphs: [
    `Most weeks, it starts the same way: a projector screen at the front of a Boulder Chamber meeting room, a "Follow Us!" slide with four QR codes, and someone standing at the podium while the last few chairs fill in. Then the slide changes, and for the next hour a rotation of founders gets a few minutes each to make their case to whoever showed up that Wednesday.`,
    "On disk, that adds up to dated session folders for roughly every Wednesday from mid-January through late July 2026, and — further back — three more from the first week of September 2024. Two years of the same room, recorded practically every time it met.",
    `Most weeks the room hears from someone new. Not always — one May session carried a slide titled, plainly, "Alumni Update": a founder named Ashle Jantzen, back to report on Leyden Space, a company she'd apparently already introduced to this room once before.`,
  ],
};
---

<Base title={study.meta.title} description={study.meta.description}>
  <CaseStudy
    study={study}
    base={base}
    commercialVideoId={commercialVideoId}
    hookPoster={hookPoster}
    hookLogo={pbLogo}
    hookLogoAlt="PitchBoulder"
    contextImage={contextImage}
    contextAlt={contextAlt}
    contextCaption={contextCaption}
    askThumb={askThumb}
    workPull={workPull}
    hookCredit="On the wall: Alana Arnold, MD, MBA pitching PEMPal — Boulder Startup Week session, May 6, 2026"
  />

  <section class="wr" aria-label="The Wednesday Room">
    <div class="wr-inner">
      <p class="hud-label wr-kicker">{WEDNESDAY_ROOM.kicker}</p>
      <h2 class="wr-heading">{WEDNESDAY_ROOM.heading}</h2>

      {
        wrHero && (
          <figure class="wr-hero">
            <picture>
              <source type="image/avif" srcset={wrHero.avif} sizes="(max-width: 760px) 100vw, 46rem" />
              <source type="image/webp" srcset={wrHero.webp} sizes="(max-width: 760px) 100vw, 46rem" />
              <img src={wrHero.src} alt="Ashle Jantzen, founder of Leyden Space, mid-gesture at a Boulder Chamber podium, both arms spread wide, a slide reading 'New Electromagnetic Propulsion' projected behind her." loading="lazy" decoding="async" />
            </picture>
            <figcaption class="wr-cap">Ashle Jantzen, back for a PitchBoulder alumni update on Leyden Space.</figcaption>
          </figure>
        )
      }

      <p class="wr-para">{WEDNESDAY_ROOM.paragraphs[0]}</p>
      <p class="wr-para">{WEDNESDAY_ROOM.paragraphs[1]}</p>

      {
        wrFollowUs && (
          <figure class="wr-mid">
            <picture>
              <source type="image/avif" srcset={wrFollowUs.avif} sizes="(max-width: 760px) 100vw, 26rem" />
              <source type="image/webp" srcset={wrFollowUs.webp} sizes="(max-width: 760px) 100vw, 26rem" />
              <img src={wrFollowUs.src} alt="Two men stand together in front of the 'Follow Us!' QR slide, one gesturing toward the room, the other laughing." loading="lazy" decoding="async" />
            </picture>
            <figcaption class="wr-cap">End of session — the room's own recurring closing ritual.</figcaption>
          </figure>
        )
      }

      <p class="wr-para">{WEDNESDAY_ROOM.paragraphs[2]}</p>

      {
        (wrLeydenTitle || wrPerlionTitle) && (
          <div class="wr-duo">
            {wrLeydenTitle && (
              <figure class="wr-duo-fig">
                <picture>
                  <source type="image/avif" srcset={wrLeydenTitle.avif} sizes="(max-width: 760px) 48vw, 20rem" />
                  <source type="image/webp" srcset={wrLeydenTitle.webp} sizes="(max-width: 760px) 48vw, 20rem" />
                  <img src={wrLeydenTitle.src} alt="A projected title slide reading 'Leyden Space — Pitch Boulder Alumni Update — Founder: Ashle Jantzen,' with Jantzen standing at the podium in front of it." loading="lazy" decoding="async" />
                </picture>
                <figcaption class="wr-cap">The title slide that confirms who's back at the podium, and why.</figcaption>
              </figure>
            )}
            {wrPerlionTitle && (
              <figure class="wr-duo-fig">
                <picture>
                  <source type="image/avif" srcset={wrPerlionTitle.avif} sizes="(max-width: 760px) 48vw, 20rem" />
                  <source type="image/webp" srcset={wrPerlionTitle.webp} sizes="(max-width: 760px) 48vw, 20rem" />
                  <img src={wrPerlionTitle.src} alt="A projected title slide reading 'Perlion — Sunscreen Active Ingredients — Logan Chang, CEO,' with Chang standing beside a whiteboard to the right of the screen." loading="lazy" decoding="async" />
                </picture>
                <figcaption class="wr-cap">Logan Chang, CEO of Perlion — three weeks earlier, same podium.</figcaption>
              </figure>
            )}
          </div>
        )
      }

      <p class="wr-para wr-close">
        None of this is dramatic. It's a weekly meeting, in one room, mostly the same shape every time, that's been going on long enough to have its own alumni.
      </p>
    </div>
  </section>

  {/* Structural-only outbound link — see the second CTA already carried by
      /venture/dawn-patrol's own sign-off pattern, applied here. */}
  <section class="mx-auto max-w-3xl px-8 pb-10 text-center">
    <a href={`${base}/venture`} class="link">← Venture Stories</a>
  </section>
</Base>

<style>
  /* CRITIC FIX (CRITIC-REPORT.md, non-blocking finding): the new hook frame
     has a bright white slide area behind the title block — deepen the text
     shadow on this page's hook h1 + credit so they hold contrast. Scoped
     :global so it touches only THIS page's case hook (Shelby unaffected). */
  :global(.case .hero-video__content h1) {
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.85), 0 1px 4px rgba(0, 0, 0, 0.7);
  }
  :global(.case .case-hook-credit) {
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9), 0 1px 3px rgba(0, 0, 0, 0.8);
    color: #fff;
  }

  .wr {
    background: color-mix(in srgb, var(--color-elevated) 55%, var(--color-base));
    border-top: 1px solid var(--color-hairline);
    padding: 4rem 1.5rem 3rem;
  }
  .wr-inner {
    max-width: 46rem;
    margin-inline: auto;
    display: grid;
    gap: 1.3rem;
  }
  .wr-kicker {
    letter-spacing: 0.24em;
    color: color-mix(in srgb, var(--color-accent) 82%, transparent);
  }
  .wr-heading {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 560;
    font-size: clamp(1.7rem, 3.6vw, 2.4rem);
    line-height: 1.15;
    color: var(--color-peak);
    margin: 0 0 0.3rem;
  }
  .wr-para {
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-ink) 92%, transparent);
  }
  .wr-close { font-style: italic; }
  .wr-hero, .wr-mid {
    margin: 0.3rem 0;
  }
  .wr-hero img, .wr-mid img {
    display: block;
    width: 100%;
    border-radius: 8px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .wr-mid { max-width: 26rem; }
  .wr-cap {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--color-ink-muted);
  }
  .wr-duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
    margin: 0.3rem 0;
  }
  .wr-duo-fig img {
    display: block;
    width: 100%;
    border-radius: 8px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  @media (max-width: 560px) {
    .wr-duo { grid-template-columns: 1fr; }
  }
</style>
