---
/**
 * PitchBoulder — the first case study and the template's proof-of-concept
 * (BUILD-PLAN.md §2c/§1.5). All structure lives in CaseStudy.astro; a future
 * case is this same three lines with different data + a real video id.
 */
import Base from "../../layouts/Base.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import { PAGES } from "../../consts";
import { existsSync } from "node:fs";
import { join } from "node:path";

const study = PAGES.work.caseStudies.pitchboulder;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// R3.2c — PitchBoulder reserved logo slot. Per the PARTNER-LOGO RULE (consts.ts),
// PitchBoulder's logo may render (client relationship + public testimonial) IF a
// real asset is supplied. None exists on disk as of 2026-07-06 → this build-time
// check renders nothing today; dropping pb-logo.png in is the only future action.
const pbLogo = existsSync(join(process.cwd(), "public", "media", "work", "pitchboulder", "pb-logo.png"))
  ? `${base}/media/work/pitchboulder/pb-logo.png`
  : undefined;
// The embed his live site already uses (COPY.md §3 / DIRECTION §2.5).
const commercialVideoId = "n7k-Bwu3KIU";
/**
 * LAYOUT-OVERHAUL P3 (2026-08-01, see LAYOUT-RESEQUENCE-PLAN.md +
 * scripts/make-pitchboulder-variety.mjs): the operator flagged the repeated
 * "top-down box-opening" fixed-camera frame — it was BOTH this page's hook
 * and /venture's chapter-card poster. Retired everywhere:
 *  - /venture's hook-poster.avif was re-extracted in place from loop.mp4
 *    (frame n=120) so that card fronts a real frame of the loop it plays.
 * That pass also introduced `hook-podium` (2026-05-06) as the hook and
 * `context-room` (2026-01-28) as the Context still. BOTH ARE NOW RETIRED and
 * their files deleted — see the HERO v3 note below for why. Old bakes stay
 * existence-gated as fallbacks so a missing file never breaks the page.
 *
 * ⚠ OPERATOR READ-APPROVAL REQUIRED — the context caption, Ask-thumb caption,
 * Work pull quote, hook credit, and Wednesday-Room copy are new visible copy;
 * staging-only until read.
 *
 * LINKEDIN-VERIFIED (READ-ONLY mining 2026-08-01, dossier at
 * C:\builds\asm\LINKEDIN-POSTS.md): the 2026-04-29 ask-thumb founder is NOT
 * named in any recap on file, so that caption stays date-only — no name is
 * invented. Same rule for the 2026-01-28 hero: no recap names that session's
 * founders, so the credit states the room and the date only.
 */
const pbMedia = (file: string) =>
  existsSync(join(process.cwd(), "public", "media", "work", "pitchboulder", file))
    ? `${base}/media/work/pitchboulder/${file}`
    : undefined;
/**
 * HERO v3 (2026-08-01) — the operator rejected v2: "the one time we did it at
 * the Boulder Chamber ... too much boulder chamber image plus you're choosing a
 * close up shot of a presenter. The hero shot should be 1 of the shots that's
 * capturing the whole room with a lot of people in it."
 *
 * v3 is DSC08301 (2026-01-28, Galvanize): ~30 people, all faces, the room reads
 * full, and the only brand in frame is PitchBoulder's. Chosen over the wider
 * 2026-06-17 candidate because that frame's slides put NOBILITY SPACE at 2.4x
 * the size of the PitchBoulder mark — which would have repeated the exact
 * failure being fixed. See scripts/make-pitchboulder-hero.mjs.
 *
 * Because the new hero is the 2026-01-28 room, two images that were the SAME
 * moment had to move or the page would run one photograph three times:
 *   - the Wednesday-Room bleed  room-wide  → (now room-about, see v3 below)
 *   - the Context still         context-room → context-followus (2026-05-20)
 * The page now spans four sessions instead of leaning on one.
 */
const hookPoster = pbMedia("hook-room-1600.avif") ?? `${base}/media/work/pitchboulder/hook-poster.avif`;
const contextImage = pbMedia("context-followus-1600.webp") ?? `${base}/media/work/pitchboulder/context.avif`;
const contextAlt =
  "The PitchBoulder room from the back — attendees at long tables, the host on the mic, and the session's “Follow Us!” slide with its QR codes on both projector screens.";
const contextCaption = "The room, and the slide that closes every session — May 20, 2026.";
const askThumbSrc = pbMedia("ask-thumb-900.webp");
const askThumb = askThumbSrc
  ? {
      src: askThumbSrc,
      alt: "A founder in a blazer taking the floor beside a projected slide at a PitchBoulder session.",
      caption: "A founder takes the floor — April 29, 2026.",
    }
  : undefined;
const workPull = "Watching the gap between what a founder says and what the room actually hears.";
// BTS: no PitchBoulder BTS footage exists → section hidden (DIRECTION §2.5/§2.7).

// Build #4 (2026-08-01 archive-mining integration) — "The Wednesday Room"
// chapter, appended below the case-study template (not inside it — keeps
// CaseStudy.astro's shared shape untouched for the Shelby page too).
// COLLISION-MAP BLOCK: 2 of the plan's original 5 kept images collide with
// stills already live on THIS page (founder-duo-fullroom / full-room-bleed —
// same fixed-camera session as coworking-presenter-1600 / coworking-crowd-
// 1600 above). Ships with the 4 clean images instead — see
// scripts/make-pitchboulder-wednesday-room.mjs header for the full swap
// rationale. No pull-quote here: TESTIMONIALS["pitchboulder"] already
// renders once in CaseStudy's own "05 · Words" chapter above — repeating it
// would render the same quote twice on one page.
const wrDir = join(process.cwd(), "public", "media", "work", "pitchboulder", "wednesday-room");
function wrShot(slug: string) {
  if (!existsSync(join(wrDir, `${slug}-900.avif`))) return undefined;
  const url = (w: number, ext: string) => `${base}/media/work/pitchboulder/wednesday-room/${slug}-${w}.${ext}`;
  return {
    avif: `${url(900, "avif")} 900w, ${url(1600, "avif")} 1600w`,
    webp: `${url(900, "webp")} 900w, ${url(1600, "webp")} 1600w`,
    src: url(900, "webp"),
  };
}
/**
 * v3 (2026-08-01) — three operator rejections answered. See
 * scripts/make-pitchboulder-wednesday-room-v3.mjs for the reasoning:
 *   - the band is now `room-about` (square-on from the BACK of the room, a
 *     genuinely different vantage from the hero, "About PitchBoulder" legible
 *     on both screens) — the April 29 frame it replaces read "too similar to
 *     the hero";
 *   - `after-the-pitch` is re-baked from DSC08315 (one clear subject, sharp,
 *     eyes open) instead of the squinting frame;
 *   - the closing image is DROPPED rather than replaced — every candidate in
 *     the archive repeated the same two men, and the chapter closes better on
 *     the season list than on a filler frame;
 *   - `origami-title` replaces `leyden-space-title` so Ashle Jantzen appears
 *     once, not twice.
 * Net: every person on this page now appears exactly once.
 */
const wrHero = wrShot("leyden-space-hero");
const wrOrigamiTitle = wrShot("origami-title");
const wrPerlionTitle = wrShot("perlion-title");
const wrFollowUs = wrShot("followus-handoff");
// v2 (2026-08-01) — three frames lifted from the 2026-01-28 session's RAW
// archive, which had 98 .ARW files and only 5 ever exported. See
// scripts/make-pitchboulder-wednesday-room-v2.mjs for the extraction method
// and the selection notes.
// v3: the bleed moved off `room-wide` (2026-01-28) because that moment is now
// the page hero. v3 replaced it again with `room-about` (a different vantage).
const wrRoomWide = wrShot("room-about");
const wrAfter = wrShot("after-the-pitch");

const WEDNESDAY_ROOM = {
  kicker: "The Wednesday Room",
  heading: "What two years of showing up looks like.",
  paragraphs: [
    `Most weeks, it starts the same way: a projector screen at the front of a Boulder Chamber meeting room, a "Follow Us!" slide with four QR codes, and someone standing at the podium while the last few chairs fill in. Then the slide changes, and for the next hour a rotation of founders gets a few minutes each to make their case to whoever showed up that Wednesday.`,
    "On disk, that adds up to dated session folders for nearly every Wednesday from the first week of January through late July 2026, and — further back — three more from the first week of September 2024. Two years of the same room, recorded practically every time it met.",
    `Most weeks the room hears from someone new. Not always — one May session carried a slide titled, plainly, "Alumni Update": a founder named Ashle Jantzen, back to report on Leyden Space, a company she'd apparently already introduced to this room once before.`,
  ],
  // v2 additions. ⚠ OPERATOR READ-APPROVAL REQUIRED — new copy, staging-only.
  afterPitch:
    "The pitch is the part people photograph. The part that actually does the work happens after it: the presenter comes down off the screen and the room re-forms around them in twos and threes, and the questions that were too specific to ask in front of forty people get asked.",
  ledgerIntro:
    "Who actually took the front of the room in 2026. Where there's a write-up, it's linked — those live on LinkedIn, not here.",
};

/**
 * THE 2026 SEASON — v2 (2026-08-02), rebuilt against Meetup as ground truth.
 *
 * The operator flagged two problems with the v1 ledger: (a) most sessions
 * carried no LinkedIn link even though he'd covered "just about all these",
 * and (b) some company names looked wrong — he suspected the source was his
 * own inconsistent folder naming. Both were right.
 *
 * COMPANY NAMES + DATES now come from PitchBoulder's own Meetup event history
 * (meetup.com/pitchboulder/events/past/ — the org's authoritative record),
 * not from the 2026 Recordings folder names, which turned out to have real
 * errors: "PJ Pickup Play" was the recording labeled with presenter PJ
 * Bullock's initials folded into the company name (it's just "Pickup Play");
 * "Hummingbird AI" was a mishearing/mistyping of the actual company, "Humming
 * Agent AI". Meetup also revealed TWO SESSIONS MISSING ENTIRELY from the old
 * ledger (Jan 7 — TS MEDICAL LLC, Feb 11 — Antelope Recovery) and confirmed a
 * date error: Jun 24 was Arkana Therapeutics (the last session at Galvanize
 * before the room moved to the Library), NOT Jul 1, which was actually a
 * different company, Lucent — the old ledger had mapped one LinkedIn post to
 * the wrong Wednesday.
 *
 * LINKS were re-harvested by scrolling his own LinkedIn profile (shares feed)
 * end to end, READ-ONLY, rather than relying on LinkedIn's own content search
 * — which does not reliably index a user's own historical posts (confirmed:
 * it returned zero results for "PickleMatch" and "eating quarters", both
 * verbatim phrases from posts that demonstrably exist on his profile). Each
 * post's date is decoded from its activity URN, not estimated from "2mo ago"
 * labels. `href` links the sessions he actually wrote up; those write-ups
 * live on LinkedIn and are deliberately not rehosted here. Sessions with no
 * write-up found carry no link — see the per-row notes below for which ones
 * were confirmed absent vs. simply not yet located.
 */
const LI = "https://www.linkedin.com/feed/update/urn:li:activity:";
const LEDGER = [
  // No write-up found for this one — a season-opener gap, not a search miss.
  { d: "Jan 7", co: "TS Medical" },
  { d: "Jan 14", co: "Career Ops", href: `${LI}7417649901003567104/` },
  { d: "Jan 21", co: "Pickup Play", href: `${LI}7421599560583790592/` },
  { d: "Jan 28", co: "Humming Agent AI", href: `${LI}7424134565239087104/` },
  { d: "Feb 4", co: "Sagittarius Logistics", href: `${LI}7426671239802343424/` },
  // Only mentioned as "scouting next Wednesday" inside the Feb 4 post above —
  // no dedicated write-up of its own, so it stays unlinked rather than
  // pointing at a post that isn't really about it.
  { d: "Feb 11", co: "Antelope Recovery" },
  { d: "Feb 18", co: "Origami Motion", href: `${LI}7431744706184720384/` },
  { d: "Feb 25", co: "NeuroGeneces", href: `${LI}7434666417595142144/` },
  { d: "Mar 4", co: "Actuate", href: `${LI}7436803006056185856/` },
  { d: "Mar 11", co: "Aika", href: `${LI}7439339729952604161/` },
  { d: "Mar 18", co: "OncoPatch", href: `${LI}7441876452704268288/` },
  { d: "Mar 25", co: "PickleMatch", href: `${LI}7444413168413663232/` },
  // Post confirmed to exist (a coin-payment device pitch, "the most
  // overlooked revenue in America... quietly eating quarters") but its
  // permalink wasn't recovered this pass — LinkedIn unmounts far-scrolled
  // posts from the DOM and its own search doesn't index post text.
  { d: "Apr 1", co: "PixelPay" },
  { d: "Apr 8", co: "Retrocycle", href: `${LI}7449486603942789120/` },
  { d: "Apr 15", co: "Amplified Space", href: `${LI}7452023347694997504/` },
  { d: "Apr 22", co: "Pristino Labs", href: `${LI}7454560105531875329/` },
  { d: "Apr 29", co: "Perlion", href: `${LI}7457096795706478592/` },
  { d: "May 6", co: "PEMPal", href: `${LI}7459980841486569472/` },
  { d: "May 13", co: "Momease Solutions", href: `${LI}7462155048475611136/` },
  { d: "May 20", co: "NoLimitRobotics", href: `${LI}7464691825614741505/` },
  { d: "May 27", co: "DoorBotics", href: `${LI}7467228523712126976/` },
  { d: "Jun 3", co: "Angld.AI", href: `${LI}7469765230886125569/` },
  { d: "Jun 10", co: "Veery", href: `${LI}7472301932305334272/` },
  { d: "Jun 17", co: "Nobility Space", href: `${LI}7474838710073851904/` },
  // v1 had this blank and misattributed the Jul 1 slot below to Arkana.
  // Meetup confirms Jun 24 (Arkana) was the LAST session at Galvanize; the
  // room moved to the Boulder Public Library starting Jul 1 — matching his
  // own post's line about "the final PitchBoulder at Galvanize."
  { d: "Jun 24", co: "Arkana Therapeutics", href: `${LI}7477399943255699456/` },
  // No write-up found — this is the company v1 wrongly had under Jun 24.
  { d: "Jul 1", co: "Lucent" },
  { d: "Jul 8", co: "GIFD", href: `${LI}7482844808185683968/` },
  { d: "Jul 22", co: "AquaPuck", href: `${LI}7487934806463369216/` },
] as const;
---

<Base title={study.meta.title} description={study.meta.description}>
  <CaseStudy
    study={study}
    base={base}
    commercialVideoId={commercialVideoId}
    commercialPoster={pbMedia("film-poster-1600.avif")}
    hookPoster={hookPoster}
    hookLogo={pbLogo}
    hookLogoAlt="PitchBoulder"
    contextImage={contextImage}
    contextAlt={contextAlt}
    contextCaption={contextCaption}
    askThumb={askThumb}
    workPull={workPull}
    hookCredit="The Wednesday room at Galvanize — January 28, 2026"
  />

  <section class="wr" aria-label="The Wednesday Room">
    <div class="wr-inner">
      <p class="hud-label wr-kicker">{WEDNESDAY_ROOM.kicker}</p>
      <h2 class="wr-heading">{WEDNESDAY_ROOM.heading}</h2>

      {
        wrHero && (
          <figure class="wr-hero wr-wide">
            <picture>
              <source type="image/avif" srcset={wrHero.avif} sizes="(max-width: 760px) 100vw, 46rem" />
              <source type="image/webp" srcset={wrHero.webp} sizes="(max-width: 760px) 100vw, 46rem" />
              <img src={wrHero.src} alt="Ashle Jantzen, founder of Leyden Space, mid-gesture at a Boulder Chamber podium, both arms spread wide, a slide reading 'New Electromagnetic Propulsion' projected behind her." loading="lazy" decoding="async" />
            </picture>
            <figcaption class="wr-cap">Ashle Jantzen, back for a PitchBoulder alumni update on Leyden Space.</figcaption>
          </figure>
        )
      }

      <p class="wr-para">{WEDNESDAY_ROOM.paragraphs[0]}</p>
      <p class="wr-para">{WEDNESDAY_ROOM.paragraphs[1]}</p>

      {
        wrFollowUs && (
          <figure class="wr-mid">
            <picture>
              <source type="image/avif" srcset={wrFollowUs.avif} sizes="(max-width: 760px) 100vw, 26rem" />
              <source type="image/webp" srcset={wrFollowUs.webp} sizes="(max-width: 760px) 100vw, 26rem" />
              <img src={wrFollowUs.src} alt="Two men stand together in front of the 'Follow Us!' QR slide, one gesturing toward the room, the other laughing." loading="lazy" decoding="async" />
            </picture>
            <figcaption class="wr-cap">End of session — the room's own recurring closing ritual.</figcaption>
          </figure>
        )
      }

      <p class="wr-para">{WEDNESDAY_ROOM.paragraphs[2]}</p>

      {
        (wrOrigamiTitle || wrPerlionTitle) && (
          <div class="wr-duo wr-wide">
            {wrOrigamiTitle && (
              <figure class="wr-duo-fig">
                <picture>
                  <source type="image/avif" srcset={wrOrigamiTitle.avif} sizes="(max-width: 760px) 48vw, 20rem" />
                  <source type="image/webp" srcset={wrOrigamiTitle.webp} sizes="(max-width: 760px) 48vw, 20rem" />
                  <img src={wrOrigamiTitle.src} alt="A founder in red presents beside a projected title slide reading 'origami — The First Smart Cabinet to Autonomously Fold Laundry,' with a rendering of the cabinet beside the text." loading="lazy" decoding="async" />
                </picture>
                <figcaption class="wr-cap">“The first smart cabinet to autonomously fold laundry” — February 18.</figcaption>
              </figure>
            )}
            {wrPerlionTitle && (
              <figure class="wr-duo-fig">
                <picture>
                  <source type="image/avif" srcset={wrPerlionTitle.avif} sizes="(max-width: 760px) 48vw, 20rem" />
                  <source type="image/webp" srcset={wrPerlionTitle.webp} sizes="(max-width: 760px) 48vw, 20rem" />
                  <img src={wrPerlionTitle.src} alt="A projected title slide reading 'Perlion — Sunscreen Active Ingredients — Logan Chang, CEO,' with Chang standing beside a whiteboard to the right of the screen." loading="lazy" decoding="async" />
                </picture>
                <figcaption class="wr-cap">Logan Chang, CEO of Perlion — ten weeks later, same podium.</figcaption>
              </figure>
            )}
          </div>
        )
      }
    </div>

    {/* v2 — THE ROOM AT SCALE: a full-bleed band breaking the 46rem column.
        The page's only edge-to-edge beat, and the first frame anywhere on the
        site that shows how many people are actually in this room. */}
    {
      wrRoomWide && (
        <figure class="wr-bleed">
          <picture>
            <source type="image/avif" srcset={wrRoomWide.avif} sizes="100vw" />
            <source type="image/webp" srcset={wrRoomWide.webp} sizes="100vw" />
            <img
              src={wrRoomWide.src}
              alt="The PitchBoulder room from the back, looking square-on at the front wall — roughly eighteen attendees seated either side of a centre aisle, the host standing between two projector screens that both read “About PitchBoulder”."
              loading="lazy"
              decoding="async"
            />
          </picture>
          <figcaption class="wr-bleed-cap wr-cap">Every session opens the same way: what this room is, and how it works — April 29, 2026.</figcaption>
        </figure>
      )
    }

    <div class="wr-inner">
      {/* v2 — the human beat: text left, close portrait right, deliberately
          the smallest-scale image on the page after the widest one. */}
      <div class="wr-aside wr-wide">
        <p class="wr-para">{WEDNESDAY_ROOM.afterPitch}</p>
        {wrAfter && (
          <figure class="wr-aside-fig">
            <picture>
              <source type="image/avif" srcset={wrAfter.avif} sizes="(max-width: 760px) 70vw, 17rem" />
              <source type="image/webp" srcset={wrAfter.webp} sizes="(max-width: 760px) 70vw, 17rem" />
              <img src={wrAfter.src} alt="A founder mid-sentence, answering one person one-to-one after his pitch, the listener's hair filling the foreground and a plain grey wall behind." loading="lazy" decoding="async" />
            </picture>
            <figcaption class="wr-cap">One question, one answer, after the room has broken up.</figcaption>
          </figure>
        )}
      </div>

      {/* v3: the closing photograph was REMOVED, not replaced — see the note at
          the top of this file. The chapter now closes on the season list. */}

      {/* THE SEASON — the scale claim, itemised, linking out to the write-ups. */}
      <p class="wr-para">{WEDNESDAY_ROOM.ledgerIntro}</p>
      <div class="wr-ledger" aria-label="PitchBoulder 2026 season — who presented">
        <p class="hud-label wr-ledger-head">The 2026 season</p>
        <ol class="wr-ledger-list">
          {LEDGER.map((s) => (
            <li class={s.co === "—" ? "wr-ledger-row wr-ledger-row--blank" : "wr-ledger-row"}>
              <span class="wr-ledger-date">{s.d}</span>
              {"href" in s && s.href ? (
                <a class="wr-ledger-co wr-ledger-link" href={s.href} target="_blank" rel="noopener">
                  {s.co} <span class="wr-ledger-out" aria-hidden="true">↗</span>
                </a>
              ) : (
                <span class="wr-ledger-co">{s.co}</span>
              )}
            </li>
          ))}
        </ol>
        <p class="wr-ledger-note">
          Twenty-four of these have a write-up. They're on LinkedIn, where the room already is —
          arrows open them there.
        </p>
      </div>

      <p class="wr-para wr-close">
        None of this is dramatic. It's a weekly meeting, in one room, mostly the same shape every time, that's been going on long enough to have its own alumni.
      </p>
    </div>
  </section>

  {/* Structural-only outbound link — see the second CTA already carried by
      /venture/dawn-patrol's own sign-off pattern, applied here. */}
  <section class="mx-auto max-w-3xl px-8 pb-10 text-center">
    <a href={`${base}/venture`} class="link">← Venture Stories</a>
  </section>
</Base>

<style>
  /* CRITIC FIX (CRITIC-REPORT.md, non-blocking finding): the new hook frame
     has a bright white slide area behind the title block — deepen the text
     shadow on this page's hook h1 + credit so they hold contrast. Scoped
     :global so it touches only THIS page's case hook (Shelby unaffected). */
  :global(.case .hero-video__content h1) {
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.85), 0 1px 4px rgba(0, 0, 0, 0.7);
  }
  :global(.case .case-hook-credit) {
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9), 0 1px 3px rgba(0, 0, 0, 0.8);
    color: #fff;
  }

  .wr {
    background: color-mix(in srgb, var(--color-elevated) 55%, var(--color-base));
    border-top: 1px solid var(--color-hairline);
    padding: 4rem 1.5rem 3rem;
  }
  .wr-inner {
    max-width: 46rem;
    margin-inline: auto;
    display: grid;
    gap: 1.3rem;
  }
  .wr-kicker {
    letter-spacing: 0.24em;
    color: color-mix(in srgb, var(--color-accent) 82%, transparent);
  }
  .wr-heading {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 560;
    font-size: clamp(1.7rem, 3.6vw, 2.4rem);
    line-height: 1.15;
    color: var(--color-peak);
    margin: 0 0 0.3rem;
  }
  .wr-para {
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-ink) 92%, transparent);
  }
  .wr-close { font-style: italic; }
  .wr-hero, .wr-mid {
    margin: 0.3rem 0;
  }
  .wr-hero img, .wr-mid img {
    display: block;
    width: 100%;
    border-radius: 8px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  /* 2026-08-01 — breaking the single measure. Measured against
     /adventure/steel-and-dust, this chapter had ONE block left-edge (x=272)
     and TWO block widths, where the anchor page has three of each. That is the
     mechanism behind "it's just a bunch of squares and boxes … the text
     uniformly fits to the photo": text and media were literally the same box.
     The anchor solves it by running two measures at once — a 704px text column
     with media overhanging it by 128px per side. `.wr-wide` is that overhang;
     the 46rem/~78ch reading measure is correct and does NOT change. */
  .wr-wide {
    --over: 12rem;
    width: calc(100% + var(--over));
    margin-inline: calc(var(--over) / -2);
    max-width: 100vw;
  }
  @media (max-width: 900px) {
    .wr-wide { --over: 0rem; }
  }
  /* right-aligned so it opens a THIRD left edge instead of stacking on the
     same one as everything else */
  .wr-mid {
    max-width: 26rem;
    justify-self: end;
  }
  .wr-cap {
    margin-top: 0.5rem;
