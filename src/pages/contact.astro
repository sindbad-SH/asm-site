---
/**
 * /contact — PUB-B (2026-07-27): rebuilt as PUBLICATION CONTACT per
 * ACTION-PLAN.md's publication restructure (Directive PUB-B). This is a
 * copy+framing surgery over the prior P10/P29 lead-gen page, not a redesign —
 * the split-screen grammar (Disal Consulting reference: cobalt question panel
 * / stone action panel with the continuous contour line) is KEPT.
 *
 * WHAT CHANGED: the page no longer sells a booking call as its primary
 * action. The inert lead form (gated on SITE.formEndpoint, which has never
 * resolved — see the RESERVED comment on SITE.formEndpoint in consts.ts) is
 * RETIRED: it never worked, and a publication contact page doesn't need one.
 * In its place: three honest reasons to write in, ONE real email as the
 * primary action. REPOSITION (2026-08-27, operator-directed): the "work with
 * the founder" category and the booking link are GONE — the publication
 * advertises no services and has no scheduling surface. The third category
 * is a catch-all that keeps the door ajar without offering anything.
 *
 * NEW: a #follow section stub at the bottom (heading only) — PUB-C mounts
 * the newsletter capture UI there; this page only reserves the anchor +
 * heading so that build doesn't block on it.
 *
 * UNCHANGED CONTRACTS: the location decode eyebrow, the contour-line draw,
 * and the SITE.trust facts beside the email are all kept. All copy verbatim
 * from consts (⚠ operator read-approval, logged in COPY-DECK-B.md).
 */
import Base from "../layouts/Base.astro";
import FollowTheStories from "../components/FollowTheStories.astro";
import { PAGES, SITE } from "../consts";

const p = PAGES.contact;
---

<Base title={p.meta.title} description={p.meta.description}>
  <main class="ct">
    <section class="ct-split">
      <!-- ── left · the question + the reasons to write in (cobalt panel) ── -->
      <div class="ct-panel">
        <p class="hud-label ct-kicker" data-reveal data-tableau-content>
          <span data-decode>{SITE.location}</span>
        </p>
        <h1 class="ct-headline" data-reveal>{p.headline}</h1>
        <p class="ct-body" data-reveal>{p.body}</p>

        <ul class="ct-categories" data-reveal>
          {
            p.categories.map((cat) => (
              <li class="ct-category">
                <p class="ct-category-label">{cat.label}</p>
                <p class="ct-category-body">{cat.body}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- ── right · the primary action: one email (stone panel) ── -->
      <div class="ct-canvas">
        <svg class="ct-lines" viewBox="0 0 900 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true" fill="none">
          <path
            data-ct-line
            d="M-40,620 L90,540 L200,590 L330,500 L450,560 L580,470 L700,540 L820,490 L940,550"
            stroke="var(--color-accent, #38f8ec)"
            stroke-opacity="0.35"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
        <div class="ct-action" data-reveal>
          <a href={`mailto:${p.email}`} class="ct-pill ct-pill--mail">{p.email}</a>
          <ul class="ct-trust">
            <!-- REPOSITION (2026-08-27): facts only — the two service-promise
                 lines are gone with their SITE.trust fields; the credential
                 and the home base stay as facts about how the work is made. -->
            <li>{SITE.trust.drone}</li>
            <li>{SITE.trust.base}</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ── follow the stories — stub only; PUB-C mounts newsletter capture ── -->
    <section id="follow" class="ct-follow">
      <h2 class="ct-follow-heading">{p.followHeading}</h2>
      {/* REPOSITION (2026-08-27): the sitewide PRIMARY_CTA anchors here — it
          used to land on this bare heading. The capture block is live
          (Substack-wired) and finally mounts at its own anchor. */}
      <FollowTheStories />
    </section>
  </main>
</Base>

<style>
  .ct {
    --ct-cobalt: #14406b; /* shared with the P9 forge dialect */
    --ct-stone: #191a17;
  }
  .ct-split {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    min-height: 88svh;
  }
  .ct-panel {
    background: var(--ct-cobalt);
    padding: clamp(2.5rem, 6vw, 6rem);
    display: grid;
    align-content: center;
    gap: 1.2rem;
  }
  .ct-kicker {
    letter-spacing: 0.28em;
    color: color-mix(in srgb, #e8f3f6 75%, transparent);
  }
  .ct-headline {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: clamp(2.2rem, 4.2vw, 3.8rem);
    line-height: 1.08;
    color: #f4f7fa;
    max-width: 16ch;
  }
  .ct-body {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.55;
    color: color-mix(in srgb, #f4f7fa 86%, transparent);
    max-width: 46ch;
  }

  /* the three reasons to write in */
  .ct-categories {
    margin-top: 1.6rem;
    display: grid;
    gap: 1.1rem;
    list-style: none;
    padding: 0;
    max-width: 34rem;
  }
  .ct-category {
    border-left: 2px solid color-mix(in srgb, var(--color-accent, #38f8ec) 55%, transparent);
    padding-left: 1rem;
  }
  .ct-category-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, #e8f3f6 70%, transparent);
    margin-bottom: 0.3rem;
  }
  .ct-category-body {
    font-family: var(--font-sans);
    font-size: 0.98rem;
    line-height: 1.5;
    color: color-mix(in srgb, #f4f7fa 88%, transparent);
  }

  .ct-pill {
    display: inline-block;
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #071018;
    background: var(--color-accent, #38f8ec);
    border-radius: 999px;
    padding: 0.85rem 1.7rem;
    transition:
      transform 240ms var(--ease-swift, ease-out),
      opacity 240ms var(--ease-swift, ease-out);
  }
  .ct-pill:hover {
    transform: translateY(-2px);
  }
  .ct-pill--mail {
    font-size: 0.92rem;
    padding: 1rem 1.9rem;
    /* AUDIT-FIX (2026-08-03): this is the page's primary action and its
       label is a real email address, not a short button phrase — the base
       .ct-pill's uppercase (fine for "BOOK A CALL"-style labels) turned it
       into "SINDBAD@ADVENTURESTORYTELLINGMEDIA.COM", which reads worse and
       is less recognizable than the address's real case. Every other email
       on the site (footer, privacy, terms, licensing) already renders
       lower-case; this is the one place it didn't. */
    text-transform: none;
  }

  /* the action canvas — stone, contour line, one big move */
  .ct-canvas {
    position: relative;
    background: var(--ct-stone);
    display: grid;
    place-content: center;
    overflow: clip;
  }
  .ct-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .ct-action {
    position: relative;
    display: grid;
    gap: 1.1rem;
    justify-items: center;
    text-align: center;
    padding: 3rem 2rem;
  }
  /* P29 — logistics list under the booking CTA */
  .ct-trust {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, #eef4f7 60%, transparent);
  }
  /* ── follow the stories — quiet stub, PUB-C mounts the real UI ── */
  .ct-follow {
    padding: 3.5rem clamp(1.5rem, 6vw, 6rem);
    text-align: center;
    background: var(--ct-stone);
  }
  .ct-follow-heading {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 520;
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    color: color-mix(in srgb, #f4f7fa 90%, transparent);
  }

  @media (max-width: 860px) {
    .ct-split {
      /* minmax(0,1fr), not 1fr — a bare 1fr track has min-width:auto, so the
         unbreakable email pill set the column's min-content width (~557px)
         and the whole page scrolled sideways on phones. Measured at 375px:
         182px of horizontal overflow. (2026-08-13 mobile audit) */
      grid-template-columns: minmax(0, 1fr);
    }
    .ct-canvas {
      min-height: 40svh;
    }
  }
  /* the email address is one unbreakable token — allow it to wrap inside its
     pill instead of defining the pill's minimum width (2026-08-13). */
  .ct-pill--mail {
    overflow-wrap: anywhere;
  }
</style>

<script>
  // P10 enhancement: decode eyebrow (idle mount, self-gating) + the contour
  // line drawing itself on arrival (fully drawn without JS / reduced motion).
  import { gsap } from "gsap";

  const mountDecodeLabels = () => import("../lib/decode-text").then(({ mountDecode }) => mountDecode(document));
  if ("requestIdleCallback" in window) requestIdleCallback(mountDecodeLabels, { timeout: 3000 });
  else setTimeout(mountDecodeLabels, 1500);

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<SVGPathElement>("[data-ct-line]").forEach((path) => {
      const L = path.getTotalLength();
      path.style.strokeDasharray = String(L);
      gsap.fromTo(
        path,
        { strokeDashoffset: L },
        {
          strokeDashoffset: 0,
          duration: 2.4,
          delay: 0.5,
          ease: "power2.inOut",
          onComplete: () => {
            gsap.to(path, { y: 5, duration: 7, ease: "sine.inOut", yoyo: true, repeat: -1 });
          },
        },
      );
    });
  }
</script>
