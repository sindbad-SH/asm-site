---
/**
 * Venture story · SeriesFest 2025 (Season 11) — Denver, Apr 30 – May 4, 2025.
 *
 * ARCHIVE-REWORK 2026-08-03. Two problems with the previous build, both fixed
 * here:
 *
 * 1. NEAR-DUPLICATES. It ran ten Tier-1 frames that came from only three
 *    moments. Its "Awards Ceremony, two angles" diptych was two frames of the
 *    same titlecard from almost the same spot — they read as one photo printed
 *    twice. Its two screening captions were also SWAPPED: `screening-card`
 *    (20250430_201225) is the Season 11 wordmark, and `screening-title`
 *    (20250430_172103) is the International Spotlight slate; the page labelled
 *    them the other way round.
 *
 * 2. NO STORY. The operator never wrote a 2025 dispatch — his only published
 *    2025-festival sentence is "I had a blast at the full festival last year"
 *    (from his Feb 2026 Soul Power post), so the page could only say generic
 *    things. OPERATOR DECISION 2026-08-03: rebuild it CAPTION-LED. The full
 *    pool is 369 photos, and Tier 2 holds the actual programme — session after
 *    session with its own title card projected behind the panel, legible in
 *    frame. Those thirteen frames are baked by
 *    scripts/make-seriesfest-2025-programme.mjs and carry the page now.
 *
 * HONESTY: every caption fact below is read off the screen in his own
 * photograph — "AT LIBERTY hosted by W. Kamau Bell · ACLU", "PITCH-A-THON!"
 * with its Canva / Working Artist Group / RBC sponsor lockup, "GIMME SHELTER
 * (The Series) · Chantal Woodyard · Peter Trinh", "ZHIZHA created by Desdemona
 * Chiang", "The Four Seasons · Netflix · Universal Studio Group", "MARCO
 * CALVANI — Breakthrough Actor Award", "IMPACT IN TELEVISION WITH CARNIVAL
 * FILMS", "HONORING RHEA SEEHORN with the Excellence in Acting Award",
 * "LEADING THE NARRATIVE: INSIDE THE WORLD OF SHOWRUNNERS", "CLIPS AND
 * CONVERSATION WITH ST. DENIS MEDICAL". Nothing is inferred; no session is
 * described beyond its title and what is visible. The BODY COPY stays at its
 * previous honest length (attendance + his own published cross-year SeriesFest
 * voice) rather than inventing a 2025 recap he never wrote. The only status
 * claim is the SeriesFest LegendMark (tier `attended`) — verbatim from consts,
 * never upgraded. Attendance ≠ affiliation.
 *
 * CROSS-YEAR NOTE worth keeping: The Four Seasons panel and Marco Calvani's
 * Breakthrough Actor Award are 2025 (Season 11). His own Season 12 opening-
 * night post (May 2026) covers the show's Season 2 first-look with Calvani on
 * the panel — "the show returns a year after Season 1 made its mark at
 * SeriesFest." The two pages now actually connect.
 *
 * Bakes retired this pass (no-silent-caps rule): screening-card, panel-stage,
 * panel-seated, podium-speaker, podium-lectern, step-and-repeat — all
 * near-duplicates of a kept frame. Left on disk, simply not referenced.
 */
import Base from "../../layouts/Base.astro";
import LegendMark from "../../components/LegendMark.astro";
import { PAGES } from "../../consts";
import { existsSync } from "node:fs";
import { join } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const STORY = "seriesfest-2025";
const mediaDir = join(process.cwd(), "public", "media", "venture", STORY);

async function shot(slug: string, alt: string) {
  const webp900 = join(mediaDir, `${slug}-900.webp`);
  if (!existsSync(webp900)) return undefined;
  const url = (w: number, ext: string) => `${base}/media/venture/${STORY}/${slug}-${w}.${ext}`;
  return {
    alt,
    avif: `${url(900, "avif")} 900w, ${url(1600, "avif")} 1600w`,
    webp: `${url(900, "webp")} 900w, ${url(1600, "webp")} 1600w`,
    fallback: url(900, "webp"),
  };
}

// ── Opening day, Apr 30 ────────────────────────────────────────────────────
const atLiberty = await shot("panel-at-liberty", "Four people seated on the SeriesFest stage below a pink screen reading “At Liberty, hosted by W. Kamau Bell, ACLU.”");
const spotlightSlate = await shot("screening-title", "The International Spotlight slate on the big screen — a grid of six series stills — with two empty chairs staged for the post-screening conversation.");
const sunnyNights = await shot("panel-sunny-nights", "Five panelists seated across the SeriesFest stage under a screen reading “Sunny Nights.”");

// ── May 1 — the programme ──────────────────────────────────────────────────
const pitchAThon = await shot("pitch-a-thon", "A host at the SeriesFest podium under a screen reading “Pitch-A-Thon!” with the Canva, Working Artist Group and RBC sponsor lockup.");
const gimmeShelter = await shot("screening-gimme-shelter", "Two people at the podium beside a panel row, the screen behind them showing the Gimme Shelter (The Series) logo with the names Chantal Woodyard and Peter Trinh.");
const zhizha = await shot("screening-zhizha", "A creator speaking from the stage in front of a still from Zhizha, the screen crediting Desdemona Chiang.");
const fourSeasons = await shot("panel-four-seasons", "Three panelists seated on the SeriesFest stage under a screen reading “The Four Seasons,” with the Netflix and Universal Studio Group marks.");
const calvaniCard = await shot("award-marco-calvani", "The SeriesFest screen reading “Marco Calvani — Breakthrough Actor Award,” a panel seated below it.");
const calvaniHandoff = await shot("panel-mics", "Four people on stage handing over an award, the SeriesFest.com wordmark projected behind them.");

// ── May 2 — panels and the Soirée ──────────────────────────────────────────
const carnivalFilms = await shot("panel-carnival-films", "A row of panelists on stage beneath a screen reading “Impact in Television with Carnival Films,” with the Deadline and Universal Studio Group marks.");
const soireeQuartet = await shot("soiree-quartet", "A string quartet in formal gowns performing on the Soirée stage, the sponsor wall projected behind them.");
const soireeAddress = await shot("hero", "Governor Jared Polis addressing the room at the SeriesFest Soirée, a ceramic peacock installation beside the stage.");
const seehornAward = await shot("award-rhea-seehorn", "Three people at the Soirée podium under a screen reading “Honoring Rhea Seehorn with the Excellence in Acting Award.”");

// ── May 3–4 — the last days ────────────────────────────────────────────────
const showrunners = await shot("panel-showrunners", "Six panelists seated on the SeriesFest stage beneath a screen reading “Leading the Narrative: Inside the World of Showrunners.”");
const stDenis = await shot("panel-st-denis", "A panel on the SeriesFest stage under a screen reading “Clips and Conversation with St. Denis Medical.”");
const awardsCeremony = await shot("podium-address", "A host at the podium during the Season 11 Awards Ceremony, the ceremony titlecard filling the screen behind the stage.");

// The SeriesFest proof line — imported from consts, rendered VERBATIM.
const seriesRoom = PAGES.entertainment.rooms.items.find(
  (r) => r.proof.relationshipId === "seriesfest",
);

/*
  ⚠ OPERATOR READ-APPROVAL REQUIRED — the four movement kickers and every
  caption below are new visible copy (staging-only until read). The body
  paragraphs are UNCHANGED from the previous build (his own published
  cross-year SeriesFest voice, plus the one supportable 2025 fact: he attended
  the full festival). No 2025-specific session is described beyond its own
  on-screen title.
*/
const KICKERS = {
  m1: "Apr 30 · Opening",
  m2: "May 1 · The programme",
  m3: "May 2 · Panels, then the Soirée",
  m4: "May 3–4 · The last days",
};
const PULL = "You simply couldn't pull off this kind of intimate, high-access event in New York or LA.";
const CAPTIONS = {
  hero: "Opening day, April 30 — At Liberty, hosted by W. Kamau Bell with the ACLU.",
  spotlightSlate: "The International Spotlight slate — six series, one screening block.",
  sunnyNights: "Sunny Nights, later the same evening.",
  pitchAThon: "The Pitch-A-Thon, a year before we watched the Roadshow Showcase of the same programme.",
  gimmeShelter: "Gimme Shelter (The Series) — Chantal Woodyard and Peter Trinh introduced from the podium.",
  zhizha: "Zhizha, created by Desdemona Chiang.",
  fourSeasons: "The Four Seasons — Netflix and Universal Studio Group — a year before its Season 2 first-look opened Season 12.",
  calvaniDiptych: "The Breakthrough Actor Award to Marco Calvani: the titlecard, then the handoff.",
  carnivalFilms: "Impact in Television with Carnival Films, presented with Deadline.",
  soireeQuartet: "The Soirée opens with a string quartet, the sponsor wall behind them.",
  soireeAddress: "Governor Jared Polis at the Soirée.",
  seehornAward: "The Excellence in Acting Award to Rhea Seehorn.",
  showrunners: "Leading the Narrative: Inside the World of Showrunners.",
  stDenis: "Clips and Conversation with St. Denis Medical.",
  awardsCeremony: "The Season 11 Awards Ceremony, the last night.",
};

const meta = {
  title: "SeriesFest 2025 — a venture story",
  description:
    "SeriesFest Season 11 in Denver, Colorado, April 30 – May 4, 2025 — official-selection screenings, the Pitch-A-Thon, panels from Carnival Films to the showrunners room, the Soirée and the Awards Ceremony, from a week of relationship-building attendance.",
};
---

<Base title={meta.title} description={meta.description}>
  <main class="vs" data-lane="venture" style="--ground:#10141f">
    <section class="vs-head">
      <a href={`${base}/venture`} class="link vs-back"><span class="arrow" aria-hidden="true">←</span> Venture</a>

      <p class="hud-label vs-slate" data-reveal>SeriesFest · Apr 30 – May 4, 2025 · Denver, CO</p>

      <h1 class="vs-headline" data-reveal>
        <span class="vs-line">SERIESFEST</span>
        <span class="vs-line vs-line--push"><span class="vs-turn">Denver,</span> 2025</span>
      </h1>

      {seriesRoom && (
        <div class="vs-proof" data-reveal>
          <LegendMark proof={seriesRoom.proof} />
        </div>
      )}
    </section>

    {atLiberty && (
      <figure class="vs-hero" data-reveal>
        <picture>
          <source type="image/avif" srcset={atLiberty.avif} sizes="(max-width: 900px) 100vw, 78rem" />
          <source type="image/webp" srcset={atLiberty.webp} sizes="(max-width: 900px) 100vw, 78rem" />
          <img src={atLiberty.fallback} alt={atLiberty.alt} style="aspect-ratio:16/9;object-fit:cover;object-position:50% 42%" loading="eager" decoding="async" />
        </picture>
        <figcaption class="vs-cap">{CAPTIONS.hero}</figcaption>
      </figure>
    )}

    <!-- ══ APR 30 · OPENING ══════════════════════════════════════════════ -->
    <section class="vs-movement" data-reveal>
      <p class="hud-label vs-kicker">{KICKERS.m1}</p>
      <div class="vs-prose">
        <p>
          For a few days at the end of spring, SeriesFest turns Denver into a room
          where creators, audiences, and industry actually share the same air. In
          2025 we came for the full festival — official-selection screenings,
          on-stage Q&amp;As, and panels, back to back.
        </p>
      </div>
    </section>

    <div class="vs-duo" data-reveal>
      {spotlightSlate && (
        <figure class="vs-duo-fig">
          <picture>
            <source type="image/avif" srcset={spotlightSlate.avif} sizes="(max-width: 760px) 100vw, 30rem" />
            <source type="image/webp" srcset={spotlightSlate.webp} sizes="(max-width: 760px) 100vw, 30rem" />
            <img src={spotlightSlate.fallback} alt={spotlightSlate.alt} style="aspect-ratio:16/9;object-fit:cover;object-position:50% 45%" loading="lazy" decoding="async" />
          </picture>
          <figcaption class="vs-cap">{CAPTIONS.spotlightSlate}</figcaption>
        </figure>
      )}
      <div class="vs-prose vs-prose--inrow">
        <p>
          There's a saying about SeriesFest: you simply couldn't pull off this kind
          of intimate, high-access event in New York or LA. The energy the team
          brings to Denver is one of a kind, and it's a big part of what keeps us
          coming back.
        </p>
      </div>
    </div>

    {sunnyNights && (
      <figure class="vs-fullbeat" data-reveal>
        <picture>
          <source type="image/avif" srcset={sunnyNights.avif} sizes="(max-width: 900px) 100vw, 60rem" />
          <source type="image/webp" srcset={sunnyNights.webp} sizes="(max-width: 900px) 100vw, 60rem" />
          <img src={sunnyNights.fallback} alt={sunnyNights.alt} style="aspect-ratio:3/2;object-fit:cover;object-position:50% 55%" loading="lazy" decoding="async" />
        </picture>
        <figcaption class="vs-cap">{CAPTIONS.sunnyNights}</figcaption>
      </figure>
    )}

    <blockquote class="vs-pull" data-reveal>{PULL}</blockquote>

    <!-- ══ MAY 1 · THE PROGRAMME ═════════════════════════════════════════ -->
    <section class="vs-movement" data-reveal>
      <p class="hud-label vs-kicker">{KICKERS.m2}</p>
      <div class="vs-prose">
        <p>
          A full festival day here is a title card, a panel, and a room that turns
          over and does it again — pitches in the morning, official selections
          through the afternoon, an award before the evening block.
        </p>
      </div>
    </section>

    {(pitchAThon || gimmeShelter) && (
      <div class="vs-pair" data-reveal>
        {gimmeShelter && (
          <figure class="vs-pair-a">
            <picture>
              <source type="image/avif" srcset={gimmeShelter.avif} sizes="(max-width: 760px) 100vw, 44rem" />
              <source type="image/webp" srcset={gimmeShelter.webp} sizes="(max-width: 760px) 100vw, 44rem" />
              <img src={gimmeShelter.fallback} alt={gimmeShelter.alt} style="aspect-ratio:3/2;object-fit:cover;object-position:50% 48%" loading="lazy" decoding="async" />
            </picture>
            <figcaption class="vs-cap">{CAPTIONS.gimmeShelter}</figcaption>
          </figure>
        )}
        {pitchAThon && (
          <figure class="vs-pair-b">
            <picture>
              <source type="image/avif" srcset={pitchAThon.avif} sizes="(max-width: 760px) 100vw, 26rem" />
              <source type="image/webp" srcset={pitchAThon.webp} sizes="(max-width: 760px) 100vw, 26rem" />
              <img src={pitchAThon.fallback} alt={pitchAThon.alt} style="aspect-ratio:4/5;object-fit:cover;object-position:50% 55%" loading="lazy" decoding="async" />
            </picture>
            <figcaption class="vs-cap">{CAPTIONS.pitchAThon}</figcaption>
          </figure>
        )}
      </div>
    )}

    {zhizha && (
      <figure class="vs-widest" data-reveal>
        <picture>
          <source type="image/avif" srcset={zhizha.avif} sizes="(max-width: 900px) 100vw, 86rem" />
          <source type="image/webp" srcset={zhizha.webp} sizes="(max-width: 900px) 100vw, 86rem" />
          <img src={zhizha.fallback} alt={zhizha.alt} style="aspect-ratio:2/1;object-fit:cover;object-position:50% 52%" loading="lazy" decoding="async" />
        </picture>
        <figcaption class="vs-cap">{CAPTIONS.zhizha}</figcaption>
      </figure>
    )}

    {fourSeasons && (
      <figure class="vs-fullbeat" data-reveal>
        <picture>
          <source type="image/avif" srcset={fourSeasons.avif} sizes="(max-width: 900px) 100vw, 60rem" />
          <source type="image/webp" srcset={fourSeasons.webp} sizes="(max-width: 900px) 100vw, 60rem" />
          <img src={fourSeasons.fallback} alt={fourSeasons.alt} style="aspect-ratio:3/2;object-fit:cover;object-position:50% 62%" loading="lazy" decoding="async" />
        </picture>
        <figcaption class="vs-cap">{CAPTIONS.fourSeasons}</figcaption>
      </figure>
    )}

    {(calvaniCard || calvaniHandoff) && (
      <figure class="vs-diptych vs-diptych--wide" data-reveal>
        <div class="vs-diptych-row">
          {calvaniCard && (
            <picture>
              <source type="image/avif" srcset={calvaniCard.avif} sizes="(max-width: 760px) 50vw, 30rem" />
              <source type="image/webp" srcset={calvaniCard.webp} sizes="(max-width: 760px) 50vw, 30rem" />
              <img src={calvaniCard.fallback} alt={calvaniCard.alt} style="aspect-ratio:3/2;object-fit:cover;object-position:50% 62%" loading="lazy" decoding="async" />
            </picture>
          )}
          {calvaniHandoff && (
            <picture>
              <source type="image/avif" srcset={calvaniHandoff.avif} sizes="(max-width: 760px) 50vw, 30rem" />
              <source type="image/webp" srcset={calvaniHandoff.webp} sizes="(max-width: 760px) 50vw, 30rem" />
              <img src={calvaniHandoff.fallback} alt={calvaniHandoff.alt} style="aspect-ratio:3/2;object-fit:cover;object-position:50% 58%" loading="lazy" decoding="async" />
            </picture>
          )}
        </div>
        <figcaption class="vs-cap">{CAPTIONS.calvaniDiptych}</figcaption>
      </figure>
    )}

    <!-- ══ MAY 2 · PANELS, THEN THE SOIRÉE ═══════════════════════════════ -->
    <section class="vs-movement" data-reveal>
      <p class="hud-label vs-kicker">{KICKERS.m3}</p>
      <div class="vs-prose">
        <p>
          Co-founders Randi Kleiner and Kaily Smith, with Claire Taylor Smith and
          Patrick O'Brien, keep championing the independent creative community here
          — the reason a festival of this caliber still manages to feel this
          personal. Nowhere more than at the Soirée, the festival's signature
          evening.
        </p>
      </div>
    </section>

    {carnivalFilms && (
      <figure class="vs-fullbeat" data-reveal>
        <picture>
          <source type="image/avif" srcset={carnivalFilms.avif} sizes="(max-width: 900px) 100vw, 60rem" />
          <source type="image/webp" srcset={carnivalFilms.webp} sizes="(max-width: 900px) 100vw, 60rem" />
          <img src={carnivalFilms.fallback} alt={carnivalFilms.alt} style="aspect-ratio:3/2;object-fit:cover;object-position:50% 50%" loading="lazy" decoding="async" />
        </picture>
        <figcaption class="vs-cap">{CAPTIONS.carnivalFilms}</figcaption>
      </figure>
    )}

    <div class="vs-duo vs-duo--flip" data-reveal>
      {soireeQuartet && (
        <figure class="vs-duo-fig">
          <picture>
            <source type="image/avif" srcset={soireeQuartet.avif} sizes="(max-width: 760px) 100vw, 34rem" />
            <source type="image/webp" srcset={soireeQuartet.webp} sizes="(max-width: 760px) 100vw, 34rem" />
            <img src={soireeQuartet.fallback} alt={soireeQuartet.alt} style="aspect-ratio:4/3;object-fit:cover;object-position:50% 50%" loading="lazy" decoding="async" />
          </picture>
          <figcaption class="vs-cap">{CAPTIONS.soireeQuartet}</figcaption>
        </figure>
      )}
      {soireeAddress && (
        <figure class="vs-duo-fig">
          <picture>
            <source type="image/avif" srcset={soireeAddress.avif} sizes="(max-width: 760px) 100vw, 34rem" />
            <source type="image/webp" srcset={soireeAddress.webp} sizes="(max-width: 760px) 100vw, 34rem" />
            <img src={soireeAddress.fallback} alt={soireeAddress.alt} style="aspect-ratio:4/3;object-fit:cover;object-position:50% 45%" loading="lazy" decoding="async" />
          </picture>
          <figcaption class="vs-cap">{CAPTIONS.soireeAddress}</figcaption>
        </figure>
      )}
    </div>

    {seehornAward && (
      <figure class="vs-closer" data-reveal>
        <picture>
          <source type="image/avif" srcset={seehornAward.avif} sizes="(max-width: 760px) 100vw, 40rem" />
          <source type="image/webp" srcset={seehornAward.webp} sizes="(max-width: 760px) 100vw, 40rem" />
          <img src={seehornAward.fallback} alt={seehornAward.alt} style="aspect-ratio:4/3;object-fit:cover;object-position:50% 48%" loading="lazy" decoding="async" />
        </picture>
        <figcaption class="vs-cap">{CAPTIONS.seehornAward}</figcaption>
      </figure>
    )}

    <!-- ══ MAY 3–4 · THE LAST DAYS ═══════════════════════════════════════ -->
    <section class="vs-movement" data-reveal>
      <p class="hud-label vs-kicker">{KICKERS.m4}</p>
      <div class="vs-prose">
        <p>
          The last two days ran the same way to the end — a showrunners room, a
          clips-and-conversation block, and then the Season 11 Awards Ceremony to
          close it out.
        </p>
      </div>
    </section>

    {showrunners && (
      <figure class="vs-widest" data-reveal>
        <picture>
          <source type="image/avif" srcset={showrunners.avif} sizes="(max-width: 900px) 100vw, 86rem" />
          <source type="image/webp" srcset={showrunners.webp} sizes="(max-width: 900px) 100vw, 86rem" />
          <img src={showrunners.fallback} alt={showrunners.alt} style="aspect-ratio:2/1;object-fit:cover;object-position:50% 58%" loading="lazy" decoding="async" />
        </picture>
        <figcaption class="vs-cap">{CAPTIONS.showrunners}</figcaption>
      </figure>
    )}

    {(stDenis || awardsCeremony) && (
      <div class="vs-pair vs-pair--flip" data-reveal>
        {stDenis && (
          <figure class="vs-pair-b">
            <picture>
              <source type="image/avif" srcset={stDenis.avif} sizes="(max-width: 760px) 100vw, 26rem" />
              <source type="image/webp" srcset={stDenis.webp} sizes="(max-width: 760px) 100vw, 26rem" />
              <img src={stDenis.fallback} alt={stDenis.alt} style="aspect-ratio:4/5;object-fit:cover;object-position:50% 50%" loading="lazy" decoding="async" />
            </picture>
            <figcaption class="vs-cap">{CAPTIONS.stDenis}</figcaption>
          </figure>
        )}
        {awardsCeremony && (
          <figure class="vs-pair-a">
            <picture>
              <source type="image/avif" srcset={awardsCeremony.avif} sizes="(max-width: 760px) 100vw, 44rem" />
              <source type="image/webp" srcset={awardsCeremony.webp} sizes="(max-width: 760px) 100vw, 44rem" />
              <img src={awardsCeremony.fallback} alt={awardsCeremony.alt} style="aspect-ratio:4/3;object-fit:cover;object-position:35% 58%" loading="lazy" decoding="async" />
            </picture>
            <figcaption class="vs-cap">{CAPTIONS.awardsCeremony}</figcaption>
          </figure>
        )}
      </div>
    )}

    <section class="vs-movement" data-reveal>
      <div class="vs-prose">
        <p class="vs-close">
          Official-selection screenings and creator Q&amp;As and panels. SeriesFest,
          Denver, Colorado, April 30 – May 4, 2025.
        </p>
      </div>
    </section>

    <section class="vs-foot">
      <a href={`${base}/venture/seriesfest`} class="link">All five SeriesFest visits <span class="arrow" aria-hidden="true">→</span></a>
      <a href={`${base}/venture`} class="link"><span class="arrow" aria-hidden="true">←</span> Venture</a>
    </section>
  </main>
</Base>

<style>
  .vs {
    background: var(--ground);
    min-height: 100svh;
    padding: 6rem clamp(1.25rem, 5vw, 6rem) 5rem;
    display: grid;
    gap: clamp(2rem, 4vw, 3.25rem);
    max-width: 90rem;
    margin-inline: auto;
  }

  .vs-head {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .vs-back {
    margin-bottom: 0.4rem;
  }
  .vs-slate {
    letter-spacing: 0.28em;
    color: color-mix(in srgb, var(--color-peak) 72%, transparent);
  }

  .vs-headline {
    font-family: var(--font-sans);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 0.94;
    letter-spacing: 0.006em;
    color: #f2f4f8;
    font-size: clamp(2.4rem, 7.6vw, 7.4rem);
    display: grid;
    gap: 0.03em;
  }
  .vs-turn {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: #eef1f6;
    font-size: 0.44em;
    vertical-align: 0.2em;
    margin-inline: 0.1em;
  }
  .vs-line {
    display: block;
