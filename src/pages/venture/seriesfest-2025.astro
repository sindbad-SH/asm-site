---
/**
 * Venture story · SeriesFest 2025 — built on the P12.8 pilot pattern.
 * Same grammar as afm-2025.astro: operator's tiered photo library →
 * repeatable sharp export (scripts/make-venture-story.mjs) → this template.
 *
 * HONESTY: the only status claim is the SeriesFest LegendMark (tier `attended`),
 * rendered near the top from consts — verbatim, never upgraded. The prose is the
 * operator's OWN words (see the read-approval block). Attendance ≠ affiliation.
 *
 * AUDIT-FIX (2026-08-03, design pass): rebuilt from the flat 6-col "editorial
 * wall" grid onto afm-2025.astro's Movement template — see seriesfest-2026.astro
 * for the fuller account of why (the operator's own consistency complaint).
 * Same rule applied here: every image now carries a caption, and near-duplicate
 * frames are collapsed to one. This folder's source set turned out to hold
 * THREE separate near-duplicate clusters of the same moment (hero/step-and-
 * repeat/podium-speaker all the same Soirée/Polis remarks; podium-lectern/
 * podium-address the same Awards Ceremony moment from two angles; panel-stage/
 * screening-title the same Season 11 wordmark backdrop) — the old grid ran
 * SIX of those as if they were six different beats. This pass keeps ONE frame
 * from the first cluster (hero), pairs the other two clusters as intentional
 * two-angle duos/diptychs (the same treatment afm-2025 uses for its own
 * two-angle panel pair), and leaves step-and-repeat + podium-speaker unused in
 * reserve (no-silent-caps rule).
 */
import Base from "../../layouts/Base.astro";
import LegendMark from "../../components/LegendMark.astro";
import { PAGES } from "../../consts";
import { existsSync } from "node:fs";
import { join } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const STORY = "seriesfest-2025";
const mediaDir = join(process.cwd(), "public", "media", "venture", STORY);

async function shot(slug: string, alt: string) {
  const webp900 = join(mediaDir, `${slug}-900.webp`);
  if (!existsSync(webp900)) return undefined;
  const url = (w: number, ext: string) => `${base}/media/venture/${STORY}/${slug}-${w}.${ext}`;
  return {
    alt,
    avif: `${url(900, "avif")} 900w, ${url(1600, "avif")} 1600w`,
    webp: `${url(900, "webp")} 900w, ${url(1600, "webp")} 1600w`,
    fallback: url(900, "webp"),
  };
}

const hero = await shot("hero", "Governor Jared Polis addressing the room at the SeriesFest Soirée 2025, a ceramic peacock installation beside the stage.");
const screeningCard = await shot("screening-card", "The International Spotlight screening slate projected on the big screen, two empty chairs staged for the post-screening Q&A.");
const panelStage = await shot("panel-stage", "A five-person panel seated on stage before the SeriesFest Season 11 backdrop.");
const screeningTitle = await shot("screening-title", "The SeriesFest Season 11 wordmark on the big screen, hosts introducing the room from the podium.");
const podiumLectern = await shot("podium-lectern", "The Awards Ceremony titlecard lit up behind a five-person panel on stage.");
const podiumAddress = await shot("podium-address", "The Awards Ceremony, from closer in — two hosts at the podium, trophies lined up on the table beside them.");
const panelMics = await shot("panel-mics", "Four people on stage exchanging an award, the SeriesFest.com wordmark projected behind them.");

// The SeriesFest proof line — imported from consts, rendered VERBATIM. This is
// the only status claim on the page (tier `attended`), and it sits up top.
const seriesRoom = PAGES.entertainment.rooms.items.find(
  (r) => r.proof.relationshipId === "seriesfest",
);

const KICKERS = {
  m1: "Official selection",
  m2: "The people behind it",
};
const PULL = "You simply couldn't pull off this kind of intimate, high-access event in New York or LA.";
const CAPTIONS = {
  screeningCard: "The International Spotlight slate — six shows, six countries.",
  panelStageDuo: "The room, twice over — the introduction, then the panel.",
  awardsDiptych: "The Awards Ceremony, two angles — the titlecard, then the trophies.",
  panelMics: "Handing off — the reason this festival still feels personal.",
};

const meta = {
  title: "SeriesFest 2025 — a venture story",
  description:
    "SeriesFest 2025 in Denver, Colorado — official-selection screenings, on-stage Q&As and panels, and the Awards Ceremony, from a weekend of relationship-building attendance.",
};
---

<Base title={meta.title} description={meta.description}>
  <main class="vs" data-lane="venture" style="--ground:#10141f">
    <section class="vs-head">
      <a href={`${base}/venture`} class="link vs-back"><span class="arrow" aria-hidden="true">←</span> Venture</a>

      <p class="hud-label vs-slate" data-reveal>SeriesFest · Apr 30 – May 4, 2025 · Denver, CO</p>

      <h1 class="vs-headline" data-reveal>
        <span class="vs-line">SERIESFEST</span>
        <span class="vs-line vs-line--push"><span class="vs-turn">Denver,</span> 2025</span>
      </h1>

      {seriesRoom && (
        <div class="vs-proof" data-reveal>
          <LegendMark proof={seriesRoom.proof} />
        </div>
      )}
    </section>

    {hero && (
      <figure class="vs-hero" data-reveal>
        <picture>
          <source type="image/avif" srcset={hero.avif} sizes="(max-width: 900px) 100vw, 78rem" />
          <source type="image/webp" srcset={hero.webp} sizes="(max-width: 900px) 100vw, 78rem" />
          <img src={hero.fallback} alt={hero.alt} style="aspect-ratio:16/9;object-fit:cover;object-position:50% 42%" loading="eager" decoding="async" />
        </picture>
      </figure>
    )}

    <!--
      ⚠ OPERATOR READ-APPROVAL REQUIRED — new copy (source: his LinkedIn posts —
      the fact he attended the full 2025 festival is from his SeriesFest "Soul
      Power" promo, Feb 2026, "I had a blast at the full festival last year"; the
      cross-year SeriesFest voice is from his Opening Night post ["share the same
      air"] and Soul Power recap ["couldn't pull this off in New York or LA … the
      unique energy they bring to Denver is one-of-a-kind"]), staging-only until
      read. HONESTY/FLAG: the dossier holds no detailed 2025-festival dispatch —
      all his day-by-day posts are Season 12 (2026) — so this draws only on his
      published cross-year SeriesFest voice + the single supportable 2025 fact
      (he attended the full festival). No 2025-specific sessions are invented.
      Named people are only those he publicly named/thanked.
    -->
    <!-- MOVEMENT 1 · OFFICIAL SELECTION -->
    <section class="vs-movement" data-reveal>
      <p class="hud-label vs-kicker">{KICKERS.m1}</p>
      <div class="vs-prose">
        <p>
          For a few days at the end of spring, SeriesFest turns Denver into a room
          where creators, audiences, and industry actually share the same air. In
          2025 we came for the full festival — official-selection screenings,
          on-stage Q&amp;As, and panels, back to back.
        </p>
      </div>
    </section>

    {screeningCard && (
      <figure class="vs-fullbeat" data-reveal>
        <picture>
          <source type="image/avif" srcset={screeningCard.avif} sizes="(max-width: 900px) 100vw, 60rem" />
          <source type="image/webp" srcset={screeningCard.webp} sizes="(max-width: 900px) 100vw, 60rem" />
          <img src={screeningCard.fallback} alt={screeningCard.alt} style="aspect-ratio:16/9;object-fit:cover;object-position:50% 45%" loading="lazy" decoding="async" />
        </picture>
        <figcaption class="vs-cap">{CAPTIONS.screeningCard}</figcaption>
      </figure>
    )}

    <blockquote class="vs-pull" data-reveal>{PULL}</blockquote>

    <section class="vs-movement" data-reveal>
      <div class="vs-prose">
        <p>
          There's a saying about SeriesFest: you simply couldn't pull off this kind
          of intimate, high-access event in New York or LA. The energy the team
          brings to Denver is one of a kind, and it's a big part of what keeps us
          coming back.
        </p>
      </div>
    </section>

    {(screeningTitle || panelStage) && (
      <div class="vs-duo" data-reveal>
        {screeningTitle && (
          <figure class="vs-duo-fig vs-duo-fig--small">
            <picture>
              <source type="image/avif" srcset={screeningTitle.avif} sizes="(max-width: 760px) 100vw, 26rem" />
              <source type="image/webp" srcset={screeningTitle.webp} sizes="(max-width: 760px) 100vw, 26rem" />
              <img src={screeningTitle.fallback} alt={screeningTitle.alt} style="aspect-ratio:4/3;object-fit:cover;object-position:50% 55%" loading="lazy" decoding="async" />
            </picture>
          </figure>
        )}
        {panelStage && (
          <figure class="vs-duo-fig">
            <picture>
              <source type="image/avif" srcset={panelStage.avif} sizes="(max-width: 760px) 100vw, 34rem" />
              <source type="image/webp" srcset={panelStage.webp} sizes="(max-width: 760px) 100vw, 34rem" />
              <img src={panelStage.fallback} alt={panelStage.alt} style="aspect-ratio:3/2;object-fit:cover;object-position:50% 68%" loading="lazy" decoding="async" />
            </picture>
          </figure>
        )}
        <figcaption class="vs-cap vs-duo-cap">{CAPTIONS.panelStageDuo}</figcaption>
      </div>
    )}

    <!-- MOVEMENT 2 · THE PEOPLE BEHIND IT -->
    <section class="vs-movement" data-reveal>
      <p class="hud-label vs-kicker">{KICKERS.m2}</p>
      <div class="vs-prose">
        <p>
          Co-founders Randi Kleiner and Kaily Smith, with Claire Taylor Smith and
          Patrick O'Brien, keep championing the independent creative community here
          — the reason a festival of this caliber still manages to feel this
          personal.
        </p>
      </div>
    </section>

    {(podiumLectern || podiumAddress) && (
      <figure class="vs-diptych" data-reveal>
        <div class="vs-diptych-row">
          {podiumLectern && (
            <picture>
              <source type="image/avif" srcset={podiumLectern.avif} sizes="(max-width: 760px) 100vw, 26rem" />
              <source type="image/webp" srcset={podiumLectern.webp} sizes="(max-width: 760px) 100vw, 26rem" />
              <img src={podiumLectern.fallback} alt={podiumLectern.alt} style="aspect-ratio:3/2;object-fit:cover;object-position:50% 78%" loading="lazy" decoding="async" />
            </picture>
          )}
          {podiumAddress && (
            <picture>
              <source type="image/avif" srcset={podiumAddress.avif} sizes="(max-width: 760px) 100vw, 26rem" />
              <source type="image/webp" srcset={podiumAddress.webp} sizes="(max-width: 760px) 100vw, 26rem" />
              <img src={podiumAddress.fallback} alt={podiumAddress.alt} style="aspect-ratio:3/2;object-fit:cover;object-position:50% 82%" loading="lazy" decoding="async" />
            </picture>
          )}
        </div>
        <figcaption class="vs-cap">{CAPTIONS.awardsDiptych}</figcaption>
      </figure>
    )}

    <section class="vs-movement" data-reveal>
      <div class="vs-prose">
        <p class="vs-close">
          Official-selection screenings and creator Q&amp;As and panels. SeriesFest,
          Denver, Colorado, late April – early May 2025.
        </p>
      </div>
    </section>

    {panelMics && (
      <figure class="vs-closer" data-reveal>
        <picture>
          <source type="image/avif" srcset={panelMics.avif} sizes="(max-width: 760px) 100vw, 40rem" />
          <source type="image/webp" srcset={panelMics.webp} sizes="(max-width: 760px) 100vw, 40rem" />
          <img src={panelMics.fallback} alt={panelMics.alt} style="aspect-ratio:1/1;object-fit:cover;object-position:50% 40%" loading="lazy" decoding="async" />
        </picture>
        <figcaption class="vs-cap">{CAPTIONS.panelMics}</figcaption>
      </figure>
    )}

    <section class="vs-foot">
      <a href={`${base}/venture`} class="link"><span class="arrow" aria-hidden="true">←</span> Venture</a>
    </section>
  </main>
</Base>

<style>
  .vs {
    background: var(--ground);
    min-height: 100svh;
    padding: 6rem clamp(1.25rem, 5vw, 6rem) 5rem;
    display: grid;
    gap: clamp(2rem, 4vw, 3.25rem);
    max-width: 90rem;
    margin-inline: auto;
  }

  .vs-head {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .vs-back {
    margin-bottom: 0.4rem;
  }
  .vs-slate {
    letter-spacing: 0.28em;
    color: color-mix(in srgb, var(--color-peak) 72%, transparent);
  }

  .vs-headline {
    font-family: var(--font-sans);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 0.94;
    letter-spacing: 0.006em;
    color: #f2f4f8;
    font-size: clamp(2.8rem, 9vw, 8.5rem);
    display: grid;
    gap: 0.03em;
  }
  .vs-turn {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: #eef1f6;
    font-size: 0.44em;
    vertical-align: 0.2em;
    margin-inline: 0.1em;
  }
  .vs-line {
    display: block;
  }
  .vs-line--push {
    transform: translateX(5vw);
  }
  .vs-proof {
    margin-top: 0.4rem;
    max-width: 42rem;
  }

  .vs-hero {
    margin: 0;
    max-width: 78rem;
    width: 100%;
    justify-self: center;
    border: 1px solid color-mix(in srgb, var(--color-peak) 16%, transparent);
    padding: 0.4rem;
    background: var(--color-elevated);
  }
  .vs-hero img {
    display: block;
    width: 100%;
    height: auto;
  }

  .vs-cap {
    display: block;
    margin-top: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
  }

  .vs-movement {
    display: grid;
    gap: 1.1rem;
    justify-items: center;
  }
  .vs-kicker {
    justify-self: center;
    letter-spacing: 0.28em;
    color: color-mix(in srgb, var(--color-accent) 82%, transparent);
  }
  .vs-prose {
    max-width: 44rem;
    display: grid;
    gap: 1.1rem;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink) 92%, transparent);
  }
  .vs-close {
    font-style: italic;
  }

  .vs-fullbeat {
    margin: 0;
    max-width: 60rem;
    width: 100%;
    justify-self: center;
  }
  .vs-fullbeat img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .vs-pull {
    margin: 0 auto;
    max-width: 52rem;
    padding-inline: 1rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 560;
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    line-height: 1.3;
    text-align: center;
    color: var(--color-peak);
  }

  /* two-angle duo of the SAME moment — equal columns, ONE shared caption
     spanning both (unlike the site's usual duo, which pairs image + prose) */
  .vs-duo {
    display: grid;
    grid-template-columns: 34fr 58fr;
    grid-template-areas: "small big" "cap cap";
    gap: clamp(0.9rem, 2vw, 1.6rem) clamp(0.9rem, 2vw, 1.6rem);
    align-items: start;
    max-width: 74rem;
    width: 100%;
    justify-self: center;
  }
  .vs-duo-fig {
    margin: 0;
    grid-area: big;
  }
  .vs-duo-fig--small {
    grid-area: small;
  }
  .vs-duo-fig img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .vs-duo-cap {
    grid-area: cap;
    margin-top: 0;
  }

  /* two-angle diptych of the SAME moment — equal columns, shared caption */
  .vs-diptych {
    margin: 0;
    max-width: 54rem;
    width: 100%;
  }
  .vs-diptych-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }
  .vs-diptych img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .vs-closer {
    margin: 0;
    max-width: 40rem;
    width: 100%;
    justify-self: center;
  }
  .vs-closer img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .vs-foot {
    justify-self: start;
    padding-top: 1rem;
    border-top: 1px solid var(--color-hairline);
    width: 100%;
  }

  @media (max-width: 760px) {
    .vs-line--push {
      transform: none;
    }
    .vs-duo {
      grid-template-columns: 1fr;
      grid-template-areas: "small" "big" "cap";
    }
  }
</style>
