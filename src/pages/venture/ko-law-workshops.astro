---
/**
 * /venture/ko-law-workshops — P12-KO: a LIGHT venture story. Sibling to
 * /venture/amazing-aerial + /venture/meme (same venture-article grammar:
 * slate, italic title, LegendMark proof, short paragraphs, photo band,
 * ← Venture backlink + prominent CTAs with the arrow-slide grammar).
 *
 * CONTEXT (2026-07-12): the operator confirmed he covered FOUR of KO Law's
 * 2026 startup workshops (video + photos) and lifted the former "ko law" audit
 * exclusion. His framing: "just create a light story … a page about the
 * workshops they're doing." So this stays modest — coverage of a workshop
 * series, NEVER an embedded/ongoing body of work, NO client-endorsement claim.
 *
 * ⚠ OPERATOR READ-APPROVAL REQUIRED — every prose string below (slate, title,
 * the three paragraphs) is NEW copy, staging-only until he reads it. The
 * relationship status renders ONLY through LegendMark from the LOCKED
 * permittedPhrasing in consts ("workshop-coverage" → KO Law · four 2026
 * sessions). The four session titles are FACTUAL, sourced: Jan 29 + Feb 26
 * from the operator's own edit filenames; Apr 30 ("Formation: Building the
 * Foundation") + Jun 25 ("Building Your Team") read verbatim off the KO-branded
 * title slide visible in his own event photos.
 *
 * FIRM VERIFIED from its own site: KO Law PC (kofirm.com) — a corporate /
 * transactional business-law firm in Boulder + Denver, Colorado, serving
 * founders and emerging companies; Ian Kuliasha is a Partner there. The page
 * names the FIRM only; it never names a person and claims no Pitch Boulder tie.
 *
 * Photos: real event stills the operator shot at the four sessions, exported by
 * scripts/make-ko-law-story.mjs (avif+webp, EXIF auto-oriented). Native 1:1
 * (the frames are square as shot). The HERO is an audience-from-behind frame
 * (no identifiable faces) facing the KO-branded "Startup Workshop" screen.
 */
import Base from "../../layouts/Base.astro";
import LegendMark from "../../components/LegendMark.astro";
import { PAGES } from "../../consts";
import { existsSync, statSync } from "node:fs";
import { join } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ko = PAGES.entertainment.rooms.items.find(
  (r) => r.proof.relationshipId === "workshop-coverage",
)!; // proof = { relationshipId: "workshop-coverage" }

// ── media (existence-gated, cache-busted like the rest of the site) ──
const VDIR = join(process.cwd(), "public", "media", "venture", "ko-law-workshops");
const WIDTHS = [900, 1600];
const bust = (slug: string, w: number, ext: string) => {
  try {
    return `?v=${Math.round(statSync(join(VDIR, `${slug}-${w}.${ext}`)).mtimeMs).toString(36)}`;
  } catch {
    return "";
  }
};
function shot(slug: string) {
  if (!existsSync(join(VDIR, `${slug}-900.avif`))) return undefined;
  const widths = WIDTHS.filter((w) => existsSync(join(VDIR, `${slug}-${w}.avif`)));
  const set = (ext: string) =>
    widths
      .map((w) => `${base}/media/venture/ko-law-workshops/${slug}-${w}.${ext}${bust(slug, w, ext)} ${w}w`)
      .join(", ");
  const w0 = widths[0];
  return {
    avif: set("avif"),
    webp: set("webp"),
    src: `${base}/media/venture/ko-law-workshops/${slug}-${w0}.webp${bust(slug, w0, "webp")}`,
  };
}
const hero = shot("hero");
const collage = ["stage-team", "venue-wide", "workshop-slide", "boardroom", "roundtable"]
  .map((slug) => shot(slug))
  .filter((s): s is NonNullable<typeof s> => !!s);

// ── THE ARTICLE (all new sentences — see the approval note above) ──
const ARTICLE = {
  slate: "KO LAW · STARTUP WORKSHOP SERIES · 2026",
  // ROUND 5 (2026-07-21, operator NO-COUNT rule): a growing series is never
  // numerized — "Four startup workshops" -> "A startup workshop series". The
  // dated session index below stays (a fixed factual list, not a running
  // total). ⚠ OPERATOR READ-APPROVAL REQUIRED — revised strings (staging-only).
  title: "A startup workshop series, on camera.",
  paragraphs: [
    "KO Law is a business-law firm in Boulder and Denver, and part of what they do is teach — a startup workshop series that walks founders through the fundamentals of building a company.",
    "We cover the series as it runs, on video and in photographs — from an early boardroom to a full room under stage lights.",
    "It's light, honest coverage: we show up, catch the session as it happens, and cut it into something that lasts.",
  ],
};

// Session index — FACTUAL titles (see the approval note). Jan/Feb from the
// operator's edit filenames; Apr/Jun read off the on-screen KO title slide.
//
// ⚠ OPERATOR READ-APPROVAL REQUIRED — the one-line `note` on each session is
// NEW copy (light touch, per operator), staging-only until read. Each is drawn
// from his own LinkedIn post recapping that session:
//   · Modeling the Exit — his "Modeling the Exit: Understanding M&A Economics"
//     post (~Feb 2026: the tax reality where founders are "wealthy on paper but
//     cash-poor on closing day"; "starting where most founders hope to finish").
//   · Mapping Your Business's Lifecycle — his session-2 post (~Mar 2026: from
//     incorporation to liquidity; entity choice + vesting keeping a team aligned).
//   · Formation: Building the Foundation — his "Building the Foundation" post
//     (~May 2026: his own opening line, quoted as his words).
//   · Building Your Team — NO post exists in the dossier, so no note (honest gap).
const SESSIONS = [
  {
    date: "Jan 29, 2026",
    title: "Modeling the Exit",
    note: "The exit, modeled — where the tax math can leave a founder wealthy on paper but cash-poor on closing day.",
  },
  {
    date: "Feb 26, 2026",
    title: "Mapping Your Business's Lifecycle",
    note: "From incorporation to liquidity — how entity choice and vesting schedules keep a team aligned for the long haul.",
  },
  {
    date: "Apr 30, 2026",
    title: "Formation: Building the Foundation",
    note: "“You don't form a company. You answer questions, and what falls out of them is a company.”",
  },
  { date: "Jun 25, 2026", title: "Building Your Team" },
];

const CTAS = [
  { label: "See the venture lane", href: `${base}/venture`, external: false },
  { label: "About KO Law", href: "https://kofirm.com", external: true },
];

// ── Build #5 (2026-08-01 archive-mining integration) — "the teacher"
// chapter, named-teacher content about Ian Kuliasha. ⚠⚠ DOUBLE-GATED — the
// FIRST ASM piece to name Ian by name and firm role.
// _INTEGRATION-PLAN.md §1.5 requires BOTH (1) the operator's own
// read-approval (same as every other row in this round) AND (2) a courtesy
// heads-up to Ian himself before this goes anywhere public. Neither has
// happened. Same HELD-FROM-PUBLISH interlock as
// venture/makeshift-film-group.astro: renders under `astro dev` (operator
// preview) or when explicitly built with PUBLISH_KO_IAN=true; a normal
// `astro build` (what every deploy uses) omits the section entirely. The
// rest of this page (firm-first, no individual named) is unaffected and
// ships normally.
const PUBLISH_KO_IAN = import.meta.env.DEV || process.env.PUBLISH_KO_IAN === "true";

const ianDir = join(process.cwd(), "public", "media", "venture", "ko-law-workshops");
function ianShot(slug: string) {
  if (!existsSync(join(ianDir, `ian-${slug}-900.avif`))) return undefined;
  const url = (w: number, ext: string) => `${base}/media/venture/ko-law-workshops/ian-${slug}-${w}.${ext}`;
  return {
    avif: `${url(900, "avif")} 900w, ${url(1600, "avif")} 1600w`,
    webp: `${url(900, "webp")} 900w, ${url(1600, "webp")} 1600w`,
    src: url(900, "webp"),
  };
}
const ianHero = ianShot("hero-team-launch");
const ianBleed = ianShot("audience-classification");
const ianFormation = ianShot("formation-gesture");
const ianOfficeWide = ianShot("boulder-office-wide");
const ianLifecycle = ianShot("lifecycle-screen");
const ianNext = ianShot("next-workshop");

// COLLISION-MAP DROP: `whiteboard-open` confirmed-collides with the live
// boardroom-1600 image above (same/adjacent frame) — never baked, never
// referenced. `boulder-office-wide` (a near-crop of the same live image, a
// different exact moment) is kept per the map's permissive guidance.
//
// NO-COUNT rule (consts.ts, RELATIONSHIPS["workshop-coverage"]): the
// sessions are referred to plurally, never numerized — "across this year's
// sessions," never "four 2026 sessions."
const IAN_CHAPTER = {
  kicker: "The teacher",
  title: "Ian Kuliasha, at the front of the room.",
  paragraphs: [
    "KO Law's startup workshop series has one constant across every session: Ian Kuliasha, a partner in the firm's corporate practice, opens the room and teaches it. He works with founders on formation, financing, and exits — the standing subject of the series — and across this year's sessions he's the one at the whiteboard, the one at the screen, the one who hands the room a framework before the coffee's gone.",
    `The series moves rooms as it grows. It starts in KO Law's own Boulder boardroom — a whiteboard, a wall-mounted screen, coffee cups and a dozen chairs pulled close. By June, the same series fills a stage at Kiln, a Boulder coworking space, house lighting and all. He teaches in examples, not just slides: on independent contractors versus employees, his test is a lawyer joke — call him and ask for legal advice, he says yes, that's the job; ask him to bring the room coffee and he'll say no.`,
    `By the "Building Your Team" session, he's not doing it alone — a colleague from KO Law's corporate team joins him on stage, and the workshop turns into a back-and-forth. What holds it together on camera is simple: whichever room, whichever slide, Ian Kuliasha is the one teaching it.`,
  ],
  captions: {
    hero: "Ian Kuliasha (left) opens a session the way he opens every session — with a show of hands.",
    bleed: "By June the series fills a stage — same teacher, a bigger room to read.",
    formation: `Back in KO Law's own office: "You don't form a company. You answer questions, and what falls out of them is a company."`,
    officeWide: "KO Law's own Boulder office, the room this series started in.",
    lifecycle: "The framework on screen, twenty minutes into a session.",
    next: "He closes every session the same way — by naming the next one.",
  },
};
---

<Base
  title="KO Law startup workshops — a venture story"
  description="Light, honest coverage of KO Law's startup workshop series — on video and in photographs, from the boardroom to the stage."
>
  <main class="ko-story">
    <article class="ko-inner">
      <a href={`${base}/venture`} class="link ko-back">← Venture</a>

      <p class="hud-label ko-slate" data-reveal>
        <span data-decode>{ARTICLE.slate}</span>
      </p>
      <h1 class="ko-title" data-reveal>{ARTICLE.title}</h1>
      <div class="ko-proof" data-reveal>
        <LegendMark proof={ko.proof} />
      </div>

      {
        hero && (
          <figure class="ko-hero" data-reveal>
            <picture>
              <source type="image/avif" srcset={hero.avif} sizes="(max-width: 720px) 100vw, 46rem" />
              <source type="image/webp" srcset={hero.webp} sizes="(max-width: 720px) 100vw, 46rem" />
              <img src={hero.src} alt="A KO Law startup workshop in session, the room facing the branded screen." loading="eager" decoding="async" />
            </picture>
          </figure>
        )
      }

      {ARTICLE.paragraphs.map((para) => <p class="ko-para" data-reveal>{para}</p>)}

      <ul class="ko-sessions" data-reveal aria-label="The sessions covered">
        {
          SESSIONS.map((s) => (
            <li class="ko-session">
              <span class="ko-session-date">{s.date}</span>
              <span class="ko-session-body">
                <span class="ko-session-title">{s.title}</span>
                {s.note && <span class="ko-session-note">{s.note}</span>}
              </span>
            </li>
          ))
        }
      </ul>

      {
        collage.length > 0 && (
          <figure class="ko-collage-wrap" data-reveal>
            <div class="ko-collage">
              {collage.map((s) => (
                <div class="ko-shot">
                  <picture>
                    <source type="image/avif" srcset={s.avif} sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 15rem" />
                    <source type="image/webp" srcset={s.webp} sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 15rem" />
                    <img src={s.src} alt="" loading="lazy" decoding="async" />
                  </picture>
                </div>
              ))}
            </div>
            <figcaption class="hud-label ko-collage-cap">From the 2026 sessions — Boulder + Denver</figcaption>
          </figure>
        )
      }

      {
        PUBLISH_KO_IAN && (
          <section class="ko-ian" aria-label="The teacher">
            <p class="hud-label ko-ian-kicker">{IAN_CHAPTER.kicker}</p>
            <h2 class="ko-ian-title">{IAN_CHAPTER.title}</h2>

            {ianHero && (
              <figure class="ko-ian-hero">
                <picture>
                  <source type="image/avif" srcset={ianHero.avif} sizes="(max-width: 760px) 100vw, 46rem" />
                  <source type="image/webp" srcset={ianHero.webp} sizes="(max-width: 760px) 100vw, 46rem" />
                  <img src={ianHero.src} alt="Two presenters on a stage give an enthusiastic thumbs-up in front of a screen reading KO Law, Startup Workshop, Building Your Team, colorful stage lighting behind them." loading="lazy" decoding="async" />
                </picture>
                <figcaption class="ko-ian-cap">{IAN_CHAPTER.captions.hero}</figcaption>
              </figure>
            )}

            <p class="ko-ian-para">{IAN_CHAPTER.paragraphs[0]}</p>

            {ianBleed && (
              <figure class="ko-ian-bleed">
                <picture>
                  <source type="image/avif" srcset={ianBleed.avif} sizes="100vw" />
                  <source type="image/webp" srcset={ianBleed.webp} sizes="100vw" />
                  <img src={ianBleed.src} alt="A full room of seated workshop attendees facing a stage where two presenters stand beside a screen reading Classification, Employee versus IC, at a venue branded Kiln." loading="lazy" decoding="async" />
                </picture>
                <figcaption class="ko-ian-cap ko-ian-bleed-cap">{IAN_CHAPTER.captions.bleed}</figcaption>
              </figure>
            )}

            <p class="ko-ian-para">{IAN_CHAPTER.paragraphs[1]}</p>

            {ianFormation && (
              <figure class="ko-ian-mid ko-ian-mid--large">
                <picture>
                  <source type="image/avif" srcset={ianFormation.avif} sizes="(max-width: 760px) 100vw, 30rem" />
                  <source type="image/webp" srcset={ianFormation.webp} sizes="(max-width: 760px) 100vw, 30rem" />
                  <img src={ianFormation.src} alt="A bald man with glasses and a beard, wearing a checkered shirt, gestures with both hands while speaking beside a screen reading Startup Workshop, Formation, Building the Foundation, a KO Law sign visible through the window behind him." loading="lazy" decoding="async" />
                </picture>
                <figcaption class="ko-ian-cap">{IAN_CHAPTER.captions.formation}</figcaption>
              </figure>
            )}

            {(ianOfficeWide || ianLifecycle) && (
              <div class="ko-ian-duo">
                {ianOfficeWide && (
                  <figure class="ko-ian-mid">
                    <picture>
                      <source type="image/avif" srcset={ianOfficeWide.avif} sizes="(max-width: 760px) 48vw, 22rem" />
                      <source type="image/webp" srcset={ianOfficeWide.webp} sizes="(max-width: 760px) 48vw, 22rem" />
                      <img src={ianOfficeWide.src} alt="A wide view of a law-firm boardroom with attendees seated around a table, a presenter standing at a whiteboard in the background, and a street sign reading Broadway and Portland visible through the window." loading="lazy" decoding="async" />
                    </picture>
                    <figcaption class="ko-ian-cap">{IAN_CHAPTER.captions.officeWide}</figcaption>
                  </figure>
                )}
                {ianLifecycle && (
                  <figure class="ko-ian-mid">
                    <picture>
                      <source type="image/avif" srcset={ianLifecycle.avif} sizes="(max-width: 760px) 48vw, 22rem" />
                      <source type="image/webp" srcset={ianLifecycle.webp} sizes="(max-width: 760px) 48vw, 22rem" />
                      <img src={ianLifecycle.src} alt="A presenter stands beside a wall-mounted screen displaying a diagram titled Lifecycle Stages, addressing a seated group in a law-office boardroom." loading="lazy" decoding="async" />
                    </picture>
                    <figcaption class="ko-ian-cap">{IAN_CHAPTER.captions.lifecycle}</figcaption>
                  </figure>
                )}
              </div>
            )}

            <p class="ko-ian-para">{IAN_CHAPTER.paragraphs[2]}</p>

            {ianNext && (
              <figure class="ko-ian-mid ko-ian-mid--small">
                <picture>
                  <source type="image/avif" srcset={ianNext.avif} sizes="(max-width: 760px) 60vw, 18rem" />
                  <source type="image/webp" srcset={ianNext.webp} sizes="(max-width: 760px) 60vw, 18rem" />
                  <img src={ianNext.src} alt="A man in a checkered shirt stands with hands in his pockets beside a screen reading Next Workshop, Save the Date, Thursday June 25, Building a Team." loading="lazy" decoding="async" />
                </picture>
                <figcaption class="ko-ian-cap">{IAN_CHAPTER.captions.next}</figcaption>
              </figure>
            )}
          </section>
        )
      }

      <nav class="ko-ctas" data-reveal>
        {
          CTAS.map((c) => (
            <a
              href={c.href}
              class="ko-cta"
              rel={c.external ? "noopener" : undefined}
              target={c.external ? "_blank" : undefined}
            >
              <span>{c.label}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </nav>
      <a href={`${base}/venture`} class="link ko-back">← Venture</a>
    </article>
  </main>
</Base>

<style>
  .ko-story {
    background: #11131c; /* the venture rooms family — a dark, quiet ground */
    min-height: 100svh;
  }
  .ko-inner {
    max-width: 46rem;
    margin-inline: auto;
    padding: 7rem 2rem 6rem;
    display: grid;
    gap: 1.5rem;
  }
  .ko-back {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .ko-slate {
    letter-spacing: 0.24em;
    color: color-mix(in srgb, #d9f2ec 75%, transparent);
    margin: 0;
  }
  .ko-title {
    font-family: var(--font-display);
    font-weight: 560;
    font-style: italic;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.12;
    color: #f2f4f8;
  }

  /* lead hero — native square frame, cropped to a calmer landscape band so the
     branded screen + room read without the column running impossibly tall */
  .ko-hero {
    margin: 0.4rem 0 0;
    border-radius: 8px;
    overflow: hidden;
    background: color-mix(in srgb, #ffffff 4%, transparent);
  }
  .ko-hero img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center 42%;
  }

  .ko-para {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.65;
    color: color-mix(in srgb, #eef2f5 86%, transparent);
  }

  /* session index — a clean mono list, four rows, NOT links (no per-session
     pages yet). Date in accent-quiet, title in the reading color. */
  .ko-sessions {
    list-style: none;
    margin: 0.4rem 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
  }
  .ko-session {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.85rem 0.2rem;
    border-bottom: 1px solid color-mix(in srgb, #ffffff 10%, transparent);
  }
  .ko-session-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, #d9f2ec 72%, transparent);
  }
  .ko-session-body {
    display: grid;
    gap: 0.3rem;
  }
  .ko-session-title {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    color: color-mix(in srgb, #eef2f5 90%, transparent);
  }
  /* one-line session note — quieter, smaller, sits under the title */
  .ko-session-note {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.5;
    color: color-mix(in srgb, #eef2f5 60%, transparent);
  }

  /* photo collage — native 1:1 tiles (the frames are square as shot), a tidy
     responsive grid, lazy + avif/webp responsive sources */
  .ko-collage-wrap {
    margin: 0.6rem 0 0;
  }
  .ko-collage {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
  }
  .ko-shot {
    border-radius: 6px;
    overflow: hidden;
    background: color-mix(in srgb, #ffffff 4%, transparent);
  }
  .ko-shot img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .ko-collage-cap {
    margin-top: 0.8rem;
    letter-spacing: 0.18em;
    color: color-mix(in srgb, #d9f2ec 60%, transparent);
  }

  /* ── "The teacher" chapter (Build #5, DOUBLE-GATED — see PUBLISH_KO_IAN
     above; only ever rendered in dev preview or an explicit gated build) ── */
  .ko-ian {
    margin-top: 0.8rem;
    padding-top: 1.6rem;
    border-top: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
    display: grid;
    gap: 1.1rem;
  }
  .ko-ian-kicker {
    letter-spacing: 0.24em;
    color: color-mix(in srgb, #d9f2ec 75%, transparent);
  }
  .ko-ian-title {
    font-family: var(--font-display);
    font-weight: 560;
    font-style: italic;
    font-size: clamp(1.7rem, 3.6vw, 2.6rem);
    line-height: 1.15;
    color: #f2f4f8;
    margin: 0;
  }
  .ko-ian-para {
    font-family: var(--font-sans);
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.65;
    color: color-mix(in srgb, #eef2f5 86%, transparent);
  }
  .ko-ian-hero, .ko-ian-bleed { margin: 0.2rem 0; }
  .ko-ian-hero img {
    display: block;
    width: 100%;
    border-radius: 8px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .ko-ian-bleed {
    margin-inline: calc(-1 * (100vw - 100%) / 2 - 1px);
    width: 100vw;
    max-width: 100vw;
    position: relative;
  }
  .ko-ian-bleed img {
    display: block;
    width: 100%;
    max-height: 62svh;
    object-fit: cover;
  }
  .ko-ian-bleed-cap {
    position: absolute;
    left: 1.5rem;
    bottom: 1rem;
    margin: 0;
    padding: 0.4rem 0.7rem;
    background: color-mix(in srgb, #11131c 72%, transparent);
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }
  .ko-ian-mid img {
    display: block;
    width: 100%;
    border-radius: 8px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .ko-ian-mid--large { max-width: 30rem; }
  .ko-ian-mid--small { max-width: 18rem; }
  .ko-ian-duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .ko-ian-cap {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, #eef2f5 60%, transparent);
  }
  @media (max-width: 560px) {
    .ko-ian-duo { grid-template-columns: 1fr; }
  }

  /* CTA row — shared button grammar: 1px border, Space Mono caps, arrow slides
     6px on hover, accent hover, visible at rest, ≥44px tall */
  .ko-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
