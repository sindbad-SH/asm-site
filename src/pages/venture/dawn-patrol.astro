---
/**
 * /venture/dawn-patrol — Build #1 of the 2026-08-01 archive-mining
 * integration round (_STORY-STAGING/_INTEGRATION-PLAN.md). The flagship of
 * this round: Grade-A material (14 processed images + a 63s cleared-music
 * video), built to the /adventure/steel-and-dust magazine grammar — the
 * measured exemplar bar (6-rank cover, <=80px stagger differentials, one
 * full-bleed with real content behind it, video as the first visual after
 * the lede, <=~6200px height ceiling, zero repeated images).
 *
 * VESSEL: full story page, venture lane (§0a of the plan — this reads as an
 * arrival/landscape story but is attended WITH a car owner, which is the
 * venture-lane test, not the adventure-lane one).
 *
 * COLLISION-MAP SWAP: staging pick `cobra-alone-on-the-lawn` near-crops the
 * live work/shelby-pebble-beach/photos/on-set-1600 image (same tripod
 * position, same backdrop). Swapped for `judges-and-owner` — see
 * scripts/make-dawn-patrol.mjs header note. Zero images on this page repeat
 * anywhere else in public/media/**.
 *
 * LAYOUT-OVERHAUL P4 (2026-08-01, see LAYOUT-RESEQUENCE-PLAN.md): the audit
 * found THREE pages running the identical newsstand rhythm (steel-and-dust →
 * vybe → this page) — formulaic template, one level above the operator's
 * original complaint. This page de-formalizes toward the Atavist text-led
 * dispatch it already leans to, with the smallest diff that breaks the
 * triplet: (1) the two corner plates are dropped — the cover reads as an
 * Alpinist full-bleed opener, not a newsstand rack; (2) the pull quote is
 * de-overlapped to a plain full-width bold line (Atavist device 8), not the
 * sd-family shadowed plate; (3) the Ferrari stagger becomes an equal-height
 * DIPTYCH with one shared caption (Atavist device 4); (4) afterVideo +
 * beforeLight now run as one unbroken 2-paragraph stretch before the first
 * stagger (chronology unchanged; a 3rd paragraph would require moving the
 * video, which the video-first operator rule forbids). Everything else —
 * video-first, field log + honesty footnote, the bleed, all captions, the
 * zero-repeats rule — is untouched.
 *
 * HONESTY: the only relationship claim renders via <LegendMark> from
 * RELATIONSHIPS["pebble-beach"].permittedPhrasing (verbatim). The sign-off
 * attribution composes from the WORK record, gating `engagement` exactly like
 * steel-and-dust does (never resolves the "[confirm]" by omission-as-silence).
 * Clock times attribute to the shoot's per-car log via fieldLog.timeNote,
 * never stated as bare EXIF-sourced fact.
 */
import Base from "../../layouts/Base.astro";
import LegendMark from "../../components/LegendMark.astro";
import { PAGES, WORK } from "../../consts";
import { existsSync } from "node:fs";
import { join } from "node:path";

const dp = PAGES.ventureStories.dawnPatrol;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const shelby = WORK.find((w) => w.slug === "shelby-pebble-beach");

// Baked media (make-dawn-patrol.mjs) — existence-gated per file, same
// contract as every other baked set on the site.
const mediaDir = join(process.cwd(), "public", "media", "venture", "dawn-patrol");
const WIDTHS = [900, 1600] as const;
function photo(slug: string) {
  if (!existsSync(join(mediaDir, `${slug}-900.avif`))) return undefined;
  const url = (w: number, ext: string) => `${base}/media/venture/dawn-patrol/${slug}-${w}.${ext}`;
  return {
    avif: WIDTHS.map((w) => `${url(w, "avif")} ${w}w`).join(", "),
    webp: WIDTHS.map((w) => `${url(w, "webp")} ${w}w`).join(", "),
    src: url(900, "webp"),
  };
}
const cover = photo("transporter-row-predawn");
// P4: cover plates no longer render (newsstand furniture dropped — see the
// layout-overhaul note above). dp.cover.plates stays in consts untouched.
const beforeA = photo("paddock-tent-first-light");
const beforeB = photo("cobra-in-the-staging-line");
const bleed = photo("eighteenth-green-sunrise");
const gapHero = photo("judges-and-owner");
const judgedHero = photo("judging-the-cobra");
const engineDetail = photo("csx3042-engine-bay");
const threeQuarter = photo("cobra-three-quarter");
const fieldWide = photo("full-field-midday");
const ferrariA = photo("ferrari-250-lm-no8-three-quarter");
const ferrariB = photo("ferrari-250-lm-no7-499fx");
const closing = photo("prewar-line-along-the-coast");

// Dedicated poster pulled FROM the video itself (t=2s), never a re-used
// still — keeps the page's zero-repeated-images rule intact.
const videoDir = join(process.cwd(), "public", "media", "venture", "dawn-patrol");
const loopPoster = existsSync(join(videoDir, "video-poster-1600.avif"))
  ? { avif: `${base}/media/venture/dawn-patrol/video-poster-1600.avif`, src: `${base}/media/venture/dawn-patrol/video-poster-1600.webp` }
  : undefined;
const loopSrc = existsSync(join(videoDir, "dawn-patrol.mp4")) ? `${base}/media/venture/dawn-patrol/dawn-patrol.mp4` : undefined;
---

<Base title={dp.meta.title} description={dp.meta.description}>
  <div data-lane="venture">
    <!-- ── COVER · THE NEWSSTAND (landscape variant — the source material is
         all 16:9, so the cover is a full-bleed widescreen frame rather than
         steel-and-dust's narrow vertical card; the same six typographic
         ranks still apply). ─────────────────────────────────────────────── -->
    <section class="dp-stage" aria-label={`${dp.cover.masthead} — ${dp.meta.title}`}>
      {
        cover && (
          <picture>
            <source type="image/avif" srcset={cover.avif} sizes="100vw" />
            <source type="image/webp" srcset={cover.webp} sizes="100vw" />
            <img
              src={cover.src}
              alt="A row of car-haulers and already-parked pre-war classics in a floodlit staging lot before sunrise, orange cones marking the lanes"
              class="dp-cover-img"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        )
      }
      <div class="dp-scrim" aria-hidden="true"></div>

      <p class="dp-corner dp-corner--tl hud-label">{dp.cover.issue}</p>
      <p class="dp-corner dp-corner--tr hud-label dp-accent">{dp.cover.location}</p>
      <p class="dp-coords hud-label" aria-hidden="true">{dp.cover.coords}</p>

      <header class="dp-masthead">
        <p class="dp-masthead-word">{dp.cover.masthead}</p>
        <p class="dp-masthead-credit hud-label">{dp.cover.credit}</p>
      </header>

      <div class="dp-titleblock">
        <p class="hud-label dp-accent">{dp.cover.storyLabel}</p>
        <h1 class="dp-title">{dp.cover.title}</h1>
        <p class="dp-deck">{dp.cover.deck}</p>
        <ul class="dp-teasers" role="list">
          {dp.cover.teasers.map((t) => <li class="hud-label">{t}</li>)}
        </ul>
      </div>

      <p class="dp-cue hud-label" aria-hidden="true">{dp.cover.scrollCue} ↓</p>
    </section>

    <!-- ── THE FIELD REPORT ────────────────────────────────────────────── -->
    <article class="border-t border-hairline dp-report">
      <header class="dp-col dp-chapter" data-chapter="01">
        <hr class="flight-line mb-4" aria-hidden="true" />
        <p class="hud-label" data-reveal>{dp.slate}</p>
        <p class="hud-label dp-accent" data-reveal>{dp.byline}</p>
        <div class="dp-proof" data-reveal>
          <LegendMark proof={{ relationshipId: "pebble-beach" }} />
        </div>
        <p class="dp-lede" data-reveal>{dp.lede}</p>
      </header>

      <div class="dp-col space-y-4">
        {dp.paragraphs.map((para) => <p class="text-lg text-ink" data-reveal>{para}</p>)}
      </div>

      <!-- VIDEO — first visual after the opening text (operator rule) -->
      {
        loopPoster && loopSrc && (
          <section class="mx-auto dp-video-wrap px-8 pt-4">
            <figure class="dp-photo" data-reveal>
              <div class="dp-video">
                <picture>
                  <source type="image/avif" srcset={loopPoster.avif} />
                  <img class="dp-poster" src={loopPoster.src} alt="" loading="lazy" decoding="async" />
                </picture>
                <video class="dp-loop" data-dp-loop data-loop-src={loopSrc} muted loop playsinline preload="none" aria-hidden="true" />
              </div>
              <figcaption class="dp-cap hud-label">{dp.captions.loop}</figcaption>
            </figure>
          </section>
        )
      }
      <!-- P4: afterVideo + beforeLight run as ONE unbroken text stretch (the
           Atavist text-led signature) before the first image pair; chronology
           unchanged (the pass, then the pre-dawn queue). -->
      <div class="dp-col space-y-6 pt-4">
        <p class="text-lg text-ink" data-reveal>{dp.afterVideo}</p>
        <p class="text-lg text-ink" data-reveal>{dp.beforeLight}</p>
      </div>

      <!-- PASS ONE — before light: asymmetric stagger -->
      <section class="mx-auto max-w-5xl px-8 pt-6 dp-chapter" data-chapter="01">
        <p class="hud-label dp-accent dp-chapter-label" data-reveal>{dp.chapters.before}</p>
        {
          (beforeA || beforeB) && (
            <div class="dp-stagger">
              {beforeA && (
                <figure class="dp-photo dp-stagger-a" data-reveal>
                  <picture>
                    <source type="image/avif" srcset={beforeA.avif} sizes="(min-width: 1024px) 58vw, 90vw" />
                    <source type="image/webp" srcset={beforeA.webp} sizes="(min-width: 1024px) 58vw, 90vw" />
                    <img src={beforeA.src} alt="The interior of a large event tent marked CARS — Classic Automotive Relocation Services, International Entrant Pavilion, postwar sedans and a pale blue Cobra parked inside at dawn" style="aspect-ratio:16/9;object-fit:cover" class="block w-full" loading="lazy" decoding="async" />
                  </picture>
                  <figcaption class="dp-cap hud-label">{dp.captions.beforeA}</figcaption>
                </figure>
              )}
              {beforeB && (
                <figure class="dp-photo dp-stagger-b" data-reveal data-reveal-stagger="80">
                  <picture>
                    <source type="image/avif" srcset={beforeB.avif} sizes="(min-width: 1024px) 34vw, 80vw" />
                    <source type="image/webp" srcset={beforeB.webp} sizes="(min-width: 1024px) 34vw, 80vw" />
                    <img src={beforeB.src} alt="A dark blue Cobra roadster queued in a line of pre-war cars at dusk-blue light, transporters queued behind" style="aspect-ratio:4/3;object-fit:cover" class="block w-full" loading="lazy" decoding="async" />
                  </picture>
                  <figcaption class="dp-cap hud-label">{dp.captions.beforeB}</figcaption>
                </figure>
              )}
            </div>
          )
        }
      </section>

      <!-- pull quote — plain full-width bold line (P4, Atavist device 8) -->
      <section class="dp-col dp-pull-wrap">
        <blockquote class="dp-pull panel" data-reveal>{dp.pullQuote}</blockquote>
      </section>

      <!-- PASS TWO — the gap: prose, then a FULL-BLEED band, then a single hero -->
      <section class="dp-col space-y-6 dp-chapter" data-chapter="02">
        <p class="hud-label dp-accent dp-chapter-label" data-reveal>{dp.chapters.gap}</p>
        <p class="text-lg text-ink" data-reveal>{dp.gap}</p>
      </section>
      {
        bleed && (
          <figure class="dp-bleed" data-reveal>
            <picture>
              <source type="image/avif" srcset={bleed.avif} sizes="100vw" />
              <source type="image/webp" srcset={bleed.webp} sizes="100vw" />
              <img
                src={bleed.src}
                alt="Wide view of Pebble Beach's 18th green at sunrise, three Shelby Cobras spaced across the fairway, bunkers and the bay behind, orange marker flags in the water"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <figcaption class="dp-cap dp-bleed-cap hud-label">{dp.captions.bleed}</figcaption>
          </figure>
        )
      }
      <!-- gapHero paired with the rest of the "gap" narrative as a duo (not a
           stacked solo block) — keeps the page under its height ceiling -->
      <section class="mx-auto max-w-5xl px-8 pt-4">
        <div class="dp-duo dp-duo--gap">
          {
            gapHero && (
              <figure class="dp-photo" data-reveal>
                <picture>
                  <source type="image/avif" srcset={gapHero.avif} sizes="(min-width: 1024px) 32vw, 90vw" />
                  <source type="image/webp" srcset={gapHero.webp} sizes="(min-width: 1024px) 32vw, 90vw" />
                  <img
                    src={gapHero.src}
                    alt="A blue Shelby Cobra with its hood up on a golf fairway at dawn, a small group of people around it, the bay and coastline behind"
                    style="aspect-ratio:2/1;object-fit:cover"
                    class="block w-full"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <figcaption class="dp-cap hud-label">{dp.captions.gapHero}</figcaption>
              </figure>
            )
          }
          <p class="text-lg text-ink" data-reveal>{dp.gapDetail}</p>
        </div>
      </section>

      <!-- PASS THREE — judged: tilted evidence frame + prose + field log -->
      <section class="mx-auto max-w-5xl px-8 pt-4 dp-chapter" data-chapter="03">
        <p class="hud-label dp-accent dp-chapter-label" data-reveal>{dp.chapters.judged}</p>
        <div class="dp-duo">
          {
            judgedHero && (
              <figure class="dp-photo dp-tilt" data-reveal>
                <picture>
                  <source type="image/avif" srcset={judgedHero.avif} sizes="(min-width: 1024px) 40vw, 90vw" />
                  <source type="image/webp" srcset={judgedHero.webp} sizes="(min-width: 1024px) 40vw, 90vw" />
                  <img
                    src={judgedHero.src}
                    alt="A blue Shelby Cobra with a green class ribbon on its front fender, a small crowd of spectators gathered around it on the show lawn"
                    style="aspect-ratio:4/5;object-fit:cover"
                    class="block w-full"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <figcaption class="dp-cap hud-label">{dp.captions.judgedHero}</figcaption>
              </figure>
            )
          }
          <div class="space-y-6">
            <p class="text-lg text-ink" data-reveal>{dp.judged}</p>
            <div class="panel dp-log" data-reveal>
              <p class="hud-label dp-accent">{dp.fieldLog.heading}</p>
              <dl>
                {
                  dp.fieldLog.rows.map((row) => (
                    <div class="dp-log-row">
                      <dt class="hud-label">{row.label}</dt>
                      <dd>{row.value}</dd>
                    </div>
                  ))
                }
              </dl>
              <p class="dp-log-note">{dp.fieldLog.timeNote}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- walkaround detail + angle — stagger-flip -->
      {
        (engineDetail || threeQuarter) && (
          <section class="mx-auto max-w-5xl px-8 pt-4">
            <div class="dp-stagger dp-stagger--flip">
              {engineDetail && (
                <figure class="dp-photo dp-stagger-b" data-reveal>
                  <picture>
                    <source type="image/avif" srcset={engineDetail.avif} sizes="(min-width: 1024px) 34vw, 80vw" />
                    <source type="image/webp" srcset={engineDetail.webp} sizes="(min-width: 1024px) 34vw, 80vw" />
                    <img src={engineDetail.src} alt="Close view into the open engine bay of a blue Shelby Cobra showing twin carburetors, a crowd of onlookers visible in the background" style="aspect-ratio:1/1;object-fit:cover" class="block w-full" loading="lazy" decoding="async" />
                  </picture>
                  <figcaption class="dp-cap hud-label">{dp.captions.engineDetail}</figcaption>
                </figure>
              )}
              {threeQuarter && (
                <figure class="dp-photo dp-stagger-a" data-reveal data-reveal-stagger="80">
                  <picture>
                    <source type="image/avif" srcset={threeQuarter.avif} sizes="(min-width: 1024px) 58vw, 90vw" />
                    <source type="image/webp" srcset={threeQuarter.webp} sizes="(min-width: 1024px) 58vw, 90vw" />
                    <img src={threeQuarter.src} alt="Front three-quarter view of a blue Shelby Cobra with a green ribbon on the fender under a clear sky, a pale Cobra visible in the background" style="aspect-ratio:16/9;object-fit:cover" class="block w-full" loading="lazy" decoding="async" />
                  </picture>
                  <figcaption class="dp-cap hud-label">{dp.captions.threeQuarter}</figcaption>
                </figure>
              )}
            </div>
          </section>
        )
      }

      <!-- PASS FOUR — the field becomes a city: prose + image as a duo (not a
           stacked solo block — keeps the page under its height ceiling) -->
      <section class="mx-auto max-w-5xl px-8 pt-4 dp-chapter" data-chapter="04">
        <p class="hud-label dp-accent dp-chapter-label" data-reveal>{dp.chapters.field}</p>
        <div class="dp-duo dp-duo--wide">
          {
            fieldWide && (
              <figure class="dp-photo" data-reveal>
                <picture>
                  <source type="image/avif" srcset={fieldWide.avif} sizes="(min-width: 1024px) 46vw, 90vw" />
                  <source type="image/webp" srcset={fieldWide.webp} sizes="(min-width: 1024px) 46vw, 90vw" />
                  <img
                    src={fieldWide.src}
                    alt={`A dense midday crowd on the Pebble Beach show field, a class sign reading "L-3 Postwar Preservation Late," coastline behind`}
                    style="aspect-ratio:16/9;object-fit:cover"
                    class="block w-full"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <figcaption class="dp-cap hud-label">{dp.captions.fieldWide}</figcaption>
              </figure>
            )
          }
          <p class="text-lg text-ink" data-reveal>{dp.field}</p>
        </div>
      </section>
      <!-- P4: the Ferraris as an equal-height DIPTYCH — two related frames
           grouped as ONE beat with a shared caption (Atavist device 4),
           replacing the third stagger module. -->
      {
        (ferrariA || ferrariB) && (
          <section class="mx-auto max-w-5xl px-8 pt-4">
            <figure class="dp-diptych" data-reveal>
              <div class="dp-diptych-row">
                {ferrariA && (
                  <picture>
                    <source type="image/avif" srcset={ferrariA.avif} sizes="(min-width: 1024px) 44vw, 90vw" />
                    <source type="image/webp" srcset={ferrariA.webp} sizes="(min-width: 1024px) 44vw, 90vw" />
                    <img src={ferrariA.src} alt="Three-quarter view of a red Ferrari 250 LM race car, number 8, with a green ribbon on the hood, spectators behind" style="aspect-ratio:3/2;object-fit:cover" class="block w-full" loading="lazy" decoding="async" />
                  </picture>
                )}
                {ferrariB && (
                  <picture>
                    <source type="image/avif" srcset={ferrariB.avif} sizes="(min-width: 1024px) 44vw, 90vw" />
                    <source type="image/webp" srcset={ferrariB.webp} sizes="(min-width: 1024px) 44vw, 90vw" />
                    <img src={ferrariB.src} alt={`Head-on view of a red Ferrari 250 LM, race number 7, with a UK registration plate reading "499FX," a dense crowd behind`} style="aspect-ratio:3/2;object-fit:cover" class="block w-full" loading="lazy" decoding="async" />
                  </picture>
                )}
              </div>
              {/* ⚠ OPERATOR READ-APPROVAL REQUIRED — new shared caption
                  (composed from the two existing per-frame captions; facts
                  unchanged), staging-only until read. */}
              <figcaption class="dp-cap hud-label">Ferrari 250 LMs — race No. 8 already ribboned, No. 7 with a UK plate still on the nose.</figcaption>
            </figure>
          </section>
        )
      }

      <!-- closing beat — prose + image as a duo (flipped: text leads, image
           trails), the closing bookend paired rather than stacked -->
      <section class="mx-auto max-w-5xl px-8 pt-6">
        <div class="dp-duo dp-duo--wide dp-duo--flip">
          <p class="text-lg text-ink" data-reveal>{dp.close}</p>
          {
            closing && (
              <figure class="dp-photo" data-reveal>
                <picture>
                  <source type="image/avif" srcset={closing.avif} sizes="(min-width: 1024px) 46vw, 90vw" />
                  <source type="image/webp" srcset={closing.webp} sizes="(min-width: 1024px) 46vw, 90vw" />
                  <img
                    src={closing.src}
                    alt="A line of black pre-war luxury cars parked along the Pebble Beach coastline, well-dressed spectators including a woman in a gold gown, the Pacific behind"
                    style="aspect-ratio:16/9;object-fit:cover"
                    class="block w-full"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <figcaption class="dp-cap hud-label">{dp.captions.closing}</figcaption>
              </figure>
            )
          }
        </div>
      </section>

      <!-- sign-off -->
      <footer class="dp-col pt-6 pb-8">
        {shelby && (
          <p class="dp-attrib">
            For {shelby.forOrg} · {shelby.what}
            {shelby.engagement && shelby.engagement !== "[confirm]" ? ` — ${shelby.engagement}` : ""}
          </p>
        )}
        <nav class="dp-links">
          <a href={`${base}${dp.links.shelbyCase.href}`} class="link">{dp.links.shelbyCase.label} <span class="arrow" aria-hidden="true">→</span></a>
          <a href={`${base}${dp.links.back.href}`} class="link"><span class="arrow" aria-hidden="true">←</span> {dp.links.back.label}</a>
        </nav>
      </footer>
    </article>
  </div>
</Base>

<style>
  /* ── COVER · landscape newsstand variant ──────────────────────────────── */
  .dp-stage {
    position: relative;
    min-height: 80svh;
    display: grid;
    align-content: end;
    overflow: clip;
  }
  .dp-cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    html.js .dp-cover-img {
      animation: dp-settle 2400ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes dp-settle {
      from { transform: scale(1.045); }
      to { transform: scale(1); }
    }
  }
  .dp-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to bottom, rgba(10, 13, 18, 0.6) 0%, rgba(10, 13, 18, 0.12) 26%, transparent 42%),
      linear-gradient(to top, rgba(10, 13, 18, 0.88) 0%, rgba(10, 13, 18, 0.4) 30%, transparent 58%);
  }
  .dp-corner {
    position: absolute;
    top: 5.5rem;
    z-index: 2;
    font-size: 0.6rem;
  }
  .dp-corner--tl { left: 1.25rem; }
  .dp-corner--tr { right: 1.25rem; }
  .dp-accent { color: var(--color-accent); }
  .dp-coords {
    position: absolute;
    right: 1.1rem;
    top: 50%;
    z-index: 2;
    transform: translateY(-50%);
    writing-mode: vertical-rl;
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    color: var(--color-accent-deep);
  }
  .dp-masthead {
    position: absolute;
    top: 9%;
    left: 0;
    right: 0;
    z-index: 2;
    text-align: center;
  }
  .dp-masthead-word {
    font-family: var(--font-display-condensed);
    font-size: clamp(2.4rem, 9vw, 4.6rem);
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
  }
  .dp-masthead-credit {
    margin-top: 0.5rem;
    font-size: 0.58rem;
    letter-spacing: 0.32em;
    color: color-mix(in srgb, #fff 72%, transparent);
  }
  .dp-titleblock {
    position: relative;
    z-index: 2;
    max-width: 42rem;
