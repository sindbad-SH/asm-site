</style>

<script>
  // ── hero video: plays only when motion is allowed and on-screen; the
  // poster is the permanent base layer (same IO-gated pattern as
  // steel-and-dust's showcase loop). ──
  (() => {
    const video = document.querySelector<HTMLVideoElement>("[data-dp-loop]");
    const box = video?.closest<HTMLElement>(".dp-video");
    if (!box || !video) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const conn = (navigator as { connection?: { saveData?: boolean } }).connection;
    if (conn?.saveData) return;
    video.addEventListener("playing", () => box.classList.add("is-playing"));
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        if (entry.isIntersecting) {
          if (!video.src) video.src = video.dataset.loopSrc!;
          video.play().catch(() => {});
        } else if (!video.paused) {
          video.pause();
        }
      },
      { threshold: 0.25 },
    );
    io.observe(box);
    window.addEventListener("pagehide", () => io.disconnect(), { once: true });
  })();
</script>
