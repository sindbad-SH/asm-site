---
/**
 * /venture/seriesfest — the SeriesFest hub. Not a second flagship: the
 * chapter pages carry the real depth; this page's value is the architecture —
 * one cover-story frame that gives them a parent, plus a condensed arc.
 *
 * ARCHIVE-REWORK 2026-08-03: a FIFTH row joins the contents column — the
 * November 2025 "Devil in Disguise: John Wayne Gacy" screening, a real visit
 * the arc previously jumped straight over (it sat between Season 11 and the
 * Soul Power premiere). It is the one visit with NO photo pool, so it runs as
 * a deliberately unillustrated row: an accent rule under the title stands in
 * for the image, which is honest, where a 480px card beside four full-res ones
 * would not be. See src/pages/venture/seriesfest-2025-devil-in-disguise.astro.
 *
 * LAYOUT-OVERHAUL P2 (2026-08-01, see LAYOUT-RESEQUENCE-PLAN.md): the
 * uniform 2×2 card grid (four identical 4:3 tiles — the audit's
 * "grid-as-body" fail, the operator's boxes complaint verbatim) becomes an
 * editorial CONTENTS-PAGE column: chapter rows, each a different layout,
 * separated by hairlines instead of enclosed in bordered boxes.
 *   01 · 2025 festival — FEATURED row: 16:9 image at 58fr beside the text
 *        (the deepest visit reads biggest).
 *   02 · Devil in Disguise — TEXT-ONLY, centered (no photo pool exists).
 *   03 · Soul Power — a contained 2:1 banner above its text (the
 *        step-and-repeat + press pack composition is a natural wide band).
 *   04 · Fashion in Focus — a small ~200px square thumbnail beside text
 *        (the Magnum related-content device; deliberately the smallest).
 *   05 · Season 12 — mirrored row: portrait 4:5 image (the red-carpet
 *        lineup is a standing-figures vertical) with text to its right.
 * Crop note: the hub bakes are square/near-square (900×900, s12 900×996);
 * every crop is CSS aspect-ratio + object-position tuned against a contact
 * sheet (eye-reviewed) — no new bakes, originals untouched.
 *
 * COLLISION-MAP GATE: only 5 of the miner's staged 10 images survive
 * perceptual dedup — see scripts/make-seriesfest-hub.mjs. That's a cover
 * image + exactly one illustrated card per chapter, with nothing spare for
 * a full-bleed band without repeating an image. This page deliberately
 * skips the "one full-bleed" convention for that reason (material honesty
 * over template completeness — "small vessels stay small").
 *
 * HONESTY: the only status claim is the SeriesFest LegendMark (tier
 * `attended`), rendered from consts — verbatim, never upgraded. Attendance
 * != affiliation.
 */
import Base from "../../layouts/Base.astro";
import { PAGES } from "../../consts";
import { existsSync } from "node:fs";
import { join } from "node:path";

const sf = PAGES.ventureStories.seriesfestHub;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const mediaDir = join(process.cwd(), "public", "media", "venture", "seriesfest");
const WIDTHS = [900, 1600] as const;
function photo(slug: string) {
  if (!existsSync(join(mediaDir, `${slug}-900.avif`))) return undefined;
  const url = (w: number, ext: string) => `${base}/media/venture/seriesfest/${slug}-${w}.${ext}`;
  // Existence-gate each width. Not every frame has a 1600 tier — the Devil in
  // Disguise signage tops out at 480px native, so emitting a -1600 candidate
  // for it would put a URL that 404s into the srcset.
  const widths = WIDTHS.filter((w) => existsSync(join(mediaDir, `${slug}-${w}.avif`)));
  return {
    avif: widths.map((w) => `${url(w, "avif")} ${w}w`).join(", "),
    webp: widths.map((w) => `${url(w, "webp")} ${w}w`).join(", "),
    src: url(900, "webp"),
  };
}
const cover = photo(sf.coverImageSlug);
const chapters = sf.chapters.map((c) => ({ ...c, media: photo(c.imageSlug) }));

// Per-row layout + crop assignment (index-aligned with sf.chapters 01–05;
// crops tuned against the eye-reviewed contact sheet — see header note).
// Row 02 (Devil in Disguise) is deliberately imageless — see its consts entry.
// OPERATOR REWORK 2026-08-05. Two changes to the sequence:
//  (a) It used to END SMALL — row 04 was a 200px thumb and row 05 a 20rem
//      portrait, the two smallest treatments back to back at the close, so the
//      page faded out on its own main event. The two full festivals are now
//      the BOOKENDS (01 and 05, mirrored), and the page ends large.
//  (b) Row 02 was `textonly` — a deliberately imageless row, which read as a
//      dead entry beside four photographed ones. Devil in Disguise does have
//      photography: two 480x480 frames, all that exists (no larger original
//      anywhere). It now runs at the smallest treatment on the page, using the
//      venue sign that names the screening. Small is the honest answer here —
//      operator: "I only really had like two photos, it was a pretty small
//      event" — but small and present beats absent.
// Aspect ratios are also relaxed: every source here is 1:1, so the old 16/9
// featured crop threw away 44% of the frame. 4/3 keeps 75%.
const ROW_LAYOUT = ["featured", "thumb", "banner", "portrait", "featured-flip"] as const;
const ROW_STYLE = [
  "aspect-ratio:4/3;object-fit:cover;object-position:50% 42%",  // 01 featured — Season 11 wordmark + moderator
  "aspect-ratio:1/1;object-fit:cover;object-position:50% 50%",  // 02 thumb — the venue sign, uncropped (square in square)
  "aspect-ratio:2/1;object-fit:cover;object-position:50% 58%",  // 03 banner — the ABA lineup, tuned to keep full bodies in the band
  "aspect-ratio:4/5;object-fit:cover;object-position:55% 55%",  // 04 portrait — model + florals
  "aspect-ratio:4/3;object-fit:cover;object-position:50% 45%",  // 05 featured-flip — the standing lineup
] as const;
const ROW_SIZES = [
  "(max-width: 760px) 100vw, 38rem",
  "200px",
  "(max-width: 760px) 100vw, 30rem",
  "(max-width: 760px) 80vw, 20rem",
  "(max-width: 760px) 100vw, 38rem",
] as const;
---

<Base title={sf.meta.title} description={sf.meta.description}>
  <div data-lane="venture">
    {/* ── COVER · OPERATOR REWORK 2026-08-05 ────────────────────────────
         Was: a full-bleed landscape band with the type laid over it. The
         source is 1:1 (every SeriesFest frame is — 96 of 98 across the sets),
         so `object-fit: cover` in a 70svh band showed ~44% of the picture and
         cut the subject. Operator: "it uses a photo from the Fashion in Focus
         event that's really stretched out, which doesn't really work super
         well as the main SeriesFest hero photo."
         Note the old `aspect-ratio: 16/9` on .sf-cover-img was INERT — with
         `inset: 0` plus width/height 100% both axes were already definite, so
         the band's height came from .sf-stage's min-height alone. Editing the
         ratio would have changed nothing; the band itself had to go.
         Now: the photograph runs at its NATIVE SQUARE beside the type instead
         of underneath it. Nothing is cropped, and because the type no longer
         sits on the picture, the picture no longer has to be a letterbox. */}
    <section class="sf-stage" aria-label={`${sf.cover.masthead} — ${sf.meta.title}`}>
      <div class="sf-stage-inner">
        <div class="sf-cover-frame">
          {
            cover && (
              <picture>
                <source type="image/avif" srcset={cover.avif} sizes="(max-width: 900px) 92vw, 40rem" />
                <source type="image/webp" srcset={cover.webp} sizes="(max-width: 900px) 92vw, 40rem" />
                <img src={cover.src} alt={sf.coverAlt} class="sf-cover-img" fetchpriority="high" decoding="async" />
              </picture>
            )
          }
          <p class="sf-corner sf-corner--tl hud-label">{sf.cover.issue}</p>
          <p class="sf-corner sf-corner--tr hud-label sf-accent">{sf.cover.location}</p>
        </div>

        <div class="sf-titleblock">
          <header class="sf-masthead">
            <p class="sf-masthead-word">{sf.cover.masthead}</p>
            <p class="sf-masthead-credit hud-label">{sf.cover.credit}</p>
          </header>
          <p class="hud-label sf-accent">{sf.cover.storyLabel}</p>
          <h1 class="sf-title">{sf.cover.title}</h1>
          <p class="sf-deck">{sf.cover.deck}</p>
          <ul class="sf-teasers" role="list">
            {sf.cover.teasers.map((t) => <li class="hud-label">{t}</li>)}
          </ul>
          <p class="sf-coords hud-label" aria-hidden="true">{sf.cover.coords}</p>
        </div>
      </div>
      <p class="sf-cue hud-label" aria-hidden="true">{sf.cover.scrollCue} ↓</p>
    </section>

    <!-- ── THE FIELD REPORT ────────────────────────────────────────────── -->
    <article class="border-t border-hairline sf-report">
      <header class="sf-col sf-chapter">
        <hr class="flight-line mb-4" aria-hidden="true" />
        <p class="hud-label" data-reveal>{sf.slate}</p>
        <p class="hud-label sf-accent" data-reveal>{sf.byline}</p>
        <div class="sf-proof" data-reveal>
        </div>
        <p class="sf-lede" data-reveal>{sf.lede}</p>
      </header>
      <div class="sf-col">
        <p class="text-lg text-ink" data-reveal>{sf.intro}</p>
      </div>

      <!-- THE CONTENTS COLUMN — five visits, five different row layouts
           (featured / text-only / banner / thumbnail / portrait),
           hairline-separated. The hub's value is architecture; the variety
           is the point. -->
      <section class="sf-toc mx-auto px-8 pt-6" aria-label="The five visits">
        {
          chapters.map((c, i) => (
            <a
              href={`${base}${c.href}`}
              class={`sf-row sf-row--${ROW_LAYOUT[i] ?? "featured"}`}
              data-reveal
            >
              {c.media && (
                <div class="sf-row-media">
                  <picture>
                    <source type="image/avif" srcset={c.media.avif} sizes={ROW_SIZES[i]} />
                    <source type="image/webp" srcset={c.media.webp} sizes={ROW_SIZES[i]} />
                    <img src={c.media.src} alt={c.alt} style={ROW_STYLE[i]} loading="lazy" decoding="async" />
                  </picture>
                </div>
              )}
              {/* OPERATOR REWORK 2026-08-05 — the five visits did not read as
                  five separate events: the date was an 0.68rem mono line
                  typographically identical to the slate directly above it, so
                  the two blurred into one grey run. The dateline is now its
                  own plate — big numeral, event name at display scale, date
                  spelled out — and it is the FIRST thing in each row. */}
              <div class="sf-row-body">
                <div class="sf-dateline">
                  <span class="sf-dateline-no">{c.no}</span>
                  <span class="sf-dateline-stack">
                    <span class="sf-dateline-event">{c.slate}</span>
                    <span class="sf-dateline-date">{c.date}</span>
                  </span>
                </div>
                <h2 class="sf-row-title">{c.title}</h2>
                <p class="sf-row-copy">{c.body}</p>
                <span class="sf-row-cta">{c.cta} <span class="arrow" aria-hidden="true">→</span></span>
              </div>
            </a>
          ))
        }
      </section>

      <section class="sf-col pt-8">
        <p class="text-lg text-ink" data-reveal>{sf.close}</p>
      </section>

      <footer class="sf-col pt-6 pb-8">
        <nav class="sf-links">
          <a href={`${base}${sf.links.moreHref}`} class="link">{sf.links.moreLabel} <span class="arrow" aria-hidden="true">→</span></a>
          <a href={`${base}${sf.links.back.href}`} class="link"><span class="arrow" aria-hidden="true">←</span> {sf.links.back.label}</a>
        </nav>
      </footer>
    </article>
  </div>
</Base>

<style>
  /* OPERATOR REWORK 2026-08-05 — the stage is no longer a full-bleed band
     with type over the picture. It is a two-column composition: the square
     photograph at NATIVE ratio on the left, the masthead and title stack on
     the right. Nothing is cropped and nothing is stretched. */
  .sf-stage {
    position: relative;
    padding: clamp(2rem, 6vw, 4.5rem) clamp(1.25rem, 5vw, 3rem) 0;
    display: grid;
    gap: 1rem;
  }
  .sf-stage-inner {
    width: min(100%, 78rem);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 40rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .sf-cover-frame {
    position: relative;
    border-radius: 8px;
    overflow: clip;
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.75);
  }
  /* height:auto + no object-fit = the 1:1 source renders as 1:1. */
  .sf-cover-img {
    display: block;
    width: 100%;
    height: auto;
  }
  .sf-corner {
    position: absolute;
    top: 0.9rem;
    z-index: 2;
    font-size: 0.6rem;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.8);
  }
  .sf-corner--tl { left: 1rem; }
  .sf-corner--tr { right: 1rem; }
  .sf-accent { color: var(--color-accent); }
  .sf-coords {
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    color: var(--color-accent-deep);
    margin-top: 0.4rem;
  }
  .sf-masthead { margin-bottom: 0.2rem; }
  .sf-masthead-word {
    font-family: var(--font-display-condensed);
    font-size: clamp(2.2rem, 8vw, 4rem);
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
  }
  .sf-masthead-credit { margin-top: 0.5rem; font-size: 0.58rem; letter-spacing: 0.32em; color: color-mix(in srgb, #fff 72%, transparent); }
  /* Left-aligned now that it sits beside the picture rather than over it. */
  .sf-titleblock { display: grid; gap: 0.55rem; justify-items: start; text-align: left; }
  .sf-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 640;
    font-size: clamp(2.4rem, 8vw, 4rem);
    line-height: 0.98;
    color: #fff;
    letter-spacing: -0.01em;
    font-style: italic;
  }
  .sf-deck { max-width: 38ch; font-family: var(--font-display); font-style: italic; font-size: 0.98rem; line-height: 1.5; color: color-mix(in srgb, #fff 92%, transparent); }
  .sf-teasers { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; margin-top: 0.2rem; padding: 0; list-style: none; }
  .sf-teasers li { font-size: 0.56rem; color: color-mix(in srgb, #fff 68%, transparent); }
  .sf-teasers li::before { content: "◆ "; color: var(--color-accent); font-size: 0.5em; vertical-align: 20%; }
  .sf-cue { position: relative; z-index: 2; text-align: center; padding-block: 1.6rem 0.8rem; font-size: 0.58rem; color: color-mix(in srgb, #fff 55%, transparent); }

  @media (max-width: 900px) {
    .sf-stage-inner { grid-template-columns: 1fr; gap: 1.4rem; }
    .sf-cover-frame { max-width: 34rem; margin-inline: auto; }
  }

  .sf-report { overflow-x: clip; }
  .sf-col { margin-inline: auto; max-width: 48rem; padding-inline: 2rem; }
  .sf-chapter { padding-top: 1.5rem; }
  .sf-proof { max-width: 40rem; }
  .sf-lede {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 460;
    font-size: clamp(1.3rem, 2.6vw, 1.6rem);
    line-height: 1.4;
    color: var(--color-peak);
  }

  /* ── THE CONTENTS COLUMN — de-boxed rows, hairline-separated ─────────── */
  .sf-toc {
    max-width: 64rem;
    display: grid;
  }
  .sf-row {
    display: grid;
    gap: clamp(1.2rem, 3vw, 2.2rem);
    padding-block: 2rem;
    border-top: 1px solid var(--color-hairline);
    text-decoration: none;
    color: inherit;
    align-items: center;
  }
  .sf-row:first-child {
    border-top: none;
  }
  .sf-row-media {
    margin: 0;
  }
  .sf-row-media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    transition: transform var(--dur-hover, 180ms) var(--ease-swift, ease);
  }
  .sf-row:hover .sf-row-media img,
  .sf-row:focus-visible .sf-row-media img {
    transform: scale(1.015);
  }
  .sf-row-body {
    display: grid;
    gap: 0.4rem;
    align-content: center;
  }
  /* ── THE DATELINE PLATE (2026-08-05) ────────────────────────────────────
     Constant across all five rows — a repeating masthead is what makes them
     read as one series. The event NAME carries the display scale rather than
     the year, because four of the five years would read 2025/2026/2026/2026
     and defeat the purpose. */
  .sf-dateline {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 0.7rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    margin-bottom: 0.55rem;
  }
  .sf-dateline-no {
    font-family: var(--font-display-condensed);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 0.85;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--color-accent) 55%, transparent);
  }
  .sf-dateline-stack { display: grid; gap: 0.12rem; }
  .sf-dateline-event {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1rem, 1.9vw, 1.25rem);
    line-height: 1.15;
    color: var(--color-peak);
  }
  /* The actual fix he asked for: the date was 0.68rem muted mono. Now larger,
     brighter, letterspaced, and no longer a typographic clone of the line
     above it. */
  .sf-dateline-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .sf-row-title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 560;
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    line-height: 1.2;
    color: var(--color-peak);
    margin-top: 0.2rem;
  }
  .sf-row-copy { font-size: 0.96rem; line-height: 1.55; color: var(--color-ink); max-width: 52ch; }
  .sf-row-cta {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .sf-row:hover .sf-row-cta .arrow,
  .sf-row:focus-visible .sf-row-cta .arrow { transform: translateX(4px); }
  .sf-row-cta .arrow { display: inline-block; transition: transform var(--dur-hover, 160ms) var(--ease-swift); }

  /* 01 — FEATURED: big image left, text right. The 2025 festival. */
  .sf-row--featured {
    grid-template-columns: 58fr 34fr;
  }
  /* 05 — FEATURED-FLIP: the mirror of 01. Same weight, opposite hand, so the
     two full festivals bookend the page and the sequence ends large instead
     of trailing off on the two smallest rows. */
  .sf-row--featured-flip {
    grid-template-columns: 34fr 58fr;
  }
  .sf-row--featured-flip .sf-row-media { order: 2; }
  .sf-row--featured-flip .sf-row-body { order: 1; }
  /* (The old `textonly` variant is gone — row 02 now carries the Devil in
     Disguise venue sign at thumb scale instead of standing in with a rule.) */

  /* 03 — BANNER: contained 2:1 band stacked above centered text */
  .sf-row--banner {
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 1.1rem;
  }
  .sf-row--banner .sf-row-media {
    width: min(100%, 30rem);
  }
  .sf-row--banner .sf-row-body {
    max-width: 38rem;
    text-align: center;
    justify-items: center;
  }
  /* 04 — THUMB: text left, small square thumbnail right (~200px) */
  .sf-row--thumb {
    grid-template-columns: 1fr 200px;
  }
  .sf-row--thumb .sf-row-media {
    order: 2;
    width: 200px;
  }
  .sf-row--thumb .sf-row-body {
    order: 1;
  }
  /* 05 — PORTRAIT: 4:5 image left at 20rem, text right */
  .sf-row--portrait {
    grid-template-columns: 20rem 1fr;
  }

  .sf-links { display: flex; flex-wrap: wrap; gap: 1.5rem; }

  @media (max-width: 760px) {
    .sf-row--featured,
    .sf-row--thumb,
    .sf-row--portrait {
      grid-template-columns: 1fr;
    }
    .sf-row--thumb .sf-row-media {
      order: 1;
      width: 200px;
    }
    .sf-row--thumb .sf-row-body {
      order: 2;
    }
    .sf-row--portrait .sf-row-media {
      width: min(80vw, 20rem);
    }
  }
</style>
