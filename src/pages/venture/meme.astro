---
/**
 * /venture/meme — P14b: the MEME story. Sibling to /venture/amazing-aerial
 * (same venture-article grammar: slate, italic title, LegendMark proof, short
 * paragraphs, external + back links). Typographic only — NO photos exist for
 * this relationship yet, so the page carries a ghost "M E M E" letter motif
 * (entertainment.astro's grammar) in place of a media collage.
 *
 * ⚠ OPERATOR READ-APPROVAL REQUIRED — the ARTICLE prose below is new copy,
 * ADAPTED from the operator's own published bio at meme.ngo/meet-the-team
 * (operator-approved source, 2026-07-12: "reference what it says on the
 * website", reasonable copy adaptation allowed). Staging-only until he reads
 * it. Fact base (verbatim from that page): title "Member At-Large"; role
 * "Strategic Liaison and Scout … first point of contact for new talent";
 * self-description "a StorySmith, adventurer, and market strategist dedicated
 * to the art of audience discovery"; founded Adventure Storytelling Media;
 * cinematic drone work in Switzerland and Italy; the Boulder startup scene.
 * Org: Makeshift Entertainment Media Education (MEME), a Colorado nonprofit.
 *
 * The relationship claim itself renders ONLY through LegendMark, from the
 * LOCKED permitted phrasing in consts (RELATIONSHIPS "meme" → "Member
 * At-Large, MEME …, a Colorado nonprofit"). Never overstated to Board Chair
 * (that is Amber MacPherson — see the honesty note in consts.ts).
 */
import Base from "../../layouts/Base.astro";
import LegendMark from "../../components/LegendMark.astro";
import { PAGES } from "../../consts";
import { existsSync, statSync } from "node:fs";
import { join } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meme = PAGES.entertainment.meme; // proof = { relationshipId: "meme" }

// ghost letterforms — the page's own subject, scattered as faint backdrop
// (presentational; assembles under the engine, sits still with no-JS).
const ghost = ["M", "E", "M", "E"];

// ── the operator's MEME logo animatic (scripts/make-meme-loop.sh) — an
// ambient, always-looping moment: the org's own animated mark, muted, sitting
// between the proof block and the article text. Existence-gated + cache-busted
// like the rest of the site's build-time media checks (see Tableaux.astro,
// ko-law-workshops.astro).
const loopDir = join(process.cwd(), "public", "media", "venture", "meme");
const lv = (file: string) => {
  try {
    return `?v=${Math.round(statSync(join(loopDir, file)).mtimeMs).toString(36)}`;
  } catch {
    return "";
  }
};
const loop = existsSync(join(loopDir, "meme-loop.mp4"))
  ? {
      mp4: `${base}/media/venture/meme/meme-loop.mp4${lv("meme-loop.mp4")}`,
      posterAvif: `${base}/media/venture/meme/meme-poster.avif${lv("meme-poster.avif")}`,
      posterWebp: `${base}/media/venture/meme/meme-poster.webp${lv("meme-poster.webp")}`,
    }
  : undefined;

// Build #6 (2026-08-01 archive-mining integration) — copy refresh only, per
// _INTEGRATION-PLAN.md §1.6 ("bones — no new page, no padding"). Source:
// _STORY-STAGING/meme-origin-story/STORY.md, itself flagged BONES by its own
// miner (no real event photography exists yet for MEME). Only the
// origin/mission paragraphs below are new; the two "my role" paragraphs
// above stay exactly as they were (the personal-voice exception, unchanged).
//
// DATE VERIFICATION (per the plan's explicit gate — "verify both dates
// against meme.ngo before they become sentences"):
//  - March 15, 2020 founding date: CONFIRMED directly against the live
//    meme.ngo/about page, which states in its own words "MEME was founded
//    on the Ides of March in 2020, just as COVID-19 was becoming a major
//    societal problem." Two internal documents already agreed; the public
//    site is now a third, independent match.
//  - "Traces its origin to a market in 2019": NOT corroborated anywhere on
//    meme.ngo (checked both the home and about pages) — single-sourced to
//    one internal AI-assisted strategy document per the miner's own
//    manifest. Per the honesty rule, DROPPED rather than shipped as fact.
//    The AFM-2017 photo this claim would have illustrated is separately
//    rights-flagged and not used either (see below).
const memeShots = {
  nick: pair("venture/meme/nick-goins-portrait-640"),
  steve: pair("venture/meme/steve-borne-portrait-854"),
  adam: pair("venture/meme/adam-smestad-portrait-620"),
  eric: pair("venture/meme/eric-abramson-portrait-700"),
};
function pair(relBase: string) {
  const avif = media(`${relBase}.avif`);
  const webp = media(`${relBase}.webp`);
  return avif || webp ? { avif, webp } : undefined;
}
function media(rel: string) {
  return existsSync(join(process.cwd(), "public", "media", ...rel.split("/"))) ? `${base}/media/${rel}` : undefined;
}
/**
 * 2026-08-03 EVERGREEN REBUILD (operator-directed, branch
 * meme-evergreen-2026-08-03). This section previously shipped THE CAMPAIGN —
 * the operator's own dated flyer renders for one specific term's programs
 * (Business of Show Business "Sat, Aug 15, 2026", the two on-demand sheets).
 * Operator, verbatim: "that'll date a lot of it... less 'hey it's this day at
 * this time at this location' and more 'here's what it is about usually'...
 * if we do another Business of Show Business it'll work the same way. Same
 * for Pitch Quorum and Market Fresh."
 *
 * So the flyers are retired from this page — nothing was deleted from
 * public/media/venture/meme/, this section just stops pointing at
 * bofsb-portrait / pitch-quorum-sheet / market-fresh-sheet — and replaced
 * with the evergreen program catalog: what each workshop covers and who
 * teaches it, grouped into three tracks, illustrated with NEW card art
 * (scripts/make-meme-evergreen.mjs) built from the site's own type (Anton /
 * Fraunces / DM Sans) plus a crop of MEME's own filmstrip-M logo mark — no
 * dates, times, venues, or prices anywhere on them.
 *
 * SOURCE: E:\Makeshift\MEME\05 - Source Docs from MEME\MEME Marketing.xlsx
 * ("Instructor & Program Details" sheet — Course Description column, MEME's
 * own words, paraphrased here into the evergreen register; "2026 Programs"
 * sheet for the current catalog list) and MEME Programatic Overview.pdf
 * (MEME's own evergreen-register catalog overview — used as the phrasing
 * model: format/session facts kept, calendar dates dropped). Nick C. Goins
 * Jr's bio field in that sheet names a company this site's build rules
 * forbid printing (see scripts/audit-lib.mjs's forbidden-terms list) — that
 * clause is omitted below without changing any other fact.
 *
 * ⚠ OPERATOR READ-APPROVAL REQUIRED — every program description below is new,
 * paraphrased copy, staging-only until read.
 */
const bakedCard = (slug: string) => pair(`venture/meme/${slug}-1600`) ?? pair(`venture/meme/${slug}-900`);
const programCard = (slug: string) => bakedCard(`program-${slug}`);

const PROGRAM_TRACKS = {
  "pitch-market": { label: "Pitch & Market", color: "#e0a52c" },
  "on-set": { label: "On-Set Craft", color: "#c9503f" },
  sound: { label: "Sound", color: "#38f8ec" },
} as const;

const PROGRAMS = [
  {
    slug: "pitch-quorum",
    track: "pitch-market",
    alt: "An evergreen MEME program card reading Pitch Quorum, Pitch & Market track, with a workshop description and instructor credit to Nick C. Goins Jr.",
  },
  {
    slug: "market-fresh",
    track: "pitch-market",
    alt: "An evergreen MEME program card reading Market Fresh, Pitch & Market track, with a workshop description and instructor credit to Nick C. Goins Jr.",
  },
  {
    slug: "business-of-show-business",
    track: "pitch-market",
    alt: "An evergreen MEME program card reading The Business of Show Business, Pitch & Market track, with a workshop description and instructor credit to Nick C. Goins Jr.",
  },
  {
    slug: "pa-workshop",
    track: "on-set",
    alt: "An evergreen MEME program card reading PA Workshop, On-Set Craft track, with a workshop description and instructor credit to Adam Smestad.",
  },
  {
    slug: "script-supervisor",
    track: "on-set",
    alt: "An evergreen MEME program card reading Script Supervisor Workshop, On-Set Craft track, with a workshop description and instructor credit to Adam Smestad.",
  },
  {
    slug: "carpenter",
    track: "on-set",
    alt: "An evergreen MEME program card reading The Carpenter Not the Tools, On-Set Craft track, with a workshop description and instructor credit to Eric Abramson.",
  },
  {
    slug: "sound-workshop",
    track: "sound",
    alt: "An evergreen MEME program card reading Sound Workshop, Sound track, with a description of the two-part workshop and instructor credit to Steve Borne.",
  },
] as const;

const PROGRAMS_INTRO = {
  kicker: "The programs",
  heading: "The workshops, not the flyer.",
  body: "MEME runs the same handful of workshops most years — sometimes remote, sometimes at the Boulder library, sometimes free. What follows is the shape of the catalog rather than any single term's schedule: what each program actually covers, and who's usually teaching it.",
  footnote:
    "Programs run on a rotating schedule. Current dates, cost, and registration live at meme.ngo — this page is the catalog, not the calendar.",
};

/**
 * 2026-08-03 EVERGREEN REBUILD (operator-directed): this grid previously
 * shipped as "who teaches the workshops" — 3 instructors, deliberately NOT
 * labelled as the team (see the 2026-08-02 correction preserved below, which
 * is still the reason Borne and Smestad are kept separate from the team
 * tier). The operator's direction now is to show the FULLER roster: "There
 * were other teachers and people involved in the organization — the fuller
 * roster should appear," while also not repeating a headshot: "I don't need
 * to see the exact same picture of Nick's head side by side."
 *
 * So this is now two tiers. TEAM = the five people on MEME's own team page
 * (meme.ngo/meet-the-team, re-verified 2026-08-03), each row picturing that
 * person exactly once and crediting what they teach where applicable (Nick,
 * Eric). INSTRUCTOR_CREDITS = the working professionals confirmed as
 * instructors in the xlsx who are NOT on the team page (Adam, Steve) — shown
 * once, below, rather than duplicated in the team tier.
 *
 * Eric Abramson's photo is new this build (scripts/make-meme-evergreen.mjs,
 * cropped from his only photo on file — a work selfie that also shows an
 * unrelated interview subject in the background; the crop excludes that
 * person entirely). Amber MacPherson's two headshots (color + B/W) both
 * carry a visible "April O'Hare Photography" watermark with the credit
 * unconfirmed — same flag the prior build raised — so her row stays
 * text-only, like Shaun Michael Ellis (no photo on file at all). Sindbad's
 * row carries no photo by house rule and keeps the locked, modest phrasing:
 * "Member At-Large, MEME."
 */
const TEAM = [
  {
    key: "nick",
    name: "Nick C. Goins Jr",
    role: "Executive Director & Founder.",
    bio: "Has worked in the film industry in various capacities since making his first feature at 16 — critic, writer, director, producer, graphic artist. Teaches MEME's flagship Pitch Quorum and Market Fresh programs himself.",
    alt: "Close portrait of Nick C. Goins Jr wearing a plaid flat cap, black t-shirt, looking directly at camera.",
  },
  { key: null, name: "Amber MacPherson", role: "Board Chair & Admin.", bio: null, alt: null },
  {
    key: "eric",
    name: "Eric Abramson",
    role: "Member At-Large.",
    bio: "A filmmaker and firefighter — documentary, music video, and live-event work aired on outlets including MTV, ESPN, and PBS, alongside years fighting wildland fires across the American West. Teaches The Carpenter Not the Tools.",
    alt: "Eric Abramson on a shoot, wearing a ballcap and headphones, camera and monitor visible beside him.",
  },
  { key: null, name: "Shaun Michael Ellis", role: "Member At-Large. Producer and screenwriter.", bio: null, alt: null },
  { key: null, name: "Sindbad Horizon", role: "Member At-Large, MEME.", bio: null, alt: null },
] as const;

const INSTRUCTOR_CREDITS = [
  {
    key: "adam",
    name: "Adam Smestad",
    bio: "Teaches the PA and Script Supervisor workshops. A writer, director, and producer who's worked more than 50 film, TV, and commercial sets — as a PA, and in the art department, camera department, sound, G&E, and craft services — after leaving a career in law in 2018.",
    alt: "Studio portrait of Adam Smestad, bald, short beard, smiling, black blazer, gray backdrop.",
  },
  {
    key: "steve",
    name: "Steve Borne",
    bio: "Teaches the two-part Sound Workshop. A film and TV sound designer for more than 35 years, with two Emmy awards for TV sound mixing, credits alongside directors from Harmony Korine to Robert Altman, and recording work with musicians including Jerry Garcia and Tom Petty.",
    alt: "Portrait of Steve Borne, bald, glasses, gray beard, dark sweater, softly lit interior background.",
  },
] as const;

// ── THE ARTICLE (all new sentences — see the approval note above) ──
const ARTICLE = {
  slate: "MEME · MAKESHIFT ENTERTAINMENT MEDIA EDUCATION",
  title: "The most formal role I hold in this world.",
  paragraphs: [
    "MEME — Makeshift Entertainment Media Education — is a Colorado nonprofit, and it holds the most formal title I carry anywhere: Member At-Large.",
    "The work is to be a Strategic Liaison and Scout — often the first point of contact for new talent. I look for storytellers worth backing, and help them find a way in.",
    // Build #6 — replaces the prior generic mission line with the
    // organization's own verified founding fact (meme.ngo/about, quoted
    // above) plus its actual teaching focus, sourced from the internal
    // playbook + one-pager (cross-checked, matching on every fact used).
    "MEME was founded on March 15, 2020 — the Ides of March, as the organization's own site puts it — just as COVID-19 was becoming a major societal problem. What it teaches is deliberately narrow: not directing, not cinematography — film schools already do that — but the business side of filmmaking that founders rarely get taught anywhere. The goal is to keep Colorado's filmmaking talent, and the projects it makes, from having to leave the state to get made.",
    // Build #6 — new roster paragraph, first person (matches this page's
    // established voice), names the instructors the roster grid below
    // pictures. Facts: Playbook Appendix + MEME_OnePager.html, matching.
    // 2026-08-02 correction (operator): the previous version blurred MEME's
    // TEAM with the people who teach its workshops. Per meme.ngo/meet-the-team
    // the team is five: Nick C. Goins Jr (Executive Director & Founder), Amber
    // MacPherson (Board Chair & Admin), and three Members At-Large — Eric
    // Abramson, Shaun Michael Ellis, and me. Steve Borne and Adam Smestad have
    // taught workshops; they are NOT on the team page, and the copy must not
    // imply they are.
    "Nick C. Goins Jr founded MEME and runs it as Executive Director; Amber MacPherson chairs the board. Alongside me there are two other Members At-Large, Eric Abramson and Shaun Michael Ellis. The workshops themselves are taught by working professionals brought in for them — which is the point, since the whole idea is to put people in front of the ones already doing the job.",
    "It runs on the same instinct as everything else this studio makes: a StorySmith's read on what an audience will feel, and a market strategist's read on who that audience actually is.",
  ],
  ctas: [
    { label: "About the organization →", href: "https://www.meme.ngo", external: true },
    { label: "See the venture lane →", href: `${base}/venture`, external: false },
  ],
};
---

<Base title="MEME — a venture story" description="Member At-Large at MEME (Makeshift Entertainment Media Education), a Colorado nonprofit: Strategic Liaison and Scout for new storytellers.">
  <main class="meme-story">
    <div class="meme-ghosts" aria-hidden="true">
      {ghost.map((ch, i) => <span class="meme-ghost" data-im-ghost style={`--gi:${i}`}>{ch}</span>)}
    </div>
    <article class="meme-inner">
      <a href={`${base}/venture`} class="link meme-back">← Venture</a>
      <p class="hud-label meme-slate" data-reveal data-tableau-content>
        <span data-decode>{ARTICLE.slate}</span>
      </p>
      <h1 class="meme-title" data-reveal>{ARTICLE.title}</h1>
      <div class="meme-proof" data-reveal>
        <LegendMark proof={meme.proof} />
      </div>

      {
        loop && (
          <figure class="meme-loop-wrap" data-reveal>
            <div class="meme-loop-frame">
              <picture>
                <source type="image/avif" srcset={loop.posterAvif} />
                <img class="meme-loop-poster" src={loop.posterWebp} alt="The MEME logo — a filmstrip-lettered M, on a deep blue textured ground." loading="lazy" decoding="async" />
              </picture>
              <video
                class="meme-loop-vid"
                data-meme-loop
                muted
                loop
                playsinline
                preload="metadata"
                poster={loop.posterWebp}
                aria-hidden="true"
              >
                <source src={loop.mp4} type="video/mp4" />
              </video>
            </div>
            {/* ⚠ OPERATOR READ-APPROVAL REQUIRED — new copy, staging-only until read. */}
            <figcaption class="hud-label meme-loop-cap">MEME's own animated mark, in motion</figcaption>
          </figure>
        )
      }

      <!-- LAYOUT-OVERHAUL P5 (2026-08-01, see LAYOUT-RESEQUENCE-PLAN.md):
           the 6-paragraph stretch gets one typographic beat — a full-width
           pull quote after the founding-fact paragraph (Atavist device 8),
           and an asterisk divider before the roster (device 6). No new
           imagery; this is a bones page and stays one.
           ⚠ OPERATOR READ-APPROVAL REQUIRED — the pull quote is new visible
           copy (a tightened reprise of the paragraph above it; facts
           unchanged), staging-only until read. -->
      {ARTICLE.paragraphs.slice(0, 3).map((para) => <p class="meme-para" data-reveal>{para}</p>)}
      <blockquote class="meme-pull" data-reveal>
        Founded on the Ides of March, 2020 — built so Colorado's filmmaking talent doesn't have to leave the state.
      </blockquote>
      {ARTICLE.paragraphs.slice(3).map((para) => <p class="meme-para" data-reveal>{para}</p>)}

      <p class="meme-break" aria-hidden="true">✳</p>

      {/* 2026-08-03 EVERGREEN REBUILD — the program catalog, grouped into
          three tracks, replacing the retired dated-campaign poster wall. */}
      {/* ⚠ OPERATOR READ-APPROVAL REQUIRED — new heading, intro, and program
          card copy below, staging-only until read. */}
      <section class="meme-programs" aria-label="MEME's program catalog">
        <p class="hud-label meme-kicker">{PROGRAMS_INTRO.kicker}</p>
        <h2 class="meme-h2">{PROGRAMS_INTRO.heading}</h2>
        <p class="meme-para">{PROGRAMS_INTRO.body}</p>

        <div class="meme-track" data-track="pitch-market">
          <p class="hud-label meme-track-label" style={`--track-color:${PROGRAM_TRACKS["pitch-market"].color}`}>
            {PROGRAM_TRACKS["pitch-market"].label}
          </p>
          <div class="meme-program-grid">
            {PROGRAMS.filter((p) => p.track === "pitch-market").map((c) => {
              const m = programCard(c.slug);
              return m ? (
                <figure class="meme-program-card">
                  <picture>
                    {m.avif && <source srcset={m.avif} type="image/avif" />}
                    <img src={m.webp ?? m.avif} alt={c.alt} loading="lazy" decoding="async" />
                  </picture>
                </figure>
              ) : null;
            })}
          </div>
        </div>

        <div class="meme-track" data-track="on-set">
          <p class="hud-label meme-track-label" style={`--track-color:${PROGRAM_TRACKS["on-set"].color}`}>
            {PROGRAM_TRACKS["on-set"].label}
          </p>
          <div class="meme-program-grid">
            {PROGRAMS.filter((p) => p.track === "on-set").map((c) => {
              const m = programCard(c.slug);
              return m ? (
                <figure class="meme-program-card">
                  <picture>
                    {m.avif && <source srcset={m.avif} type="image/avif" />}
                    <img src={m.webp ?? m.avif} alt={c.alt} loading="lazy" decoding="async" />
                  </picture>
                </figure>
              ) : null;
            })}
            <!-- CARPENTER-RECORDING-SEGMENT: integration point -->
          </div>
        </div>

        <div class="meme-track" data-track="sound">
          <p class="hud-label meme-track-label" style={`--track-color:${PROGRAM_TRACKS["sound"].color}`}>
            {PROGRAM_TRACKS["sound"].label}
          </p>
          <div class="meme-program-grid">
            {PROGRAMS.filter((p) => p.track === "sound").map((c) => {
              const m = programCard(c.slug);
              return m ? (
                <figure class="meme-program-card">
                  <picture>
                    {m.avif && <source srcset={m.avif} type="image/avif" />}
                    <img src={m.webp ?? m.avif} alt={c.alt} loading="lazy" decoding="async" />
                  </picture>
                </figure>
              ) : null;
            })}
          </div>
        </div>

        <p class="meme-footnote">{PROGRAMS_INTRO.footnote}</p>
      </section>

      {/* 2026-08-03 EVERGREEN REBUILD — the people, in two tiers: MEME's own
          team (each pictured once, credited with what they teach where the
          xlsx confirms it), then the working professionals confirmed as
          instructors who are NOT on the team page. See the header note above
          TEAM for the Amber MacPherson photo-rights flag and the Sindbad
          house rule. */}
      {/* ⚠ OPERATOR READ-APPROVAL REQUIRED — new heading + bio copy below,
          staging-only until read. */}
      <p class="hud-label meme-kicker" data-reveal>The people</p>
      <h2 class="meme-h2" data-reveal>Who's actually behind it.</h2>

      <p class="hud-label meme-track-label" data-reveal>The team</p>
      <div class="meme-roster" data-reveal aria-label="MEME's team">
        {
          TEAM.map((p) => {
            const shot = p.key ? memeShots[p.key as keyof typeof memeShots] : undefined;
            return (
              <figure class:list={["meme-roster-card", { "meme-roster-card--text": !shot }]}>
                {shot && (
                  <picture>
                    {shot.avif && <source srcset={shot.avif} type="image/avif" />}
                    <img src={shot.webp ?? shot.avif} alt={p.alt!} loading="lazy" decoding="async" />
                  </picture>
                )}
                <figcaption>
                  <span class="meme-roster-name">{p.name}</span>
                  <span class="meme-roster-role">{p.role}</span>
                  {p.bio && <span class="meme-roster-bio">{p.bio}</span>}
                </figcaption>
              </figure>
            );
          })
        }
      </div>

      <p class="hud-label meme-track-label" data-reveal>Also teaching</p>
      <div class="meme-roster meme-roster--instructors" data-reveal aria-label="Other MEME workshop instructors, not on the team page">
        {
          INSTRUCTOR_CREDITS.map((p) => {
            const shot = memeShots[p.key as keyof typeof memeShots];
            return shot ? (
              <figure class="meme-roster-card">
                <picture>
                  {shot.avif && <source srcset={shot.avif} type="image/avif" />}
                  <img src={shot.webp ?? shot.avif} alt={p.alt} loading="lazy" decoding="async" />
                </picture>
                <figcaption>
                  <span class="meme-roster-name">{p.name}</span>
                  <span class="meme-roster-bio">{p.bio}</span>
                </figcaption>
              </figure>
            ) : null;
          })
        }
      </div>
      <p class="meme-footnote" data-reveal>
        The team is MEME's own (meme.ngo/meet-the-team); instructors are working
        professionals brought in to teach a session, not the board.
      </p>

      <nav class="meme-ctas" data-reveal>
        {
          ARTICLE.ctas.map((c) => (
            <a href={c.href} class="link" rel={c.external ? "noopener" : undefined} target={c.external ? "_blank" : undefined}>
              {c.label}
            </a>
          ))
        }
      </nav>
      <a href={`${base}/venture`} class="link meme-back">← Venture</a>
    </article>
  </main>
</Base>

<style>
  .meme-story {
    position: relative;
    background: #0e2230; /* entertainment chapter 03 (MEME) ground — same room */
    min-height: 100svh;
    overflow: clip;
  }
  .meme-inner {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    margin-inline: auto;
    padding: 7rem 2rem 6rem;
    display: grid;
    gap: 1.5rem;
  }
  .meme-back {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .meme-slate {
    letter-spacing: 0.24em;
    color: color-mix(in srgb, #d9f2ec 75%, transparent);
  }
  .meme-title {
    font-family: var(--font-display);
    font-weight: 560;
    font-style: italic;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.12;
    color: #f2f4f8;
  }
  .meme-para {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.65;
    color: color-mix(in srgb, #eef2f5 86%, transparent);
  }

  /* ambient logo loop — a framed moment between the proof and the article,
     the org's own animated mark, always playing (never a hover trigger).
     Native 16:9 source, so aspect-ratio + object-fit:cover crops nothing.
     Poster image is the permanent base layer (no-JS / reduced-motion /
     autoplay-refused all land here); the video fades in over it once JS
     confirms motion is allowed and the figure is on-screen. */
  .meme-loop-wrap {
    margin: 0.2rem 0 0;
  }
  .meme-loop-frame {
    position: relative;
    border: 1px solid color-mix(in srgb, #ffffff 14%, transparent);
    border-radius: 8px;
    overflow: hidden;
    background: color-mix(in srgb, #ffffff 4%, transparent);
    box-shadow: 0 0 32px -12px color-mix(in srgb, var(--color-accent, #38f8ec) 35%, transparent);
  }
  .meme-loop-poster {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .meme-loop-vid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 600ms var(--ease-survey, ease);
  }
  .meme-loop-frame.is-playing .meme-loop-vid {
    opacity: 1;
  }
  /* Caption sits BELOW the frame, not over it: the poster art carries its own
     baked-in "A NOT-FOR-PROFIT COMPANY" line along the bottom edge, and an
     overlaid caption landed on top of it (white-on-white). */
  .meme-loop-cap {
    display: block;
    margin: 0.55rem 0 0;
    letter-spacing: 0.18em;
    color: var(--color-ink-muted, #8a9a96);
  }
  @media (prefers-reduced-motion: reduce) {
    .meme-loop-vid {
      transition: none;
    }
  }
  /* P5 — the one typographic beat in the text stretch: a plain full-width
     pull quote (no panel, no border — the Atavist device) */
  .meme-pull {
    margin: 0.6rem 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 560;
    font-size: clamp(1.35rem, 2.8vw, 1.9rem);
    line-height: 1.35;
    text-align: center;
    color: #f2f4f8;
  }
  /* P5 — bare asterisk chapter break before the roster (device 6) */
  .meme-break {
    margin: 0.4rem 0 0;
    text-align: center;
    font-size: 1.1rem;
    color: color-mix(in srgb, #d9f2ec 45%, transparent);
    letter-spacing: 0;
  }
  /* ── 2026-08-03 EVERGREEN REBUILD · THE PROGRAM CATALOG ──────────────────
     replaces the retired dated-flyer poster wall. Three tracks, each its own
     small kicker (color set per-track via --track-color), cards laid out in
     a simple responsive grid rather than the old unequal-rank poster wall —
     a catalog reads as a catalog, not as a hierarchy of "next up". */
  .meme-programs {
    display: grid;
    gap: 1.1rem;
    margin: 0.6rem 0 0.4rem;
    padding-top: 1.6rem;
    border-top: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
  }
  .meme-kicker {
    letter-spacing: 0.26em;
    color: color-mix(in srgb, var(--color-accent, #38f8ec) 85%, transparent);
  }
  .meme-h2 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 560;
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    line-height: 1.15;
    color: #f2f4f8;
    margin-bottom: 0.2rem;
  }
  .meme-track {
    display: grid;
    gap: 0.7rem;
    margin-top: 0.5rem;
  }
  .meme-track-label {
    letter-spacing: 0.22em;
    color: color-mix(in srgb, var(--track-color, var(--color-accent, #38f8ec)) 82%, transparent);
  }
  .meme-program-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.1rem;
  }
  .meme-program-card {
    margin: 0;
  }
  .meme-program-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, #ffffff 14%, transparent);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.35);
  }
  .meme-footnote {
    font-size: 0.72rem;
    line-height: 1.5;
    color: color-mix(in srgb, #eef2f5 55%, transparent);
  }

  /* 2026-08-03 EVERGREEN REBUILD — roster grid grown from 3 headshots to the
     full team tier (5, one text-only row per missing/unconfirmed photo) plus
     a second, narrower instructor tier (2). Still a masthead/contributors
     block (~11rem cells, centered), deliberately smaller than a gallery so it
     reads as credits, not imagery. */
  .meme-roster {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 0.4rem auto 0.2rem;
    max-width: 36rem;
    width: 100%;
  }
  .meme-roster--instructors {
    grid-template-columns: repeat(2, 1fr);
    max-width: 24rem;
  }
  .meme-roster-card {
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .meme-roster-card img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, #ffffff 14%, transparent);
  }
  /* text-only rows (Amber, Shaun, Sindbad — see the TEAM header note for why
     no photo) get a bordered placeholder the same footprint as a photo card,
     so the grid rhythm holds without faking imagery that doesn't exist. */
  .meme-roster-card--text figcaption {
    aspect-ratio: 1 / 1;
    border: 1px dashed color-mix(in srgb, #ffffff 18%, transparent);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 0.9rem;
    gap: 0.3rem;
  }
  .meme-roster-card figcaption {
    display: grid;
    gap: 0.2rem;
  }
  .meme-roster-name {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: #f2f4f8;
  }
  .meme-roster-role {
    font-size: 0.78rem;
    line-height: 1.4;
    color: color-mix(in srgb, #eef2f5 70%, transparent);
  }
  .meme-roster-bio {
    font-size: 0.74rem;
    line-height: 1.45;
    color: color-mix(in srgb, #eef2f5 62%, transparent);
  }
  @media (max-width: 640px) {
    .meme-roster { grid-template-columns: 1fr 1fr; }
  }

  .meme-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    border-top: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
    padding-top: 1.4rem;
    margin-top: 0.6rem;
  }

  /* ghost "M E M E" — faint letterforms behind the column (no-JS = at rest) */
  .meme-ghosts {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .meme-ghost {
    position: absolute;
    font-family: var(--font-sans);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(6rem, 18vw, 16rem);
    line-height: 1;
    color: color-mix(in srgb, #ffffff 5%, transparent);
  }
  .meme-ghost:nth-child(1) { left: 4%; top: 12%; }
  .meme-ghost:nth-child(2) { right: 8%; top: 30%; }
  .meme-ghost:nth-child(3) { left: 10%; bottom: 18%; }
  .meme-ghost:nth-child(4) { right: 4%; bottom: 8%; }

  @media (max-width: 640px) {
    .meme-ghost { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .meme-ghost { transform: none !important; }
  }
</style>

<script>
  // enhancement only: decode the slate label, and let the ghost letters drift
  // in and settle (their resting positions already live in CSS, so no-JS and
  // reduced-motion see the final, correct layout).
  const mountDecode = () => import("../../lib/decode-text").then(({ mountDecode }) => mountDecode(document));
  if ("requestIdleCallback" in window) requestIdleCallback(mountDecode, { timeout: 3000 });
  else setTimeout(mountDecode, 1500);

  (async () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia("(max-width: 640px)").matches) return;
    const { gsap } = await import("gsap");
    document.querySelectorAll<HTMLElement>("[data-im-ghost]").forEach((g, i) => {
      const dx = (i % 2 ? 1 : -1) * (36 + (i % 3) * 24);
      gsap.fromTo(
        g,
        { x: dx, y: 48, opacity: 0 },
        {
          x: 0,
          y: 0,
          opacity: 1,
          duration: 1.1,
          ease: "power3.out",
          delay: i * 0.08,
          onComplete: () => {
            gsap.to(g, {
              y: (i % 2 ? -1 : 1) * 10,
              duration: 5 + (i % 3) * 1.5,
              ease: "sine.inOut",
              yoyo: true,
              repeat: -1,
            });
          },
        },
      );
    });
  })();

  // ambient logo loop (P14b) — plays only when motion is allowed and the
  // figure is actually on-screen; the poster image underneath is the
  // permanent base layer, so reduced-motion / no-JS / autoplay-refused all
  // just show the still. Mirrors HeroVideo.astro's poster-first contract:
  // no native `autoplay`/`src`-at-parse-time, JS decides, muted always.
  (() => {
    const wrap = document.querySelector<HTMLElement>(".meme-loop-frame");
    const video = wrap?.querySelector<HTMLVideoElement>("[data-meme-loop]");
    if (!wrap || !video) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const conn = (navigator as { connection?: { saveData?: boolean } }).connection;
    if (conn?.saveData) return;

    video.addEventListener("playing", () => wrap.classList.add("is-playing"));

    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        if (entry.isIntersecting) video.play().catch(() => {}); // refusal → poster stands
        else video.pause();
      },
      { threshold: 0.2 },
    );
    io.observe(wrap);
    window.addEventListener("pagehide", () => io.disconnect(), { once: true });
  })();
</script>
