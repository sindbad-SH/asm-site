 * the operator's own dated flyer renders for one specific term's programs
 * (Business of Show Business "Sat, Aug 15, 2026", the two on-demand sheets).
 * Operator, verbatim: "that'll date a lot of it... less 'hey it's this day at
 * this time at this location' and more 'here's what it is about usually'...
 * if we do another Business of Show Business it'll work the same way. Same
 * for Pitch Quorum and Market Fresh."
 *
 * So the flyers are retired from this page — nothing was deleted from
 * public/media/venture/meme/, this section just stops pointing at
 * bofsb-portrait / pitch-quorum-sheet / market-fresh-sheet — and replaced
 * with the evergreen program catalog: what each workshop covers and who
 * teaches it, grouped into three tracks, illustrated with NEW card art
 * (scripts/make-meme-evergreen.mjs) built from the site's own type (Anton /
 * Fraunces / DM Sans) plus a crop of MEME's own filmstrip-M logo mark — no
 * dates, times, venues, or prices anywhere on them.
 *
 * SOURCE: E:\Makeshift\MEME\05 - Source Docs from MEME\MEME Marketing.xlsx
 * ("Instructor & Program Details" sheet — Course Description column, MEME's
 * own words, paraphrased here into the evergreen register; "2026 Programs"
 * sheet for the current catalog list) and MEME Programatic Overview.pdf
 * (MEME's own evergreen-register catalog overview — used as the phrasing
 * model: format/session facts kept, calendar dates dropped). Nick C. Goins
 * Jr's bio field in that sheet names a company this site's build rules
 * forbid printing (see scripts/audit-lib.mjs's forbidden-terms list) — that
 * clause is omitted below without changing any other fact.
 *
 * ⚠ OPERATOR READ-APPROVAL REQUIRED — every program description below is new,
 * paraphrased copy, staging-only until read.
 */
const bakedCard = (slug: string) => pair(`venture/meme/${slug}-1600`) ?? pair(`venture/meme/${slug}-900`);
const programCard = (slug: string) => bakedCard(`program-${slug}`);

const PROGRAM_TRACKS = {
