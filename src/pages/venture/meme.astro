---
/**
 * /venture/meme — P14b: the MEME story. Sibling to /venture/amazing-aerial
 * (same venture-article grammar: slate, italic title, LegendMark proof, short
 * paragraphs, external + back links). Typographic only — NO photos exist for
 * this relationship yet, so the page carries a ghost "M E M E" letter motif
 * (entertainment.astro's grammar) in place of a media collage.
 *
 * ⚠ OPERATOR READ-APPROVAL REQUIRED — the ARTICLE prose below is new copy,
 * ADAPTED from the operator's own published bio at meme.ngo/meet-the-team
 * (operator-approved source, 2026-07-12: "reference what it says on the
 * website", reasonable copy adaptation allowed). Staging-only until he reads
 * it. Fact base (verbatim from that page): title "Member At-Large"; role
 * "Strategic Liaison and Scout … first point of contact for new talent";
 * self-description "a StorySmith, adventurer, and market strategist dedicated
 * to the art of audience discovery"; founded Adventure Storytelling Media;
 * cinematic drone work in Switzerland and Italy; the Boulder startup scene.
 * Org: Makeshift Entertainment Media Education (MEME), a Colorado nonprofit.
 *
 * The relationship claim itself renders ONLY through LegendMark, from the
 * LOCKED permitted phrasing in consts (RELATIONSHIPS "meme" → "Member
 * At-Large, MEME …, a Colorado nonprofit"). Never overstated to Board Chair
 * (that is Amber MacPherson — see the honesty note in consts.ts).
 */
import Base from "../../layouts/Base.astro";
import LegendMark from "../../components/LegendMark.astro";
import { PAGES } from "../../consts";
import { existsSync, statSync } from "node:fs";
import { join } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meme = PAGES.entertainment.meme; // proof = { relationshipId: "meme" }

// ghost letterforms — the page's own subject, scattered as faint backdrop
// (presentational; assembles under the engine, sits still with no-JS).
const ghost = ["M", "E", "M", "E"];

// ── the operator's MEME logo animatic (scripts/make-meme-loop.sh) — an
// ambient, always-looping moment: the org's own animated mark, muted, sitting
// between the proof block and the article text. Existence-gated + cache-busted
// like the rest of the site's build-time media checks (see Tableaux.astro,
// ko-law-workshops.astro).
const loopDir = join(process.cwd(), "public", "media", "venture", "meme");
const lv = (file: string) => {
  try {
    return `?v=${Math.round(statSync(join(loopDir, file)).mtimeMs).toString(36)}`;
  } catch {
    return "";
  }
};
const loop = existsSync(join(loopDir, "meme-loop.mp4"))
  ? {
      mp4: `${base}/media/venture/meme/meme-loop.mp4${lv("meme-loop.mp4")}`,
      posterAvif: `${base}/media/venture/meme/meme-poster.avif${lv("meme-poster.avif")}`,
      posterWebp: `${base}/media/venture/meme/meme-poster.webp${lv("meme-poster.webp")}`,
    }
  : undefined;

// Build #6 (2026-08-01 archive-mining integration) — copy refresh only, per
// _INTEGRATION-PLAN.md §1.6 ("bones — no new page, no padding"). Source:
// _STORY-STAGING/meme-origin-story/STORY.md, itself flagged BONES by its own
// miner (no real event photography exists yet for MEME). Only the
// origin/mission paragraphs below are new; the two "my role" paragraphs
// above stay exactly as they were (the personal-voice exception, unchanged).
//
// DATE VERIFICATION (per the plan's explicit gate — "verify both dates
// against meme.ngo before they become sentences"):
//  - March 15, 2020 founding date: CONFIRMED directly against the live
//    meme.ngo/about page, which states in its own words "MEME was founded
//    on the Ides of March in 2020, just as COVID-19 was becoming a major
//    societal problem." Two internal documents already agreed; the public
//    site is now a third, independent match.
//  - "Traces its origin to a market in 2019": NOT corroborated anywhere on
//    meme.ngo (checked both the home and about pages) — single-sourced to
//    one internal AI-assisted strategy document per the miner's own
//    manifest. Per the honesty rule, DROPPED rather than shipped as fact.
//    The AFM-2017 photo this claim would have illustrated is separately
//    rights-flagged and not used either (see below).
const memeShots = {
  nick: pair("venture/meme/nick-goins-portrait-640"),
  steve: pair("venture/meme/steve-borne-portrait-854"),
  adam: pair("venture/meme/adam-smestad-portrait-620"),
};
function pair(relBase: string) {
  const avif = media(`${relBase}.avif`);
  const webp = media(`${relBase}.webp`);
  return avif || webp ? { avif, webp } : undefined;
}
function media(rel: string) {
  return existsSync(join(process.cwd(), "public", "media", ...rel.split("/"))) ? `${base}/media/${rel}` : undefined;
}
/**
 * v3 (2026-08-01) — THE CAMPAIGN. This page previously shipped as a
 * typographic "bones" page on the stated grounds that no MEME imagery
 * existed. That was wrong: the operator BUILDS MEME's current campaign
 * artwork (E:\Makeshift\MEME — a code-rendered flyer family, five social
 * formats per program plus animated cuts, QR-gated), and those renders are
 * his own work product. They are now the page's evidence: what "Strategic
 * Liaison and Scout" looks like in practice is, among other things, the
 * poster that fills the room. Baked by scripts/make-meme-campaign.mjs.
 *
 * HONESTY: these are HIS renders for MEME, shown as his work — the page
 * never claims authorship of MEME's brand, its programs, or its curriculum,
 * and it does not display MEME's own earlier materials as a "before".
 * Program facts (dates, venue, instructor, format) are quoted from the
 * campaign copy packs in that repo, which are the approved event copy.
 */
/**
 * 2026-08-02 (operator): only campaigns for programs that are ACTUALLY LIVE may
 * appear here. Crew Call was pulled — its flyers are built but the event has
 * not been announced, and showing unannounced client material as portfolio
 * both front-runs MEME's own announcement and misrepresents what is running.
 * The three that remain are live: Business of Show Business (Sat Aug 15) and
 * the two year-round on-demand programs.
 */
const campaign = (slug: string) => pair(`venture/meme/${slug}-1600`) ?? pair(`venture/meme/${slug}-900`);
const bofsbPortrait = campaign("bofsb-portrait");
const pitchQuorumSheet = campaign("pitch-quorum-sheet");
const marketFreshSheet = campaign("market-fresh-sheet");

// ⚠ OPERATOR READ-APPROVAL REQUIRED — new visible copy (staging-only until
// read). Every program fact below is quoted from the approved copy packs in
// E:\Makeshift\MEME (BofSB Aug-2026 pack; On-Demand PQ/MF pack).
const CAMPAIGN = {
  kicker: "The work",
  heading: "Somebody has to fill the room.",
  body: [
    "A nonprofit workshop only works if people show up to it. That part isn't teaching — it's a poster, a date, a QR code that goes somewhere, and the same look holding across every format a platform will ask you for.",
    "So that's the part I build. Each program gets a rendered flyer family — feed, portrait, story, link card, registration banner — plus a seven-second animated cut of each, generated from code rather than redrawn by hand, so a date change is a re-render instead of a redesign.",
  ],
  items: [
    {
      media: () => bofsbPortrait,
      slug: "bofsb-portrait",
      label: "The Business of Show Business",
      meta: "Sat, Aug 15, 2026 · 1:00 PM · Mike's Camera, Boulder",
      note: "A 90-minute in-person workshop on the state of the film industry from a business perspective, taught by producer Nick C. Goins Jr. Co-branded with the host venue.",
      alt: "A magazine-cover-style flyer headed MEME, reading The Business of Show Business, with a portrait of instructor Nick C. Goins Jr., the date Sat Aug 15, and a QR code.",
    },
    {
      media: () => pitchQuorumSheet,
      slug: "pitch-quorum-sheet",
      label: "Pitch Quorum",
      meta: "Live session · remote or in person · scheduled on request",
      note: "\u201CA great script doesn't get funded. A great pitch does.\u201D Packaging and pitching a film project to the people who fund films.",
      alt: "A program sheet headed MEME with an ON DEMAND badge, reading A great script doesn't get funded — a great pitch does.",
    },
    {
      media: () => marketFreshSheet,
      slug: "market-fresh-sheet",
      label: "Market Fresh",
      meta: "Live session · remote or in person · scheduled on request",
      note: "\u201CA badge isn't a strategy.\u201D What to prepare before a film market like AFM, who to meet there, and the follow-through afterwards.",
      alt: "A program sheet headed MEME with an ON DEMAND badge, reading A badge isn't a strategy — walk in ready to work it.",
    },
  ],
  footnote:
    "Rendered from the campaign repo, five formats per program plus animated cuts. Registration links and any co-brand sign-off stay MEME's call.",
};

/**
 * 2026-08-02 CORRECTION (operator-directed, verified against
 * https://www.meme.ngo/meet-the-team):
 *
 * This grid previously ran as an unlabelled roster of Nick Goins + Steve Borne
 * + Adam Smestad, which read as "the MEME team". It is not. MEME's own team
 * page lists FIVE people — Nick C. Goins Jr (Executive Director & Founder),
 * Amber MacPherson (Board Chair & Admin), and three Members At-Large: Eric
 * Abramson, Shaun Michael Ellis, and Sindbad. Borne and Smestad appear
 * nowhere on it; they are working professionals who have TAUGHT workshops.
 * Presenting a guest instructor as organisational leadership overstates their
 * relationship to the nonprofit and misrepresents its actual governance.
 *
 * So the section is now explicitly "who teaches the workshops", the titles are
 * exact, and the copy points at MEME's own team page for the team itself. The
 * team is described in prose (above) rather than pictured, because the
 * remaining headshots are not clean: Amber MacPherson's carries a visible
 * "April O'Hare Photography" watermark with credit unconfirmed, and there is
 * no Shaun Michael Ellis portrait on file at all. A half-complete leadership
 * grid would be worse than none.
 */
const INSTRUCTORS = [
  { key: "nick", name: "Nick C. Goins Jr", role: "Executive Director & Founder. Teaches the flagship programs — Pitch Quorum and Market Fresh — himself.", alt: "Close portrait of Nick C. Goins Jr wearing a plaid flat cap, black t-shirt, looking directly at camera." },
  { key: "steve", name: "Steve Borne", role: "Has taught the two-part sound workshop — setting a shoot up for success on location, and what happens to that audio in post.", alt: "Portrait of Steve Borne, bald, glasses, gray beard, dark sweater, softly lit interior background." },
  { key: "adam", name: "Adam Smestad", role: "Has taught the production-assistant and script-supervisor workshops — the on-set roles most people learn by getting yelled at until they figure it out.", alt: "Studio portrait of Adam Smestad, bald, short beard, smiling, black blazer, gray backdrop." },
] as const;

// ── THE ARTICLE (all new sentences — see the approval note above) ──
const ARTICLE = {
  slate: "MEME · MAKESHIFT ENTERTAINMENT MEDIA EDUCATION",
  title: "The most formal role I hold in this world.",
  paragraphs: [
    "MEME — Makeshift Entertainment Media Education — is a Colorado nonprofit, and it holds the most formal title I carry anywhere: Member At-Large.",
    "The work is to be a Strategic Liaison and Scout — often the first point of contact for new talent. I look for storytellers worth backing, and help them find a way in.",
    // Build #6 — replaces the prior generic mission line with the
    // organization's own verified founding fact (meme.ngo/about, quoted
    // above) plus its actual teaching focus, sourced from the internal
    // playbook + one-pager (cross-checked, matching on every fact used).
    "MEME was founded on March 15, 2020 — the Ides of March, as the organization's own site puts it — just as COVID-19 was becoming a major societal problem. What it teaches is deliberately narrow: not directing, not cinematography — film schools already do that — but the business side of filmmaking that founders rarely get taught anywhere. The goal is to keep Colorado's filmmaking talent, and the projects it makes, from having to leave the state to get made.",
    // Build #6 — new roster paragraph, first person (matches this page's
    // established voice), names the instructors the roster grid below
    // pictures. Facts: Playbook Appendix + MEME_OnePager.html, matching.
    // 2026-08-02 correction (operator): the previous version blurred MEME's
    // TEAM with the people who teach its workshops. Per meme.ngo/meet-the-team
    // the team is five: Nick C. Goins Jr (Executive Director & Founder), Amber
    // MacPherson (Board Chair & Admin), and three Members At-Large — Eric
    // Abramson, Shaun Michael Ellis, and me. Steve Borne and Adam Smestad have
    // taught workshops; they are NOT on the team page, and the copy must not
    // imply they are.
    "Nick C. Goins Jr founded MEME and runs it as Executive Director; Amber MacPherson chairs the board. Alongside me there are two other Members At-Large, Eric Abramson and Shaun Michael Ellis. The workshops themselves are taught by working professionals brought in for them — which is the point, since the whole idea is to put people in front of the ones already doing the job.",
    "It runs on the same instinct as everything else this studio makes: a StorySmith's read on what an audience will feel, and a market strategist's read on who that audience actually is.",
  ],
  ctas: [
    { label: "About the organization →", href: "https://www.meme.ngo", external: true },
    { label: "See the venture lane →", href: `${base}/venture`, external: false },
  ],
};
---

<Base title="MEME — a venture story" description="Member At-Large at MEME (Makeshift Entertainment Media Education), a Colorado nonprofit: Strategic Liaison and Scout for new storytellers.">
  <main class="meme-story">
    <div class="meme-ghosts" aria-hidden="true">
      {ghost.map((ch, i) => <span class="meme-ghost" data-im-ghost style={`--gi:${i}`}>{ch}</span>)}
    </div>
    <article class="meme-inner">
      <a href={`${base}/venture`} class="link meme-back">← Venture</a>
      <p class="hud-label meme-slate" data-reveal data-tableau-content>
        <span data-decode>{ARTICLE.slate}</span>
      </p>
      <h1 class="meme-title" data-reveal>{ARTICLE.title}</h1>
      <div class="meme-proof" data-reveal>
        <LegendMark proof={meme.proof} />
      </div>

      {
        loop && (
          <figure class="meme-loop-wrap" data-reveal>
            <div class="meme-loop-frame">
              <picture>
                <source type="image/avif" srcset={loop.posterAvif} />
                <img class="meme-loop-poster" src={loop.posterWebp} alt="The MEME logo — a filmstrip-lettered M, on a deep blue textured ground." loading="lazy" decoding="async" />
              </picture>
              <video
                class="meme-loop-vid"
                data-meme-loop
                muted
                loop
                playsinline
                preload="metadata"
                poster={loop.posterWebp}
                aria-hidden="true"
              >
                <source src={loop.mp4} type="video/mp4" />
              </video>
            </div>
            {/* ⚠ OPERATOR READ-APPROVAL REQUIRED — new copy, staging-only until read. */}
            <figcaption class="hud-label meme-loop-cap">MEME's own animated mark, in motion</figcaption>
          </figure>
        )
      }

      <!-- LAYOUT-OVERHAUL P5 (2026-08-01, see LAYOUT-RESEQUENCE-PLAN.md):
           the 6-paragraph stretch gets one typographic beat — a full-width
           pull quote after the founding-fact paragraph (Atavist device 8),
           and an asterisk divider before the roster (device 6). No new
           imagery; this is a bones page and stays one.
           ⚠ OPERATOR READ-APPROVAL REQUIRED — the pull quote is new visible
           copy (a tightened reprise of the paragraph above it; facts
           unchanged), staging-only until read. -->
      {ARTICLE.paragraphs.slice(0, 3).map((para) => <p class="meme-para" data-reveal>{para}</p>)}
      <blockquote class="meme-pull" data-reveal>
        Founded on the Ides of March, 2020 — built so Colorado's filmmaking talent doesn't have to leave the state.
      </blockquote>
      {ARTICLE.paragraphs.slice(3).map((para) => <p class="meme-para" data-reveal>{para}</p>)}

      <p class="meme-break" aria-hidden="true">✳</p>

      {/* v3 — THE CAMPAIGN: the page's evidence. A poster wall at deliberately
          unequal scale — the lead flyer runs large beside its own spec block,
          the three others drop to a smaller rank underneath. */}
      {
        (bofsbPortrait || pitchQuorumSheet || marketFreshSheet) && (
          <section class="meme-campaign" aria-label="Campaign work for MEME">
            <p class="hud-label meme-kicker">{CAMPAIGN.kicker}</p>
            <h2 class="meme-h2">{CAMPAIGN.heading}</h2>
            {CAMPAIGN.body.map((p) => <p class="meme-para">{p}</p>)}

            {CAMPAIGN.items[0].media() && (
              <div class="meme-lead">
                <figure class="meme-lead-fig">
                  <picture>
                    {CAMPAIGN.items[0].media()!.avif && <source srcset={CAMPAIGN.items[0].media()!.avif} type="image/avif" />}
                    <img src={CAMPAIGN.items[0].media()!.webp ?? CAMPAIGN.items[0].media()!.avif} alt={CAMPAIGN.items[0].alt} loading="lazy" decoding="async" />
                  </picture>
                </figure>
                <div class="meme-lead-body">
                  <p class="hud-label meme-next">Next up</p>
                  <p class="meme-item-label">{CAMPAIGN.items[0].label}</p>
                  <p class="meme-item-meta">{CAMPAIGN.items[0].meta}</p>
                  <p class="meme-item-note">{CAMPAIGN.items[0].note}</p>
                </div>
              </div>
            )}

            <div class="meme-wall">
              {CAMPAIGN.items.slice(1).map((it) => {
                const m = it.media();
                return m ? (
                  <figure class="meme-wall-fig">
                    <picture>
                      {m.avif && <source srcset={m.avif} type="image/avif" />}
                      <img src={m.webp ?? m.avif} alt={it.alt} loading="lazy" decoding="async" />
                    </picture>
                    <figcaption>
                      <span class="meme-item-label">{it.label}</span>
                      <span class="meme-item-meta">{it.meta}</span>
                      <span class="meme-item-note">{it.note}</span>
                    </figcaption>
                  </figure>
                ) : null;
              })}
            </div>
            <p class="meme-footnote">{CAMPAIGN.footnote}</p>
          </section>
        )
      }

      {/* Build #6 — the roster grid: 3 clean headshots (Nick, Steve, Adam).
          Amber MacPherson's headshot is cut (unconfirmed photo-credit
          watermark) and the AFM 2017 photo is cut (rights unresolved) —
          see the header note. Native-resolution images, not upscaled. */}
      {/* ⚠ OPERATOR READ-APPROVAL REQUIRED — new heading + note (staging-only). */}
      <p class="hud-label meme-kicker" data-reveal>Who teaches the workshops</p>
      <div class="meme-roster" data-reveal aria-label="Workshop instructors">
        {
          INSTRUCTORS.map((r) => {
            const shot = memeShots[r.key as keyof typeof memeShots];
            return shot ? (
              <figure class="meme-roster-card">
                <picture>
                  {shot.avif && <source srcset={shot.avif} type="image/avif" />}
                  <img src={shot.webp ?? shot.avif} alt={r.alt} loading="lazy" decoding="async" />
                </picture>
                <figcaption>
                  <span class="meme-roster-name">{r.name}</span>
                  <span class="meme-roster-role">{r.role}</span>
                </figcaption>
              </figure>
            ) : null;
          })
        }
      </div>
      <p class="meme-footnote" data-reveal>
        Instructors are working professionals brought in to teach a session — not MEME's
        board. The organisation's team is listed on its own site.
      </p>

      <nav class="meme-ctas" data-reveal>
        {
          ARTICLE.ctas.map((c) => (
            <a href={c.href} class="link" rel={c.external ? "noopener" : undefined} target={c.external ? "_blank" : undefined}>
              {c.label}
            </a>
          ))
        }
      </nav>
      <a href={`${base}/venture`} class="link meme-back">← Venture</a>
    </article>
  </main>
</Base>

<style>
  .meme-story {
    position: relative;
    background: #0e2230; /* entertainment chapter 03 (MEME) ground — same room */
    min-height: 100svh;
    overflow: clip;
  }
  .meme-inner {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    margin-inline: auto;
    padding: 7rem 2rem 6rem;
    display: grid;
    gap: 1.5rem;
  }
  .meme-back {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .meme-slate {
    letter-spacing: 0.24em;
    color: color-mix(in srgb, #d9f2ec 75%, transparent);
  }
  .meme-title {
    font-family: var(--font-display);
    font-weight: 560;
    font-style: italic;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.12;
    color: #f2f4f8;
  }
  .meme-para {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.65;
    color: color-mix(in srgb, #eef2f5 86%, transparent);
  }

  /* ambient logo loop — a framed moment between the proof and the article,
     the org's own animated mark, always playing (never a hover trigger).
     Native 16:9 source, so aspect-ratio + object-fit:cover crops nothing.
     Poster image is the permanent base layer (no-JS / reduced-motion /
     autoplay-refused all land here); the video fades in over it once JS
     confirms motion is allowed and the figure is on-screen. */
  .meme-loop-wrap {
    margin: 0.2rem 0 0;
  }
  .meme-loop-frame {
    position: relative;
    border: 1px solid color-mix(in srgb, #ffffff 14%, transparent);
    border-radius: 8px;
    overflow: hidden;
    background: color-mix(in srgb, #ffffff 4%, transparent);
    box-shadow: 0 0 32px -12px color-mix(in srgb, var(--color-accent, #38f8ec) 35%, transparent);
  }
  .meme-loop-poster {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .meme-loop-vid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 600ms var(--ease-survey, ease);
  }
  .meme-loop-frame.is-playing .meme-loop-vid {
    opacity: 1;
  }
  /* Caption sits BELOW the frame, not over it: the poster art carries its own
     baked-in "A NOT-FOR-PROFIT COMPANY" line along the bottom edge, and an
     overlaid caption landed on top of it (white-on-white). */
  .meme-loop-cap {
    display: block;
    margin: 0.55rem 0 0;
    letter-spacing: 0.18em;
    color: var(--color-ink-muted, #8a9a96);
  }
  @media (prefers-reduced-motion: reduce) {
    .meme-loop-vid {
      transition: none;
    }
  }
  /* P5 — the one typographic beat in the text stretch: a plain full-width
     pull quote (no panel, no border — the Atavist device) */
  .meme-pull {
    margin: 0.6rem 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 560;
    font-size: clamp(1.35rem, 2.8vw, 1.9rem);
    line-height: 1.35;
    text-align: center;
    color: #f2f4f8;
  }
  /* P5 — bare asterisk chapter break before the roster (device 6) */
  .meme-break {
    margin: 0.4rem 0 0;
    text-align: center;
    font-size: 1.1rem;
    color: color-mix(in srgb, #d9f2ec 45%, transparent);
    letter-spacing: 0;
  }
  /* ── v3 · THE CAMPAIGN — poster wall at unequal rank ─────────────────── */
  .meme-campaign {
    display: grid;
    gap: 1.1rem;
    margin: 0.6rem 0 0.4rem;
    padding-top: 1.6rem;
    border-top: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
  }
  .meme-kicker {
    letter-spacing: 0.26em;
    color: color-mix(in srgb, var(--color-accent, #38f8ec) 85%, transparent);
  }
  .meme-h2 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 560;
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    line-height: 1.15;
    color: #f2f4f8;
    margin-bottom: 0.2rem;
  }
  /* the lead: one flyer at full rank beside its own spec block */
  .meme-lead {
    display: grid;
    grid-template-columns: 22rem 1fr;
    gap: 1.8rem;
    align-items: center;
    margin-top: 0.5rem;
  }
  .meme-lead-fig {
    margin: 0;
  }
  .meme-lead-fig img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, #ffffff 14%, transparent);
    box-shadow: 0 22px 55px rgba(0, 0, 0, 0.45);
  }
  .meme-lead-body {
    display: grid;
    gap: 0.35rem;
    align-content: center;
  }
  .meme-next {
    letter-spacing: 0.24em;
    color: color-mix(in srgb, var(--color-accent, #38f8ec) 80%, transparent);
  }
  /* the wall: three subordinate flyers, deliberately a rank smaller than the
     lead AND unequal to each other — Crew Call is a different animal (a call
     sheet, not a cover) so it takes the wide track, and the two sibling
     program sheets sit narrower with a dropped baseline. A flat repeat(3,1fr)
     here would rebuild the uniform-tile grid this whole overhaul removed. */
  /* two siblings now (Crew Call pulled — unannounced), so the ratio is the
     house 1.62:1 rather than the old three-across. Still unequal on purpose:
     a 1fr 1fr pair is the "two identical squares" shape being removed
     everywhere else on the site. */
  .meme-wall {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 1.6rem;
    margin-top: 0.6rem;
    align-items: start;
    max-width: 46rem;
  }
  .meme-wall-fig {
    margin: 0;
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .meme-wall-fig:nth-child(2) {
    margin-top: 2.2rem;
  }
  .meme-wall-fig img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    border: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
  }
  .meme-wall-fig figcaption {
    display: grid;
    gap: 0.2rem;
  }
  .meme-item-label {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: #f2f4f8;
  }
  .meme-item-meta {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, #eef2f5 62%, transparent);
  }
  .meme-item-note {
    font-size: 0.82rem;
    line-height: 1.45;
    color: color-mix(in srgb, #eef2f5 72%, transparent);
  }
  .meme-lead-body .meme-item-label {
    font-size: 1.25rem;
  }
  .meme-lead-body .meme-item-note {
    font-size: 0.92rem;
    max-width: 44ch;
  }
  .meme-footnote {
    font-size: 0.72rem;
    line-height: 1.5;
    color: color-mix(in srgb, #eef2f5 55%, transparent);
  }
  @media (max-width: 780px) {
    .meme-lead { grid-template-columns: 1fr; }
    .meme-lead-fig { max-width: 22rem; }
    .meme-wall-fig:nth-child(2) { margin-top: 1.4rem; }
  }
  @media (max-width: 520px) {
    .meme-wall { grid-template-columns: 1fr; }
    .meme-wall-fig:nth-child(2) { margin-top: 0; }
  }

  /* Build #6 — roster grid, 3 headshot cards. P5: scale-dropped to a
     masthead/contributors block (~11rem cells, centered) — deliberately
     smaller than a gallery so it reads as credits, not imagery. */
  .meme-roster {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 0.4rem auto 0.2rem;
    max-width: 36rem;
    width: 100%;
  }
  .meme-roster-card {
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .meme-roster-card img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, #ffffff 14%, transparent);
  }
  .meme-roster-card figcaption {
    display: grid;
    gap: 0.2rem;
  }
  .meme-roster-name {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: #f2f4f8;
  }
  .meme-roster-role {
    font-size: 0.78rem;
    line-height: 1.4;
    color: color-mix(in srgb, #eef2f5 70%, transparent);
  }
  @media (max-width: 640px) {
    .meme-roster { grid-template-columns: 1fr 1fr; }
  }

  .meme-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    border-top: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
    padding-top: 1.4rem;
    margin-top: 0.6rem;
  }

  /* ghost "M E M E" — faint letterforms behind the column (no-JS = at rest) */
  .meme-ghosts {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .meme-ghost {
    position: absolute;
    font-family: var(--font-sans);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(6rem, 18vw, 16rem);
    line-height: 1;
    color: color-mix(in srgb, #ffffff 5%, transparent);
  }
  .meme-ghost:nth-child(1) { left: 4%; top: 12%; }
  .meme-ghost:nth-child(2) { right: 8%; top: 30%; }
  .meme-ghost:nth-child(3) { left: 10%; bottom: 18%; }
  .meme-ghost:nth-child(4) { right: 4%; bottom: 8%; }

  @media (max-width: 640px) {
    .meme-ghost { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .meme-ghost { transform: none !important; }
  }
</style>

<script>
  // enhancement only: decode the slate label, and let the ghost letters drift
  // in and settle (their resting positions already live in CSS, so no-JS and
  // reduced-motion see the final, correct layout).
  const mountDecode = () => import("../../lib/decode-text").then(({ mountDecode }) => mountDecode(document));
  if ("requestIdleCallback" in window) requestIdleCallback(mountDecode, { timeout: 3000 });
  else setTimeout(mountDecode, 1500);

  (async () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia("(max-width: 640px)").matches) return;
    const { gsap } = await import("gsap");
    document.querySelectorAll<HTMLElement>("[data-im-ghost]").forEach((g, i) => {
      const dx = (i % 2 ? 1 : -1) * (36 + (i % 3) * 24);
      gsap.fromTo(
        g,
        { x: dx, y: 48, opacity: 0 },
        {
          x: 0,
          y: 0,
          opacity: 1,
          duration: 1.1,
          ease: "power3.out",
          delay: i * 0.08,
          onComplete: () => {
            gsap.to(g, {
              y: (i % 2 ? -1 : 1) * 10,
              duration: 5 + (i % 3) * 1.5,
              ease: "sine.inOut",
              yoyo: true,
              repeat: -1,
            });
          },
        },
      );
    });
  })();

  // ambient logo loop (P14b) — plays only when motion is allowed and the
  // figure is actually on-screen; the poster image underneath is the
  // permanent base layer, so reduced-motion / no-JS / autoplay-refused all
  // just show the still. Mirrors HeroVideo.astro's poster-first contract:
  // no native `autoplay`/`src`-at-parse-time, JS decides, muted always.
  (() => {
    const wrap = document.querySelector<HTMLElement>(".meme-loop-frame");
    const video = wrap?.querySelector<HTMLVideoElement>("[data-meme-loop]");
    if (!wrap || !video) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const conn = (navigator as { connection?: { saveData?: boolean } }).connection;
    if (conn?.saveData) return;

    video.addEventListener("playing", () => wrap.classList.add("is-playing"));

    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        if (entry.isIntersecting) video.play().catch(() => {}); // refusal → poster stands
        else video.pause();
      },
      { threshold: 0.2 },
    );
    io.observe(wrap);
    window.addEventListener("pagehide", () => io.disconnect(), { once: true });
  })();
</script>
