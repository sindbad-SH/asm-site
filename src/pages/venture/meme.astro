 * MEME-STICKLER-2026-08-03 (operator: "Amber and Eric's photos aren't really
 * focused well — they cut off a good chunk of their head"): all five crops
 * re-baked as exact SQUARES via scripts/fix-meme-roster-crops-2026-08-03.mjs
 * (not left to the live CSS object-fit:cover to auto-center-crop a non-square
 * file), so every crop shown here is exactly what was viewed and verified.
 * Amber and Eric recropped from the same sources. Adam and Steve checked
 * against the live crop and already passed — untouched. Nick's crop swaps to
 * a different source photo entirely (see that script's header note) because
 * the previously-used one has zero headroom in the native file.
 */
const ROSTER_LEADS = [
  {
    key: "nick",
    name: "Nick C. Goins Jr",
    role: "Executive Director & Founder.",
    bio: "Has worked in the film industry in various capacities since making his first feature at 16 — critic, writer, director, producer, graphic artist. Teaches MEME's flagship Pitch Quorum and Market Fresh programs himself.",
    // MEME-STICKLER-2026-08-03: photo swapped (see scripts/fix-meme-roster-crops-2026-08-03.mjs
    // header note) — the previously-used plaid-cap photo has zero headroom
    // above his hat in the native source (pixel-verified), failing the
    // operator's "full head + breathing room" standard with no honest crop
    // fix available. ⚠ OPERATOR READ-APPROVAL REQUIRED — this is a different
    // photo of Nick (navy flat cap, white shirt, from the same cleared
    // source folder), not just a recrop.
    alt: "Close portrait of Nick C. Goins Jr wearing a navy flat cap, white shirt, looking directly at camera.",
  },
  {
    key: "amber",
    name: "Amber MacPherson",
    role: "Board Chair & Administrator.",
    bio: "Co-founded the company behind MEME alongside Nick, and serves as the organization's Board Chair and Administrator.",
    alt: "Portrait of Amber MacPherson, long wavy brown hair, smiling, black top, dark blue background.",
    photoCredit: "April O'Hare Photography",
  },
] as const;

const ROSTER_INSTRUCTORS = [
  {
    key: "eric",
    name: "Eric Abramson",
    bio: "Teaches The Carpenter Not the Tools. A filmmaker and firefighter — documentary, music video, and live-event work aired on outlets including MTV, ESPN, and PBS, alongside years fighting wildland fires across the American West.",
    alt: "Eric Abramson on a shoot, wearing a ballcap and headphones, camera and monitor visible beside him.",
  },
  {
    key: "adam",
    name: "Adam Smestad",
    bio: "Teaches the PA and Script Supervisor workshops. A writer, director, and producer who's worked more than 50 film, TV, and commercial sets — as a PA, and in the art department, camera department, sound, G&E, and craft services — after leaving a career in law in 2018.",
    alt: "Studio portrait of Adam Smestad, bald, short beard, smiling, black blazer, gray backdrop.",
  },
  {
    key: "steve",
    name: "Steve Borne",
    bio: "Teaches the two-part Sound Workshop. A film and TV sound designer for more than 35 years, with two Emmy awards for TV sound mixing, credits alongside directors from Harmony Korine to Robert Altman, and recording work with musicians including Jerry Garcia and Tom Petty.",
    alt: "Portrait of Steve Borne, bald, glasses, gray beard, dark sweater, softly lit interior background.",
  },
] as const;

// ── THE ARTICLE (all new sentences — see the approval note above) ──
const ARTICLE = {
  slate: "MEME · MAKESHIFT ENTERTAINMENT MEDIA EDUCATION",
  title: "The most formal role I hold in this world.",
  paragraphs: [
    "MEME — Makeshift Entertainment Media Education — is a Colorado nonprofit, and it holds the most formal title I carry anywhere: Member At-Large.",
    "The work is to be a Strategic Liaison and Scout — often the first point of contact for new talent. I look for storytellers worth backing, and help them find a way in.",
    // Build #6 — replaces the prior generic mission line with the
    // organization's own verified founding fact (meme.ngo/about, quoted
    // above) plus its actual teaching focus, sourced from the internal
    // playbook + one-pager (cross-checked, matching on every fact used).
    "MEME was founded on March 15, 2020 — the Ides of March, as the organization's own site puts it — just as COVID-19 was becoming a major societal problem. What it teaches is deliberately narrow: not directing, not cinematography — film schools already do that — but the business side of filmmaking that founders rarely get taught anywhere. The goal is to keep Colorado's filmmaking talent, and the projects it makes, from having to leave the state to get made.",
    // Build #6 — new roster paragraph, first person (matches this page's
    // established voice), names the instructors the roster grid below
    // pictures. Facts: Playbook Appendix + MEME_OnePager.html, matching.
    // 2026-08-02 correction (operator): the previous version blurred MEME's
    // TEAM with the people who teach its workshops. Per meme.ngo/meet-the-team
    // the team is five: Nick C. Goins Jr (Executive Director & Founder), Amber
    // MacPherson (Board Chair & Admin), and three Members At-Large — Eric
    // Abramson, Shaun Michael Ellis, and me. Steve Borne and Adam Smestad have
    // taught workshops; they are NOT on the team page, and the copy must not
    // imply they are.
    "Nick C. Goins Jr founded MEME and runs it as Executive Director; Amber MacPherson chairs the board. Alongside me there are two other Members At-Large, Eric Abramson and Shaun Michael Ellis. The workshops themselves are taught by working professionals brought in for them — which is the point, since the whole idea is to put people in front of the ones already doing the job.",
    "It runs on the same instinct as everything else this studio makes: a StorySmith's read on what an audience will feel, and a market strategist's read on who that audience actually is.",
  ],
  ctas: [
    { label: "Meet the full MEME team →", href: "https://www.meme.ngo/meet-the-team", external: true },
    { label: "See the venture lane →", href: `${base}/venture`, external: false },
  ],
};
---

<Base title="MEME — a venture story" description="Member At-Large at MEME (Makeshift Entertainment Media Education), a Colorado nonprofit: Strategic Liaison and Scout for new storytellers.">
  <main class="meme-story">
    <div class="meme-ghosts" aria-hidden="true">
      {ghost.map((ch, i) => <span class="meme-ghost" data-im-ghost style={`--gi:${i}`}>{ch}</span>)}
    </div>
    <article class="meme-inner">
      <a href={`${base}/venture`} class="link meme-back">← Venture</a>
      <p class="hud-label meme-slate" data-reveal data-tableau-content>
        <span data-decode>{ARTICLE.slate}</span>
      </p>
      <h1 class="meme-title" data-reveal>{ARTICLE.title}</h1>
      <div class="meme-proof" data-reveal>
        <LegendMark proof={meme.proof} />
      </div>

      {
        loop && (
          <figure class="meme-loop-wrap" data-reveal>
            <div class="meme-loop-frame">
              <picture>
                <source type="image/avif" srcset={loop.posterAvif} />
                <img class="meme-loop-poster" src={loop.posterWebp} alt="The MEME logo — a filmstrip-lettered M, on a deep blue textured ground." loading="lazy" decoding="async" />
              </picture>
              <video
                class="meme-loop-vid"
                data-meme-loop
                muted
                loop
                playsinline
                preload="metadata"
                poster={loop.posterWebp}
                aria-hidden="true"
              >
                <source src={loop.mp4} type="video/mp4" />
              </video>
            </div>
            {/* ⚠ OPERATOR READ-APPROVAL REQUIRED — new copy, staging-only until read. */}
            <figcaption class="hud-label meme-loop-cap">MEME's own animated mark, in motion</figcaption>
          </figure>
        )
      }

      <!-- LAYOUT-OVERHAUL P5 (2026-08-01, see LAYOUT-RESEQUENCE-PLAN.md):
           the 6-paragraph stretch gets one typographic beat — a full-width
           pull quote after the founding-fact paragraph (Atavist device 8),
           and an asterisk divider before the roster (device 6). No new
           imagery; this is a bones page and stays one.
           ⚠ OPERATOR READ-APPROVAL REQUIRED — the pull quote is new visible
           copy (a tightened reprise of the paragraph above it; facts
           unchanged), staging-only until read. -->
      {ARTICLE.paragraphs.slice(0, 3).map((para) => <p class="meme-para" data-reveal>{para}</p>)}
      <blockquote class="meme-pull" data-reveal>
        Founded on the Ides of March, 2020 — built so Colorado's filmmaking talent doesn't have to leave the state.
      </blockquote>
      {ARTICLE.paragraphs.slice(3).map((para) => <p class="meme-para" data-reveal>{para}</p>)}

      <p class="meme-break" aria-hidden="true">✳</p>

      {/* 2026-08-03 EVERGREEN REBUILD — the program catalog, grouped into
          three tracks, replacing the retired dated-campaign poster wall. */}
      {/* ⚠ OPERATOR READ-APPROVAL REQUIRED — new heading, intro, and program
          card copy below, staging-only until read. */}
      <section class="meme-programs" aria-label="MEME's program catalog">
        <p class="hud-label meme-kicker">{PROGRAMS_INTRO.kicker}</p>
        <h2 class="meme-h2">{PROGRAMS_INTRO.heading}</h2>
        <p class="meme-para">{PROGRAMS_INTRO.body}</p>

        <div class="meme-track" data-track="pitch-market" style={`--track-color:${PROGRAM_TRACKS["pitch-market"].color}`}>
          <p class="hud-label meme-track-label">
            {PROGRAM_TRACKS["pitch-market"].label}
          </p>
          <div class="meme-program-grid">
            {PROGRAMS.filter((p) => p.track === "pitch-market").map((c) => {
              const m = programCard(c.slug);
              return m ? (
                <figure class={`meme-program-card meme-program-card--${c.rank}`}>
                  <picture>
                    {m.avif && <source srcset={m.avif} type="image/avif" />}
                    <img src={m.webp ?? m.avif} alt={c.alt} loading="lazy" decoding="async" />
                  </picture>
                  <figcaption class="meme-program-desc">{c.desc}</figcaption>
                </figure>
              ) : null;
            })}
          </div>
        </div>

        <div class="meme-track" data-track="on-set" style={`--track-color:${PROGRAM_TRACKS["on-set"].color}`}>
          <p class="hud-label meme-track-label">
            {PROGRAM_TRACKS["on-set"].label}
          </p>
          <div class="meme-program-grid">
            {PROGRAMS.filter((p) => p.track === "on-set").map((c) => {
              const m = programCard(c.slug);
              return m ? (
                <figure class={`meme-program-card meme-program-card--${c.rank}`}>
                  <picture>
                    {m.avif && <source srcset={m.avif} type="image/avif" />}
                    <img src={m.webp ?? m.avif} alt={c.alt} loading="lazy" decoding="async" />
                  </picture>
                  <figcaption class="meme-program-desc">{c.desc}</figcaption>
                </figure>
              ) : null;
            })}
          </div>

          {/* CARPENTER-RECORDING-SEGMENT (2026-08-03) — from the operator's own
              recording of the 2025-12-03 session (the first MEME event he has
              real footage of; mined in E:\Makeshift\MEME\_CARPENTER-MINED).
              Quote is VERBATIM from the transcript (part1, 00:23:31-00:23:42),
              light filler cleanup only, source + timestamp preserved there for
              verification.
              MEME-POLISH-2026-08-03: the quote is now COMPOSITED into the
              photo itself (scripts/make-carpenter-room.mjs), filling the
              frame's dead-space left third like a magazine cover — the
              separate blockquote below the image is retired, and the alt
              text now says the photo carries the quote. Still excludes the
              operator, who attended. Date claim (December 2025) is from the
              recording's own file metadata (2025-12-03).
              ROUND 3 (operator: "let the Carpenter figure sit asymmetrically
              against text"): the photo moved from a plain centered figure
              to a tilted, asymmetric duo (68/32 split). Caption text is
              UNCHANGED throughout every round, only its position has moved.
              MEME-STICKLER-2026-08-03 (layout verdict, operator: "very
              linear, a lot of boxes"): the duo is retired for the page's one
              full-bleed moment — this is the obvious candidate (it's already
              the page's single richest photo, quote + branding baked in) —
              breaking past `.meme-inner`'s 46rem column via the same
              viewport-breakout technique steel-and-dust.astro's `.sd-bleed`
              uses (`left:50%; margin-left:-50vw; width:100vw`). The caption
              now overlaps the photo's own bottom-left corner (sd-bleed-cap's
              device: a small blurred pill sitting ON the image) instead of
              living in a separate column — one of this pass's two
              overlapping-element beats.
              ⚠ OPERATOR READ-APPROVAL REQUIRED — the one-line caption below
              is new visible copy (staging-only until read). */}
          <figure class="meme-room-bleed" data-reveal>
            <picture>
              <source
                srcset={`${base}/media/venture/meme/carpenter-room-900.avif 900w, ${base}/media/venture/meme/carpenter-room-1440.avif 1440w`}
                type="image/avif"
              />
              <img
                src={`${base}/media/venture/meme/carpenter-room-900.webp`}
                srcset={`${base}/media/venture/meme/carpenter-room-900.webp 900w, ${base}/media/venture/meme/carpenter-room-1440.webp 1440w`}
                sizes="100vw"
                alt={`Eric Abramson teaching The Carpenter Not the Tools, gesturing at the head of a long table as attendees listen; white text composited over the room's left wall carries his quote: "People get hung up — should I buy this expensive camera? No. Use the cheaper camera, but get a good mic."`}
                loading="lazy"
                decoding="async"
                width="1440"
                height="1080"
              />
            </picture>
            <figcaption class="hud-label meme-room-cap">Inside The Carpenter Not the Tools, December 2025 session</figcaption>
          </figure>
        </div>

        <div class="meme-track" data-track="sound" style={`--track-color:${PROGRAM_TRACKS["sound"].color}`}>
          <p class="hud-label meme-track-label">
            {PROGRAM_TRACKS["sound"].label}
          </p>
          <div class="meme-program-grid">
            {PROGRAMS.filter((p) => p.track === "sound").map((c) => {
              const m = programCard(c.slug);
              return m ? (
                <figure class={`meme-program-card meme-program-card--${c.rank}`}>
                  <picture>
                    {m.avif && <source srcset={m.avif} type="image/avif" />}
                    <img src={m.webp ?? m.avif} alt={c.alt} loading="lazy" decoding="async" />
                  </picture>
                  <figcaption class="meme-program-desc">{c.desc}</figcaption>
                </figure>
              ) : null;
            })}
          </div>
        </div>

        <p class="meme-footnote">{PROGRAMS_INTRO.footnote}</p>
        <a href={PROGRAMS_INTRO.cta.href} class="meme-cta-strong" target="_blank" rel="noopener">
          {PROGRAMS_INTRO.cta.label}
        </a>
      </section>

      {/* MEME-ARCHIVE-2026-08-03 — "MEME in the world." The first section on
          this page built from MEME's OWN event archive rather than borrowed or
          generated art (see the WORLD const's header note). Existence-gated:
          if the three world-* renders aren't on disk the whole section simply
          doesn't render, same pattern as the NOCOVA photo slot.
          ⚠ OPERATOR READ-APPROVAL REQUIRED — new copy, staging-only. */}
      {
        Object.values(worldShots).some(Boolean) ? (
          <section class="meme-world" aria-label="MEME beyond the workshops" data-reveal>
            <p class="hud-label meme-kicker">{WORLD.kicker}</p>
            <h2 class="meme-h2">{WORLD.heading}</h2>
            <p class="meme-para meme-world-lede">{WORLD.body}</p>
            <div class="meme-world-strip">
              {WORLD.shots.map((s) => {
                const shot = worldShots[s.key as keyof typeof worldShots];
                return shot ? (
                  <figure class="meme-world-shot">
                    <picture>
                      {shot.avif && <source srcset={shot.avif} type="image/avif" />}
                      <img src={shot.webp ?? shot.avif} alt={s.alt} loading="lazy" decoding="async" />
                    </picture>
                    <figcaption>
                      <span class="meme-world-cap">{s.caption}</span>
                      <span class="meme-world-sub">{s.sub}</span>
                    </figcaption>
                  </figure>
                ) : null;
              })}
            </div>
          </section>
        ) : null
      }

      {/* MEME-POLISH-2026-08-03 ROUND 3 — NOCOVA, MEME's social arm. Its own
          distinct, lighter moment (operator: "it can look/feel lighter than
          the workshops") — a translucent card in place of a photo, since none
          exist yet (see the NOCOVA const's header comment). ⚠ OPERATOR
          READ-APPROVAL REQUIRED — every sentence below is new copy,
          staging-only until read. */}
      <section class="meme-nocova" aria-label="NOCOVA — MEME's social arm" data-reveal>
        <p class="hud-label meme-kicker">{NOCOVA.kicker}</p>
        <div class="meme-nocova-grid">
          <div class="meme-nocova-copy">
            <h2 class="meme-h2 meme-h2--bold">{NOCOVA.heading}</h2>
            {NOCOVA.paragraphs.map((p) => <p class="meme-para">{p}</p>)}
            <p class="meme-footnote">{NOCOVA.note}</p>
            <a href={NOCOVA.cta.href} class="link" target="_blank" rel="noopener">
              {NOCOVA.cta.label}
            </a>
          </div>

          {/* NOCOVA-PHOTOS: integration point — drop nocova-meetup-1 (and
              optionally -2) -900/-1600 .avif/.webp files into
              public/media/venture/meme/ to swap the venue card below for 1-2
              real photos; no other code changes needed (existence-gated via
              pair(), same helper the roster/program art already uses). */}
          {
            nocovaShots.length > 0 ? (
              <div class="meme-nocova-photos">
                {nocovaShots.map((shot) => (
                  <figure class="meme-nocova-photo">
                    <picture>
                      {shot.avif && <source srcset={shot.avif} type="image/avif" />}
                      <img src={shot.webp ?? shot.avif} alt="A NOCOVA community-networking meetup." loading="lazy" decoding="async" />
                    </picture>
                  </figure>
                ))}
              </div>
            ) : (
              <aside class="meme-nocova-card">
                <p class="hud-label meme-nocova-card-kicker">Usually found at</p>
                <ul class="meme-nocova-venues">
                  <li>Rosetta Hall</li>
                  <li>The St. Julien Hotel lobby</li>
                </ul>
                <p class="meme-nocova-freq">Recurring — usually a couple of times a month.</p>
              </aside>
            )
          }
        </div>
      </section>

      {/* MEME-POLISH-2026-08-03 REROSTER — the people, in two tiers: founders
          (Nick + Amber, both pictured), then instructors (Eric, Adam, Steve).
          See the header note above ROSTER_LEADS for the scope rule (why
          Shaun/Sindbad are gone) and the Amber photo-crop/credit note.
          MEME-STICKLER-2026-08-03 (layout verdict) — wrapped in its own
          <section> so it can carry a distinct ground tint (varied section
          grounds device) and a quieter heading scale than NOCOVA's — the
          typography scale-jump the layout verdict asked for. */}
      {/* ⚠ OPERATOR READ-APPROVAL REQUIRED — new heading + bio copy below,
          staging-only until read. Roster SCOPE RULE: founders + instructors
          only — see the header comment above ROSTER_LEADS before adding
          anyone else here. */}
      <section class="meme-roster-section" aria-label="The people behind MEME">
      <p class="hud-label meme-kicker" data-reveal>The people</p>
      <h2 class="meme-h2 meme-h2--quiet" data-reveal>Who's actually behind it.</h2>

      <p class="hud-label meme-track-label" data-reveal>Founders</p>
      <div class="meme-roster meme-roster--leads" data-reveal aria-label="MEME's founders">
        {
          ROSTER_LEADS.map((p) => {
            const shot = memeShots[p.key as keyof typeof memeShots];
            return shot ? (
              <figure class="meme-roster-card">
                <picture>
                  {shot.avif && <source srcset={shot.avif} type="image/avif" />}
                  <img src={shot.webp ?? shot.avif} alt={p.alt} loading="lazy" decoding="async" />
                </picture>
                <figcaption>
                  <span class="meme-roster-name">{p.name}</span>
                  <span class="meme-roster-role">{p.role}</span>
                  <span class="meme-roster-bio">{p.bio}</span>
                  {"photoCredit" in p && <span class="meme-roster-credit">Photo: {p.photoCredit}</span>}
                </figcaption>
              </figure>
            ) : null;
          })
        }
      </div>

      <p class="hud-label meme-track-label" data-reveal>Instructors</p>
      <div class="meme-roster meme-roster--instructors" data-reveal aria-label="MEME's workshop instructors">
        {
          ROSTER_INSTRUCTORS.map((p) => {
            const shot = memeShots[p.key as keyof typeof memeShots];
            return shot ? (
              <figure class="meme-roster-card">
                <picture>
                  {shot.avif && <source srcset={shot.avif} type="image/avif" />}
                  <img src={shot.webp ?? shot.avif} alt={p.alt} loading="lazy" decoding="async" />
                </picture>
                <figcaption>
                  <span class="meme-roster-name">{p.name}</span>
                  <span class="meme-roster-bio">{p.bio}</span>
                </figcaption>
              </figure>
            ) : null;
          })
        }
      </div>
      <p class="meme-footnote" data-reveal>
        Founders and instructors shown here; the wider Member At-Large board
        (including my own role) isn't repeated in this roster — see the article
        above.
      </p>
      </section>

      {/* MEME-ARCHIVE-2026-08-03 — the outbound block (operator: "enough
          buttons that ultimately direct people to meme's main website as well
          as their social media"). Grouped rather than listed flat, so "go do
          the thing" doesn't get lost among "keep up with them." All hrefs
          verified against meme.ngo's own nav/footer — see MEME_LINKS.
          ⚠ OPERATOR READ-APPROVAL REQUIRED — new copy, staging-only. */}
      <section class="meme-out" aria-label="MEME's own website and accounts" data-reveal>
        <p class="hud-label meme-kicker">{MEME_LINKS.kicker}</p>
        <h2 class="meme-h2 meme-h2--bold">{MEME_LINKS.heading}</h2>
        <p class="meme-para meme-out-lede">{MEME_LINKS.body}</p>

        <div class="meme-out-groups">
          {MEME_LINKS.groups.map((g) => (
            <div class="meme-out-group">
              <p class="hud-label meme-out-group-label">{g.label}</p>
              <ul class="meme-out-list">
                {g.links.map((l) => (
                  <li>
                    <a href={l.href} class="meme-out-link" target="_blank" rel="noopener">
                      <span class="meme-out-link-label">{l.label}</span>
                      {l.note && <span class="meme-out-link-note">{l.note}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <p class="hud-label meme-out-group-label meme-out-social-label">Follow MEME</p>
        <ul class="meme-out-socials">
          {MEME_LINKS.socials.map((s) => (
            <li>
              <a href={s.href} class="meme-out-social" target="_blank" rel="noopener">
                <span class="meme-out-social-name">{s.label}</span>
                <span class="meme-out-social-handle">{s.handle}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <nav class="meme-ctas" data-reveal>
        {
          ARTICLE.ctas.map((c) => (
            <a href={c.href} class="link" rel={c.external ? "noopener" : undefined} target={c.external ? "_blank" : undefined}>
              {c.label}
            </a>
          ))
        }
      </nav>
      <a href={`${base}/venture`} class="link meme-back">← Venture</a>
    </article>
  </main>
</Base>

<style>
  .meme-story {
    position: relative;
    background: #0e2230; /* entertainment chapter 03 (MEME) ground — same room */
    min-height: 100svh;
    overflow: clip;
  }
  .meme-inner {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    margin-inline: auto;
    padding: 7rem 2rem 6rem;
    display: grid;
    gap: 1.5rem;
  }
  .meme-back {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .meme-slate {
    letter-spacing: 0.24em;
    color: color-mix(in srgb, #d9f2ec 75%, transparent);
  }
  .meme-title {
    font-family: var(--font-display);
    font-weight: 560;
    font-style: italic;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.12;
    color: #f2f4f8;
  }
  .meme-para {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.65;
    color: color-mix(in srgb, #eef2f5 86%, transparent);
  }

  /* ambient logo loop — a framed moment between the proof and the article,
     the org's own animated mark, always playing (never a hover trigger).
     Native 16:9 source, so aspect-ratio + object-fit:cover crops nothing.
     Poster image is the permanent base layer (no-JS / reduced-motion /
     autoplay-refused all land here); the video fades in over it once JS
     confirms motion is allowed and the figure is on-screen. */
  .meme-loop-wrap {
    margin: 0.2rem 0 0;
  }
  .meme-loop-frame {
    position: relative;
    border: 1px solid color-mix(in srgb, #ffffff 14%, transparent);
    border-radius: 8px;
    overflow: hidden;
    background: color-mix(in srgb, #ffffff 4%, transparent);
    box-shadow: 0 0 32px -12px color-mix(in srgb, var(--color-accent, #38f8ec) 35%, transparent);
  }
  .meme-loop-poster {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .meme-loop-vid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 600ms var(--ease-survey, ease);
  }
  .meme-loop-frame.is-playing .meme-loop-vid {
    opacity: 1;
  }
  /* Caption sits BELOW the frame, not over it: the poster art carries its own
     baked-in "A NOT-FOR-PROFIT COMPANY" line along the bottom edge, and an
     overlaid caption landed on top of it (white-on-white). */
  .meme-loop-cap {
    display: block;
    margin: 0.55rem 0 0;
    letter-spacing: 0.18em;
    color: var(--color-ink-muted, #8a9a96);
  }
  @media (prefers-reduced-motion: reduce) {
    .meme-loop-vid {
      transition: none;
    }
  }
  /* P5 — the one typographic beat in the text stretch: a plain full-width
     pull quote (no panel, no border — the Atavist device) */
  .meme-pull {
    margin: 0.6rem 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 560;
    font-size: clamp(1.35rem, 2.8vw, 1.9rem);
    line-height: 1.35;
    text-align: center;
    color: #f2f4f8;
  }
  /* P5 — bare asterisk chapter break before the roster (device 6) */
  .meme-break {
    margin: 0.4rem 0 0;
    text-align: center;
    font-size: 1.1rem;
    color: color-mix(in srgb, #d9f2ec 45%, transparent);
    letter-spacing: 0;
  }
  /* ── 2026-08-03 EVERGREEN REBUILD · THE PROGRAM CATALOG ──────────────────
     replaces the retired dated-flyer poster wall. Three tracks, each its own
     small kicker (color set per-track via --track-color), cards laid out in
     a simple responsive grid rather than the old unequal-rank poster wall —
     a catalog reads as a catalog, not as a hierarchy of "next up". */
  .meme-programs {
    position: relative;
    display: grid;
    gap: 1.1rem;
    margin: 0.6rem 0 0.4rem;
    padding-top: 1.6rem;
    border-top: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
  }
  /* MEME-STICKLER-2026-08-03 (layout verdict, "not one continuous navy
     river") — VARIED SECTION GROUNDS: a full-viewport-width tonal wash sits
     behind each major section via a ::before breakout (same left:50%/
     margin-left:-50vw trick as the full-bleed photo above), so the page
     reads as a sequence of rooms rather than one flat background. Kept
     subtle (a few % mix) so it never fights the text; z-index:-1 stacks it
     under `.meme-inner`'s content (z-index:1) but above `.meme-story`'s own
     base fill and the ghost letterforms. */
  .meme-programs::before {
    content: "";
    position: absolute;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    top: 0;
    bottom: 0;
    z-index: -1;
    background: color-mix(in srgb, #0a1a28 100%, transparent);
  }
  .meme-kicker {
    letter-spacing: 0.26em;
    color: color-mix(in srgb, var(--color-accent, #38f8ec) 85%, transparent);
  }
  .meme-h2 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 560;
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    line-height: 1.15;
    color: #f2f4f8;
    margin-bottom: 0.2rem;
  }
  /* typography scale-jump (layout verdict): NOCOVA gets a bigger, bolder
     heading (its own distinct, lighter moment); the roster section below it
     answers with a quieter, smaller one — a rhythm instead of every h2
     repeating the same size. */
  .meme-h2--bold {
    font-size: clamp(2.1rem, 4.6vw, 3.1rem);
  }
  .meme-h2--quiet {
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    font-style: normal;
    font-weight: 500;
  }
  .meme-track {
    display: grid;
    gap: 0.7rem;
    margin-top: 0.5rem;
  }
  .meme-track-label {
    letter-spacing: 0.22em;
    color: color-mix(in srgb, var(--track-color, var(--color-accent, #38f8ec)) 82%, transparent);
  }
  /* MEME-POLISH-2026-08-03: cards went from 1440x900 flyer-shaped to 1080x1350
     (4:5) poster-shaped ("film-festival section cards, not flyers" — operator).
     ROUND 3 (operator: "a lot of rectangles... I like that asymmetry layout
     we've had on other pages" — steel-and-dust.astro / vybe.astro's staggers):
     flex-wrap replaces the equal-cell grid so each card can carry its own
     `rank`-driven width, and the "b" rank drops onto a lower baseline — the
     same dropped-baseline stagger device those pages use for photo pairs,
     applied here to card scale instead. Uneven row totals naturally wrap
     (2-up/1-down or similar) rather than forcing 3 equal boxes every time. */
  .meme-program-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 1.5rem 1.75rem;
  }
  .meme-program-card {
    margin: 0;
    width: 13rem;
  }
  .meme-program-card--lead {
    width: 16.5rem;
  }
  .meme-program-card--b {
    width: 13.5rem;
    margin-top: 3rem; /* the dropped-baseline stagger */
  }
  .meme-program-card--solo {
    width: 15rem;
  }
  @media (max-width: 640px) {
    .meme-program-card,
    .meme-program-card--lead,
    .meme-program-card--solo {
      width: min(70vw, 15rem);
    }
    .meme-program-card--b {
      width: min(70vw, 15rem);
      margin-top: 0;
    }
  }
  .meme-program-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, #ffffff 14%, transparent);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.35);
  }
  /* the description, OFF the image now — real HTML text, selectable, readable
     at any size (the whole point of the redesign: the image no longer carries
     a body paragraph that turns to mush at card scale).
     MEME-STICKLER-2026-08-03 (layout verdict, "tighter integration of the
     descriptions with their cards — caption-style rather than uniform text
     blocks"): tightened to sit snug under the card (margin cut, a thin
     track-colored rule standing in for the old flat gap) and set in italic
     display type instead of plain body sans — reads as a photo caption, not
     a second paragraph of body copy. */
  .meme-program-desc {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 2px solid color-mix(in srgb, var(--track-color, #38f8ec) 55%, transparent);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.86rem;
    line-height: 1.45;
    color: color-mix(in srgb, #eef2f5 74%, transparent);
  }
  .meme-footnote {
    font-size: 0.72rem;
    line-height: 1.5;
    color: color-mix(in srgb, #eef2f5 55%, transparent);
  }
  /* CARPENTER-RECORDING-SEGMENT — the one photographic moment in the programs
     section: a real frame from inside the workshop.
     MEME-POLISH-2026-08-03: the quote is composited INTO the photo
     (scripts/make-carpenter-room.mjs), so the separate blockquote styles are
     retired — just a caption.
     MEME-STICKLER-2026-08-03 (layout verdict) — the page's one FULL-BLEED
     moment: the same viewport-breakout trick as steel-and-dust.astro's
     .sd-bleed, escaping .meme-inner's 46rem column entirely. The caption
     overlaps the image's own bottom-left corner (sd-bleed-cap's device) —
     one of this pass's two overlapping-element beats. */
  .meme-room-bleed {
    position: relative;
    left: 50%;
    right: 50%;
    width: 100vw;
    margin: 1.8rem -50vw 0;
  }
  .meme-room-bleed img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 74svh;
    object-fit: cover;
  }
  .meme-room-cap {
    position: absolute;
    left: max(2rem, calc((100vw - 46rem) / 2 + 2rem));
    bottom: 1rem;
    display: block;
    margin: 0;
    padding: 0.4rem 0.7rem;
    letter-spacing: 0.18em;
    color: color-mix(in srgb, #f7f9fb 92%, transparent);
    background: color-mix(in srgb, #060a12 68%, transparent);
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }
  @media (max-width: 760px) {
    .meme-room-cap {
      left: 1rem;
      right: 1rem;
      bottom: 0.7rem;
    }
  }

  /* ── MEME-POLISH-2026-08-03 ROUND 3 · NOCOVA ─────────────────────────────
     Its own distinct, lighter moment (operator: "it can look/feel lighter
     than the workshops") — an asymmetric copy/aside split (58/34, same
     proportion as the site's other staggers), with a translucent light card
     standing in for a photo (none exist yet). */
  .meme-nocova {
    position: relative;
    display: grid;
    gap: 0.6rem;
    margin: 0.6rem 0 0.4rem;
    padding-top: 1.6rem;
    border-top: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
  }
  /* varied section grounds — NOCOVA's own wash, a shade LIGHTER/more teal
     than the programs section above it (matches the operator's "it can
     look/feel lighter than the workshops" note; see the ::before comment on
     .meme-programs for the mechanism). */
  .meme-nocova::before {
    content: "";
    position: absolute;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    top: 0;
    bottom: 0;
    z-index: -1;
    background: color-mix(in srgb, #163449 100%, transparent);
  }
  .meme-nocova-grid {
    display: grid;
    grid-template-columns: 58fr 34fr;
    gap: 1.75rem;
    align-items: start;
    margin-top: 0.4rem;
  }
  .meme-nocova-copy {
    display: grid;
    gap: 0.9rem;
  }
  /* the lighter card: a translucent off-dark panel (not the page's own flat
     navy) plus a cyan accent kicker — the "social arm feels lighter than a
     workshop" cue, in place of a photo until one exists.
     MEME-STICKLER-2026-08-03 (layout verdict) — OVERLAPPING ELEMENT #2: the
     card now rises on a negative margin so it visually crosses this
     section's own top border/ground-tint boundary (the copy column's kicker
     + heading sit in the other grid track, so nothing text-on-text
     collides — verified by viewing the rendered page). Was +2.2rem
     (pushed down to balance the taller copy column); the overlap direction
     reverses that. */
  .meme-nocova-card {
    position: relative;
    z-index: 1;
    margin-top: -2.75rem;
    padding: 1.4rem 1.5rem;
    background: color-mix(in srgb, #ffffff 8%, transparent);
    border: 1px solid color-mix(in srgb, #ffffff 18%, transparent);
    border-radius: 10px;
    box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.5);
    display: grid;
    gap: 0.6rem;
    backdrop-filter: blur(6px);
  }
  .meme-nocova-card-kicker {
    letter-spacing: 0.22em;
    color: color-mix(in srgb, #38f8ec 82%, transparent);
  }
  .meme-nocova-venues {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.25rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: #f2f4f8;
  }
  .meme-nocova-freq {
    font-size: 0.78rem;
    line-height: 1.4;
    color: color-mix(in srgb, #eef2f5 62%, transparent);
  }
  /* future state once real photos land (see the NOCOVA-PHOTOS integration
     comment in the markup) — a small stacked column beside the copy. */
  .meme-nocova-photos {
    display: grid;
    gap: 0.8rem;
    margin-top: 2.2rem;
  }
  .meme-nocova-photo {
    margin: 0;
  }
  .meme-nocova-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, #ffffff 14%, transparent);
  }
  @media (max-width: 640px) {
    .meme-nocova-grid {
      grid-template-columns: 1fr;
    }
    .meme-nocova-card,
    .meme-nocova-photos {
      margin-top: 1.2rem;
    }
  }

  /* MEME-STICKLER-2026-08-03 (layout verdict) — the roster's own ground: a
     shade DARKER/cooler than NOCOVA's wash above it, so the page's three
     zones (workshops / social arm / people) each read as a distinct room.
     Also carries its own top rule + padding, same rhythm as the other two
     sections. */
  .meme-roster-section {
    position: relative;
    margin: 0.6rem 0 0.4rem;
    padding-top: 1.6rem;
    border-top: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
    display: grid;
    gap: 0.65rem;
  }
  .meme-roster-section::before {
    content: "";
    position: absolute;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    top: 0;
    bottom: 0;
    z-index: -1;
    background: color-mix(in srgb, #081522 100%, transparent);
  }

  /* MEME-POLISH-2026-08-03 REROSTER — down from a 5+2 team/instructor split
     (with 3 text-only placeholder rows) to 2 founders + 3 instructors, EVERY
     row now pictured (Amber's photo added, Shaun/Sindbad removed — see the
     ROSTER_LEADS header comment for the scope rule). No more text-only
     placeholder cards: uniform photo treatment throughout fixes the layout
     raggedness the operator flagged ("spots where things just don't fit").
     Founders get a slightly larger 2-up row (they're the leads); instructors
     stay the smaller 3-up row below. Both use the same 1:1 crop ratio. */
  .meme-roster {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 0.4rem auto 0.2rem;
    max-width: 36rem;
    width: 100%;
  }
  /* ROUND 3 — a small "vary section rhythm" touch: Nick's column runs
     slightly wider than Amber's (founder/ED, teaches the two flagship
     programs above) rather than a strict 50/50 split. Photo crop is
     object-fit:cover, so the uneven column widths crop nothing. */
  .meme-roster--leads {
    grid-template-columns: 61fr 39fr;
    max-width: 26rem;
  }
  .meme-roster--instructors {
    max-width: 36rem;
  }
  .meme-roster-card {
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .meme-roster-card img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, #ffffff 14%, transparent);
  }
  .meme-roster-card figcaption {
    display: grid;
    gap: 0.2rem;
  }
  .meme-roster-name {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: #f2f4f8;
  }
  .meme-roster-role {
    font-size: 0.78rem;
    line-height: 1.4;
    color: color-mix(in srgb, #eef2f5 70%, transparent);
  }
  .meme-roster-bio {
    font-size: 0.74rem;
    line-height: 1.45;
    color: color-mix(in srgb, #eef2f5 62%, transparent);
  }
  /* attribution for the one licensed/credited photo in this roster (Amber's,
     shot by April O'Hare Photography) — cropping the source's own watermark
     out and printing this line instead is the honest way to use it. */
  .meme-roster-credit {
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, #eef2f5 45%, transparent);
  }
  @media (max-width: 640px) {
    .meme-roster { grid-template-columns: 1fr 1fr; }
    .meme-roster--leads { grid-template-columns: 1fr 1fr; }
  }

  /* ── MEME-ARCHIVE-2026-08-03 ─────────────────────────────────────────
     The catalog's exit button. Deliberately the loudest single control on
     the page (cyan fill, not the usual hairline .link) because it is the
     one the operator actually wants pressed: "the whole point of these
     programs is to get you to go to the programs themselves." Cyan on the
     page's navy reads ~9:1, well clear of AA. */
  .meme-cta-strong {
    justify-self: start;
    display: inline-block;
    margin-top: 1.1rem;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    background: #38f8ec;
    color: #04121f;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }
  .meme-cta-strong:hover,
  .meme-cta-strong:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px -10px color-mix(in srgb, #38f8ec 60%, transparent);
  }

  /* "Beyond the classroom" — MEME's own archive, shown as photography rather
     than as card art. Ragged on purpose: the middle shot drops on a margin so
     the row reads as a hand-laid strip, not a third rectangle grid (the
     operator's standing note against "a lot of boxes"). */
  .meme-world {
    position: relative;
    display: grid;
    gap: 0.55rem;
    margin: 1.4rem 0 0.6rem;
    padding-top: 1.8rem;
    border-top: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
  }
  .meme-world::before {
    content: "";
    position: absolute;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    top: 0;
    bottom: -1.4rem;
    z-index: -1;
    background: color-mix(in srgb, #0d2237 100%, transparent);
  }
  .meme-world-lede {
    max-width: 46ch;
  }
  .meme-world-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
    margin-top: 1.1rem;
    align-items: start;
  }
  .meme-world-shot {
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }
  .meme-world-shot:nth-child(2) {
    margin-top: 2.4rem;
  }
  .meme-world-shot:nth-child(3) {
    margin-top: 1rem;
  }
  .meme-world-shot img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 8px;
    display: block;
    box-shadow: 0 18px 38px -14px rgba(0, 0, 0, 0.6);
  }
  .meme-world-shot figcaption {
    display: grid;
    gap: 0.15rem;
  }
  .meme-world-cap {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: #f2f4f8;
  }
  .meme-world-sub {
    font-size: 0.76rem;
    line-height: 1.45;
    color: color-mix(in srgb, #eef2f5 58%, transparent);
  }
  @media (max-width: 760px) {
    .meme-world-strip { grid-template-columns: 1fr; gap: 1.4rem; }
    .meme-world-shot:nth-child(2),
    .meme-world-shot:nth-child(3) { margin-top: 0; }
  }

  /* The outbound block — meme.ngo + the org's accounts. Two grouped columns
     over a social row, so the "go do the thing" links don't get read as
     footer furniture. */
  .meme-out {
    position: relative;
    display: grid;
    gap: 0.55rem;
    margin: 1.4rem 0 0.4rem;
    padding-top: 1.8rem;
    border-top: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
  }
  .meme-out-lede {
    max-width: 52ch;
  }
  .meme-out-groups {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem 2.2rem;
    margin-top: 1.2rem;
  }
  .meme-out-group-label {
    letter-spacing: 0.22em;
    color: color-mix(in srgb, #38f8ec 82%, transparent);
    margin-bottom: 0.6rem;
  }
  .meme-out-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .meme-out-link {
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid color-mix(in srgb, #ffffff 16%, transparent);
    border-radius: 8px;
    text-decoration: none;
    background: color-mix(in srgb, #ffffff 4%, transparent);
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }
  .meme-out-link:hover,
  .meme-out-link:focus-visible {
    border-color: color-mix(in srgb, #38f8ec 55%, transparent);
    background: color-mix(in srgb, #38f8ec 8%, transparent);
    transform: translateX(3px);
  }
  .meme-out-link-label {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 600;
    color: #f2f4f8;
  }
  .meme-out-link-note {
    font-size: 0.74rem;
    color: color-mix(in srgb, #eef2f5 55%, transparent);
  }
  .meme-out-social-label {
    margin-top: 1.6rem;
  }
  .meme-out-socials {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .meme-out-social {
    display: grid;
    gap: 0.05rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, #ffffff 18%, transparent);
    text-decoration: none;
    transition: border-color 160ms ease, background 160ms ease;
  }
  .meme-out-social:hover,
  .meme-out-social:focus-visible {
    border-color: color-mix(in srgb, #38f8ec 60%, transparent);
    background: color-mix(in srgb, #38f8ec 8%, transparent);
  }
  .meme-out-social-name {
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 600;
    color: #f2f4f8;
  }
  .meme-out-social-handle {
    font-size: 0.7rem;
    color: color-mix(in srgb, #eef2f5 52%, transparent);
  }
  @media (max-width: 640px) {
    .meme-out-groups { grid-template-columns: 1fr; }
  }

  .meme-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    border-top: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
    padding-top: 1.4rem;
    margin-top: 0.6rem;
  }

  /* ghost "M E M E" — faint letterforms behind the column (no-JS = at rest) */
  .meme-ghosts {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .meme-ghost {
    position: absolute;
    font-family: var(--font-sans);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(6rem, 18vw, 16rem);
    line-height: 1;
    color: color-mix(in srgb, #ffffff 5%, transparent);
  }
  .meme-ghost:nth-child(1) { left: 4%; top: 12%; }
  .meme-ghost:nth-child(2) { right: 8%; top: 30%; }
  .meme-ghost:nth-child(3) { left: 10%; bottom: 18%; }
  .meme-ghost:nth-child(4) { right: 4%; bottom: 8%; }

  @media (max-width: 640px) {
    .meme-ghost { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .meme-ghost { transform: none !important; }
  }
</style>

<script>
  // enhancement only: decode the slate label, and let the ghost letters drift
  // in and settle (their resting positions already live in CSS, so no-JS and
  // reduced-motion see the final, correct layout).
  const mountDecode = () => import("../../lib/decode-text").then(({ mountDecode }) => mountDecode(document));
  if ("requestIdleCallback" in window) requestIdleCallback(mountDecode, { timeout: 3000 });
  else setTimeout(mountDecode, 1500);

  (async () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia("(max-width: 640px)").matches) return;
    const { gsap } = await import("gsap");
    document.querySelectorAll<HTMLElement>("[data-im-ghost]").forEach((g, i) => {
      const dx = (i % 2 ? 1 : -1) * (36 + (i % 3) * 24);
      gsap.fromTo(
        g,
        { x: dx, y: 48, opacity: 0 },
        {
          x: 0,
          y: 0,
          opacity: 1,
          duration: 1.1,
          ease: "power3.out",
          delay: i * 0.08,
          onComplete: () => {
            gsap.to(g, {
              y: (i % 2 ? -1 : 1) * 10,
              duration: 5 + (i % 3) * 1.5,
              ease: "sine.inOut",
              yoyo: true,
              repeat: -1,
            });
          },
        },
      );
    });
  })();

  // ambient logo loop (P14b) — plays only when motion is allowed and the
  // figure is actually on-screen; the poster image underneath is the
  // permanent base layer, so reduced-motion / no-JS / autoplay-refused all
  // just show the still. Mirrors HeroVideo.astro's poster-first contract:
  // no native `autoplay`/`src`-at-parse-time, JS decides, muted always.
  (() => {
    const wrap = document.querySelector<HTMLElement>(".meme-loop-frame");
    const video = wrap?.querySelector<HTMLVideoElement>("[data-meme-loop]");
    if (!wrap || !video) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const conn = (navigator as { connection?: { saveData?: boolean } }).connection;
    if (conn?.saveData) return;

    video.addEventListener("playing", () => wrap.classList.add("is-playing"));

    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        if (entry.isIntersecting) video.play().catch(() => {}); // refusal → poster stands
        else video.pause();
      },
      { threshold: 0.2 },
    );
    io.observe(wrap);
    window.addEventListener("pagehide", () => io.disconnect(), { once: true });
  })();
</script>
