---
/**
 * /venture/meme — P14b: the MEME story. Sibling to /venture/amazing-aerial
 * (same venture-article grammar: slate, italic title, LegendMark proof, short
 * paragraphs, external + back links). Typographic only — NO photos exist for
 * this relationship yet, so the page carries a ghost "M E M E" letter motif
 * (entertainment.astro's grammar) in place of a media collage.
 *
 * ⚠ OPERATOR READ-APPROVAL REQUIRED — the ARTICLE prose below is new copy,
 * ADAPTED from the operator's own published bio at meme.ngo/meet-the-team
 * (operator-approved source, 2026-07-12: "reference what it says on the
 * website", reasonable copy adaptation allowed). Staging-only until he reads
 * it. Fact base (verbatim from that page): title "Member At-Large"; role
 * "Strategic Liaison and Scout … first point of contact for new talent";
 * self-description "a StorySmith, adventurer, and market strategist dedicated
 * to the art of audience discovery"; founded Adventure Storytelling Media;
 * cinematic drone work in Switzerland and Italy; the Boulder startup scene.
 * Org: Makeshift Entertainment Media Education (MEME), a Colorado nonprofit.
 *
 * The relationship claim itself renders ONLY through LegendMark, from the
 * LOCKED permitted phrasing in consts (RELATIONSHIPS "meme" → "Member
 * At-Large, MEME …, a Colorado nonprofit"). Never overstated to Board Chair
 * (that is Amber MacPherson — see the honesty note in consts.ts).
 */
import Base from "../../layouts/Base.astro";
import LegendMark from "../../components/LegendMark.astro";
import { PAGES } from "../../consts";
import { existsSync, statSync } from "node:fs";
import { join } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meme = PAGES.entertainment.meme; // proof = { relationshipId: "meme" }

// ghost letterforms — the page's own subject, scattered as faint backdrop
// (presentational; assembles under the engine, sits still with no-JS).
const ghost = ["M", "E", "M", "E"];

// ── the operator's MEME logo animatic (scripts/make-meme-loop.sh) — an
// ambient, always-looping moment: the org's own animated mark, muted, sitting
// between the proof block and the article text. Existence-gated + cache-busted
// like the rest of the site's build-time media checks (see Tableaux.astro,
// ko-law-workshops.astro).
const loopDir = join(process.cwd(), "public", "media", "venture", "meme");
const lv = (file: string) => {
  try {
    return `?v=${Math.round(statSync(join(loopDir, file)).mtimeMs).toString(36)}`;
  } catch {
    return "";
  }
};
const loop = existsSync(join(loopDir, "meme-loop.mp4"))
  ? {
      mp4: `${base}/media/venture/meme/meme-loop.mp4${lv("meme-loop.mp4")}`,
      posterAvif: `${base}/media/venture/meme/meme-poster.avif${lv("meme-poster.avif")}`,
      posterWebp: `${base}/media/venture/meme/meme-poster.webp${lv("meme-poster.webp")}`,
    }
  : undefined;

// Build #6 (2026-08-01 archive-mining integration) — copy refresh only, per
// _INTEGRATION-PLAN.md §1.6 ("bones — no new page, no padding"). Source:
// _STORY-STAGING/meme-origin-story/STORY.md, itself flagged BONES by its own
// miner (no real event photography exists yet for MEME). Only the
// origin/mission paragraphs below are new; the two "my role" paragraphs
// above stay exactly as they were (the personal-voice exception, unchanged).
//
// DATE VERIFICATION (per the plan's explicit gate — "verify both dates
// against meme.ngo before they become sentences"):
//  - March 15, 2020 founding date: CONFIRMED directly against the live
//    meme.ngo/about page, which states in its own words "MEME was founded
//    on the Ides of March in 2020, just as COVID-19 was becoming a major
//    societal problem." Two internal documents already agreed; the public
//    site is now a third, independent match.
//  - "Traces its origin to a market in 2019": NOT corroborated anywhere on
//    meme.ngo (checked both the home and about pages) — single-sourced to
//    one internal AI-assisted strategy document per the miner's own
//    manifest. Per the honesty rule, DROPPED rather than shipped as fact.
//    The AFM-2017 photo this claim would have illustrated is separately
//    rights-flagged and not used either (see below).
const memeShots = {
  nick: pair("venture/meme/nick-goins-portrait-640"),
  steve: pair("venture/meme/steve-borne-portrait-854"),
  adam: pair("venture/meme/adam-smestad-portrait-620"),
};
function pair(relBase: string) {
  const avif = media(`${relBase}.avif`);
  const webp = media(`${relBase}.webp`);
  return avif || webp ? { avif, webp } : undefined;
}
function media(rel: string) {
  return existsSync(join(process.cwd(), "public", "media", ...rel.split("/"))) ? `${base}/media/${rel}` : undefined;
}
const ROSTER = [
  { key: "nick", name: "Nick Goins", role: "Executive Director — runs Pitch Quorum and Market Fresh himself.", alt: "Close portrait of Nick Goins wearing a plaid flat cap, black t-shirt, looking directly at camera." },
  { key: "steve", name: "Steve Borne", role: "Teaches the two-part sound workshop — setting a shoot up for success on location, and what happens to that audio in post.", alt: "Portrait of Steve Borne, bald, glasses, gray beard, dark sweater, softly lit interior background." },
  { key: "adam", name: "Adam Smestad", role: "Teaches the production-assistant and script-supervisor workshops — the on-set roles most people learn by getting yelled at until they figure it out.", alt: "Studio portrait of Adam Smestad, bald, short beard, smiling, black blazer, gray backdrop." },
] as const;

// ── THE ARTICLE (all new sentences — see the approval note above) ──
const ARTICLE = {
  slate: "MEME · MAKESHIFT ENTERTAINMENT MEDIA EDUCATION",
  title: "The most formal role I hold in this world.",
  paragraphs: [
    "MEME — Makeshift Entertainment Media Education — is a Colorado nonprofit, and it holds the most formal title I carry anywhere: Member At-Large.",
    "The work is to be a Strategic Liaison and Scout — often the first point of contact for new talent. I look for storytellers worth backing, and help them find a way in.",
    // Build #6 — replaces the prior generic mission line with the
    // organization's own verified founding fact (meme.ngo/about, quoted
    // above) plus its actual teaching focus, sourced from the internal
    // playbook + one-pager (cross-checked, matching on every fact used).
    "MEME was founded on March 15, 2020 — the Ides of March, as the organization's own site puts it — just as COVID-19 was becoming a major societal problem. What it teaches is deliberately narrow: not directing, not cinematography — film schools already do that — but the business side of filmmaking that founders rarely get taught anywhere. The goal is to keep Colorado's filmmaking talent, and the projects it makes, from having to leave the state to get made.",
    // Build #6 — new roster paragraph, first person (matches this page's
    // established voice), names the instructors the roster grid below
    // pictures. Facts: Playbook Appendix + MEME_OnePager.html, matching.
    "Per MEME's own program materials, Nick Goins runs the organization as Executive Director and teaches its flagship programs himself, and the rest of the working roster is taught by people with real credits behind them — Steve Borne runs the sound workshop, and Adam Smestad teaches the on-set roles most people learn the hard way.",
    "It runs on the same instinct as everything else this studio makes: a StorySmith's read on what an audience will feel, and a market strategist's read on who that audience actually is.",
    "The cinematic drone work over Switzerland and Italy, the founders met around the Boulder startup scene, and this role at MEME are one practice — pointed at the same question: whose story is this, and who is it for?",
  ],
  ctas: [
    { label: "About the organization →", href: "https://www.meme.ngo", external: true },
    { label: "See the venture lane →", href: `${base}/venture`, external: false },
  ],
};
---

<Base title="MEME — a venture story" description="Member At-Large at MEME (Makeshift Entertainment Media Education), a Colorado nonprofit: Strategic Liaison and Scout for new storytellers.">
  <main class="meme-story">
    <div class="meme-ghosts" aria-hidden="true">
      {ghost.map((ch, i) => <span class="meme-ghost" data-im-ghost style={`--gi:${i}`}>{ch}</span>)}
    </div>
    <article class="meme-inner">
      <a href={`${base}/venture`} class="link meme-back">← Venture</a>
      <p class="hud-label meme-slate" data-reveal data-tableau-content>
        <span data-decode>{ARTICLE.slate}</span>
      </p>
      <h1 class="meme-title" data-reveal>{ARTICLE.title}</h1>
      <div class="meme-proof" data-reveal>
        <LegendMark proof={meme.proof} />
      </div>

      {
        loop && (
          <figure class="meme-loop-wrap" data-reveal>
            <picture>
              <source type="image/avif" srcset={loop.posterAvif} />
              <img class="meme-loop-poster" src={loop.posterWebp} alt="The MEME logo — a filmstrip-lettered M, on a deep blue textured ground." loading="lazy" decoding="async" />
            </picture>
            <video
              class="meme-loop-vid"
              data-meme-loop
              muted
              loop
              playsinline
              preload="metadata"
              poster={loop.posterWebp}
              aria-hidden="true"
            >
              <source src={loop.mp4} type="video/mp4" />
            </video>
            {/* ⚠ OPERATOR READ-APPROVAL REQUIRED — new copy, staging-only until read. */}
            <figcaption class="hud-label meme-loop-cap">MEME's own animated mark, in motion</figcaption>
          </figure>
        )
      }

      <!-- LAYOUT-OVERHAUL P5 (2026-08-01, see LAYOUT-RESEQUENCE-PLAN.md):
           the 6-paragraph stretch gets one typographic beat — a full-width
           pull quote after the founding-fact paragraph (Atavist device 8),
           and an asterisk divider before the roster (device 6). No new
           imagery; this is a bones page and stays one.
           ⚠ OPERATOR READ-APPROVAL REQUIRED — the pull quote is new visible
           copy (a tightened reprise of the paragraph above it; facts
           unchanged), staging-only until read. -->
      {ARTICLE.paragraphs.slice(0, 3).map((para) => <p class="meme-para" data-reveal>{para}</p>)}
      <blockquote class="meme-pull" data-reveal>
        Founded on the Ides of March, 2020 — built so Colorado's filmmaking talent doesn't have to leave the state.
      </blockquote>
      {ARTICLE.paragraphs.slice(3).map((para) => <p class="meme-para" data-reveal>{para}</p>)}

      <p class="meme-break" aria-hidden="true">✳</p>

      {/* Build #6 — the roster grid: 3 clean headshots (Nick, Steve, Adam).
          Amber MacPherson's headshot is cut (unconfirmed photo-credit
          watermark) and the AFM 2017 photo is cut (rights unresolved) —
          see the header note. Native-resolution images, not upscaled. */}
      <div class="meme-roster" data-reveal aria-label="The roster">
        {
          ROSTER.map((r) => {
            const shot = memeShots[r.key as keyof typeof memeShots];
            return shot ? (
              <figure class="meme-roster-card">
                <picture>
                  {shot.avif && <source srcset={shot.avif} type="image/avif" />}
                  <img src={shot.webp ?? shot.avif} alt={r.alt} loading="lazy" decoding="async" />
                </picture>
                <figcaption>
                  <span class="meme-roster-name">{r.name}</span>
                  <span class="meme-roster-role">{r.role}</span>
                </figcaption>
              </figure>
            ) : null;
          })
        }
      </div>

      <nav class="meme-ctas" data-reveal>
        {
          ARTICLE.ctas.map((c) => (
            <a href={c.href} class="link" rel={c.external ? "noopener" : undefined} target={c.external ? "_blank" : undefined}>
              {c.label}
            </a>
          ))
        }
      </nav>
      <a href={`${base}/venture`} class="link meme-back">← Venture</a>
    </article>
  </main>
</Base>

<style>
  .meme-story {
    position: relative;
    background: #0e2230; /* entertainment chapter 03 (MEME) ground — same room */
    min-height: 100svh;
    overflow: clip;
  }
  .meme-inner {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    margin-inline: auto;
    padding: 7rem 2rem 6rem;
    display: grid;
    gap: 1.5rem;
  }
  .meme-back {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .meme-slate {
    letter-spacing: 0.24em;
    color: color-mix(in srgb, #d9f2ec 75%, transparent);
  }
  .meme-title {
    font-family: var(--font-display);
    font-weight: 560;
    font-style: italic;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.12;
    color: #f2f4f8;
  }
  .meme-para {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.65;
    color: color-mix(in srgb, #eef2f5 86%, transparent);
  }

  /* ambient logo loop — a framed moment between the proof and the article,
     the org's own animated mark, always playing (never a hover trigger).
     Native 16:9 source, so aspect-ratio + object-fit:cover crops nothing.
     Poster image is the permanent base layer (no-JS / reduced-motion /
     autoplay-refused all land here); the video fades in over it once JS
     confirms motion is allowed and the figure is on-screen. */
  .meme-loop-wrap {
    position: relative;
    margin: 0.2rem 0 0;
    border: 1px solid color-mix(in srgb, #ffffff 14%, transparent);
    border-radius: 8px;
    overflow: hidden;
    background: color-mix(in srgb, #ffffff 4%, transparent);
    box-shadow: 0 0 32px -12px color-mix(in srgb, var(--color-accent, #38f8ec) 35%, transparent);
  }
  .meme-loop-poster {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .meme-loop-vid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 600ms var(--ease-survey, ease);
  }
  .meme-loop-wrap.is-playing .meme-loop-vid {
    opacity: 1;
  }
  .meme-loop-cap {
    position: absolute;
    left: 0.9rem;
    bottom: 0.8rem;
    margin: 0;
    letter-spacing: 0.18em;
    color: color-mix(in srgb, #f4fbfa 88%, transparent);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    .meme-loop-vid {
      transition: none;
    }
  }
  /* P5 — the one typographic beat in the text stretch: a plain full-width
     pull quote (no panel, no border — the Atavist device) */
  .meme-pull {
    margin: 0.6rem 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 560;
    font-size: clamp(1.35rem, 2.8vw, 1.9rem);
    line-height: 1.35;
    text-align: center;
    color: #f2f4f8;
  }
  /* P5 — bare asterisk chapter break before the roster (device 6) */
  .meme-break {
    margin: 0.4rem 0 0;
    text-align: center;
    font-size: 1.1rem;
    color: color-mix(in srgb, #d9f2ec 45%, transparent);
    letter-spacing: 0;
  }
  /* Build #6 — roster grid, 3 headshot cards. P5: scale-dropped to a
     masthead/contributors block (~11rem cells, centered) — deliberately
     smaller than a gallery so it reads as credits, not imagery. */
  .meme-roster {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 0.4rem auto 0.2rem;
    max-width: 36rem;
    width: 100%;
  }
  .meme-roster-card {
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .meme-roster-card img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, #ffffff 14%, transparent);
  }
  .meme-roster-card figcaption {
    display: grid;
    gap: 0.2rem;
  }
  .meme-roster-name {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: #f2f4f8;
  }
  .meme-roster-role {
    font-size: 0.78rem;
    line-height: 1.4;
    color: color-mix(in srgb, #eef2f5 70%, transparent);
  }
  @media (max-width: 640px) {
    .meme-roster { grid-template-columns: 1fr 1fr; }
  }

  .meme-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    border-top: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
    padding-top: 1.4rem;
    margin-top: 0.6rem;
  }

  /* ghost "M E M E" — faint letterforms behind the column (no-JS = at rest) */
  .meme-ghosts {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .meme-ghost {
    position: absolute;
    font-family: var(--font-sans);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(6rem, 18vw, 16rem);
    line-height: 1;
    color: color-mix(in srgb, #ffffff 5%, transparent);
  }
  .meme-ghost:nth-child(1) { left: 4%; top: 12%; }
  .meme-ghost:nth-child(2) { right: 8%; top: 30%; }
  .meme-ghost:nth-child(3) { left: 10%; bottom: 18%; }
  .meme-ghost:nth-child(4) { right: 4%; bottom: 8%; }

  @media (max-width: 640px) {
    .meme-ghost { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .meme-ghost { transform: none !important; }
  }
</style>

<script>
  // enhancement only: decode the slate label, and let the ghost letters drift
  // in and settle (their resting positions already live in CSS, so no-JS and
  // reduced-motion see the final, correct layout).
  const mountDecode = () => import("../../lib/decode-text").then(({ mountDecode }) => mountDecode(document));
  if ("requestIdleCallback" in window) requestIdleCallback(mountDecode, { timeout: 3000 });
  else setTimeout(mountDecode, 1500);

  (async () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia("(max-width: 640px)").matches) return;
    const { gsap } = await import("gsap");
    document.querySelectorAll<HTMLElement>("[data-im-ghost]").forEach((g, i) => {
      const dx = (i % 2 ? 1 : -1) * (36 + (i % 3) * 24);
      gsap.fromTo(
        g,
        { x: dx, y: 48, opacity: 0 },
        {
          x: 0,
          y: 0,
          opacity: 1,
          duration: 1.1,
          ease: "power3.out",
          delay: i * 0.08,
          onComplete: () => {
            gsap.to(g, {
              y: (i % 2 ? -1 : 1) * 10,
              duration: 5 + (i % 3) * 1.5,
              ease: "sine.inOut",
              yoyo: true,
              repeat: -1,
            });
          },
        },
      );
    });
  })();

  // ambient logo loop (P14b) — plays only when motion is allowed and the
  // figure is actually on-screen; the poster image underneath is the
  // permanent base layer, so reduced-motion / no-JS / autoplay-refused all
  // just show the still. Mirrors HeroVideo.astro's poster-first contract:
  // no native `autoplay`/`src`-at-parse-time, JS decides, muted always.
  (() => {
    const wrap = document.querySelector<HTMLElement>(".meme-loop-wrap");
    const video = wrap?.querySelector<HTMLVideoElement>("[data-meme-loop]");
    if (!wrap || !video) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const conn = (navigator as { connection?: { saveData?: boolean } }).connection;
    if (conn?.saveData) return;

    video.addEventListener("playing", () => wrap.classList.add("is-playing"));

    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        if (entry.isIntersecting) video.play().catch(() => {}); // refusal → poster stands
        else video.pause();
      },
      { threshold: 0.2 },
    );
    io.observe(wrap);
    window.addEventListener("pagehide", () => io.disconnect(), { once: true });
  })();
</script>
