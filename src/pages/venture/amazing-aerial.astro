---
/**
 * /venture/amazing-aerial — REDESIGN (2026-08-13, operator-directed: "the
 * layout is pretty formulaic… utilize a lot more of the recent photos… a lot
 * of call to action buttons that are attractive and interesting that get
 * people to go to specifically my page on Amazing Aerial").
 *
 * Direction chosen by the operator from three staged options: THE LIVING
 * COLLECTION.
 *
 * THESIS: the collection is alive and growing — the page proves it with the
 * newest work first. Refuses the article-with-a-collage default it replaces.
 * OWN-WORLD: the site's survey grammar — near-black ground, cyan accent,
 * Fraunces display, mono slates — carried photo-first: full-bleed frames,
 * location-stamped, watermarked previews standing as what licensing looks like.
 * STORY: a visitor sees fresh aerials, learns the agent arrangement in the
 * operator's own approved words, and leaves for his Amazing Aerial portfolio.
 * FIRST VIEWPORT: an edge-to-edge Twin Lakes aerial; AA lockup and slate top,
 * headline and the primary "License the collection" action lower-left.
 * FORM: user-pinned (beats the roll per new-work §3); no seed run.
 *
 * ── HONESTY RAILS (unchanged from the P13g build) ─────────────────────────
 * The four ARTICLE paragraphs are KEPT VERBATIM from the approval queue.
 * Locked phrasing only: contributor / licensed-through / "official agent
 * arrangement with the collection" — never "represented exclusively", never
 * ownership. The AA mark is nominative editorial use, operator-authorized.
 * "Thousands of aerial photographs" is the operator-approved collection-scale
 * phrasing (2026-08-13; counts never numerized).
 * ⚠ OPERATOR READ-APPROVAL REQUIRED — new non-verbatim strings are the section
 * headings, the strip intro line, the ribbon, and the CTA labels (staging-only
 * until read). Photo slates carry only place + month, from the notes' own
 * frontmatter dates.
 *
 * Watermark discipline (matches the field notes): the HERO is the unmarked
 * covers/ export; every collection preview below is the marked gallery/ export
 * — the watermarks aren't a compromise, they ARE the story.
 */
import Base from "../../layouts/Base.astro";
import LegendMark from "../../components/LegendMark.astro";
import { PAGES } from "../../consts";
import { existsSync } from "node:fs";
import { join } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const aa = PAGES.adventure.licensed; // the locked licensed-relationship block
const AA_PORTFOLIO = PAGES.adventure.aaFunnel.cta.href;

const logoAbs = join(process.cwd(), "public", "media", "adventure", "aa-logo.png");
const hasLogo = existsSync(logoAbs);
const LOGO = `${base}/media/adventure/aa-logo.png`;

// Existence-gated frame lookup over BOTH ladders (landscape 800/1400/2200,
// vertical 800/1120/1600), from either the marked gallery or the clean covers.
const MEDIA = join(process.cwd(), "public", "media", "adventure");
const ALL_WIDTHS = [800, 1120, 1400, 1600, 2200];
function frame(dir: "gallery" | "covers", slug: string) {
  const root = join(MEDIA, dir);
  if (!existsSync(join(root, `${slug}-800.avif`))) return undefined;
  const widths = ALL_WIDTHS.filter((w) => existsSync(join(root, `${slug}-${w}.avif`)));
  const set = (ext: string) =>
    widths.map((w) => `${base}/media/adventure/${dir}/${slug}-${w}.${ext} ${w}w`).join(", ");
  return { avif: set("avif"), webp: set("webp"), src: `${base}/media/adventure/${dir}/${slug}-800.webp` };
}

// HERO — the newest marquee frame, clean (the covers export the operator
// approved as the twin-lakes field-note lead).
const hero = frame("covers", "twin-lakes-01");

// FRESH FROM THE FIELD — the August 2026 Colorado flights, marked previews.
// Slates carry place + month only (dates from the notes' own frontmatter).
const FRESH = [
  { slug: "twin-lakes-02", place: "Twin Lakes, Colorado", date: "Aug 2026" },
  { slug: "clinton-gulch-01", place: "Clinton Gulch, Colorado", date: "Aug 2026" },
  { slug: "clear-creek-02", place: "Clear Creek Reservoir, Colorado", date: "Aug 2026" },
  { slug: "twin-lakes-03", place: "Twin Lakes, Colorado", date: "Aug 2026" },
  { slug: "clinton-gulch-03", place: "Climax tailings, Colorado", date: "Aug 2026" },
  { slug: "clear-creek-03", place: "Clear Creek Reservoir, Colorado", date: "Aug 2026" },
  { slug: "clinton-gulch-04", place: "Climax tailings, Colorado", date: "Aug 2026" },
  { slug: "clear-creek-04", place: "Clear Creek Reservoir, Colorado", date: "Aug 2026" },
  { slug: "clinton-gulch-02", place: "Clinton Gulch, Colorado", date: "Aug 2026" },
].map((f) => ({ ...f, media: frame("gallery", f.slug) })).filter((f) => f.media);

// THE COLLECTION — the rest of the represented leads, marked. (The old page
// silently dropped one slug here: lac-de-tseuzier-01 never existed — the lead
// is -02. Fixed in passing.)
const WALL = [
  { slug: "matterhorn-zermatt-01", place: "Zermatt, Switzerland" },
  { slug: "bellagio-01", place: "Bellagio, Lake Como" },
  { slug: "eldorado-springs-01", place: "Eldorado Springs, Colorado" },
  { slug: "castel-toblino-01", place: "Castel Toblino, Trentino" },
  { slug: "lac-de-tseuzier-02", place: "Lac de Tseuzier, Valais" },
  { slug: "varenna-lake-como-01", place: "Varenna, Lake Como" },
  { slug: "gornergrat-glacier-01", place: "Gornergrat, Switzerland" },
  { slug: "flatirons-chautauqua-03", place: "The Flatirons, Colorado" },
  { slug: "lugano-01", place: "Lugano, Ticino" },
  { slug: "madonna-di-campiglio-01", place: "Madonna di Campiglio, Dolomites" },
].map((f) => ({ ...f, media: frame("gallery", f.slug) })).filter((f) => f.media);

// The story — VERBATIM from the P13g approval queue. Do not edit here.
const ARTICLE = {
  slate: "AMAZING AERIAL AGENCY · OFFICIAL AGENT · SINCE MID-2024",
  title: "The agency that takes our aerials to market.",
  facts: ["SINCE MID-2024", "OFFICIAL AGENT", "FRONT RANGE · THE ALPS"],
  paragraphs: [
    "In June 2024, a LinkedIn conversation with Amazing Aerial's founder, Paul, turned into a month of talking — and by mid-2024 it was an official agent arrangement with the collection.",
    "The arrangement is simple and honest: we chase the frames, from the Front Range to the Alps, and Amazing Aerial licenses them to the people who need them. The aerial work you see across our adventure pages lives with them.",
    "It's the quiet engine behind the adventure stories — every expedition feeds the collection, and the collection funds the next one.",
    "And it matters that every frame is real. None of it is generated — from the peaks of Zermatt to rooftops in Colorado, the work is shot, flown, and edited on location, never stock filler and never an AI rendering. Audiences can tell what's real, and that's what earns belief.",
  ],
};

// The ribbon line, repeated for the marquee. Composed ONLY of the approved
// collection-scale phrasing + the locked permitted phrasing.
const RIBBON = "Thousands of aerial photographs · One collection · Licensed through Amazing Aerial Agency";
---

<Base
  title="Amazing Aerial — the agency story"
  description="How our aerial work reaches the market: an official agent with Amazing Aerial Agency since mid-2024. The collection is live and growing."
>
  <main class="aax">
    <!-- ═ 1 · HERO — the newest marquee frame, edge to edge ═══════════════ -->
    <section class="aax-hero">
      {hero && (
        <picture class="aax-hero-media">
          <source type="image/avif" srcset={hero.avif} sizes="100vw" />
          <source type="image/webp" srcset={hero.webp} sizes="100vw" />
          <img
            src={hero.src}
            alt="Twin Lakes, Colorado from the air — a turquoise channel between sandbars, the Sawatch Range behind"
            loading="eager"
            decoding="async"
          />
        </picture>
      )}
      <div class="aax-hero-scrim" aria-hidden="true"></div>

      <a href={`${base}/venture`} class="aax-back hud-label">← Venture</a>

      <div class="aax-hero-top" data-reveal>
        {hasLogo && (
          <img class="aax-logo" src={LOGO} alt="Amazing Aerial Agency" width="480" height="158" loading="eager" decoding="async" />
        )}
        <p class="hud-label aax-slate"><span data-decode>{ARTICLE.slate}</span></p>
      </div>

      <div class="aax-hero-foot">
        <h1 class="aax-title" data-reveal>{ARTICLE.title}</h1>
        <div class="aax-hero-ctas" data-reveal>
          <a href={AA_PORTFOLIO} class="aax-btn aax-btn--primary" rel="noopener" target="_blank">
            <span>License the collection</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
          <a href="https://www.amazingaerial.com/" class="aax-btn aax-btn--ghost" rel="noopener" target="_blank">
            <span>About the agency</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="hud-label aax-hero-stamp">Twin Lakes, Colorado · Aug 2026 · shot, flown &amp; edited on location</p>
      </div>
    </section>

    <!-- ═ 2 · THE RIBBON — a moving line that is itself the door ══════════ -->
    <a href={AA_PORTFOLIO} class="aax-ribbon" rel="noopener" target="_blank" aria-label="Thousands of aerial photographs, one collection — licensed through Amazing Aerial Agency. Visit the portfolio.">
      <div class="aax-ribbon-track" aria-hidden="true">
        {[0, 1].map(() => (
          <span class="aax-ribbon-run">
            {[0, 1, 2].map(() => (
              <span class="aax-ribbon-line">{RIBBON} <span class="aax-ribbon-arrow">→</span> </span>
            ))}
          </span>
        ))}
      </div>
    </a>

    <!-- ═ 3 · FRESH FROM THE FIELD — the strip that proves it's alive ═════ -->
    <section class="aax-fresh" aria-labelledby="aax-fresh-h">
      <div class="aax-band-head">
        <h2 id="aax-fresh-h" class="aax-h2" data-reveal>Fresh from the field</h2>
        <p class="aax-lede" data-reveal>
          The three newest flights, straight into the collection — Colorado's high country, August 2026.
        </p>
      </div>
      <div class="aax-strip" tabindex="0" role="group" aria-label="Newest frames, scroll sideways">
        {FRESH.map((f) => (
          <figure class="aax-cell">
            <picture>
              <source type="image/avif" srcset={f.media!.avif} sizes="(max-width: 640px) 78vw, 30rem" />
              <source type="image/webp" srcset={f.media!.webp} sizes="(max-width: 640px) 78vw, 30rem" />
              <img src={f.media!.src} alt={`Aerial frame — ${f.place}`} loading="lazy" decoding="async" />
            </picture>
            <figcaption class="hud-label aax-cell-slate">{f.place} · {f.date}</figcaption>
          </figure>
        ))}
        <a href={AA_PORTFOLIO} class="aax-cell aax-cell--cta" rel="noopener" target="_blank">
          <span class="aax-cell-cta-kicker hud-label">The strip keeps going</span>
          <span class="aax-cell-cta-line">See what's new on Amazing Aerial</span>
          <span class="aax-btn aax-btn--primary aax-cell-cta-btn" aria-hidden="true">
            <span>Open the portfolio</span>
            <span class="arrow">↗</span>
          </span>
        </a>
      </div>
    </section>

    <!-- ═ 4 · THE STORY — the approved prose, beside a tall frame ═════════ -->
    <section class="aax-story" aria-labelledby="aax-story-h">
      <div class="aax-story-text">
        <h2 id="aax-story-h" class="aax-h2" data-reveal>How the arrangement works</h2>
        <div class="aax-proof" data-reveal><LegendMark proof={aa.proof} /></div>
        {ARTICLE.paragraphs.map((para) => <p class="aax-para" data-reveal>{para}</p>)}
        <ul class="aax-facts" aria-label="At a glance">
          {ARTICLE.facts.map((f) => <li class="aax-chip hud-label">{f}</li>)}
        </ul>
      </div>
      {WALL[9]?.media && (
        <figure class="aax-story-figure" data-reveal>
          <picture>
            <source type="image/avif" srcset={WALL[9].media.avif} sizes="(max-width: 900px) 92vw, 24rem" />
            <source type="image/webp" srcset={WALL[9].media.webp} sizes="(max-width: 900px) 92vw, 24rem" />
            <img src={WALL[9].media.src} alt={`Aerial frame — ${WALL[9].place}`} loading="lazy" decoding="async" />
          </picture>
          <figcaption class="hud-label aax-cell-slate">{WALL[9].place}</figcaption>
        </figure>
      )}
    </section>

    <!-- ═ 5 · THE COLLECTION WALL — the mosaic is the door ════════════════ -->
    <section class="aax-wall-wrap" aria-labelledby="aax-wall-h">
      <div class="aax-band-head">
        <h2 id="aax-wall-h" class="aax-h2" data-reveal>The represented collection</h2>
        <p class="aax-lede" data-reveal>Front Range to the Alps — every frame below is licensable through the agency.</p>
      </div>
      <div class="aax-wall">
        {WALL.slice(0, 9).map((f) => (
          <a class="aax-tile" href={AA_PORTFOLIO} rel="noopener" target="_blank" aria-label={`${f.place} — view the collection on Amazing Aerial`}>
            <picture>
              <source type="image/avif" srcset={f.media!.avif} sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw" />
              <source type="image/webp" srcset={f.media!.webp} sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw" />
              <img src={f.media!.src} alt={`Aerial frame — ${f.place}`} loading="lazy" decoding="async" />
            </picture>
            <span class="aax-tile-veil" aria-hidden="true">
              <span class="hud-label aax-tile-place">{f.place}</span>
              <span class="aax-tile-go">View in the collection <span class="arrow">↗</span></span>
            </span>
          </a>
        ))}
      </div>
      <p class="hud-label aax-wall-cap">Aerial work licensed through Amazing Aerial Agency</p>
    </section>

    <!-- ═ 6 · THE CLOSE — the funnel panel ════════════════════════════════ -->
    <section class="aax-close" aria-labelledby="aax-close-h">
      <div class="aax-close-panel">
        <span class="aax-close-grid" aria-hidden="true"></span>
        <span class="aax-close-shimmer" aria-hidden="true"></span>
        <div class="aax-close-inner">
          {hasLogo && (
            <img class="aax-logo aax-close-logo" src={LOGO} alt="Amazing Aerial Agency" width="480" height="158" loading="lazy" decoding="async" />
          )}
          <h2 id="aax-close-h" class="aax-close-h">{PAGES.adventure.aaFunnel.heading}</h2>
          <p class="aax-close-body">{PAGES.adventure.aaFunnel.body}</p>
          <a href={AA_PORTFOLIO} class="aax-btn aax-btn--primary aax-close-cta" rel="noopener" target="_blank">
            <span>{PAGES.adventure.aaFunnel.cta.label}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
          <nav class="aax-close-links" aria-label="Related">
            <a href={`${base}/work/amazing-aerial`} class="link">The highlights reel <span class="arrow" aria-hidden="true">→</span></a>
            <a href={`${base}/adventure`} class="link">More adventure stories <span class="arrow" aria-hidden="true">→</span></a>
            <a href={`${base}/venture`} class="link">← Venture</a>
          </nav>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .aax {
    background: #10141f; /* the venture rooms ground */
    min-height: 100svh;
  }

  /* ── shared type + buttons ─────────────────────────────────────────── */
  .aax-h2 {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    color: #f2f4f8;
    text-wrap: balance;
  }
  .aax-lede {
    color: color-mix(in srgb, #eef2f5 78%, transparent);
    max-width: 52ch;
  }
  .aax-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 46px;
    padding: 0.75rem 1.3rem;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      border-color var(--dur-hover, 160ms) var(--ease-swift),
      background-color var(--dur-hover, 160ms) var(--ease-swift),
      color var(--dur-hover, 160ms) var(--ease-swift),
      box-shadow var(--dur-hover, 160ms) var(--ease-swift);
  }
  .aax-btn .arrow { display: inline-block; transition: transform var(--dur-hover, 160ms) var(--ease-swift); }
  .aax-btn:hover .arrow, .aax-btn:focus-visible .arrow { transform: translate(3px, -3px); }
  .aax-btn--primary {
    background: color-mix(in srgb, var(--color-accent, #38f8ec) 14%, #0c1018);
    border: 1px solid color-mix(in srgb, var(--color-accent, #38f8ec) 55%, transparent);
    color: var(--color-accent, #38f8ec);
  }
  .aax-btn--primary:hover, .aax-btn--primary:focus-visible {
    background: color-mix(in srgb, var(--color-accent, #38f8ec) 24%, #0c1018);
    box-shadow: 0 6px 32px -8px color-mix(in srgb, var(--color-accent, #38f8ec) 60%, transparent);
  }
  .aax-btn--ghost {
    border: 1px solid color-mix(in srgb, #ffffff 26%, transparent);
    color: color-mix(in srgb, #eef2f5 90%, transparent);
    background: color-mix(in srgb, #0c1018 55%, transparent);
  }
  .aax-btn--ghost:hover, .aax-btn--ghost:focus-visible {
    border-color: var(--color-accent, #38f8ec);
    color: var(--color-accent, #38f8ec);
  }

  /* ── 1 · hero ──────────────────────────────────────────────────────── */
  .aax-hero {
    position: relative;
    min-height: 86svh;
    display: grid;
    align-content: end;
    overflow: hidden;
  }
  .aax-hero-media, .aax-hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .aax-hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8, 11, 18, 0.72) 0%, rgba(8, 11, 18, 0.05) 34%, rgba(8, 11, 18, 0.08) 55%, rgba(8, 11, 18, 0.88) 100%);
  }
  .aax-back {
    position: absolute;
    top: 1.1rem;
    left: 1.4rem;
    z-index: 3;
    letter-spacing: 0.16em;
    color: color-mix(in srgb, #eef2f5 82%, transparent);
  }
  .aax-back:hover { color: var(--color-accent, #38f8ec); }
  .aax-hero-top {
    position: absolute;
    top: 3.2rem;
    left: 1.4rem;
    right: 1.4rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .aax-logo { height: 2.2rem; width: auto; }
  .aax-slate {
    letter-spacing: 0.24em;
    color: color-mix(in srgb, #d9f2ec 82%, transparent);
    margin: 0;
  }
  .aax-hero-foot {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    padding: 0 1.4rem 2.2rem;
    max-width: 60rem;
  }
  .aax-title {
    font-family: var(--font-display);
    font-weight: 560;
    font-style: italic;
    font-size: clamp(2.1rem, 5vw, 3.9rem);
    line-height: 1.08;
    color: #f5f7fa;
    text-wrap: balance;
    text-shadow: 0 2px 26px rgba(5, 8, 14, 0.55);
  }
  .aax-hero-ctas { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .aax-hero-stamp {
    letter-spacing: 0.18em;
    color: color-mix(in srgb, #d9f2ec 66%, transparent);
  }

  /* ── 2 · ribbon ────────────────────────────────────────────────────── */
  .aax-ribbon {
    display: block;
    overflow: hidden;
    border-block: 1px solid color-mix(in srgb, var(--color-accent, #38f8ec) 30%, transparent);
    background: color-mix(in srgb, var(--color-accent, #38f8ec) 7%, #0c1018);
    padding: 0.65rem 0;
  }
  .aax-ribbon-track { display: flex; width: max-content; animation: aax-ribbon 36s linear infinite; }
  .aax-ribbon-run { display: inline-flex; white-space: nowrap; }
  .aax-ribbon-line {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-accent, #38f8ec) 88%, #ffffff);
    padding-inline: 1.2rem;
  }
  .aax-ribbon-arrow { color: var(--color-accent, #38f8ec); }
  .aax-ribbon:hover .aax-ribbon-track, .aax-ribbon:focus-visible .aax-ribbon-track { animation-play-state: paused; }
  .aax-ribbon:hover .aax-ribbon-line { color: var(--color-accent, #38f8ec); }
  @keyframes aax-ribbon { to { transform: translateX(-50%); } }

  /* ── 3 · fresh strip ───────────────────────────────────────────────── */
  .aax-band-head {
    max-width: 72rem;
    margin-inline: auto;
    padding: 3.4rem 1.4rem 1.2rem;
    display: grid;
    gap: 0.5rem;
  }
  .aax-strip {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding: 0.2rem 1.4rem 1.6rem;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--color-accent, #38f8ec) 45%, transparent) transparent;
  }
  .aax-cell {
    flex: 0 0 auto;
    scroll-snap-align: start;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    background: color-mix(in srgb, #ffffff 4%, transparent);
  }
  .aax-cell picture, .aax-cell img { display: block; height: 19rem; width: auto; }
  .aax-cell-slate {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    margin: 0;
    padding: 0.3rem 0.55rem;
    background: rgba(8, 11, 18, 0.72);
    border-radius: 2px;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, #eef2f5 88%, transparent);
  }
  .aax-cell--cta {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 0.9rem;
    min-width: 19rem;
    padding: 1.6rem;
    background:
      radial-gradient(120% 130% at 15% 0%, color-mix(in srgb, var(--color-accent-deep, #1e8f8a) 26%, transparent) 0%, transparent 60%),
      #0c1018;
    border: 1px solid color-mix(in srgb, var(--color-accent, #38f8ec) 35%, transparent);
  }
  .aax-cell-cta-kicker { letter-spacing: 0.2em; color: color-mix(in srgb, #d9f2ec 70%, transparent); }
  .aax-cell-cta-line {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: 1.35rem;
    line-height: 1.2;
    color: #f2f4f8;
    max-width: 16ch;
    text-wrap: balance;
  }
  .aax-cell--cta:hover .aax-cell-cta-btn, .aax-cell--cta:focus-visible .aax-cell-cta-btn {
