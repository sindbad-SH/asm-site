  <!-- §2e hover-distortion (feature-gated; CSS fallback is the default) -->
  <DistortionLayer />
</Base>

<style>
  /* ── THE TRAVEL-STORIES INDEX (2026-08-06) — replaces the .dispatch-* list.
     One rule carries all three registers: WIDTH COMES FROM SHAPE.

     These live in the PAGE-SCOPED style block, not global.css, and must stay
     here: Astro emits page styles UNLAYERED while global.css sits inside a
     @layer, and unlayered beats layered regardless of specificity — a
     primitive added there would be inert against these rules. ── */

  /* ① THE LEAD */
  .df-lead {
    display: block;
    margin-top: clamp(1.2rem, 3vw, 1.9rem);
    text-decoration: none;
    color: inherit;
  }
  .df-plate {
    display: block;
    overflow: hidden;
    border-radius: 10px;
    aspect-ratio: var(--ar); /* measured from the file itself at build */
    background: color-mix(in srgb, var(--color-elevated) 70%, transparent);
  }
  .df-plate img {
    display: block;
    width: 100%;
    height: auto; /* native aspect — never object-fit, never cropped */
    filter: saturate(0.94) brightness(0.96);
    transition: filter var(--dur-hover, 220ms) var(--ease-swift);
  }
  .df-lead:hover .df-plate img,
  .df-lead:focus-visible .df-plate img,
  .df-two:hover .df-plate img,
  .df-two:focus-visible .df-plate img {
    filter: none;
  }
  .df-say {
    display: grid;
    gap: 0.5rem;
  }
  .df-where {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-muted);
  }
  .df-head {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 3.4vw, 2.35rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--color-peak);
    transition: color var(--dur-hover, 160ms) var(--ease-swift);
  }
  .df-head--sm {
    font-size: clamp(1.05rem, 1.9vw, 1.28rem);
    line-height: 1.2;
  }
  .df-deck {
    font-size: 0.92rem;
    line-height: 1.5;
    max-width: 38ch;
    color: var(--color-ink);
  }

  /* Measured while building this: --color-accent-deep on --color-elevated is
     3.99:1, BELOW WCAG AA. It only clears 4.5:1 on --color-base (4.54:1),
     which is what the 2026-08-02 audit-fix tuned it for. This cue sits ON the
     elevated slab, so it rests in ink-muted (5.27:1) and fires accent only on
     hover. The token itself wants a separate sweep. */
  .df-cue {
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    color: var(--color-ink-muted);
    transition: color var(--dur-hover, 160ms) var(--ease-swift);
  }
  .df-cue .arrow {
    display: inline-block;
    transition: transform var(--dur-hover, 160ms) var(--ease-swift);
  }
  .df-lead:hover .df-cue,
  .df-lead:focus-visible .df-cue {
    color: var(--color-accent);
  }
  .df-lead:hover .df-cue .arrow,
  .df-lead:focus-visible .df-cue .arrow {
    transform: translateX(5px);
  }

  /* ② THE SHOULDER — a plain asymmetric pair. */
  .df-shoulder {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1rem, 2.4vw, 1.9rem);
    align-items: start;
    margin-top: clamp(2.4rem, 5vw, 3.6rem);
  }
  .df-two {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
  }
  .df-two:nth-child(2) {
    margin-top: clamp(1.1rem, 3.2vw, 2.8rem); /* the hand-hung drop */
  }
  .df-two-say {
    display: grid;
    gap: 0.25rem;
  }
  .df-two:hover .df-head,
  .df-two:focus-visible .df-head {
    color: var(--color-accent);
  }

  /* ③ THE FOLIO — `columns: 3 17rem` picks its own column count (3/2/1) with
     no breakpoints; `break-inside: avoid` keeps each territory whole so groups
     PACK rather than forming a grid. Column depth varies with how many
     dispatches a territory holds — real data, not decoration. */
  .df-folio {
    margin-top: clamp(2.4rem, 5vw, 3.4rem);
    /* the deepest column's last row otherwise lands 16px off the field board —
       the group margin-bottom is contained by the multicol box, so the gap to
       the board has to be declared here */
    margin-bottom: clamp(2rem, 4vw, 3rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--color-hairline);
    columns: 3 17rem;
    column-gap: clamp(1.6rem, 4vw, 3rem);
  }
  .df-terr {
    break-inside: avoid;
    margin: 0 0 1.8rem;
  }
  .df-terr-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.35rem;
  }
  .df-terr-name {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-ink-muted);
  }
  .df-terr-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-accent) 45%, transparent),
      color-mix(in srgb, var(--color-accent) 8%, transparent)
    );
  }
  .df-terr-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .df-terr-list li + li {
    border-top: 1px solid var(--color-hairline);
  }
  .df-terr-list a {
    position: relative;
    display: grid;
    gap: 0.12rem;
    padding: 0.6rem 0;
    text-decoration: none;
    color: inherit;
  }
  .df-fh {
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.28;
    color: var(--color-peak);
    transition: color var(--dur-hover, 160ms) var(--ease-swift);
  }
  .df-fp {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--color-ink-muted);
  }
  .df-terr-list a:hover .df-fh,
  .df-terr-list a:focus-visible .df-fh {
    color: var(--color-accent);
  }
  /* the you-are-here contour draws out of the gutter — the accent-discipline
     doc's own sanctioned use of cyan, at row scale */
  .df-terr-list a::before {
    content: "";
    position: absolute;
    left: -0.85rem;
    top: 1.02rem;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width var(--dur-hover, 160ms) var(--ease-swift);
  }
  .df-terr-list a:hover::before,
  .df-terr-list a:focus-visible::before {
    width: 0.55rem;
  }

  /* the lead's caption slab only overlaps where there is room for it */
  @media (min-width: 900px) {
    .df-lead {
      display: grid;
      grid-template-columns: var(--plate-w) minmax(0, 1fr);
      align-items: end;
    }
    .df-lead .df-plate {
      grid-column: 1;
