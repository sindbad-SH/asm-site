<style>
  /* ── PUB-A · the dispatch stream — a numbered list of every Field Notes
     entry, replacing the retired hire-the-operator panel. Space Mono index
     + date, serif title, hairline row dividers; the whole row is the link
     (matches the site's .signpost-link affordance on home).
     2026-08-03 design audit — this was a bare text list (no imagery) right
     between the hero and the art-directed Territory map, the site's own
     named "dead trough" pattern. Each row now carries a lead thumbnail
     (dispatch-thumb) pulled from the same gallery bake every field note
     already has — align-items moves from baseline to center to seat it. ── */
  .dispatch-list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
  }
  .dispatch-row {
    border-top: 1px solid var(--color-hairline);
  }
  .dispatch-row:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }
  .dispatch-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 0.1rem;
    text-decoration: none;
    color: inherit;
    transition: color var(--dur-hover, 160ms) var(--ease-swift);
  }
  .dispatch-link:hover,
  .dispatch-link:focus-visible {
    color: var(--color-accent, #38f8ec);
  }
  .dispatch-no {
    flex: none;
    color: var(--color-ink-muted, #8a9a96);
  }
  .dispatch-thumb {
    flex: none;
    display: block;
    width: 3.5rem;
    height: 3.5rem;
    overflow: hidden;
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-surface, #171b22) 70%, transparent);
  }
  .dispatch-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) brightness(0.94);
