---
/**
 * Adventure — credibility lane, "the wild" (BUILD-PLAN.md §1.3, amended §9.3
 * + §9.5). Runs the Adventure dialect via data-lane="adventure" (§3.3/§6
 * synthesis): flight-line dividers + violet-slate map-insets.
 *
 * A1 is now the GLOBE HERO (moved here from home, §9.3) — "where the stories
 * are told" is native to this lane. Compact headline + subline + GlobeHero,
 * wrapped in its own <section> so the globe's scroll-handoff retargets to
 * THIS section automatically (GlobeHero.astro targets `root.closest("section")`).
 *
 * 2026-08-06 (operator direct review): "THE TERRITORY" constellation is
 * RETIRED. His words — "I'm reconsidering if we need both the territory and
 * the globe effect... in a sense we've almost got like the stuff appearing
 * twice." He is right: a 3D globe at the top and a location map two sections
 * below both answered "where has he been". The map was also the page's worst
 * honesty defect — its country dots were true, but 57 of its 62 location dots
 * were drawn 1,500-4,710 km from the real place (a golden-angle spray added to
 * stop Zermatt/Crans-Montana/Ayent, ~30 km apart, from collapsing into one
 * point) in identical styling on an accurate coastline, with nothing in the UI
 * to tell a reader which were real. That is not tunable — the spray existed
 * precisely to hide the collapse — so the component is deleted rather than
 * corrected. src/data/territory.ts STAYS: it is the typed provenance inventory
 * and the source of truth for the archive. It simply has no renderer now.
 *
 * Order is now: hero/globe → THE FIELD (travel stories index + board) → the
 * Medieval Festival spread → VYBE → Postcards from the Road → close.
 *
 * 2026-07-31 (operator direct review): "FROM THE ARCHIVE" is RETIRED — it
 * duplicated the Postcards section below it (Nordic Daughter / Something for
 * Tomorrow / The Art of Brazilian Living all appeared in both). Vybe, the one
 * archive item that wasn't a postcard duplicate, now gets its own full
 * section in that slot instead of a quiet tile.
 */
import Base from "../layouts/Base.astro";
import DistortionLayer from "../components/DistortionLayer.astro";
import GlobeHero from "../components/GlobeHero.astro";
import LegendMark from "../components/LegendMark.astro";
import PostcardCover from "../components/PostcardCover.astro";
import { PAGES, WORK } from "../consts";
import { POSTCARDS } from "../data/postcards";
import { getCollection } from "astro:content";

import { existsSync } from "node:fs";
import { join } from "node:path";
import sharp from "sharp";

const p = PAGES.adventure;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// P29 — CTA hrefs may be external (Calendly direct); only prefix internal routes.
const href = (h: string) => (h.startsWith("http") ? h : `${base}${h}`);

// Slug → gallery media map. Lives up here, ahead of its first caller, because
// `const TEASER_WIDTHS` does not hoist the way a `function` declaration does —
// declaring it down in the field-teaser block threw "Cannot access
// 'TEASER_WIDTHS' before initialization" at request time. Now used by both the
// travel-stories index below and the teaser itself.
const TEASER_WIDTHS = {
  landscape: [800, 1400, 2200],
  vertical: [800, 1120, 1600],
} as const;
function galleryMedia(slug: string, orientation: "landscape" | "vertical") {
  const g = join(process.cwd(), "public", "media", "adventure", "gallery");
  if (!existsSync(join(g, `${slug}-800.avif`))) return undefined;
  const widths = TEASER_WIDTHS[orientation];
  return {
    avif: widths.map((w) => `${base}/media/adventure/gallery/${slug}-${w}.avif ${w}w`).join(", "),
    webp: widths.map((w) => `${base}/media/adventure/gallery/${slug}-${w}.webp ${w}w`).join(", "),
    src: `${base}/media/adventure/gallery/${slug}-800.webp`,
  };
}

/* ── THE TRAVEL-STORIES INDEX (2026-08-06) ─────────────────────────────────
   Replaces the PUB-A dispatch stream — eleven rows, ALL 704x76px, each a 56px
   thumbnail + a sort-position numeral + the factual `title`. Operator,
   2026-08-05: "that straight-down layout, I don't know if I'm a big fan of...
   it's a big long list and I don't know if people will go down through it
   all. Or if we should have that list there at all — and if not, just sort of
   incorporate it a little bit better into the travel stories section."

   The uniformity was the complaint, not the length: one row width and one row
   height, eleven times. So the list is not deleted — it is this page's ONLY
   route to any individual story (the field board below is a single <a> around
   the whole collage, 1 link and 1 tab stop) — it MERGES INTO the travel-
   stories section, his own second option. One section, not two; one fewer
   border-t and flight-line seam.

   THREE REGISTERS, one rule: WIDTH COMES FROM SHAPE.
     · the lead      — the featured note, plate width set by its own aspect
     · the shoulder  — the next two, unequal widths, staggered
     · the folio     — the rest as a text index grouped by territory, no images

   The lead and shoulder finally render `headline` and `deck`, which the note
   schema has carried since M5 and the old list threw away: it printed "Above
   Crans-Montana" where "The shelf that holds the light" already existed,
   approved, in the markdown.

   Also retired: 626 KB of thumbnail waste. The old rows shipped `sizes="56px"`
   against a srcset whose smallest candidate is 800w, so every visitor
   downloaded eleven 800-wide AVIFs to fill 3,136px² boxes.

   NO NUMBERS. The 01-11 were sort positions that renumbered whenever a
   markdown file landed; per-territory counts are barred outright by the
   operator-directed NO-COUNT rule (src/data/territory.ts).                  */

// Native aspect of a lead frame, read at BUILD time from the already-baked
// 800-wide export (the P12.6 `aspectOf` idiom from Tableaux.astro). A note
// baked at any shape lays out correctly with nothing to keep in sync by hand —
// the drift that left matterhorn-zermatt-01 a 9:16 file in a 4:5 box.
const AR = new Map<string, number>();
async function leadAspect(slug: string) {
  if (AR.has(slug)) return AR.get(slug)!;
  const f = join(process.cwd(), "public", "media", "adventure", "gallery", `${slug}-800.webp`);
  let ar = 1.5;
  if (existsSync(f)) {
    const m = await sharp(f).metadata();
    if (m.width && m.height) ar = m.width / m.height;
  }
  AR.set(slug, ar);
  return ar;
}

// YYYY.MM.DD — the site's survey slate, matching /adventure/field and
// /field-notes. Replaces the old Intl month/year formatter.
const fmtSlate = (d: Date) =>
  `${d.getUTCFullYear()}.${String(d.getUTCMonth() + 1).padStart(2, "0")}.${String(d.getUTCDate()).padStart(2, "0")}`;

// Same collection + same filter as Nav.astro's dropdown, so the index and the
// nav can never drift — the contract the retired dispatch stream held.
const notes = await Promise.all(
  (await getCollection("fieldNotes", ({ data }) => !data.draft))
    .filter((n) => n.data.photos && n.data.photos.length > 0)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .map(async (n) => {
      const p0 = n.data.photos![0]!;
      return {
        id: n.id,
        head: n.data.headline ?? n.data.title,
        deck: n.data.deck,
        place: n.data.location ?? n.data.territory ?? "",
        territory: n.data.territory ?? "Elsewhere",
        slate: fmtSlate(n.data.date),
        alt: p0.alt,
        featured: n.data.featured === true,
        ar: await leadAspect(p0.slug),
        media: galleryMedia(p0.slug, p0.orientation)!,
      };
    }),
);

// Cover story: the newest note flagged `featured: true`, else simply the
// newest. One boolean he types in the markdown he is already editing — not a
// hash, which is how the cover variants used to pick and why renaming a file
// silently changed a page's design.
const li = Math.max(0, notes.findIndex((n) => n.featured));
const lead = notes[li];
const shoulder = notes.filter((_, i) => i !== li).slice(0, 2);
const rest = notes.filter((n) => n !== lead && !shoulder.includes(n));

// The folio: grouped by territory, groups ordered by their newest note. NO
// COUNTS — the group head is the territory name and a rule, nothing more.
const folio: { name: string; rows: typeof rest }[] = [];
for (const n of rest) {
  let g = folio.find((f) => f.name === n.territory);
  if (!g) folio.push((g = { name: n.territory, rows: [] }));
  g.rows.push(n);
}

// Plate width by shape (percent of the column) and its exact `sizes`. The
// column is max-w-5xl (64rem) minus p-8, so 960px once the viewport passes
// 1024. The `sizes` ladder is LOAD-BEARING: a bare `66vw` makes the browser
// fetch the 2200w file for a 634px plate.
const plateW = (ar: number) => (ar >= 1.2 ? 66 : ar >= 0.7 ? 46 : 36);
const plateSizes = (pct: number) =>
  `(min-width:1024px) ${Math.round(9.6 * pct)}px, (min-width:900px) calc(${pct}vw - ${Math.round(0.64 * pct)}px), calc(92vw - 42px)`;
const LW = plateW(lead.ar);

// Ambient reel + the floating gallery wall: MOVED to /adventure/field
// (Round 5 block→subpage pattern). This page keeps a teaser only.

/* ─────────────────────────────────────────────────────────────────────────
 * A4b — MEDIEVAL FESTIVAL IN LOVELAND (Round 3, 2026-07-21).
 *
 * The Knights of Mayhem piece RE-LANED here from the /work wall (operator:
 * "Knights of Mayhem is an adventure story") and BROADENED into one cohesive
 * festival story block: the showcase video (the existing loop + poster export
 * under media/work/knights-of-mayhem/ — path unchanged, no asset churn) stays
 * the feature, ringed by four of the operator's own drone frames of the joust
 * lane and the armored ground-combat arena (baked to media/adventure/festival/
 * by scripts/make-festival-photos.mjs). The attribution line composes from the
 * WORK record — single source, same "For [org] · [what] — [engagement]"
 * grammar the wall used. The aerial-licensing credibility marker renders ONLY
 * via LegendMark (amazing-aerial's verbatim permittedPhrasing).
 * ───────────────────────────────────────────────────────────────────────── */
const knights = WORK.find((w) => w.slug === "knights-of-mayhem");
// (The showcase loop now lives on the full story page, not this teaser.)
// Photo lookup — existence-gated per file, like every other baked set. The
// festival block is now a magazine-cover TEASER (M1 v3, 2026-07-22, operator:
// "the block got too busy — reuse the cover photo + two stills + a CTA, drop
// the inline video"). Two orientations: the vertical cover (widths 800/1120/
// 1600) + the two landscape teaser stills (900/1600).
const festImg = (slug: string, widths: number[]) => {
  const dir = join(process.cwd(), "public", "media", "adventure", "festival");
  const w0 = widths[0]!;
  if (!existsSync(join(dir, `${slug}-${w0}.avif`))) return undefined;
  return {
    avif: widths.map((w) => `${base}/media/adventure/festival/${slug}-${w}.avif ${w}w`).join(", "),
    webp: widths.map((w) => `${base}/media/adventure/festival/${slug}-${w}.webp ${w}w`).join(", "),
    src: `${base}/media/adventure/festival/${slug}-${w0}.webp`,
  };
};
// The teaser's mini magazine cover (same asset as the story page's cover).
const festCover = festImg("cover-charge", [800, 1120, 1600]);
// Two supporting stills — one joust, one combat (the story is the whole
// festival, not just the joust — operator note 2026-07-22).
const FESTIVAL_PHOTOS = [
  { slug: "joust-charge", alt: "Aerial view of a knight on a white horse charging down the jousting lane between festival crowds" },
  { slug: "arena-sails", alt: "Aerial view of the timber combat pen under blue shade sails — armored team bouts, spectators packed at the fence" },
].map((ph) => ({ ...ph, media: festImg(ph.slug, [900, 1600]) })).filter((ph) => ph.media);

/* ─────────────────────────────────────────────────────────────────────────
 * A4c — VYBE (2026-07-31 magazine-cover rebuild, operator direct review).
 *
 * The old "FROM THE ARCHIVE" band (Round 4/5) DUPLICATED the Postcards
 * section below it — Nordic Daughter, Something for Tomorrow, and The Art of
 * Brazilian Living all appeared in both places. Operator: Postcards is the
 * home for those short stories, so that band is retired entirely, not just
 * trimmed. Vybe was the one archive item that WASN'T a postcard duplicate —
 * it gets a full section here instead of a quiet display-only tile.
 *
 * ⚠ 2026-07-31 SECOND PASS (operator direct review of the shipped section):
 * "too bland — photos laid out in a couple." Bar set to the medieval-
 * festival spread: a magazine-COVER treatment here (cover photo + two
 * supporting stills + CTA, same block→subpage grammar as A4b's fest-teaser
 * below) that hands off to a genuinely richer click-through page —
 * /adventure/vybe — instead of the plain /work/vybe case page. The six-photo
 * uniform grid that used to live directly in this section moved to that new
 * page, WITH three more frames from the same already-graded contact sheet
 * (nine total; see scripts/make-vybe-section.mjs's 2026-07-31 note for the
 * per-frame sourcing and the releases-restraint reasoning for what was left
 * out — backstage/candid guest portraits, kept off the site).
 *
 * ⚠ 2026-07-31 THIRD PASS (layout-scout rebuild — _VYBE-LAYOUT-SPEC.md Part
 * C): the teaser's hierarchy was inverted — its two 4:5 supporting stills
 * rendered TALLER (47.8vh) than the 41.7vh cover they were meant to support,
 * unlike the festival teaser where the cover dominates 2:1. Root cause was
 * the same one-ratio asset problem the story page had. Fix: the stills are
 * now real 16:9 bakes (make-vybe-section.mjs varies ratio per photo), a
 * third still joins (3 total, matching the richer 12-photo pool), and the
 * cover gets the festival teaser's own mini-masthead grammar so the two
 * blocks read as siblings, not a strong one and a weak one.
 *
 * Vybe is a Denver arts, music, and dance collective the operator has
 * filmed across 2023–2024 and is friends with. This is his own editorial
 * coverage, not theirs — NO Vybe brand/logo assets appear anywhere below
 * (their official pack hasn't been provided yet; see the vybe-community-
 * partner memo). The one honesty statement is still LegendMark's verbatim
 * permittedPhrasing.
 * ───────────────────────────────────────────────────────────────────────── */
function vybePhoto(slug: string, widths: number[]) {
  const dir = join(process.cwd(), "public", "media", "adventure", "vybe");
  const w0 = widths[0]!;
  if (!existsSync(join(dir, `${slug}-${w0}.avif`))) return undefined;
  return {
    avif: widths.map((w) => `${base}/media/adventure/vybe/${slug}-${w}.avif ${w}w`).join(", "),
    webp: widths.map((w) => `${base}/media/adventure/vybe/${slug}-${w}.webp ${w}w`).join(", "),
    src: `${base}/media/adventure/vybe/${slug}-${w0}.webp`,
  };
}
// The teaser's mini cover — the blue-hour festival reveal, the single
// strongest establishing frame in the set (per _CONTACT-SHEET.md).
const VYBE_COVER = vybePhoto("festival-reveal", [800, 1120, 1600]);
// Three supporting stills, real 16:9/landscape bakes (not a 4:5 force-crop)
// so the cover reads 2x dominant, same ratio as the festival teaser's
// fest-stills — one per beat: the grounds, a clear performer face, Boogie
// Lights 2024.
const VYBE_STILLS = [
  { slug: "festival-grounds", alt: "An aerial view of the Vybe festival grounds beside a lake in fall, a stage tent and parked cars below distant foothills" },
  { slug: "band-guitarist", alt: "A guitarist playing in a live band at golden hour at the 2023 Vybe festival, sunlight through the fall trees" },
  { slug: "boogie-room", alt: "The room at a Boogie Lights show, the band on stage under pink and gold light, the crowd packed in front" },
]
  .map((ph) => ({ ...ph, media: vybePhoto(ph.slug, [900, 1600]) }))
  .filter((ph): ph is typeof ph & { media: NonNullable<typeof ph.media> } => !!ph.media);

/* ─────────────────────────────────────────────────────────────────────────
 * A4d — POSTCARDS (PUB-E, 2026-07-27, Directive PUB-E "collections
 * architecture"). A structured placeholder for MICRO stories — smaller and
 * lighter than a Field Notes dispatch: one title, one short paragraph, 2–3
 * photos, a date. The data shape lives in src/data/postcards.ts and ships
 * EMPTY on purpose — this pass builds the code path, not the content, per
 * the directive ("do NOT render invented entries"). The section below
 * renders ONLY when POSTCARDS is non-empty, so an empty array is a safe,
 * honest no-op. Expected filers (VYBE/Boogie Lights, Nordic Daughter,
 * Something Tomorrow, others TBD from archive mining) are named in that
 * file's header, not here — this page only renders what's actually filed.
 * ───────────────────────────────────────────────────────────────────────── */
const postcardMediaRoot = join(process.cwd(), "public", "media", "adventure", "postcards");
function postcardPhoto(postcardSlug: string, photoSlug: string) {
  const widths = [700, 1200];
  const dir = join(postcardMediaRoot, postcardSlug);
  if (!existsSync(join(dir, `${photoSlug}-${widths[0]}.avif`))) return undefined;
  return {
    avif: widths.map((w) => `${base}/media/adventure/postcards/${postcardSlug}/${photoSlug}-${w}.avif ${w}w`).join(", "),
    webp: widths.map((w) => `${base}/media/adventure/postcards/${postcardSlug}/${photoSlug}-${w}.webp ${w}w`).join(", "),
    src: `${base}/media/adventure/postcards/${postcardSlug}/${photoSlug}-${widths[0]}.webp`,
  };
}
const postcards = POSTCARDS.map((pc) => ({
  ...pc,
  photos: pc.photos.map((ph) => ({ ...ph, media: postcardPhoto(pc.slug, ph.slug) })),
}));

/* ─────────────────────────────────────────────────────────────────────────
 * A3b — THE FIELD TEASER (Round 5, 2026-07-21, operator-directed).
 *
 * The floating-portraits gallery wall (P19) MOVED to /adventure/field; this
 * page keeps ONE inviting block — copy from consts (⚠ flagged) plus a small
 * strip of the wall's three lead frames as the visual invitation. Same data
 * source (the fieldNotes collection), so the teaser can never drift from the
 * wall it points at.
 *
 * TEASER_WIDTHS + galleryMedia() live up near the `href` helper at the top of
 * this file, not here — see the hoisting note there.
 *
 * 2026-08-06: the travel-stories index (the merged dispatch stream) now opens
 * this same section, so the board is its tail rather than a section of its
 * own. `teaserStories` survives only as the empty-state guard on the plain-CTA
 * fallback below; the board itself is hand-composed from the fieldboard bake.
 * ───────────────────────────────────────────────────────────────────────── */
const TEASER_ORDER = ["matterhorn-zermatt", "bellagio", "flatirons-chautauqua"];
const teaserStories = (await getCollection("fieldNotes", ({ data }) => !data.draft))
  .filter((n) => TEASER_ORDER.includes(n.id) && n.data.photos && n.data.photos.length > 0)
  .sort((a, b) => TEASER_ORDER.indexOf(a.id) - TEASER_ORDER.indexOf(b.id))
  .map((story) => {
    const lead = story.data.photos![0]!;
    return { story, lead, media: galleryMedia(lead.slug, lead.orientation) };
  })
  .filter((t) => t.media);
// M2b (2026-07-22) — a small motion accent for the field teaser: one clean
// vertical drone reel leads the strip so /adventure previews the movement that
// lives on the location pages. Existence-gated; the teaser degrades to the
// still frames if the reel isn't present. Gornergrat = the Matterhorn skyline.
const TEASER_REEL_SLUG = "gornergrat-glacier";
const teaserReelDir = join(process.cwd(), "public", "media", "field-notes", TEASER_REEL_SLUG);
const teaserReel = existsSync(join(teaserReelDir, "loop.mp4"))
  ? {
      src: `${base}/media/field-notes/${TEASER_REEL_SLUG}/loop.mp4`,
      poster: existsSync(join(teaserReelDir, "poster.avif"))
        ? `${base}/media/field-notes/${TEASER_REEL_SLUG}/poster.avif`
        : undefined,
    }
  : undefined;
---

<Base title={p.meta.title} description={p.meta.description}>
  <div data-lane="adventure">
    <!-- A1 — globe hero (§2a, relocated §9.3). Headline paints first (LCP);
         the globe streams in behind it and the poster covers every fallback
         state. Compact vs. home's old treatment — this is a lane header,
         not a full-bleed moment. -->
    <section class="mx-auto max-w-3xl space-y-6 p-8 text-center">
      <!-- P29 buyer-language pairing: the plain buyer term rides above the H1
           so a producer decodes the lane in seconds (consts ⚠ flag). -->
      <p class="hud-label">{p.hero.eyebrow}</p>
      <h1 class="text-3xl font-bold sm:text-5xl">{p.hero.headline}</h1>
      <p class="mx-auto max-w-2xl text-lg text-ink">{p.hero.subline}</p>
      <GlobeHero />
    </section>

    <!-- A3b — THE FIELD (Round 5; the dispatch stream merged in 2026-08-06).
         The floating-portraits gallery lives at /adventure/field; this page
         keeps ONE block — the travel stories themselves, then the field board
         as the invitation to the rest.

         The retired PUB-A dispatch section that used to sit above this one
         also retires two ⚠-flagged strings that were never read-approved:
         "Field Notes · dispatch stream" and "Every dispatch from the field."
         The second was also a claim the folio could eventually falsify, so
         retiring it is a correctness fix — do not reinstate it. This section's
         own copy is p.fieldTeaser, unchanged. -->
    <section class="mx-auto max-w-5xl space-y-4 border-t border-hairline p-8">
      <hr class="flight-line mb-6" aria-hidden="true" />
      <p class="hud-label" data-reveal>{p.fieldTeaser.kicker}</p>
      <h2 class="text-2xl font-bold" data-reveal>{p.fieldTeaser.heading}</h2>
      <p class="max-w-3xl text-ink" data-reveal>{p.fieldTeaser.body}</p>

      {/* ① THE LEAD — plate width comes from the frame's own shape, so a 9:16
          lead is not a skyscraper and nothing is cropped. */}
      <a class="df-lead" href={`${base}/field-notes/${lead.id}`} style={`--plate-w:${LW}%`} data-reveal>
        <div class="df-plate" style={`--ar:${lead.ar.toFixed(4)}`}>
          <picture>
            <source type="image/avif" srcset={lead.media.avif} sizes={plateSizes(LW)} />
            <source type="image/webp" srcset={lead.media.webp} sizes={plateSizes(LW)} />
            <img
              src={lead.media.src}
              alt={lead.alt}
              width={Math.round(1000 * lead.ar)}
              height="1000"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <div class="df-say">
          <span class="df-where hud-label">
            {lead.place} · {lead.slate}
          </span>
          <h3 class="df-head">{lead.head}</h3>
          {lead.deck && <span class="df-deck">{lead.deck}</span>}
          <span class="df-cue hud-label">
            Read the dispatch <span class="arrow" aria-hidden="true">→</span>
          </span>
        </div>
      </a>

      {/* ② THE SHOULDER — an asymmetric pair. Unequal columns plus a vertical
          stagger, so it is never symmetric whatever shapes land here. */}
      <div class="df-shoulder">
        {shoulder.map((n) => (
          <a class="df-two" href={`${base}/field-notes/${n.id}`} data-reveal data-reveal-stagger="90">
            <div class="df-plate" style={`--ar:${n.ar.toFixed(4)}`}>
              <picture>
                <source type="image/avif" srcset={n.media.avif} sizes="(min-width:900px) 42vw, 88vw" />
                <source type="image/webp" srcset={n.media.webp} sizes="(min-width:900px) 42vw, 88vw" />
                <img
                  src={n.media.src}
                  alt={n.alt}
                  width={Math.round(1000 * n.ar)}
                  height="1000"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="df-two-say">
              <h3 class="df-head df-head--sm">{n.head}</h3>
              <span class="df-where hud-label">
                {n.place} · {n.slate}
              </span>
            </div>
          </a>
        ))}
      </div>

      {/* ③ THE FOLIO — the rest as a territory index. NO numerals: sort
          positions renumber on every new file, and per-territory counts are
          barred by the NO-COUNT rule (src/data/territory.ts). */}
      <div class="df-folio" data-reveal>
        {folio.map((g) => (
          <section class="df-terr">
            <h3 class="df-terr-head">
              <span class="df-terr-name">{g.name}</span>
              <span class="df-terr-rule" aria-hidden="true" />
            </h3>
            <ul class="df-terr-list">
              {g.rows.map((n) => (
                <li>
                  <a href={`${base}/field-notes/${n.id}`}>
                    <span class="df-fh">{n.head}</span>
