---
/**
 * /venture — PUB-A (2026-07-27): this file WAS /entertainment (git-renamed,
 * history preserved — see blame before this commit). Per ACTION-PLAN.md's
 * publication restructure, it is now the INDEX OF ALL VENTURE STORIES: the
 * retired /entertainment route redirects here, and the retired "Industry
 * Stories" lane (/work: MEME + SeriesFest + AFM) refiles into this page's
 * story rail below. The E1b "Hire this lane" services/floors chapter is
 * REMOVED — this is a story index, not a services pillar (no service
 * offerings on this site, per the addendum). Everything else — the two
 * feature chapters (Pebble Beach / PitchBoulder), the story rail, and the
 * "from the archive" band — carries over from /entertainment unchanged.
 *
 * Original P7 (V1-UPGRADE-PLAN) header, kept for context — REBUILT to the
 * irinamoi.com grammar, Sindbad's chosen reference for this lane. Her
 * grammar, his world:
 *
 *   - GIANT single-weight grotesque caps INTERLEAVED with an elegant serif
 *     italic for the connective words (her FoundersGrotesk × Romie → our
 *     DM Sans × Fraunces italic — brand faces in the reference's two roles)
 *   - scattered ghost letterforms that assemble as a section arrives
 *   - a CONTINUOUS background-color morph between scroll chapters (her
 *     burgundy→mauve→black→blue ride → our dark cinematic jewel tones)
 *   - numbered work chapters: serif index corners (01 … /02), mono client
 *     kicker, giant two-line OFFSET title, serif italic type-tag, and a
 *     collage of overlapping media cards with slight scroll parallax
 *   - the playground's scattered-letters + confetti as "The rooms"
 *
 * HONESTY (unchanged contract): every sentence is verbatim from consts —
 * the mixed-face emphasis inside them is presentational only. Every
 * relationship still renders through LegendMark (P23 — its VISIBLE tier
 * symbol is retired site-wide; the phrasing WORDING is unchanged and each
 * line still states its true status in words); the Pebble Beach quote stays
 * the car owner's, never the Concours'. The pebble-beach proof line moves
 * from the rooms list into work chapter 02 (same strings, richer stage).
 *
 * Fallbacks: no-JS/reduced motion → every section keeps its own static
 * ground color, letters sit in their final positions, collages render as
 * plain stacked media. The morph/assembly/parallax are enhancement-only.
 */
import Base from "../layouts/Base.astro";
import LegendMark from "../components/LegendMark.astro";
import Testimonial from "../components/Testimonial.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";
import { PAGES, WORK, WORK_ARCHIVE, RELATIONSHIP_BY_ID, VENTURE_STORY_RAIL } from "../consts";
import { existsSync, statSync } from "node:fs";
import { join } from "node:path";

// PUB-A — `PAGES.entertainment` is the internal key for this page's data;
// see the consts.ts comment above that object for why it isn't renamed.
const p = PAGES.entertainment;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (h: string) => (h.startsWith("http") ? h : `${base}${h}`);

// build-time media gating (cwd-anchored, per repo convention): a card only
// renders when its file shipped. avif+webp pairs preferred; lone files
// (e.g. the .mp4 loops) ride as-is via media().
const mediaRoot = join(process.cwd(), "public", "media");
const media = (rel: string) => (existsSync(join(mediaRoot, ...rel.split("/"))) ? `${base}/media/${rel}` : undefined);
const pair = (relBase: string) => {
  const avif = media(`${relBase}.avif`);
  const webp = media(`${relBase}.webp`);
  return avif || webp ? { avif, webp } : undefined;
};

// PitchBoulder chapter media (E3, the primary proof anchor; Round 5 — renders as chapter 02, after Pebble Beach)
const pbPoster = pair("work/pitchboulder/hook-poster");
const pbLoop = media("work/pitchboulder/loop.mp4"); // P21b — hover-video on the landscape video card
// Photo-quality audit (2026-08-02): hook-poster was doing double duty — the
// collage video-card poster ABOVE and the YouTube-embed facade poster below
// were the exact same file, so this chapter repeated one photograph twice.
// The embed facade now gets its own frame: room-about, a full-room wide shot
// from the Wednesday Room chapter (already live on /work/pitchboulder), so
// the two PitchBoulder media beats on this page read as two different rooms.
const pbEmbedPoster = pair("work/pitchboulder/wednesday-room/room-about-1600");
// The restored Shelby chapter media (WORK item; proof = pebble-beach room; Round 5 — LEADS as chapter 01, the magnum opus).
// Round 3 lane call: the Pebble Beach piece is VENTURE — corporate/private-
// client event coverage (a commissioned owner story shot at a business event),
// not wild/travel capture — so this chapter is its one home; its /work tile
// was retired with the old wall (case-page URL unchanged).
// P13c — real stills replace the frame-grabs: on-set (crew filming the car,
// the storytelling card) rides the wide card + hover-video; dawn-flare + heritage
// fill the tall/small cards. All from the width-suffixed photos/ exports.
// P21b — operator: "pretty good but could use a couple more photos — 3 is too
// light." TWO complementary frames join from the SAME already-baked photos/ set
// (no new export — reused, not re-cut): engine (an engine-bay DETAIL, hands at
// work) + lawn (an elevated CROWD/CONTEXT frame — the Cobra, period-dressed
// spectators, and the coastline). Five frames now, chosen to not repeat an angle.
// PUB-E (2026-07-27, Directive PUB-E) — Pebble Beach's FEATURE stays exactly
// as it was: this top-of-page chapter is still the SPECIFIC Shelby Cobra /
// Jack Bell story, untouched by the 2026-08-03 restructure below. Per the
// operator's own rule, a named collection needs at least two stories, so
// this feature still does NOT get a VENTURE_STORY_RAIL entry of its own —
// no "High Craft / Luxury Events" collection exists (still just one story in
// that space). What DID change 2026-08-03: the OVERALL Concours d'Elegance
// story (the reframed /venture/dawn-patrol — Dawn Patrol is now one movement
// inside it, not the page's own title) rides the standalone-stories rail
// further down this page (see VENTURE_STORY_RAIL in consts.ts) —
// same one-story reason, just resolved as a standalone card instead.
const shelby = WORK.find((w) => w.slug === "shelby-pebble-beach");
const shHref = shelby?.href ?? "/work/shelby-pebble-beach";
const shOnSet = pair("work/shelby-pebble-beach/photos/on-set-1600");
// Photo-quality audit (2026-08-02): these three were shipping the -900 tier
// even though the -1600 export already exists on disk for each (same source
// photo, just sharper) — bumped to match shOnSet/shLawn below.
const shDawn = pair("work/shelby-pebble-beach/photos/dawn-flare-1600");
const shHeritage = pair("work/shelby-pebble-beach/photos/heritage-1600");
const shEngine = pair("work/shelby-pebble-beach/photos/engine-1600"); // P21b — engine-bay detail
const shLawn = pair("work/shelby-pebble-beach/photos/lawn-1600"); // P21b — elevated crowd + coastline
const shLoop = media("work/shelby-pebble-beach/loop.mp4"); // P13c — hover-video on the wide card
// mtime cache-bust (same mechanism as PortalHero/Tableaux) so a returning
// browser pulls fresh crops instead of a cached stale one.
const mtimeV = (rel: string) => {
  try {
    return `?v=${Math.round(statSync(join(mediaRoot, ...rel.split("/"))).mtimeMs).toString(36)}`;
  } catch {
    return "";
  }
};
const bust = (relBase: string, p: ReturnType<typeof pair>) =>
  p
    ? {
        avif: p.avif ? p.avif + mtimeV(`${relBase}.avif`) : undefined,
        webp: p.webp ? p.webp + mtimeV(`${relBase}.webp`) : undefined,
      }
    : undefined;

// P21b — chapter 01 collage, REBUILT for a VENUE MIX (operator: "you're using
// all the photos from the Boulder Chamber [one room] — I wanted a mix", and
// "I don't like the large vertical photo above the video"). The hover-video now
// rides a LANDSCAPE card (hook-poster/loop are native 16:9 — the old tall 9:14
// crop was the vertical the operator flagged), ringed by three frames spanning
// two venues + two capture styles: a Boulder Chamber brand moment (presenter at
// the "Follow Us!" slide, square phone frame) and TWO professionally-edited
// frames from the Jan-28 co-working room — a wide crowd-energy frame and a
// presenter mid-talk. The old same-room room-wide/podium picks are retired.
// Exported by scripts/make-pitchboulder-collage.mjs, cache-busted like the
// rooms photos so a returning browser pulls fresh crops.
const pbPresenter = bust("work/pitchboulder/presenter-logo-1600", pair("work/pitchboulder/presenter-logo-1600"));
const pbCrowd = bust("work/pitchboulder/coworking-crowd-1600", pair("work/pitchboulder/coworking-crowd-1600"));
const pbTalk = bust("work/pitchboulder/coworking-presenter-1600", pair("work/pitchboulder/coworking-presenter-1600"));

// PUB-E (2026-07-27, Directive PUB-E) — MEME REJOINS /venture as the THIRD
// FEATURE (chapter 03), reusing meme.astro's already-verified copy/quotes
// (PAGES.entertainment.meme.body, the LOCKED "meme" LegendMark proof, and
// the SAME operator-produced logo-loop asset that page plays) — no new claim
// about MEME is made here; this is a structural placement only.
//
// 2026-08-04 — the note that used to sit here ("there is no event photography
// for MEME yet") is now OUT OF DATE, and it was the reason this chapter shipped
// as a lone centred logo beside two fully-collaged chapters — the operator's
// "section 03 looks pretty barren" note. Real MEME frames landed in the
// 2026-08-03 archive pass (scripts/make-carpenter-room.mjs,
// make-meme-archive-adds.mjs, make-meme-evergreen.mjs), so chapter 03 now rings
// its animated mark the same way 01 and 02 ring theirs. Every frame below is
// already published on /venture/meme itself — same assets, same verified
// context, no new claim:
//   carpenter-room ... Eric Abramson's "The Carpenter, Not the Tools" session
//   nocova-meetup .... a NOCOVA meetup, MEME's social arm
//   world-retreat .... members at a MEME retreat
// (world-catalina was considered and cut — see the collage geometry note.)
const memeLoopDir = join(process.cwd(), "public", "media", "venture", "meme");
const memeLv = (file: string) => {
  try {
    return `?v=${Math.round(statSync(join(memeLoopDir, file)).mtimeMs).toString(36)}`;
  } catch {
    return "";
  }
};
const memeLoop = existsSync(join(memeLoopDir, "meme-loop.mp4"))
  ? {
      mp4: `${base}/media/venture/meme/meme-loop.mp4${memeLv("meme-loop.mp4")}`,
      posterAvif: `${base}/media/venture/meme/meme-poster.avif${memeLv("meme-poster.avif")}`,
      posterWebp: `${base}/media/venture/meme/meme-poster.webp${memeLv("meme-poster.webp")}`,
    }
  : undefined;
const memeData = PAGES.entertainment.meme; // heading "MEME" + body, both already-approved copy — reused verbatim

// chapter-03 collage frames (same bust()/pair() contract as chapters 01-02).
const memeRoom = bust("venture/meme/carpenter-room-1440", pair("venture/meme/carpenter-room-1440"));
const memeMeetup = bust("venture/meme/nocova-meetup-1", pair("venture/meme/nocova-meetup-1"));
const memeRetreat = bust("venture/meme/world-retreat-1600", pair("venture/meme/world-retreat-1600"));

// The programs strip — the chapter's answer to what chapters 01/02 carry in
// their meta plate (a client testimonial). MEME has no testimonial to quote, so
// the parity beat is its actual substance: the evergreen program catalog, three
// covers deep, linking into the full catalog on /venture/meme. Titles are
// rendered from the ALT text of the already-published program cards on that
// page — no new claim, and per the MEME site rule these are evergreen programs,
// never dated marketing.
const memePrograms = [
  { slug: "program-carpenter", label: "The Carpenter, Not the Tools" },
  { slug: "program-pitch-quorum", label: "Pitch Quorum" },
  { slug: "program-market-fresh", label: "Market Fresh" },
]
  .map((pr) => ({ ...pr, img: bust(`venture/meme/${pr.slug}-900`, pair(`venture/meme/${pr.slug}-900`)) }))
  .filter((pr) => !!pr.img);

// P29 (unchanged) — the PitchBoulder commercial's video id, the SAME embed the
// case page carries (work/pitchboulder.astro; his live site's published id).
// Round 3: the commercial now plays IN the PitchBoulder chapter — the operator
// asked for the video component in this slot, not just the hover loop.
const pbCommercialId = "n7k-Bwu3KIU";

// the pebble-beach proof (with its owner-endorsement context) relocates from
// the rooms list to chapter 02. P12-KO — workshop-coverage (KO Law) ALSO leaves
// this list: it now has its own venture story + a linked rail card above, so the
// card carries that proof instead of an unlinked line here (the same claim is
// never rendered twice on this page). Round 3 — seriesfest + afm ALSO leave:
// their coverage tiles AND their verbatim status lines now live on /work
// (Industry Stories), the lane that owns festival/market coverage.
const pebbleRoom = p.rooms.items.find((r) => r.proof.relationshipId === "pebble-beach");
const HANDLED_ELSEWHERE = new Set(["pebble-beach", "workshop-coverage", "seriesfest", "afm"]);
const otherRooms = p.rooms.items.filter((r) => !HANDLED_ELSEWHERE.has(r.proof.relationshipId));

// Round 3 — the "from the archive" band, MOVED here from /work: early gig and
// event coverage is venture-storytelling-natured, not film-industry work. Same
// data (WORK_ARCHIVE) and honesty contract (verbatim permittedPhrasing only);
// media stays at public/media/work/archive/<slug>.* (no asset churn).
// Round 4 (2026-07-21, operator-directed) — the band SPLITS: only the VENTURE
// tiles stay here (Gigs Go Green, Vybe, PNUMIX). Nordic Daughter and The Art of
// Brazilian Living moved to /adventure's coverage band — they read as travel/
// coverage pieces, not commissioned venture work. The lane lives on the DATA
// (WORK_ARCHIVE[].lane), so neither page hardcodes a slug list.
// PUB-E (2026-07-27) — Gigs Go Green + PNUMIX carry `hideFromLaneIndex: true`
// in consts now (operator ruling: "commercials are not stories") — filtering
// it out here removes them from this band entirely; both stay listed on
// /work (see work/index.astro). No other venture-lane archive item exists
// today, so this band currently renders nothing on /venture — the guard
// below (`archive.length > 0`) already handles that safely.
const archive = WORK_ARCHIVE.filter((a) => a.lane === "venture" && !a.hideFromLaneIndex).map((a) => ({
  item: a,
  media: pair(`work/archive/${a.slug}`),
  href: a.href ? `${base}${a.href}` : undefined,
  phrasing: RELATIONSHIP_BY_ID[a.relationshipId]?.permittedPhrasing ?? "",
}));

// scattered ghost letters are drawn FROM the page's own words (presentational
// letterforms, not new copy): the hero scatters STORY.
const heroGhost = ["S", "T", "O", "R", "Y"]; // P12.3 — from "business stories"

// RESTRUCTURED 2026-08-03 (operator decisions, /venture lower-section
// restructure) — four changes from the PUB-E (2026-07-27) state:
//  1. The Makeshift Film Group slot is DROPPED ENTIRELY, not just held from
//     publish — no card, no ghost, no PUBLISH_MFG check on this page at all.
//     Its own page (venture/makeshift-film-group.astro) and its
//     audit-lib.mjs FORBIDDEN_TERMS gate are UNTOUCHED — this only removes
//     the slot that used to link to it from here.
//  2. Amazing Aerial is CUT from /venture entirely (its own page,
//     /venture/amazing-aerial, stays live and reachable — just unlinked from
//     this page). No replacement card takes its place.
//  3 & 4. PitchBoulder and MEME no longer repeat in the collections below —
//     both already lead the page as feature chapters (see VENTURE_STORY_RAIL
//     in consts.ts for the full account, including how the resulting
//     one-story "Founders & Pitch Rooms" collection was dissolved rather than
//     padded or backfilled with a feature).
//
// What's left below the (now single) collection is genuinely two ungrouped
// STANDALONE stories — KO Law and the reframed Pebble Beach Concours piece
// (consts.ts VENTURE_STORY_RAIL) — riding the same rail grammar the
// old partner rail used, minus the "Collection ·" kicker treatment: real
// stories, just not collection-grouped. slate + title are copied VERBATIM
// from each story's own destination page, same convention as the collections
// above.
const railGhosts: Record<string, string> = {
  // Currently empty — every card left on this page (the one remaining
  // collection + the two standalone stories) resolves a real hero-900 image.
  // toRailCard() below still throws if a future card resolves to neither an
  // image nor a ghostKey here — add an entry the day a story ships before
  // its photography does (hardening added in commit df48f42; see that
  // function's own comment below).
};
function toRailCard(c: { href: string; slate: string; title: string; tag?: string; mediaSlug?: string; imageSlug?: string; objectPosition?: string }) {
  // PUB-A — a card's media slug is `mediaSlug` when set (a /work/* href, or
  // any href that shouldn't drive its own media path), else derived from a
  // /venture/<slug> href exactly as before.
  const slug = c.mediaSlug ? c.mediaSlug : c.href.replace(/^\/venture\//, "");
  const ghostKey = c.href.replace(/^\/(venture|work)\//, "");
  // 2026-08-04 — a card may now name its OWN face (`imageSlug`) instead of
  // defaulting to the story page's hero. The heroes are composed for a 78rem
  // page-width beat; at a 336px card the same frame reads as ceiling. See the
  // CARD FACES note on VENTURE_STORY_RAIL in consts.ts.
  const facePath = c.imageSlug ? `venture/${c.imageSlug}` : `venture/${slug}/hero-900`;
  const img = bust(facePath, pair(facePath));
  const ghost = railGhosts[ghostKey];
  // AUDIT-FIX (2026-08-03) — hardening: the PitchBoulder card used to render
  // a ghost mark instead of its (real, existing) photo because its /work/*
  // href doesn't match the /venture/-only slug derivation above, and it went
  // unnoticed because railGhosts happened to have a "pitchboulder" entry too
  // — a future card with neither a resolvable image NOR a railGhosts fallback
  // would render a totally blank box with no signal at all. Fail the build
  // instead of shipping that silently.
  if (!img && !ghost) {
    throw new Error(
      `venture.astro toRailCard: "${c.href}" has no media at public/media/${facePath}.{avif,webp} ` +
        `and no railGhosts["${ghostKey}"] fallback — it would silently render as a blank rail card. ` +
        `Fix by adding a correct mediaSlug, baking the missing hero-900 pair, or adding a railGhosts entry.`,
    );
  }
  return { ...c, slug, img, ghost };
}
const storyCards = VENTURE_STORY_RAIL.map(toRailCard);

// chapter ground colors — the reference's jewel-tone ride, our dark family.
// PUB-A — `hire` retired with the E1b services chapter; `archive` stays for
// the from-the-archive band.
const GROUNDS = {
  intro: "#101020",
  ch01: "#191031",
  ch02: "#261118",
  // PUB-E — ch03 (MEME, the third feature) reuses meme.astro's own ground
  // color, so the feature chapter and the standalone article read as one room.
  ch03: "#0e2230",
  collectionA: "#10141f",
  collectionB: "#161129",
  rooms: "#12141c",
  archive: "#12141c",
  handoff: "#0f1118",
};
---

<Base title={p.meta.title} description={p.meta.description}>
  <!-- the morphing ground: fixed behind everything; the engine animates its
       color between chapters. Until the engine mounts (adds .im-live), each
       section paints its OWN ground — no-JS never sees a wrong color. -->
  <div class="im-ground" data-im-ground aria-hidden="true" style={`background:${GROUNDS.intro}`}></div>

  <main class="im" data-im>
    <!-- ═══ S1 · INTRODUCTION — the typographic collage hero ═══ -->
    <section class="im-sec im-intro" data-im-section data-ground={GROUNDS.intro} style={`--sec-ground:${GROUNDS.intro}`}>
      <div class="im-ghosts" aria-hidden="true">
        {heroGhost.map((ch, i) => <span class="im-ghost" data-im-ghost style={`--gi:${i}`}>{ch}</span>)}
      </div>
      <p class="hud-label im-kicker" data-reveal>{p.hero.eyebrow}</p>
      <!-- P12.3 — the VENTURE headline, composed in the reference's two
           voices: "The venture in adventure." — the pun carried by the caps,
           the connectives by the serif italic. Copy from consts (pending
           operator read-approval; see the review block there). -->
      <h1 class="im-headline" data-reveal>
        <span class="im-line"><span class="im-turn">The</span> VENTURE</span>
        <span class="im-line im-line--push"><span class="im-turn">in</span> ADVENTURE.</span>
      </h1>
      <p class="im-turn im-intro-sub" data-reveal>{p.hero.subline}</p>
    </section>

    <!-- PUB-A (2026-07-27) — E1b "Hire this lane" (services + floors, a
         booking CTA) REMOVED here: this page is now a story index, not a
         services pillar. See the file-header comment. -->

    <!-- ═══ S3 · THE WORK CHAPTERS — numbered, grounded, collaged ═══
         Round 3 — the MEME chapter moved to /work (Industry Stories); the two
         venture chapters are the client work: PitchBoulder + the Shelby. -->

    <!-- ROUND 5 (2026-07-21, operator-directed): chapter order FLIPPED —
         Pebble Beach (the magnum opus) leads as chapter 01; PitchBoulder
         follows as 02. Both lead collage cards now carry the VIDEO-LED
         treatment carried over from the old Work Stories wall: the cover
         still IS the base layer and the loop fades in over it automatically
         while the chapter is on screen (IO-gated, poster-first — the same
         contract as the /work MEME anchor). Hover is no longer required;
         reduced-motion / Save-Data / autoplay-refusal all leave the still. -->
    <section class="im-sec im-chapter" data-im-section data-ground={GROUNDS.ch02} style={`--sec-ground:${GROUNDS.ch02}`}>
      <span class="im-index im-turn" aria-hidden="true">01</span>
      <span class="im-index im-index--of im-turn" aria-hidden="true">/03</span>
      <div class="im-chapter-stage">
        <div class="im-collage im-collage--sh" aria-hidden="true">
          {
            shOnSet && (
              // P13c — real on-set still (crew filming the car); wide card is the
              // clickable hover-video link to the case page
              <a
                class="im-card im-sh-onset im-card--link"
                href={`${base}${shHref}`}
                data-im-card
                data-depth="1.2"
                tabindex="-1"
              >
                <picture>
                  {shOnSet.avif && <source srcset={shOnSet.avif} type="image/avif" />}
                  <img src={shOnSet.webp ?? shOnSet.avif} alt="" loading="lazy" decoding="async" />
                </picture>
                {shLoop && <video class="im-loop" data-im-autoloop data-loop-src={shLoop} muted loop playsinline preload="none" />}
              </a>
            )
          }
          {shDawn && (
            <figure class="im-card im-sh-dawn" data-im-card data-depth="0.6">
              <picture>
                {shDawn.avif && <source srcset={shDawn.avif} type="image/avif" />}
                <img src={shDawn.webp ?? shDawn.avif} alt="" loading="lazy" decoding="async" />
              </picture>
            </figure>
          )}
          {shLawn && (
            <figure class="im-card im-sh-lawn" data-im-card data-depth="1.5">
              <picture>
                {shLawn.avif && <source srcset={shLawn.avif} type="image/avif" />}
                <img src={shLawn.webp ?? shLawn.avif} alt="" loading="lazy" decoding="async" />
              </picture>
            </figure>
          )}
          {shHeritage && (
            <figure class="im-card im-sh-heritage" data-im-card data-depth="1.8">
              <picture>
                {shHeritage.avif && <source srcset={shHeritage.avif} type="image/avif" />}
                <img src={shHeritage.webp ?? shHeritage.avif} alt="" loading="lazy" decoding="async" />
              </picture>
            </figure>
          )}
          {shEngine && (
            <figure class="im-card im-sh-engine" data-im-card data-depth="1.0">
              <picture>
                {shEngine.avif && <source srcset={shEngine.avif} type="image/avif" />}
                <img src={shEngine.webp ?? shEngine.avif} alt="" loading="lazy" decoding="async" />
              </picture>
            </figure>
          )}
        </div>
        <div class="im-chapter-type">
          <!-- the WORK item's title verbatim, giant word carried by the caps:
               "A restored Shelby at Pebble Beach" -->
          <h2 class="im-title" data-reveal>
            <span class="im-line"><span class="im-turn">A restored</span> SHELBY</span>
            <span class="im-line im-line--push"><span class="im-turn">at</span> PEBBLE BEACH</span>
          </h2>
          {pebbleRoom && <p class="im-turn im-tag" data-reveal>{pebbleRoom.proof.context}</p>}
        </div>
        <div class="im-chapter-meta" data-reveal>
          {pebbleRoom && <LegendMark proof={pebbleRoom.proof} />}
