    opacity: 1;
  }

  /* ── P21b · chapter-01 (PitchBoulder) collage geometry — a venue MIX ringing
     the LANDSCAPE hover-video (no tall 9:14 vertical anymore). Varied aspect
     ratios that still fit the .im-card grammar: 16:10 video, 3:2 crowd, 1:1
     brand, 4:3 talk. ── */
  .im-pb-video { width: clamp(240px, 33vw, 500px); aspect-ratio: 16 / 10; left: 1%; top: 5%; }
  .im-pb-crowd { width: clamp(210px, 28vw, 430px); aspect-ratio: 3 / 2; right: 1%; top: 8%; }
  .im-pb-brand { width: clamp(140px, 17vw, 260px); aspect-ratio: 1 / 1; left: 5%; bottom: 5%; }
  .im-pb-talk  { width: clamp(180px, 22vw, 350px); aspect-ratio: 4 / 3; right: 4%; bottom: 6%; }

  /* ── P21b · chapter-02 (Shelby) collage geometry — FIVE frames scattered so
     they ring the centered title without crowding it: the on-set hover-video
     (16:10) top-right, a dawn tall (9:14) at the left edge, an elevated lawn/
     coast frame (16:10) bottom-left, a heritage frame (4:3) bottom-right, and a
     small engine-detail accent (4:3) tucked into the upper-center gap. ── */
  .im-sh-onset    { width: clamp(240px, 31vw, 460px); aspect-ratio: 16 / 10; right: 1%; top: 6%; }
  .im-sh-dawn     { width: clamp(150px, 18vw, 280px); aspect-ratio: 9 / 14; left: 1%; top: 4%; }
  .im-sh-lawn     { width: clamp(210px, 26vw, 400px); aspect-ratio: 16 / 10; left: 3%; bottom: 5%; }
  .im-sh-heritage { width: clamp(150px, 17vw, 260px); aspect-ratio: 4 / 3; right: 4%; bottom: 6%; }
  .im-sh-engine   { width: clamp(120px, 14vw, 210px); aspect-ratio: 4 / 3; left: 30%; top: 3%; }
  /* ── 2026-08-04 · chapter-03 (MEME) collage geometry — the same ringing
     grammar as 01/02, with the animated MEME mark as the anchor card. The mark
     is a 1:1 asset, so it anchors at square (its own page shows it the same
     way) and the four real frames ring it in mixed ratios. ── */
  /* the anchor sits ABOVE the meta plate, not behind it: this chapter's plate
     is taller than 01/02's (it carries the programs strip), and the MEME mark
     getting clipped mid-wordmark reads as a bug rather than as layering. */
  .im-meme-anchor   { width: clamp(130px, 16vw, 205px); aspect-ratio: 1 / 1; left: 1%; top: 1%; }
  .im-meme-room     { width: clamp(210px, 27vw, 420px); aspect-ratio: 4 / 3; right: 1%; top: 4%; }
  .im-meme-meetup   { width: clamp(150px, 18vw, 270px); aspect-ratio: 3 / 2; left: 5%; bottom: 4%; }
  .im-meme-retreat  { width: clamp(190px, 24vw, 350px); aspect-ratio: 3 / 2; right: 3%; bottom: 5%; }
  /* NOTE — a fifth frame (world-catalina) was tried at left:32%/top:2% and
     landed straight on the centred "MEME" wordmark: unlike 01/02, this
     chapter's title is a single short word, so the middle of the stage is
     occupied, not empty. Four frames ring it exactly as chapter 01 does
     (anchor TL, wide TR, small BL, medium BR) and the centre stays clear. */

  .im-chapter-type {
    position: relative;
    z-index: 2;
    text-align: center;
  }
  .im-title {
    font-size: clamp(2.6rem, 8vw, 8rem);
    display: grid;
    gap: 0.04em;
  }
  /* P23 — the short context line (ch01 PitchBoulder summary, ch02 the car
     owner's endorsement) used to float as small italic directly over the busy
     collage — the operator flagged it as unreadable. It now sits on a real,
     near-solid plate in the chapter's own ground color (fully occludes the
     imagery behind it → AA-safe light-on-dark), a notch larger, right-aligned
     as a caption block under the title. --sec-ground is the per-section inline
     var, so the plate keeps the jewel tone even after the ground morphs. */
  .im-tag {
    width: fit-content;
    max-width: min(92%, 42rem);
    margin: 1.3rem 0 0 auto;
    padding: 0.72rem 1.15rem;
    font-size: clamp(1.15rem, 1.7vw, 1.55rem);
    line-height: 1.42;
    text-align: right;
    background: color-mix(in srgb, var(--sec-ground, #191031) 90%, #000 10%);
    border: 1px solid color-mix(in srgb, #ffffff 9%, transparent);
    border-radius: 8px;
    box-shadow: 0 18px 50px -26px rgba(0, 0, 0, 0.7);
  }
  /* P23 — the proof line + testimonial + CTA also lifted onto a plate so none
     of the small type ever fights the collage underneath. */
  .im-chapter-meta {
    position: relative;
    z-index: 2;
    margin-top: 2.2rem;
    max-width: 36rem;
    display: grid;
    gap: 1rem;
    padding: 1.4rem 1.5rem;
    background: color-mix(in srgb, var(--sec-ground, #191031) 90%, #000 10%);
    border: 1px solid color-mix(in srgb, #ffffff 9%, transparent);
    border-radius: 10px;
    box-shadow: 0 22px 60px -30px rgba(0, 0, 0, 0.7);
  }
  .im-quote {
    font-style: italic;
  }

  /* ── 2026-08-04 · the MEME programs strip — chapter 03's parity beat for the
     client testimonial chapters 01/02 carry. Three evergreen program covers,
     small, all linking into the full catalog on /venture/meme. ── */
  .im-meme-programs {
    display: grid;
    gap: 0.55rem;
  }
  .im-meme-programs-label {
    letter-spacing: 0.22em;
    color: color-mix(in srgb, #e8f6f3 62%, transparent);
  }
  .im-meme-programs-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .im-meme-program {
    display: grid;
    gap: 0.4rem;
    text-decoration: none;
    color: inherit;
  }
  .im-meme-program-media {
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, #ffffff 12%, transparent);
    transition: transform 320ms var(--ease-survey, ease), border-color 320ms ease;
  }
  .im-meme-program-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .im-meme-program:hover .im-meme-program-media,
  .im-meme-program:focus-visible .im-meme-program-media {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-accent, #38f8ec) 55%, transparent);
  }
  .im-meme-program-label {
    font-size: 0.72rem;
    line-height: 1.3;
    color: color-mix(in srgb, #eef1f6 74%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .im-meme-program:hover .im-meme-program-media,
    .im-meme-program:focus-visible .im-meme-program-media { transform: none; }
  }

  /* Round 3 — the chapter-03 (MEME) ambient-loop styles left with the chapter
     (that treatment now lives on /work's MEME anchor panel). */

  /* ── Round 3 · the commercial embed in the PitchBoulder chapter meta —
     the case page's click-to-load facade, sized to the plate. ── */
  .im-chapter-meta :global(.im-pb-embed) {
    width: 100%;
  }

  /* ── chapter 03 (MEME) — the ambient logo loop. 2026-08-04: it moved OUT of
     the meta plate and INTO the collage as the anchor card (see
     .im-meme-anchor above), so these styles now scope to that card. The
     `is-playing` class is still toggled by the same script at the bottom of
     this file, on whatever carries [data-meme-loop-wrap]. Poster-first: the
     video only fades in once JS confirms motion is allowed and it's on screen.
     The stage no longer needs the --solo width cap — chapter 03 uses the same
     full stage as 01 and 02 now. ── */
  .im-meme-anchor {
    border: 1px solid color-mix(in srgb, #ffffff 14%, transparent);
    background: color-mix(in srgb, #ffffff 4%, transparent);
    box-shadow:
      0 24px 80px -24px rgba(0, 0, 0, 0.55),
      0 0 32px -12px color-mix(in srgb, var(--color-accent, #38f8ec) 35%, transparent);
  }
  .im-meme-loop-vid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 600ms var(--ease-survey, ease);
    pointer-events: none;
  }
  .im-meme-anchor.is-playing .im-meme-loop-vid {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .im-meme-loop-vid {
      transition: none;
    }
  }

  /* ── P12.6b · the shared "story CTA" — one bold, unmissable treatment used
     below every chapter's text block and (smaller) on every rail card. Space
     Mono caps, ≥44px tall, arrow slides 6px + subtle accent fill on hover. ── */
  .im-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    width: fit-content;
    padding: 0.85rem 1.5rem;
    border: 1px solid color-mix(in srgb, #ffffff 32%, transparent);
    border-radius: 4px;
    /* P23 — the same chamfered corner as the global .btn kit, so the venture
       story CTAs read as one family with the rest of the site. */
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);
    background: color-mix(in srgb, #ffffff 3%, transparent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #f2f4f8;
    text-decoration: none;
    transition:
      background 320ms var(--ease-survey, ease),
      border-color 320ms ease,
      filter 320ms ease;
  }
  .im-cta:hover,
  .im-cta:focus-visible {
    background: color-mix(in srgb, var(--color-accent, #38f8ec) 16%, transparent);
    border-color: color-mix(in srgb, var(--color-accent, #38f8ec) 62%, transparent);
    /* glow follows the chamfer (drop-shadow, not box-shadow) */
    filter: drop-shadow(0 0 16px color-mix(in srgb, var(--color-accent, #38f8ec) 42%, transparent));
  }
  .im-cta-arrow {
    color: var(--color-accent, #38f8ec);
    font-size: 1.05em;
    transition: transform 320ms var(--ease-survey, ease);
  }
  .im-cta:hover .im-cta-arrow,
  .im-cta:focus-visible .im-cta-arrow {
    transform: translateX(6px);
  }
  /* the MEME secondary link sits quiet under its primary button */
  .im-cta-secondary {
    font-size: 0.9rem;
    justify-self: start;
  }
  /* smaller scale for the story-rail cards */
  .im-cta--sm {
    min-height: 40px;
    padding: 0.55rem 1rem;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    gap: 0.7rem;
  }

  /* ── P12.6b · S4 THE STORY RAIL — the coverage stories as a user-driven
     horizontal carousel. Native overflow-x + scroll-snap (no-JS baseline);
     pointer-drag + "drag →" hint enhance on top. ── */
  /* 2026-08-04 — was min-height:100svh + 9rem padding, sized for TWO rails of
     two cards each. One rail of four fills its own width now, so the section is
     sized to its content instead of to the viewport; that removes the screen of
     dead space the operator flagged above and below it. */
  .im-rail-sec {
    padding: 5.5rem clamp(1.5rem, 6vw, 8rem);
    display: grid;
    /* minmax(0, 1fr) is load-bearing: without the 0 min-track, the flex rail's
       content width (all cards) would blow the column — and the page — wide.
       This pins the column to the section width so the rail scrolls instead. */
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    gap: 1.4rem;
  }
  .im-rail-intro {
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    max-width: 44rem;
  }
  .im-rail-wrap {
    position: relative;
    margin-top: 0.6rem;
    min-width: 0; /* let the wrap shrink to the column, so overflow-x can scroll */
  }
  .im-rail-hint {
    position: absolute;
    right: 0.2rem;
    top: -1.7rem;
    font-size: 0.6rem;
    letter-spacing: 0.24em;
    color: color-mix(in srgb, #e8f6f3 55%, transparent);
  }
  .im-rail {
    display: flex;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0 0 1.4rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, #ffffff 22%, transparent) transparent;
  }
  /* JS marks the rail draggable on fine pointers (grab cursor); dragging kills
     snap so the throw feels direct. */
  .im-rail.is-draggable { cursor: grab; }
  .im-rail.is-dragging { cursor: grabbing; scroll-snap-type: none; user-select: none; }
  .im-rail-card {
    flex: 0 0 clamp(240px, 78vw, 336px); /* one card + a peek on ~390px screens */
    scroll-snap-align: start;
  }
  .im-rail-link {
    display: grid;
    gap: 0.7rem;
    height: 100%;
    align-content: start;
    padding: 0.9rem;
    border: 1px solid color-mix(in srgb, #ffffff 13%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, #ffffff 2.5%, transparent);
    text-decoration: none;
    color: inherit;
    transition:
      transform 380ms var(--ease-survey, ease),
      border-color 380ms ease,
      background 380ms ease;
  }
  .im-rail-link:hover,
  .im-rail-link:focus-visible {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, #ffffff 30%, transparent);
    background: color-mix(in srgb, #ffffff 5%, transparent);
  }
  .im-rail-media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    overflow: hidden;
    background: color-mix(in srgb, #ffffff 6%, transparent);
  }
  .im-rail-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* typographic (ghost-letter) card — chapter-03 style for the conceptual
     stories that have no event photo (AERIAL / MEME / the film venture). */
  .im-rail-ghost {
    font-family: var(--font-sans);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 5.5vw, 2.9rem);
    letter-spacing: 0.04em;
    line-height: 1;
    color: color-mix(in srgb, #ffffff 16%, transparent);
  }
  /* 2026-08-04 — the category chip that replaced the collection sections.
     Sits on the card face so it reads before the slate line does. */
  .im-rail-tag {
    position: absolute;
    left: 0.55rem;
    top: 0.55rem;
    z-index: 1;
    padding: 0.28rem 0.5rem;
    font-size: 0.55rem;
    letter-spacing: 0.18em;
    border-radius: 999px;
    color: #eaf7f5;
    background: color-mix(in srgb, #0b0f16 78%, transparent);
    border: 1px solid color-mix(in srgb, #ffffff 20%, transparent);
    backdrop-filter: blur(6px);
  }
  .im-rail-slate {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: color-mix(in srgb, #e8f6f3 72%, transparent);
  }
  .im-rail-title {
    font-size: clamp(1.1rem, 1.5vw, 1.32rem);
    line-height: 1.24;
  }
  .im-rail-cta {
    margin-top: 0.2rem;
    pointer-events: none; /* decorative; the card <a> owns the click */
  }
  /* the card-link hover drives its decorative CTA (fill + 6px arrow slide) */
  .im-rail-link:hover .im-cta,
  .im-rail-link:focus-visible .im-cta {
    background: color-mix(in srgb, var(--color-accent, #38f8ec) 16%, transparent);
    border-color: color-mix(in srgb, var(--color-accent, #38f8ec) 62%, transparent);
  }
  .im-rail-link:hover .im-cta-arrow,
  .im-rail-link:focus-visible .im-cta-arrow {
    transform: translateX(6px);
  }
  .im-rail-proofs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 2.2rem;
    list-style: none;
    padding: 0;
    margin: 1.6rem 0 0;
  }

  /* ── S4 story-rail ambient: confetti drift (abstract shapes, kept quiet —
     the retired "rooms" ghost letters + list/coverage styles are gone). ── */
  .im-confetti {
    position: absolute;
    width: clamp(34px, 4vw, 64px);
    aspect-ratio: 1;
    background: var(--color-accent, #38f8ec);
    opacity: 0.14;
    border-radius: 4px;
  }
  .im-confetti:nth-of-type(1) { left: 14%; top: 40%; }
  .im-confetti:nth-of-type(2) { left: 44%; top: 34%; background: #0da79b; }
  .im-confetti:nth-of-type(3) { left: 66%; top: 44%; background: #8fb7d8; }
  .im-confetti:nth-of-type(4) { left: 88%; top: 36%; }
  .im-key {
    margin-top: 2rem;
  }

  /* ── Round 3 · S4b FROM THE ARCHIVE — the quieter band moved from /work:
     small tiles, muted media at rest (restored on hover), the rail's card
     grammar a notch smaller. ── */
  .im-archive-sec {
    padding: 5rem clamp(1.5rem, 6vw, 8rem) 5.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    gap: 1.2rem;
  }
  .im-archive-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .im-atile {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 0.9rem;
    border: 1px solid color-mix(in srgb, #ffffff 10%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, #ffffff 2%, transparent);
    color: inherit;
    text-decoration: none;
  }
  .im-atile--link {
    cursor: pointer;
    transition:
      transform 380ms var(--ease-survey, ease),
      border-color 380ms ease;
  }
  .im-atile--link:hover,
  .im-atile--link:focus-visible {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, #ffffff 26%, transparent);
  }
  .im-atile-media {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    background: color-mix(in srgb, #ffffff 5%, transparent);
  }
  .im-atile-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* muted at rest — the archive is quieter than the chapters */
    filter: saturate(0.82) brightness(0.85);
    transition: filter 400ms var(--ease-survey, ease);
  }
  .im-atile--link:hover .im-atile-media img {
    filter: saturate(1) brightness(0.98);
  }
  .im-atile-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .im-atile-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.25;
    color: #eef5fa;
  }
  .im-atile-date {
    flex: none;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, #e8f6f3 55%, transparent);
  }
  .im-atile-line {
    font-size: 0.74rem;
    line-height: 1.4;
    color: color-mix(in srgb, #eef1f6 72%, transparent);
  }
  .im-atile-cta {
    pointer-events: none; /* decorative; the tile <a> owns the click */
    margin-top: 0.2rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .im-atile--link,
    .im-atile-media img {
      transition: none;
    }
    .im-atile--link:hover {
      transform: none;
    }
