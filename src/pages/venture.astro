    padding: 7rem 2rem 6rem;
    text-align: center;
  }
  .im-headline {
    font-size: clamp(3rem, 9.5vw, 9.5rem);
    display: grid;
    gap: 0.05em;
  }
  .im-headline .im-turn,
  .im-title .im-turn {
    font-size: 0.42em;
    vertical-align: 0.22em;
    margin-inline: 0.12em;
  }
  .im-line {
