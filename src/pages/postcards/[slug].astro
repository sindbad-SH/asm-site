---
/**
 * /postcards/[slug] — POSTCARD2 (2026-07-27, publication-v1 branch).
 *
 * The detail page for a single "postcard" — the smallest story unit on the
 * site (src/data/postcards.ts): one place, a short paragraph or two, a small
 * gallery, a date. Deliberately LIGHT — a postcard, not a Field Notes
 * dispatch (/field-notes/[slug]). No Amazing Aerial licensing funnel
 * (postcards are personal archive coverage, not the licensed aerial
 * archive) — just the words and a few frames, with a back-link to
 * /adventure.
 *
 * ⚠ 2026-07-31 (operator direct review) — "same magazine treatment at
 * ONE-PAGER scale": the page now opens on a PostcardCover hero (the compact
 * FieldCover-derived grammar, see src/components/PostcardCover.astro) instead
 * of a plain text header; an optional pull-line (lifted verbatim from the
 * postcard's own paragraphs, see postcards.ts) renders as a callout partway
 * through the prose; the gallery gives its first supporting photo a wider
 * cell so the grid isn't perfectly uniform ("more photos, well laid out");
 * and an optional `related` cross-link (e.g. Nordic Daughter ↔ Something for
 * Tomorrow) renders as a real CTA, not just a prose mention. Still
 * deliberately light — no chapters, no full editorial spread.
 *
 * STATIC PATHS: one page per entry in POSTCARDS. No draft concept — every
 * filed postcard is routable (the array itself is the honesty gate: nothing
 * renders until it's actually filed, per postcards.ts's own header).
 */
import Base from "../../layouts/Base.astro";
import PostcardCover from "../../components/PostcardCover.astro";
import { POSTCARDS } from "../../data/postcards";
import { existsSync } from "node:fs";
import { join } from "node:path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const postcardMediaRoot = join(process.cwd(), "public", "media", "adventure", "postcards");
function postcardPhoto(postcardSlug: string, photoSlug: string) {
  const widths = [700, 1200];
  const dir = join(postcardMediaRoot, postcardSlug);
  if (!existsSync(join(dir, `${photoSlug}-${widths[0]}.avif`))) return undefined;
  return {
    avif: widths.map((w) => `${base}/media/adventure/postcards/${postcardSlug}/${photoSlug}-${w}.avif ${w}w`).join(", "),
    webp: widths.map((w) => `${base}/media/adventure/postcards/${postcardSlug}/${photoSlug}-${w}.webp ${w}w`).join(", "),
    src: `${base}/media/adventure/postcards/${postcardSlug}/${photoSlug}-${widths[0]}.webp`,
  };
}

export async function getStaticPaths() {
  return POSTCARDS.map((pc) => ({
    params: { slug: pc.slug },
    props: { pc },
  }));
}

type Props = { pc: (typeof POSTCARDS)[number] };
const { pc } = Astro.props;

const photos = pc.photos.map((ph) => ({ ...ph, media: postcardPhoto(pc.slug, ph.slug) })).filter((ph) => ph.media);
// The lead photo becomes the cover hero; the gallery below shows the rest —
// "mostly more photos, well laid out" without repeating the cover image.
const cover = photos[0];
const galleryPhotos = photos.slice(1);

const related = pc.related ? POSTCARDS.find((p) => p.slug === pc.related!.slug) : undefined;
const relatedCover = related ? postcardPhoto(related.slug, related.photos[0]!.slug) : undefined;

const meta = {
  title: `${pc.title} — Postcard | Adventure Storytelling Media`,
  // ⚠ OPERATOR READ-APPROVAL REQUIRED — new copy (meta description template,
  // staging-only until read). Composed only from the postcard's own data.
  description: `A postcard from the road — ${pc.title}, ${pc.location}.`,
};

const gallerySizes = "(min-width: 900px) 30vw, 45vw";
const wideSizes = "(min-width: 900px) 46vw, 92vw";
const heroSizes = "(min-width: 900px) 620px, 92vw";
// Any postcard whose photos set an explicit `scale` (2026-08-01,
// VYBE-quality critic-fix round) gets the tiered hero/bleed/mid layout; a
// postcard that doesn't set `scale` on any photo keeps the original
// "first supporting photo runs wide" behavior untouched.
const hasScaleTiers = galleryPhotos.some((ph) => ph.scale);
---

<Base title={meta.title} description={meta.description}>
  <div data-lane="adventure">
    <article class="pc-detail">
      <p class="pc-back" data-reveal>
        <a class="link" href={`${base}/adventure`}>← All postcards</a>
      </p>

      {
        cover?.media ? (
          <PostcardCover
            media={cover.media}
            alt={cover.alt}
            title={pc.title}
            date={pc.date}
            location={pc.location}
            class="pc-detail-cover"
          />
        ) : (
          <header class="pc-head" data-reveal>
            <p class="hud-label pc-kicker">Postcard · {pc.date}</p>
            <h1 class="pc-title">{pc.title}</h1>
            <p class="pc-loc hud-label">{pc.location}</p>
          </header>
        )
      }
      {cover?.media && <h1 class="sr-only">{pc.title}</h1>}

      <div class="pc-prose" data-reveal>
        <p>{pc.paragraphs[0]}</p>
        {pc.pullQuote && <blockquote class="pc-pull panel">{pc.pullQuote}</blockquote>}
        {pc.paragraphs.slice(1).map((graf) => <p>{graf}</p>)}
      </div>

      {
        galleryPhotos.length > 0 && (
          <section class={`pc-gallery ${hasScaleTiers ? "pc-gallery--tiered" : ""}`} data-reveal aria-label={`More photos from ${pc.title}`}>
            {galleryPhotos.map((ph, i) => {
              if (!ph.media) return null;
              // Tiered layout (scale set): hero = full-width face-forward
              // feature, bleed = full-width 2:1 wow shot, mid = default grid
              // cell. Untiered layout (no postcard photo sets `scale`):
              // original behavior — the first supporting photo runs wide.
              const cls = hasScaleTiers
                ? ph.scale === "hero"
                  ? "pc-photo--hero"
                  : ph.scale === "bleed"
                    ? "pc-photo--bleed"
                    : ""
                : i === 0
                  ? "pc-photo--wide"
                  : "";
              const sizes = hasScaleTiers ? (ph.scale === "hero" || ph.scale === "bleed" ? heroSizes : gallerySizes) : i === 0 ? wideSizes : gallerySizes;
              return (
                <figure class={`pc-photo ${cls}`}>
                  <picture>
                    <source type="image/avif" srcset={ph.media.avif} sizes={sizes} />
                    <source type="image/webp" srcset={ph.media.webp} sizes={sizes} />
                    <img src={ph.media.src} alt={ph.alt} loading="lazy" decoding="async" />
                  </picture>
                </figure>
              );
            })}
          </section>
        )
      }

      {
        related && relatedCover && (
          <a class="pc-related" href={`${base}/postcards/${related.slug}`} data-reveal>
            <span class="pc-related-thumb">
              <picture>
                <source type="image/avif" srcset={relatedCover.avif} sizes="72px" />
                <source type="image/webp" srcset={relatedCover.webp} sizes="72px" />
                <img src={relatedCover.src} alt="" loading="lazy" decoding="async" />
              </picture>
            </span>
            <span class="pc-related-text">
              <span class="hud-label pc-related-kicker">Related postcard</span>
              <span class="pc-related-label">{pc.related!.label}</span>
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        )
      }

      <footer class="pc-foot">
        <p class="pc-back" data-reveal>
          <a class="link" href={`${base}/adventure`}>← All postcards</a>
        </p>
      </footer>
    </article>
  </div>
</Base>

<style>
  .pc-detail {
    max-width: 42rem;
    margin-inline: auto;
    padding: 6.5rem clamp(1.5rem, 6vw, 3rem) 6rem;
  }
  .pc-back {
    margin: 0 0 1.75rem;
  }
  .pc-head {
    margin-bottom: 1.75rem;
  }
  /* the PostcardCover hero (2026-07-31) replaces .pc-head on postcards with
     a lead photo; give it the same breathing room the old text header had. */
  :global(.pc-detail-cover) {
    margin-bottom: 2.25rem;
  }
  .pc-kicker {
    margin: 0 0 0.6rem;
    letter-spacing: 0.2em;
    color: var(--color-adventure-warm, var(--color-accent));
  }
  .pc-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    line-height: 1.08;
    color: var(--color-peak);
  }
  .pc-loc {
    margin: 0.6rem 0 0;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--color-peak) 62%, transparent);
  }
  .pc-prose {
    max-width: 38rem;
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.72;
    color: color-mix(in srgb, var(--color-ink) 92%, transparent);
  }
  .pc-prose p {
    margin: 0 0 1.2em;
  }
  .pc-prose p:last-child {
    margin-bottom: 0;
  }
  /* pull-line (2026-07-31) — one sentence lifted verbatim from the prose,
     set large; same left-accent-rule grammar as Steel & Dust's sd-pull, at
     postcard scale ("a pull-line or two, not a full spread"). */
  .pc-pull {
    margin: 0 0 1.4em;
    padding: 0.9rem 1.2rem;
    border-left: 2px solid var(--color-adventure-warm, var(--color-accent));
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 480;
    font-size: clamp(1.15rem, 2.4vw, 1.4rem);
    line-height: 1.4;
    color: var(--color-peak);
  }
  .pc-gallery {
    margin-top: 2.25rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.75rem;
  }
  /* tiered layout (2026-08-01, VYBE-quality critic-fix round) — a postcard
     whose photos set an explicit `scale` gets bigger mid cells (~300px, was
     150px) so "more photos" doesn't collapse into a contact sheet. */
  .pc-gallery--tiered {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.9rem;
  }
  .pc-photo {
    margin: 0;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid color-mix(in srgb, var(--color-peak) 14%, transparent);
    background: color-mix(in srgb, var(--color-surface, #171b22) 70%, transparent);
  }
  .pc-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  /* the first supporting photo runs wider — "more photos, well laid out"
     without falling back to a perfectly uniform grid. (Untiered postcards
     only — see .pc-photo--hero/--bleed below for the tiered equivalent.) */
  .pc-photo--wide {
    grid-column: span 2;
  }
  .pc-photo--wide img {
    aspect-ratio: 16 / 10;
  }
  @media (max-width: 480px) {
    .pc-photo--wide {
      grid-column: span 1;
    }
    .pc-photo--wide img {
      aspect-ratio: 4 / 5;
    }
  }
  /* hero cell — a full-width, face-forward feature photo (>=560px
     rendered on desktop, matching the postcard's own cover scale), so a
     gallery can carry more than one "the wow shot" without every image
     shrinking to a contact-sheet thumbnail. */
  .pc-photo--hero {
    grid-column: 1 / -1;
  }
  .pc-photo--hero img {
    aspect-ratio: 4 / 5;
  }
  /* bleed cell — a full-width 2:1 wide establishing/wow shot. */
  .pc-photo--bleed {
    grid-column: 1 / -1;
  }
  .pc-photo--bleed img {
    aspect-ratio: 2 / 1;
  }
  /* related-postcard cross-link (2026-07-31) — a real clickable CTA, not
     just a prose mention (e.g. Nordic Daughter ↔ Something for Tomorrow). */
  .pc-related {
    margin-top: 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.8rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-peak) 16%, transparent);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--dur-hover, 180ms) var(--ease-swift, ease),
      background var(--dur-hover, 180ms) var(--ease-swift, ease);
  }
  .pc-related:hover,
  .pc-related:focus-visible {
    border-color: color-mix(in srgb, var(--color-adventure-warm, var(--color-accent)) 45%, transparent);
    background: color-mix(in srgb, #ffffff 3%, transparent);
  }
  .pc-related-thumb {
    flex: none;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 6px;
    overflow: hidden;
  }
  .pc-related-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pc-related-text {
    flex: 1 1 auto;
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  .pc-related-kicker {
    color: var(--color-adventure-warm, var(--color-accent));
  }
  .pc-related-label {
    font-size: 0.94rem;
    color: var(--color-ink);
  }
  .pc-related .arrow {
    flex: none;
    transition: transform var(--dur-hover, 180ms) var(--ease-swift, ease);
  }
  .pc-related:hover .arrow,
  .pc-related:focus-visible .arrow {
    transform: translateX(4px);
  }
  .pc-foot {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-hairline);
  }
  .pc-foot .pc-back {
    margin: 0;
  }
</style>
