---
/**
 * SocialLinks.astro — 2026-08-04, operator-directed: social links sitewide
 * should be PRESENT AS ICON BUTTONS, not bare words. Renders a row of round
 * hairline icon buttons in the site's hud grammar (stroke icons, muted ink →
 * accent on hover), with an optional mono kicker label for the row.
 *
 * Icons are hand-drawn 24×24 stroke glyphs (no icon package, no external
 * requests) — deliberately in the site's line weight rather than filled
 * brand-logo marks, so the row reads as instrument chrome, not a badge wall.
 * Every button keeps an aria-label + title with the platform name; the glyph
 * is aria-hidden.
 */
interface Entry {
  platform: string;
  href: string;
}
interface Props {
  label?: string;
  entries: Entry[];
}
const { label, entries } = Astro.props;

// 24×24 viewBox glyphs. `s` = stroked paths/shapes, `f` = filled shapes.
const ICONS: Record<string, { s?: string[]; f?: string[] }> = {
  youtube: {
    s: ["M6 6.5 H18 A3 3 0 0 1 21 9.5 V14.5 A3 3 0 0 1 18 17.5 H6 A3 3 0 0 1 3 14.5 V9.5 A3 3 0 0 1 6 6.5 Z"],
    f: ["M10.2 9.2 L15.2 12 L10.2 14.8 Z"],
  },
  instagram: {
    s: [
      "M8.5 4 H15.5 A4.5 4.5 0 0 1 20 8.5 V15.5 A4.5 4.5 0 0 1 15.5 20 H8.5 A4.5 4.5 0 0 1 4 15.5 V8.5 A4.5 4.5 0 0 1 8.5 4 Z",
      "M12 8.3 A3.7 3.7 0 1 0 12 15.7 A3.7 3.7 0 1 0 12 8.3",
    ],
    f: ["M16.6 5.9 A1.1 1.1 0 1 0 16.6 8.1 A1.1 1.1 0 1 0 16.6 5.9"],
  },
  tiktok: {
    // simplified note: stem + flag sweep + head
    s: ["M14.5 4 C14.9 6.6 16.7 8.3 19.2 8.6", "M14.5 4 V15.5 A3.8 3.8 0 1 1 11 11.8"],
  },
  x: {
    s: ["M5 4 L19 20", "M19 4 L5 20"],
  },
  linkedin: {
    s: [
      "M7 4 H17 A3 3 0 0 1 20 7 V17 A3 3 0 0 1 17 20 H7 A3 3 0 0 1 4 17 V7 A3 3 0 0 1 7 4 Z",
      "M8.2 11 V16.5",
      "M12 16.5 V11 M12 13 C12 10.8 15.8 10.8 15.8 13 V16.5",
    ],
    f: ["M8.2 7.4 A1.15 1.15 0 1 0 8.2 9.7 A1.15 1.15 0 1 0 8.2 7.4"],
  },
  facebook: {
    s: ["M15.5 4.5 H13.5 C11.8 4.5 10.8 5.6 10.8 7.4 V19.5", "M8.2 10.6 H14.2"],
  },
  substack: {
    s: ["M5 5 H19", "M5 8.6 H19", "M5 12.2 H19 V19.5 L12 15.9 L5 19.5 Z"],
  },
};
const glyph = (platform: string) => ICONS[platform.toLowerCase()];
const nice = (platform: string) =>
  ({ youtube: "YouTube", tiktok: "TikTok", linkedin: "LinkedIn", x: "X" })[platform.toLowerCase()] ??
  platform.charAt(0).toUpperCase() + platform.slice(1);
---

<div class="social-links">
  {label && <p class="hud-label social-links-label">{label}</p>}
  <ul class="social-links-row">
    {
      entries.map(({ platform, href }) => {
        const g = glyph(platform);
        return (
          <li>
            <a
              href={href}
              class="social-btn"
              aria-label={nice(platform)}
              title={nice(platform)}
              rel="me noopener"
              target="_blank"
            >
              {g ? (
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  {g.s?.map((d) => (
                    <path
                      d={d}
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  ))}
                  {g.f?.map((d) => <path d={d} fill="currentColor" />)}
                </svg>
              ) : (
                <span class="social-btn-fallback">{nice(platform).slice(0, 2)}</span>
              )}
            </a>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .social-links {
    display: grid;
    gap: 0.5rem;
  }
  .social-links-label {
    margin: 0;
  }
  .social-links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--color-hairline, color-mix(in srgb, #ffffff 16%, transparent));
    color: var(--color-ink-muted);
    transition:
      color 150ms ease,
      border-color 150ms ease,
      background-color 150ms ease;
  }
  .social-btn:hover,
  .social-btn:focus-visible {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
  }
  .social-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .social-btn-fallback {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
</style>
