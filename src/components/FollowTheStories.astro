---
/**
 * FollowTheStories.astro — PUB-C (2026-07-27), the publication's follow
 * block, mounted sitewide in Footer.astro (compact variant).
 *
 * REPOSITION (2026-08-27): WIRED LIVE. The provider question the old header
 * left open was settled by the operator's lane memo (2026-08-05): the
 * newsletter IS adventurestorytellingmedia.substack.com, live since
 * 2026-08-02 — so the "Coming soon" dead form is gone. The form now submits
 * for real: a GET to the publication's /subscribe page with the typed
 * address prefilled. The honesty contract carries forward — no fake success
 * state; Substack renders its own confirmation on its own page.
 */
import { SITE } from "../consts";

const SUBSTACK_SUBSCRIBE = `${SITE.socials.substack}/subscribe`;

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const fieldId = `fts-email${compact ? "-compact" : ""}`;
---

<div class={`fts${compact ? " fts--compact" : ""}`}>
  <p class="hud-label fts-kicker">Follow the Stories</p>
  {/* ⚠ OPERATOR READ-APPROVAL REQUIRED — new promise copy (staging-only until read). */}
  <p class="fts-promise">One dispatch when there's a real story to tell — no noise, unsubscribe anytime.</p>

  <form class="fts-form" method="get" action={SUBSTACK_SUBSCRIBE}>
    <label for={fieldId} class="sr-only">Email</label>
    <input id={fieldId} name="email" type="email" required placeholder="you@email.com" class="fts-input" />
    <button type="submit" class="btn fts-submit">Subscribe</button>
  </form>
  <p class="fts-note">Delivered by Substack — the subscribe page opens with your address filled in.</p>
</div>

<style>
  .fts {
    display: grid;
    gap: 0.55rem;
    max-width: 26rem;
  }
  .fts-kicker {
    margin: 0;
    letter-spacing: 0.22em;
  }
  .fts-promise {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 32ch;
  }
  .fts-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.3rem;
  }
  .fts-input {
    flex: 1 1 14rem;
    min-height: 44px;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--color-ink);
    background: color-mix(in srgb, #ffffff 6%, transparent);
    border: 1px solid var(--color-hairline, color-mix(in srgb, #ffffff 16%, transparent));
    border-radius: 2px;
    padding: 0.6rem 0.85rem;
  }
  .fts-input::placeholder {
    color: color-mix(in srgb, var(--color-ink-muted) 85%, transparent);
  }
  .fts-input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .fts-submit {
    flex: 0 0 auto;
  }
  .fts-note {
    margin: 0;
    font-family: var(--font-mono);
    /* AUDIT-FIX (2026-08-03): explains why the button is disabled — real
       content, not a label. 0.68rem (10.88px) was sub-11px; bumped slightly. */
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-ink-muted) 85%, transparent);
  }

  /* compact — the footer mount: tighter stack, smaller promise line */
  .fts--compact .fts-promise {
    font-size: 0.85rem;
  }
  .fts--compact .fts-form {
    max-width: 24rem;
  }
</style>
