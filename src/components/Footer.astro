---
/**
 * Footer in the system voice — hairline top rule, mono hud labels, muted ink.
 * Email + socials from SITE ([confirm] values render visibly inert, never
 * guessed links — the audit gate catches them before production).
 *
 * PUB-C (2026-07-27) — publication restructure: FOOTER_NAV below is a LOCAL
 * nav list, deliberately decoupled from the shared `NAV` in consts.ts (which
 * also drives the header Nav.astro + MobileMenu — PUB-A's surfaces). Adds
 * Licensing, drops Industry Stories, reorders — without touching the header
 * or the shared consts. Identity line now reads "Founded by {SITE.person}"
 * (byline convention) instead of the former persona line. FollowTheStories
 * (compact) mounts above the trust row + Book a call — the publication's own
 * funnel leads; Book a call stays, demoted. FAA line + "Fly the world" are
 * untouched.
 */
import { SITE } from "../consts";
import FollowTheStories from "./FollowTheStories.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const socialEntries = Object.entries(SITE.socials);

// ⚠ OPERATOR READ-APPROVAL REQUIRED — footer-only nav restructure for the
// publication pivot (staging-only until read; see COPY-DECK-C.md). Labels
// ONLY changed — every href already exists as a live page. "Industry Stories"
// is removed per PUB-C directive; the buyer-pairing convention is kept for
// the rest so the footer still reads consistently against the header.
// NOTE (2026-07-27): href points at /venture, not the shared consts.ts NAV's
// /entertainment — src/pages/entertainment.astro was renamed to venture.astro
// concurrently by another in-flight change; this footer targets the live
// route so the link never 404s, independent of when consts.ts NAV catches up.
type FooterNavItem = { label: string; href: string; buyer?: string };
const FOOTER_NAV: readonly FooterNavItem[] = [
  { label: "Adventure Stories", buyer: "Drone & aerial production", href: "/adventure" },
  { label: "Venture Stories", buyer: "Corporate storytelling & research", href: "/venture" },
  { label: "About", href: "/about" },
  { label: "Contact", buyer: "Book a call", href: "/contact" },
  { label: "Licensing", buyer: "Commercial & editorial licensing", href: "/licensing" },
  { label: "Forge the Saga", buyer: "Consulting — research + production", href: "/forge-the-saga" },
] as const;
---

<footer class="border-t border-hairline px-5 py-8 text-sm">
  <div class="mx-auto flex max-w-5xl flex-wrap items-start justify-between gap-8">
    <div class="space-y-1">
      {/* ⚠ OPERATOR READ-APPROVAL REQUIRED — byline convention replaces the former persona line (COPY-DECK-C.md). */}
      <p class="text-peak">Founded by {SITE.person}</p>
      <p class="hud-label">{SITE.location}</p>
      <p>
        <a href={`mailto:${SITE.email}`} class="text-ink-muted hover:text-accent">{SITE.email}</a>
      </p>
      <p class="pt-2">
        <a href={`${base}/privacy`} class="hud-label hover:text-accent">Privacy</a>
      </p>
      <!-- P30 — quiet persistent way back into the /world experience: a
           delight-invite in the footer's hud grammar, deliberately NOT a nav
           item (it never competes with the money lanes). -->
      <p>
        <a href={`${base}/world`} class="hud-label world-invite hover:text-accent">✦ Fly the world</a>
      </p>
    </div>
    <nav aria-label="Footer">
      <ul class="space-y-1.5">
        {
          FOOTER_NAV.map((item) => (
            <li>
              <a href={`${base}${item.href}`} class="text-ink-muted hover:text-accent">
                {item.label}
                {/* P29 buyer-language pairing (NAV.buyer) — em-dash pairing */}
                {item.buyer && <span class="footer-buyer"> — {item.buyer}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ul class="space-y-1.5">
      {
        socialEntries.map(([platform, url]) => (
          <li>
            {url === "[confirm]" ? (
              <span aria-disabled="true" class="hud-label opacity-60">
                {platform} [confirm]
              </span>
            ) : (
              <a href={url} class="text-ink-muted capitalize hover:text-accent" rel="me noopener">
                {platform}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
  <!-- PUB-C — the publication's own funnel leads: Follow the Stories mounts
       here, above the trust row + Book a call (services stay present, quiet). -->
  <div class="footer-follow mx-auto mt-8 max-w-5xl border-t border-hairline pt-6">
    <FollowTheStories compact />
  </div>

  <!-- P29 — sitewide trust row (SITE.trust — P30 copy rules in consts.ts) +
       the direct booking link, so every page terminates on a call-to-action
       with the logistics answered beside it. PUB-C: demoted below Follow the
       Stories — publication first, services quiet — but still present. -->
  <div class="footer-trust mx-auto mt-6 flex max-w-5xl flex-wrap items-center justify-between gap-4 border-t border-hairline pt-5">
    <ul class="footer-trust-list">
      <li>{SITE.trust.drone}</li>
      <li>{SITE.trust.response}</li>
      <li>{SITE.trust.base}</li>
      <li>{SITE.trust.travel}</li>
    </ul>
    <a href={SITE.bookACall} class="btn" rel="noopener">Book a call</a>
  </div>
</footer>

<style>
  /* P30 — the world invite glints softly toward the accent; an easter-egg
     whisper, not a button. */
  .world-invite {
    color: color-mix(in srgb, var(--color-accent, #5eead4) 55%, currentColor);
  }
  .footer-buyer {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, currentColor 62%, transparent);
  }
  .footer-trust-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted, #8a9a96);
  }
  .footer-trust-list li + li::before {
    content: "·";
    margin-inline: 0.6rem;
    color: color-mix(in srgb, currentColor 55%, transparent);
  }
</style>
